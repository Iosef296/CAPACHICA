---
---

<nav class="fixed top-0 left-0 right-0 h-16 backdrop-blur-xl border-b z-[1000] transition-all duration-500" id="mainNav" style="background:rgba(11,20,38,0.85); border-color:rgba(255,255,255,0.1);">
  <div class="max-w-7xl mx-auto h-full px-6 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-extrabold text-xl">
      <span class="text-2xl">🏔️</span>
      <span>Capachica</span>
    </a>

    <div class="hidden md:flex gap-6">
      <a href="#inicio" class="nav-link font-medium transition-colors text-white/70 hover:text-[#FF6B35]">Inicio</a>
      <a href="#destinos" class="nav-link font-medium transition-colors text-white/70 hover:text-[#FF6B35]">Destinos</a>
      <a href="#festividades" class="nav-link font-medium transition-colors text-white/70 hover:text-[#FF6B35]">Festividades</a>
      <a href="#calendario" class="nav-link font-medium transition-colors text-white/70 hover:text-[#FF6B35]">📅 Calendario</a>
      <a href="#admin" class="nav-link font-medium transition-colors text-white/70 hover:text-[#FF6B35]">✏️ Administrar</a>
    </div>

    <div class="flex items-center gap-3">
      <button id="themeToggle" class="flex items-center gap-1.5 rounded-full px-3 py-1.5 transition-all" style="background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.12);" aria-label="Cambiar tema día/noche">
        <span class="text-sm" id="iconMoon">🌙</span>
        <span class="w-10 h-5 rounded-full relative transition-colors duration-500" id="toggleTrack" style="background:#1B2D5A;">
          <span class="absolute top-0.5 left-0.5 w-4 h-4 bg-white rounded-full transition-transform duration-500" id="toggleThumb"></span>
        </span>
        <span class="text-sm" id="iconSun">☀️</span>
      </button>

      <button id="hamburger" class="md:hidden flex flex-col gap-1.5 bg-transparent" aria-label="Menú">
        <span class="block w-6 h-0.5 bg-white transition-all"></span>
        <span class="block w-6 h-0.5 bg-white transition-all"></span>
        <span class="block w-6 h-0.5 bg-white transition-all"></span>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div class="hidden md:hidden flex-col gap-4 p-6 backdrop-blur-xl border-b" id="mobileMenu" style="background:rgba(11,20,38,0.95); border-color:rgba(255,255,255,0.1);">
    <a href="#inicio" class="text-white/80 hover:text-[#FF6B35] font-medium">Inicio</a>
    <a href="#destinos" class="text-white/80 hover:text-[#FF6B35] font-medium">Destinos</a>
    <a href="#festividades" class="text-white/80 hover:text-[#FF6B35] font-medium">Festividades</a>
    <a href="#calendario" class="text-white/80 hover:text-[#FF6B35] font-medium">📅 Calendario</a>
    <a href="#admin" class="text-white/80 hover:text-[#FF6B35] font-medium">✏️ Administrar</a>
  </div>
</nav>

<script>
  const toggle = document.getElementById('themeToggle');
  const html = document.documentElement;
  const track = document.getElementById('toggleTrack');
  const thumb = document.getElementById('toggleThumb');
  const body = document.querySelector('body');
  const nav = document.getElementById('mainNav');
  const mobileMenu = document.getElementById('mobileMenu');
  const hamburger = document.getElementById('hamburger');
  const links = mobileMenu?.querySelectorAll('a');

  // Tema inicial según hora
  const hour = new Date().getHours();
  const initial = (hour >= 6 && hour < 18) ? 'day' : 'night';
  html.setAttribute('data-theme', initial);
  applyTheme(initial);

  function applyTheme(theme: string) {
    if (theme === 'day') {
      if (body) { body.style.background = '#87CEEB'; body.style.color = '#1A2744'; }
      if (nav) { nav.style.background = 'rgba(135,206,235,0.85)'; nav.style.borderColor = 'rgba(255,255,255,0.3)'; }
      if (track) track.style.background = '#FFD700';
      thumb?.classList.add('translate-x-5');
      document.querySelectorAll('.nav-link').forEach(l => { (l as HTMLElement).style.color = 'rgba(26,39,68,0.7)'; });
    } else {
      if (body) { body.style.background = '#0B1426'; body.style.color = '#FFFFFF'; }
      if (nav) { nav.style.background = 'rgba(11,20,38,0.85)'; nav.style.borderColor = 'rgba(255,255,255,0.1)'; }
      if (track) track.style.background = '#1B2D5A';
      thumb?.classList.remove('translate-x-5');
      document.querySelectorAll('.nav-link').forEach(l => { (l as HTMLElement).style.color = 'rgba(255,255,255,0.7)'; });
    }
  }

  toggle?.addEventListener('click', () => {
    const current = html.getAttribute('data-theme');
    const next = current === 'night' ? 'day' : 'night';
    html.setAttribute('data-theme', next);
    applyTheme(next);
  });

  // Menú hamburguesa
  hamburger?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    mobileMenu?.classList.toggle('flex');
  });

  links?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      mobileMenu?.classList.remove('flex');
    });
  });
</script>