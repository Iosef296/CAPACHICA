{
  "expo": {
    "name": "Capachica Experience AI",
    "slug": "capachica-experience-ai",
    "scheme": "capachica",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "cover",
      "backgroundColor": "#004268"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.capachica.experienceai",
      "config": {
        "googleMapsApiKey": "REPLACE_WITH_GOOGLE_MAPS_KEY"
      }
    },
    "android": {
      "package": "com.capachica.experienceai",
      "adaptiveIcon": {
        "backgroundColor": "#004268"
      },
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_GOOGLE_MAPS_KEY"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://capachica-backend-production.up.railway.app/api",
      "iaBaseUrl": "https://capachica-ia-production.up.railway.app/api",
      "googleClientIdAndroid": "936387439928-qjjka8gb17gbhmvffjmpr8jjq311epah.apps.googleusercontent.com",
      "googleClientIdIos": "936387439928-qjjka8gb17gbhmvffjmpr8jjq311epah.apps.googleusercontent.com",
      "googleClientIdWeb": "936387439928-gpn5ejhha3uips58ponnim3t6gc0s45e.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "8d029b1e-ab0f-4b6e-91ca-7a0a7e9711c3"
      }
    },
    "owner": "iosef296"
  }
}
