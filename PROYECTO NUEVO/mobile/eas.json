{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://capachica-backend-production.up.railway.app/api",
        "EXPO_PUBLIC_IA_BASE": "https://capachica-ia-production.up.railway.app/api"
      }
    },
    "production": {
      "channel": "production",
      "android": { "buildType": "apk" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
