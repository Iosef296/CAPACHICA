---
// src/components/RestauranteCard.astro
import { APP_CONFIG } from '../../config/app.config.js';

const { restaurante, translations } = Astro.props;
const { id, nombre, descripcion, direccion, fotos, tipo_comida, precio_promedio } = restaurante;

// El backend envía un array llamado "fotos". Tomamos la primera.
let imagenUrl = (fotos && fotos.length > 0) ? fotos[0] : null;

// Si la imagen es una ruta relativa (/uploads/...), le pegamos la URL del backend
if (imagenUrl && !imagenUrl.startsWith('http')) {
    const cleanPath = imagenUrl.replace(/\\/g, '/');
    const prefix = cleanPath.startsWith('/') ? '' : '/';
    imagenUrl = `${APP_CONFIG.backendUrl}${prefix}${cleanPath}`;
}
---

<article class="restaurante-card">
    <a href={`/gastronomia/${id}`} class="card-link">
        <div class="card-image-wrapper">
            <img
                    src={imagenUrl || '/images/placeholder.jpg'}
                    alt={nombre}
                    class="card-image"
            />
            <div class="image-overlay"></div>
            <span class="card-badge">
                {tipo_comida ? tipo_comida.replace('_', ' ') : 'Variado'}
            </span>
        </div>

        <div class="card-content">
            <h3 class="card-title">{nombre}</h3>

            <div class="card-location">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>{direccion || 'Ubicación no disponible'}</span>
            </div>

            <p class="card-desc">{descripcion?.substring(0, 80)}...</p>

            <div class="card-footer">
                <span class="price-label">Precio promedio</span>
                <span class="price-value">
                    {precio_promedio ? `S/ ${precio_promedio}` : 'No disponible'}
                </span>
            </div>
        </div>
    </a>
</article>

<style is:global>
/* Mantén exactamente el mismo CSS que ya tenías aquí, no cambia nada del diseño */
    .restaurante-card {
        background: rgba(26, 32, 44, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(79, 209, 197, 0.2);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
        height: 100%;
    }

    .restaurante-card:hover {
        transform: translateY(-8px);
        border-color: var(--turquesa);
        box-shadow: 0 10px 25px rgba(79, 209, 197, 0.3);
    }

    .card-link { text-decoration: none; color: inherit; display: flex; flex-direction: column; height: 100%; }
    .card-image-wrapper { height: 200px; position: relative; overflow: hidden; background-color: #1a202c; }
    .card-image { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
    .restaurante-card:hover .card-image { transform: scale(1.08); }
    .image-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 60%, rgba(26, 32, 44, 0.9) 100%); pointer-events: none; }

    .card-badge {
        position: absolute; top: 1rem; right: 1rem; background: rgba(214, 158, 46, 0.15);
        backdrop-filter: blur(4px); border: 1px solid var(--dorado); color: var(--dorado);
        padding: 0.3rem 0.8rem; border-radius: 2rem; font-size: 0.75rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px; box-shadow: 0 0 10px rgba(214, 158, 46, 0.3); z-index: 2;
    }

    .card-content { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
    .card-title { font-size: 1.4rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem; text-shadow: 0 0 8px rgba(255, 255, 255, 0.1); transition: color 0.3s ease; }
    .restaurante-card:hover .card-title { color: var(--turquesa-claro, #81e6d9); }
    .card-location { display: flex; align-items: center; gap: 0.5rem; color: #a0aec0; font-size: 0.85rem; margin-bottom: 1rem; }
    .card-location svg { color: var(--turquesa); flex-shrink: 0; }
    .card-desc { color: #cbd5e0; font-size: 0.95rem; line-height: 1.5; margin-bottom: 1.5rem; flex-grow: 1; }
    .card-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.1); margin-top: auto; }
    .price-label { font-size: 0.8rem; color: #718096; text-transform: uppercase; letter-spacing: 0.5px; }
    .price-value { font-size: 1.1rem; font-weight: 700; color: var(--turquesa); text-shadow: 0 0 10px rgba(79, 209, 197, 0.3); }

    @media (max-width: 480px) {
        .card-image-wrapper { height: 180px; }
        .card-content { padding: 1.2rem; }
        .card-title { font-size: 1.25rem; }
    }
</style>