---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Capachica Turismo — La joya del Lago Titicaca',
  description = 'Descubre la península de Capachica: turismo vivencial, gastronomía andina, festividades ancestrales y los atardeceres más bellos del Titicaca.',
  image = '/og-capachica.jpg',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#060f1a" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />

    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <slot name="head" />

    <!-- Scroll reveal script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const io = new IntersectionObserver(
          (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
          { threshold: 0.12 }
        );
        document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => io.observe(el));
      });
    </script>
  </head>
  <body>
    <Navbar client:load />
    <slot />
    <Footer />
  </body>
</html>
