---
const IA_URL = import.meta.env.PUBLIC_IA_URL || 'http://localhost:5000';
let sitecfg: any = { navbar: {}, footer: {} };
try { const r = await fetch(`${IA_URL}/api/siteconfig`); if (r.ok) sitecfg = await r.json(); } catch {}
const ft = sitecfg.footer || {};
const rawColOrder: any[] = (ft.column_order as any[]) || [['brand'],['destinos'],['experiencias'],['info'],['newsletter']];
const columnOrder: string[][] = rawColOrder.map((c: any) => Array.isArray(c) ? c : [c]);
const nb = sitecfg.navbar || {};
const logoNombre  = nb.logo_nombre  || 'Capachica';
const logoTagline = nb.logo_tagline || 'TURISMO VIVENCIAL';
---

<!-- ═══════════ BOTTOM WAVE ═══════════ -->
<div class="bottom-wave">
  <div class="sand-wave"></div>
</div>

<!-- ═══════════ ARENA FOOTER ═══════════ -->
<footer class="arena-footer">
  <!-- Campfires (dark mode) -->
  <div class="illo-campfire">
    <img src="/campfire.png" alt="" aria-hidden="true" />
  </div>
  <div class="illo-campfire2">
    <img src="/campfire.png" alt="" aria-hidden="true" />
  </div>

  <!-- Beach balls (light mode) -->
  <div class="beach-ball-wrap" style="bottom:22px;right:65px;">
    <div class="beach-ball" style="width:100px;height:100px;--bb-dur:2.9s;--bb-delay:0s;"></div>
    <div class="beach-ball-shadow" style="width:100px;height:26px;"></div>
  </div>
  <div class="beach-ball-wrap" style="bottom:22px;left:65px;">
    <div class="beach-ball" style="width:100px;height:100px;--bb-dur:3.3s;--bb-delay:0.55s;"></div>
    <div class="beach-ball-shadow" style="width:100px;height:26px;"></div>
  </div>

  <!-- Footer content -->
  <div class="arena-footer-body">
    <div class="arena-footer-grid">

      {columnOrder.map((colKeys: string[]) => {
        const colId = colKeys.join('-');
        const hasBrand = colKeys.includes('brand');
        return (
          <div class={hasBrand ? 'arena-brand-col' : ''} data-footer-col={colId} style={hasBrand ? undefined : 'min-width:0'}>
            {colKeys.map((key: string, ki: number) => {
              const mt = ki > 0 ? 'margin-top:1.25rem;' : '';
              if (key === 'brand') return (
                <>
                  <div class="arena-brand-logo">
                    <div class="arena-logo-circle">{logoNombre[0] || 'C'}</div>
                    <div>
                      <div class="arena-brand-name">{logoNombre}</div>
                      <div class="arena-brand-tagline">{logoTagline}</div>
                    </div>
                  </div>
                  <p class="arena-text arena-brand-desc">{ft.brand_desc || 'La joya escondida del lago Titicaca. Turismo comunitario auténtico a 3,820 msnm.'}</p>
                  <div class="arena-social-row">
                    <a href={ft.social_instagram || 'https://instagram.com/capachicaturismo'} target="_blank" rel="noopener noreferrer" class="arena-social-btn" aria-label="Instagram">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                    </a>
                    <a href={ft.social_facebook || 'https://facebook.com'} target="_blank" rel="noopener noreferrer" class="arena-social-btn" aria-label="Facebook">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    </a>
                    <a href={ft.social_youtube || 'https://youtube.com'} target="_blank" rel="noopener noreferrer" class="arena-social-btn" aria-label="YouTube">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#1a1008"/></svg>
                    </a>
                    <a href={ft.social_tiktok || 'https://tiktok.com'} target="_blank" rel="noopener noreferrer" class="arena-social-btn" aria-label="TikTok">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
                    </a>
                  </div>
                </>
              );
              if (key === 'destinos') return (
                <>
                  <div class="arena-heading" style={mt}>Destinos</div>
                  <ul class="arena-link-list" data-footer-section="destinos">
                    {(ft.destinos_links?.length ? ft.destinos_links : [{label:'Playa Llachón',href:'/destinos'},{label:'Mirador del Amaru',href:'/destinos'},{label:'Isla Ticonata',href:'/destinos'},{label:'Comunidad Capachica',href:'/destinos'},{label:'Ver todos →',href:'/destinos'}]).map((l: any) => (
                      <li><a href={l.href} class="arena-link footer-link">{l.label}</a></li>
                    ))}
                  </ul>
                </>
              );
              if (key === 'experiencias') return (
                <>
                  <div class="arena-heading" style={mt}>Experiencias</div>
                  <ul class="arena-link-list" data-footer-section="experiencias">
                    {(ft.experiencias_links?.length ? ft.experiencias_links : [{label:'Vivencial',href:'/vivencial'},{label:'Actividades',href:'/actividades'},{label:'Gastronomía',href:'/gastronomia'},{label:'Festividades',href:'/festividades'},{label:'Artesanía',href:'/artesania'}]).map((l: any) => (
                      <li><a href={l.href} class="arena-link footer-link">{l.label}</a></li>
                    ))}
                  </ul>
                </>
              );
              if (key === 'info') return (
                <>
                  <div class="arena-heading" style={mt}>Info</div>
                  <ul class="arena-link-list" data-footer-section="info">
                    {(ft.links?.length ? ft.links : [{label:'Alojamiento',href:'/alojamiento'},{label:'Cómo llegar',href:'/como-llegar'},{label:'Términos',href:'/terminos'},{label:'Privacidad',href:'/privacidad'},{label:'Cancelaciones',href:'/cancelaciones'}]).map((l: any) => (
                      <li><a href={l.href} class="arena-link footer-link">{l.label}</a></li>
                    ))}
                  </ul>
                </>
              );
              if (key === 'newsletter') return (
                <>
                  <div class="arena-heading">Newsletter</div>
                  <p class="arena-text" style="font-size:12px;margin-bottom:0.8rem;line-height:1.55;">{ft.newsletter_desc || 'Novedades y ofertas exclusivas · 1 email/semana'}</p>
                  <div class="arena-newsletter-form" id="arenaNewsletterForm">
                    <input type="email" id="arenaEmailInput" class="arena-newsletter-input" placeholder="tu@email.com" autocomplete="email" />
                    <button class="arena-subscribe-btn" id="arenaSubscribeBtn" type="button">Suscribirme</button>
                    <span class="arena-text" style="font-size:11px;opacity:0.7;">{ft.newsletter_spam_text || 'Sin spam, prometido'}</span>
                  </div>
                  <p id="arenaSubscribedMsg" style="display:none;font-size:13px;color:rgba(212,168,67,0.9);">¡Gracias! Te escribiremos pronto 🌊</p>
                  <div class="arena-contact-row">
                    <a href={`https://wa.me/${ft.contacto_whatsapp || '51955949404'}`} target="_blank" rel="noopener noreferrer" class="arena-contact-item">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.6 19.79 19.79 0 0 1 1.61 5.1 2 2 0 0 1 3.6 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.6a16 16 0 0 0 6 6l.94-.94a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 18z"/></svg>
                      <span>{ft.contacto_whatsapp ? `+${ft.contacto_whatsapp}` : '+51 955 949 404'}</span>
                    </a>
                    <a href={`mailto:${ft.contacto_email || 'torresdeissy56@gmail.com'}`} class="arena-contact-item">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                      <span>{ft.contacto_email || 'torresdeissy56@gmail.com'}</span>
                    </a>
                  </div>
                </>
              );
              return null;
            })}
          </div>
        );
      })}

    </div>

    <!-- Bottom bar -->
    <div class="arena-bottom-bar">
      <p class="arena-text" style="font-size:12px;letter-spacing:0.2px;">{ft.copyright || '© 2026 Capachica Turismo · Hecho con ❤️ a las orillas del lago Titicaca'}</p>
      <div class="arena-legal-links">
        <a href="/privacidad"    class="arena-link">Privacidad</a>
        <a href="/terminos"      class="arena-link">Términos</a>
        <a href="/cookies"       class="arena-link">Cookies</a>
        <a href="/cancelaciones" class="arena-link">Cancelaciones</a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  [data-theme="light"] .arena-footer { background: linear-gradient(180deg,#edd890 0%,#dbb852 28%,#c89838 60%,#ae7e20 100%) !important; }
  [data-theme="light"] .arena-footer::before { display: none; }
  [data-theme="light"] .arena-brand-name { color: rgba(26,16,4,0.95) !important; }
  [data-theme="light"] .arena-brand-tagline { color: rgba(90,55,5,0.80) !important; }
  [data-theme="light"] .arena-heading { color: rgba(60,35,4,0.90) !important; }
  [data-theme="light"] .arena-link { color: rgba(26,14,2,0.80) !important; }
  [data-theme="light"] .arena-link:hover { color: rgba(26,14,2,1) !important; }
  [data-theme="light"] .arena-text { color: rgba(26,14,2,0.72) !important; }
  [data-theme="light"] .arena-social-btn { color: rgba(26,14,2,0.70) !important; border-color: rgba(90,55,5,0.40); background: rgba(90,55,5,0.12); }
  [data-theme="light"] .arena-social-btn:hover { color: rgba(26,14,2,1) !important; background: rgba(90,55,5,0.25); border-color: rgba(90,55,5,0.65); }
  [data-theme="light"] .arena-contact-item { color: rgba(26,14,2,0.72) !important; }
  [data-theme="light"] .arena-contact-item:hover { color: rgba(26,14,2,1) !important; }
  [data-theme="light"] .arena-newsletter-input { background: rgba(255,255,255,0.50) !important; border-color: rgba(90,55,5,0.40) !important; color: rgba(26,14,2,0.95) !important; }
  [data-theme="light"] .arena-newsletter-input::placeholder { color: rgba(26,14,2,0.40) !important; }
  [data-theme="light"] .arena-link-list li::before { background: rgba(90,55,5,0.55) !important; }
  [data-theme="light"] .arena-footer-grid { border-bottom-color: rgba(90,55,5,0.22) !important; }
  [data-theme="light"] .arena-bottom-bar { border-top-color: rgba(90,55,5,0.22) !important; }
</style>

<script is:inline>
  (function() {
    const form  = document.getElementById('arenaNewsletterForm');
    const input = document.getElementById('arenaEmailInput');
    const btn   = document.getElementById('arenaSubscribeBtn');
    const msg   = document.getElementById('arenaSubscribedMsg');
    if (!btn || !input || !form || !msg) return;
    async function subscribe() {
      const email = input.value.trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        input.style.borderColor = 'rgba(220,60,60,0.6)';
        setTimeout(() => input.style.borderColor = '', 1200);
        return;
      }
      btn.disabled = true; btn.textContent = 'Enviando…';
      try {
        const res = await fetch('http://localhost:3030/api/newsletter', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ email }),
        });
        const data = await res.json();
        if (!data.success) { alert(data.message || 'Error'); btn.disabled = false; btn.textContent = 'Suscribirme'; return; }
      } catch {}
      form.style.display = 'none'; msg.style.display = 'block';
    }
    btn.addEventListener('click', subscribe);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') subscribe(); });
  })();
</script>
