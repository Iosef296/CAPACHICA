---
const { secciones = [], skipHero = false } = Astro.props;

function hexToRgb(hex: string) {
  const m = (hex || '#38bdf8').replace('#', '').match(/.{2}/g);
  return m ? (m as string[]).map((h: string) => parseInt(h, 16)).join(',') : '56,189,248';
}
---

{secciones.map((sec: any) => {
  if (skipHero && sec.tipo === 'hero') return null;

  if (sec.tipo === 'hero') return (
    <Fragment>
      {sec.titulo && <h1 class="section-title" style="font-size:clamp(2.2rem,5vw,3.5rem);margin-bottom:1rem;">{sec.titulo}</h1>}
      {sec.subtitulo && <p style="font-size:1.05rem;color:var(--text2);line-height:1.75;max-width:560px;margin:0 auto 2rem;">{sec.subtitulo}</p>}
    </Fragment>
  );

  if (sec.tipo === 'texto') return (
    <div class="reveal" data-cms-tipo="texto" style="margin-bottom:3.5rem;">
      {sec.titulo && <h2 style="font-family:var(--font-display);font-size:1.8rem;font-weight:700;color:var(--text);margin-bottom:1rem;">{sec.titulo}</h2>}
      <div style="font-size:1rem;color:var(--text2);line-height:1.85;max-width:720px;white-space:pre-wrap;">{sec.contenido}</div>
    </div>
  );

  if (sec.tipo === 'cards') return (
    <div class="reveal" data-cms-tipo="cards" style="margin-bottom:3.5rem;">
      {sec.titulo && <h2 style="font-family:var(--font-display);font-size:1.8rem;font-weight:700;color:var(--text);margin-bottom:1.5rem;">{sec.titulo}</h2>}
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.4rem;">
        {(sec.items || []).map((item: any) => {
          const rgb = item.color ? hexToRgb(item.color) : '56,189,248';
          const amenities = item.extra ? item.extra.split('\n').filter(Boolean) : [];
          return (
            <div class="card" style="padding:0;overflow:hidden;position:relative;">
              {item.popular && (
                <div style="position:absolute;top:12px;right:12px;z-index:10;padding:4px 12px;border-radius:999px;font-size:10px;font-weight:700;letter-spacing:0.1em;background:linear-gradient(135deg,#fbbf24,#f97316);color:#fff;">★ POPULAR</div>
              )}
              {/* Card header */}
              <div style={`height:160px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:${item.imagen ? `url('${item.imagen}') center/cover` : `linear-gradient(135deg,rgba(6,15,26,0.95),rgba(${rgb},0.12))`};border-bottom:1px solid var(--border);position:relative;overflow:hidden;`}>
                {item.imagen && <div style="position:absolute;inset:0;background:linear-gradient(to bottom,transparent 30%,rgba(0,0,0,0.55))"></div>}
                {!item.imagen && item.emoji && <div style="font-size:2.8rem;z-index:1;">{item.emoji}</div>}
                {item.etiqueta && (
                  <span style={`${item.imagen ? 'margin-top:auto;margin-bottom:0.75rem;' : 'margin-top:0.6rem;'}padding:3px 11px;border-radius:999px;font-size:10px;font-weight:600;background:rgba(${rgb},0.15);color:${item.color || 'var(--accent)'};border:1px solid rgba(${rgb},0.25);z-index:1;`}>{item.etiqueta}</span>
                )}
              </div>
              {/* Card body */}
              <div style="padding:1.3rem;">
                <h3 style="font-family:var(--font-display);font-size:1.05rem;font-weight:700;color:var(--text);margin-bottom:0.4rem;">{item.titulo}</h3>
                {item.lugar && <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.6rem;font-weight:500;">📍 {item.lugar}</div>}
                {item.desc && <p style="font-size:0.85rem;color:var(--text2);line-height:1.65;margin-bottom:0.9rem;">{item.desc}</p>}
                {amenities.length > 0 && (
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.3rem;margin-bottom:1rem;">
                    {amenities.map((a: string) => (
                      <span style="font-size:11px;color:var(--text3);background:rgba(255,255,255,0.04);padding:4px 8px;border-radius:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{a}</span>
                    ))}
                  </div>
                )}
                {item.precio && (
                  <div style={`display:flex;align-items:center;justify-content:space-between;${amenities.length ? 'padding-top:0.8rem;border-top:1px solid var(--border);' : ''}`}>
                    <div>
                      <span style={`font-family:var(--font-display);font-size:1.4rem;font-weight:800;color:${item.color || 'var(--accent)'};`}>{item.precio}</span>
                      {item.precio_unidad && <span style="font-size:0.75rem;color:var(--text3);margin-left:4px;">/ {item.precio_unidad}</span>}
                    </div>
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );

  if (sec.tipo === 'galeria') return (
    <div class="reveal" data-cms-tipo="galeria" style="margin-bottom:3.5rem;">
      {sec.titulo && <h2 style="font-family:var(--font-display);font-size:1.8rem;font-weight:700;color:var(--text);margin-bottom:1.5rem;">{sec.titulo}</h2>}
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:0.75rem;">
        {(sec.imagenes || []).map((url: string) => (
          <div style={`height:200px;border-radius:12px;overflow:hidden;background:url('${url}') center/cover no-repeat;border:1px solid rgba(255,255,255,0.06);`}></div>
        ))}
      </div>
    </div>
  );

  if (sec.tipo === 'contacto') return (
    <div class="reveal" data-cms-tipo="contacto" style="border-top:1px solid rgba(45,212,191,0.14);padding:4rem 0;text-align:center;margin-top:2rem;">
      <h2 class="section-title" style="margin-bottom:1rem;">{sec.titulo || '¿Listo para tu aventura?'}</h2>
      {sec.subtitulo && <p style="color:var(--text2);margin-bottom:2rem;line-height:1.7;">{sec.subtitulo}</p>}
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        {sec.boton_texto && sec.boton_url && <a href={sec.boton_url} class="btn-primary">{sec.boton_texto} →</a>}
        {(sec.boton2_texto || sec.boton2_url) ? (
          <a href={sec.boton2_url || '/'} class="btn-outline">{sec.boton2_texto || 'Más info'}</a>
        ) : (
          <a href="/" class="btn-outline">Volver al inicio</a>
        )}
      </div>
    </div>
  );

  if (sec.tipo === 'stats') return (
    <div class="reveal" data-cms-tipo="stats" style="margin-bottom:3.5rem;text-align:center;">
      {sec.titulo && <h2 style="font-family:var(--font-display);font-size:1.8rem;font-weight:700;color:var(--text);margin-bottom:1.5rem;">{sec.titulo}</h2>}
      <div style="display:flex;justify-content:center;gap:3rem;flex-wrap:wrap;">
        {(sec.items || []).map((s: any) => (
          <div>
            <div style="font-family:var(--font-display);font-size:2rem;font-weight:800;color:var(--gold);line-height:1;">{s.valor}</div>
            <div style="font-size:0.73rem;color:var(--text2);letter-spacing:0.1em;text-transform:uppercase;margin-top:4px;">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  );

  if (sec.tipo === 'features') return (
    <div class="reveal" data-cms-tipo="features" style="margin-bottom:3.5rem;">
      {sec.titulo && <h2 style="font-family:var(--font-display);font-size:1.8rem;font-weight:700;color:var(--text);margin-bottom:1.5rem;">{sec.titulo}</h2>}
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.5rem;">
        {(sec.items || []).map((f: any) => (
          <div style="text-align:center;padding:1.5rem 1rem;background:var(--bg-card,rgba(4,50,64,0.5));border:1px solid rgba(255,255,255,0.06);border-radius:12px;">
            {f.icono && <div style="font-size:2rem;margin-bottom:0.75rem;">{f.icono}</div>}
            <div style="font-weight:700;color:var(--text);margin-bottom:0.4rem;font-size:0.95rem;">{f.titulo}</div>
            <div style="font-size:0.82rem;color:var(--text2);line-height:1.6;">{f.desc}</div>
          </div>
        ))}
      </div>
    </div>
  );

  if (sec.tipo === 'pasos') return (
    <div class="reveal" data-cms-tipo="pasos" style="margin-bottom:3.5rem;">
      {sec.titulo && <h2 style="font-family:var(--font-display);font-size:1.8rem;font-weight:700;color:var(--text);margin-bottom:1.5rem;">{sec.titulo}</h2>}
      <div style="display:flex;flex-direction:column;gap:1rem;">
        {(sec.items || []).map((p: any, i: number) => (
          <div style="display:flex;gap:1.2rem;align-items:flex-start;background:var(--bg-card,rgba(4,50,64,0.5));border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:1.1rem 1.3rem;">
            <div style="font-size:1.8rem;flex-shrink:0;margin-top:2px;">{p.icono || String(i+1)}</div>
            <div>
              <div style="font-weight:700;color:var(--text);font-size:1rem;margin-bottom:0.35rem;">{p.titulo}</div>
              {p.desc && <div style="font-size:0.875rem;color:var(--text2);line-height:1.65;white-space:pre-wrap;">{p.desc}</div>}
            </div>
          </div>
        ))}
      </div>
    </div>
  );

  if (sec.tipo === 'bienvenida') return (
    <section data-cms-tipo="bienvenida" style="padding:90px 0;border-bottom:1px solid var(--border,rgba(45,212,191,0.14));">
      <div class="container">
        <div class="text-center reveal" style="margin-bottom:3.5rem;">
          {sec.label && <span class="section-label">{sec.label}</span>}
          {sec.titulo && <h2 class="section-title">Bienvenido a <span class="gradient-text">{sec.titulo}</span></h2>}
          <div class="divider" style="margin:1rem auto;"></div>
          {sec.intro && <p style="color:rgba(240,237,232,0.82);max-width:600px;margin:0 auto;line-height:1.85;font-size:1rem;">{sec.intro}</p>}
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:3.5rem;align-items:center;">
          <div class="reveal">
            {sec.parrafo1 && <p style="color:rgba(240,237,232,0.82);line-height:1.9;margin-bottom:1.4rem;font-size:1rem;">{sec.parrafo1}</p>}
            {sec.parrafo2 && <p style="color:rgba(240,237,232,0.72);line-height:1.9;font-size:0.95rem;">{sec.parrafo2}</p>}
          </div>
          {(sec.items||[]).length > 0 && (
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;" class="reveal">
              {(sec.items||[]).map((f: any) => (
                <div style="background:rgba(10,22,40,0.65);border:1px solid rgba(45,212,191,0.10);border-radius:14px;padding:1.4rem 1.2rem;">
                  {f.icono && <div style="font-size:1.7rem;margin-bottom:0.6rem;">{f.icono}</div>}
                  <div style="color:#f0ede8;font-weight:600;font-size:0.84rem;margin-bottom:0.4rem;line-height:1.35;">{f.titulo}</div>
                  <div style="color:rgba(240,237,232,0.55);font-size:0.78rem;line-height:1.65;">{f.desc}</div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  );

  if (sec.tipo === 'destinos-showcase') return (
    <section data-cms-tipo="destinos-showcase" style="padding:90px 0;border-bottom:1px solid var(--border,rgba(45,212,191,0.14));">
      <div class="container">
        <div class="text-center reveal" style="margin-bottom:3.5rem;">
          {sec.label && <span class="section-label">{sec.label}</span>}
          {sec.titulo && <h2 class="section-title">Destinos <span class="gradient-text">{sec.titulo}</span></h2>}
          <div class="divider" style="margin:1rem auto;"></div>
          {sec.intro && <p style="color:rgba(240,237,232,0.82);max-width:480px;margin:0 auto;line-height:1.75;font-size:0.95rem;">{sec.intro}</p>}
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:1.5rem;">
          {(sec.items||[]).map((d: any) => {
            const rgb = hexToRgb(d.color || '#2dd4bf');
            return (
              <div class="reveal" style={`background:linear-gradient(135deg,rgba(6,15,26,0.95),rgba(${rgb},0.12));border:1px solid rgba(${rgb},0.18);border-radius:var(--radius,16px);padding:1.85rem;position:relative;overflow:hidden;`}>
                <div style="font-size:2.2rem;margin-bottom:0.85rem;">{d.icono || '📍'}</div>
                <div style={`color:${d.color||'#2dd4bf'};font-size:10px;font-weight:700;letter-spacing:0.1em;margin-bottom:0.4rem;text-transform:uppercase;`}>{d.subtitulo}</div>
                <h3 style="color:#f0ede8;font-size:1.15rem;font-weight:700;font-family:var(--font-display,serif);margin-bottom:0.65rem;line-height:1.3;">{d.nombre}</h3>
                <p style="color:rgba(240,237,232,0.68);font-size:0.83rem;line-height:1.75;margin-bottom:1rem;">{d.desc}</p>
                <a href="/destinos" style={`display:inline-flex;align-items:center;gap:5px;color:${d.color||'#2dd4bf'};font-size:12px;font-weight:600;text-decoration:none;`}>Ver más →</a>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  );

  if (sec.tipo === 'info-practica') return (
    <section data-cms-tipo="info-practica" style="padding:80px 0;border-bottom:1px solid var(--border,rgba(45,212,191,0.14));">
      <div class="container">
        <div class="text-center reveal" style="margin-bottom:3rem;">
          {sec.label && <span class="section-label">{sec.label}</span>}
          {sec.titulo && <h2 class="section-title">Todo lo que <span class="gradient-text">{sec.titulo}</span></h2>}
          <div class="divider" style="margin:1rem auto;"></div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;">
          {(sec.items||[]).map((item: any) => {
            const rgb = hexToRgb(item.color || '#2dd4bf');
            const lineas = (item.lista||'').split('\n').filter(Boolean);
            return (
              <div class="reveal" style={`background:rgba(10,22,40,0.55);border:1px solid rgba(${rgb},0.12);border-radius:var(--radius,16px);padding:2rem;`}>
                {item.icono && <div style="font-size:2rem;margin-bottom:1rem;">{item.icono}</div>}
                <h3 style="color:#f0ede8;font-family:var(--font-display,serif);font-size:1.1rem;margin-bottom:0.85rem;">{item.titulo}</h3>
                <ul style="color:rgba(240,237,232,0.70);font-size:0.87rem;line-height:2.1;list-style:none;padding:0;margin:0 0 1.2rem;">
                  {lineas.map((li: string) => <li>{li}</li>)}
                </ul>
                {item.link && item.link_texto && (
                  <a href={item.link} style={`color:${item.color||'#2dd4bf'};font-size:13px;font-weight:600;text-decoration:none;`}>{item.link_texto} →</a>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>
  );

  if (sec.tipo === 'experiencias') return (
    <section data-cms-tipo="experiencias" style="padding:90px 0;">
      <div class="container">
        <div class="text-center reveal" style="margin-bottom:3.5rem;">
          {sec.label && <span class="section-label">{sec.label}</span>}
          {sec.titulo && <h2 class="section-title">Descubre <span class="gradient-text">{sec.titulo}</span></h2>}
          <div class="divider" style="margin:1rem auto;"></div>
          {sec.intro && <p style="color:var(--text-main,#f0ede8);max-width:520px;margin:0 auto;line-height:1.7;font-size:0.95rem;opacity:0.88;">{sec.intro}</p>}
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.5rem;">
          {(sec.items||[]).map((s: any) => {
            const rgb = hexToRgb(s.color || '#38bdf8');
            const tags = s.tags ? s.tags.split(',').map((t: string) => t.trim()).filter(Boolean) : [];
            return (
              <a href={s.href||'#'} class="reveal" style={`display:block;background:linear-gradient(135deg,rgba(6,15,26,0.95),rgba(${rgb},0.08));border:1px solid rgba(${rgb},0.15);border-radius:var(--radius,16px);padding:2rem;text-decoration:none;position:relative;overflow:hidden;`}>
                <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1rem;">
                  <div style="font-size:2.5rem;">{s.emoji}</div>
                  {s.etiqueta && <span style={`padding:4px 12px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(${rgb},0.12);color:${s.color||'#38bdf8'};border:1px solid rgba(${rgb},0.25);`}>{s.etiqueta}</span>}
                </div>
                <h3 style="font-family:var(--font-display,serif);font-size:1.25rem;font-weight:700;color:#f0ede8;margin-bottom:0.6rem;line-height:1.3;">{s.titulo}</h3>
                <p style="font-size:0.86rem;color:rgba(240,237,232,0.70);line-height:1.7;margin-bottom:1.2rem;">{s.desc}</p>
                {tags.length > 0 && (
                  <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:1.2rem;">
                    {tags.map((t: string) => (
                      <span style="padding:3px 9px;border-radius:999px;font-size:11px;background:rgba(255,255,255,0.08);color:rgba(240,237,232,0.60);border:1px solid rgba(255,255,255,0.12);">{t}</span>
                    ))}
                  </div>
                )}
                <div style={`display:flex;align-items:center;gap:6px;color:${s.color||'#38bdf8'};font-size:13px;font-weight:600;`}>Explorar <span style="font-size:16px;">→</span></div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  );

  return null;
})}
