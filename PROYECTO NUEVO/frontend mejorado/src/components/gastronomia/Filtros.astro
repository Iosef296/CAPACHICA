---
// src/components/Filtros.astro
const { translations = {} } = Astro.props;
---

<div class="filtros-hero-wrapper">
    <div class="filtros-glass-container">
        <h3 class="filtros-title">{translations.filtrar_por_tipo || 'Filtrar por tipo'}</h3>

        <form id="filtros-form" class="filtros-grid">
            <div class="input-group">
                <label for="tipo_comida">Tipo de comida</label>
                <div class="select-wrapper">
                    <select id="tipo_comida">
                        <option value="">Todos</option>
                        <option value="del_lago">Del lago</option>
                        <option value="ancestral">Ancestral</option>
                        <option value="productos_locales">Productos locales</option>
                        <option value="bebidas">Bebidas</option>
                    </select>
                </div>
            </div>

            <div class="input-group">
                <label for="precio_min">{translations.precio_min || 'Precio Mínimo'}</label>
                <input type="number" id="precio_min" min="0" step="0.5" placeholder="S/ 0.00" />
            </div>

            <div class="input-group">
                <label for="precio_max">{translations.precio_max || 'Precio Máximo'}</label>
                <input type="number" id="precio_max" min="0" step="0.5" placeholder="S/ 100.00" />
            </div>

            <div class="input-group btn-group">
                <button type="submit" class="btn-neon">{translations.aplicar_filtros || 'Aplicar Filtros'}</button>
            </div>
        </form>
    </div>
</div>

<style>
    /* ESTILOS COMPRIMIDOS Y CON LA IMAGEN DE FONDO RECUPERADA */
    .filtros-hero-wrapper { background: linear-gradient(to bottom, rgba(26, 32, 44, 0.4), rgba(26, 32, 44, 0.8)), url('/images/hero.png') center/cover no-repeat; padding: 3rem 1.5rem; border-radius: 1rem; margin-bottom: 2rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); }
    .filtros-glass-container { background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 1rem; padding: 2rem; max-width: 1000px; margin: 0 auto; box-sizing: border-box; box-shadow: 0 0 20px rgba(79, 209, 197, 0.2), inset 0 0 15px rgba(255, 255, 255, 0.05); }
    .filtros-title { color: #fff; font-size: 1.5rem; margin-bottom: 1.5rem; text-align: left; text-shadow: 0 0 10px var(--turquesa-claro), 0 0 20px var(--turquesa); letter-spacing: 1px; }
    .filtros-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 1.2rem; align-items: end; width: 100%; }
    .input-group { display: flex; flex-direction: column; gap: 0.5rem; width: 100%; min-width: 0; }
    .input-group label { color: #e2e8f0; font-size: 0.9rem; font-weight: 600; letter-spacing: 0.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .select-wrapper { width: 100%; position: relative; }
    .select-wrapper::after { content: '▼'; font-size: 0.7rem; color: var(--turquesa); position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; }
    .input-group input, .input-group select { width: 100%; box-sizing: border-box; padding: 0.75rem 1rem; background: rgba(26, 32, 44, 0.6); border: 1px solid rgba(79, 209, 197, 0.3); border-radius: 0.5rem; color: white; font-size: 0.95rem; outline: none; transition: all 0.3s ease; appearance: none; }
    .input-group input::placeholder { color: #a0aec0; }
    .input-group select option { background: #1a202c; color: white; }
    .input-group input:focus, .input-group select:focus { border-color: var(--turquesa-claro); box-shadow: 0 0 12px rgba(79, 209, 197, 0.5); background: rgba(26, 32, 44, 0.8); }
    .btn-neon { width: 100%; box-sizing: border-box; padding: 0.8rem; background: linear-gradient(135deg, var(--turquesa), #235f60); color: white; font-weight: bold; font-size: 1rem; border: 1px solid var(--turquesa-claro); border-radius: 0.5rem; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; transition: all 0.3s ease; box-shadow: 0 0 15px rgba(44, 122, 123, 0.5); }
    .btn-neon:hover { background: linear-gradient(135deg, var(--turquesa-claro), var(--turquesa)); box-shadow: 0 0 25px rgba(79, 209, 197, 0.8); transform: translateY(-2px); }
    .btn-neon:active { transform: translateY(0); }
    @media (max-width: 480px) { .filtros-hero-wrapper { padding: 1.5rem 1rem; border-radius: 0.5rem; } .filtros-glass-container { padding: 1.5rem; } }
</style>

<script>
    document.getElementById('filtros-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const tipoComida = (document.getElementById('tipo_comida') as HTMLSelectElement).value;
        const precioMin = (document.getElementById('precio_min') as HTMLInputElement).value;
        const precioMax = (document.getElementById('precio_max') as HTMLInputElement).value;

        const event = new CustomEvent('filtros-aplicados', {
            detail: { tipo_comida: tipoComida, precio_min: precioMin, precio_max: precioMax }
        });
        document.dispatchEvent(event);
    });
</script>