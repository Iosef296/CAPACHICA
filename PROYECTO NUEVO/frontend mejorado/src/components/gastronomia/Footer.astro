---
// src/components/Footer.astro
const { translations = {} } = Astro.props;
---

<footer class="footer-container">
    <div class="footer-glow-line"></div>

    <div class="footer-content">
        <div class="footer-grid">
            <div class="footer-brand">
                <h3>Capachica</h3>
                <p>{translations.footer_text || 'Turismo comunitario'}</p>
            </div>

            <div class="footer-links">
                <h4>{translations.enlaces || 'Enlaces'}</h4>
                <ul>
                    <li><a href="/">{translations.inicio || 'Inicio'}</a></li>
                    <li><a href="/gastronomia">{translations.gastronomia || 'Gastronomía'}</a></li>
                </ul>
            </div>

            <div class="footer-socials">
                <h4>{translations.redes_sociales || 'Redes sociales'}</h4>
                <div class="social-icons">
                    <a href="#" class="social-btn">Facebook</a>
                    <a href="#" class="social-btn">Instagram</a>
                    <a href="#" class="social-btn">Twitter</a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>{translations.derechos_reservados || '© 2026 Capachica. Todos los derechos reservados.'}</p>
        </div>
    </div>
</footer>

<style>
    /* Tu CSS espectacular del Footer se mantiene exactamente igual aquí */
    .footer-container { background: linear-gradient(180deg, #1a202c 0%, #0d1117 100%); color: white; position: relative; margin-top: 4rem; padding-top: 3rem; }
    .footer-glow-line { position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: linear-gradient(90deg, transparent, var(--turquesa), var(--dorado), transparent); box-shadow: 0 0 15px var(--turquesa); }
    .footer-content { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem 2rem; }
    .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2.5rem; margin-bottom: 3rem; text-align: left; }
    .footer-brand h3 { color: var(--dorado); font-size: 1.8rem; font-weight: bold; margin-bottom: 0.5rem; text-shadow: 0 0 10px rgba(214, 158, 46, 0.4); }
    .footer-brand p { color: #a0aec0; font-size: 0.95rem; line-height: 1.5; }
    .footer-links h4, .footer-socials h4 { color: var(--dorado); font-size: 1.2rem; margin-bottom: 1.2rem; letter-spacing: 0.5px; }
    .footer-links ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.8rem; }
    .footer-links a { color: #e2e8f0; text-decoration: none; transition: all 0.3s ease; display: inline-block; }
    .footer-links a:hover { color: var(--turquesa-claro); text-shadow: 0 0 8px var(--turquesa); transform: translateX(5px); }
    .social-icons { display: flex; gap: 0.8rem; flex-wrap: wrap; }
    .social-btn { padding: 0.5rem 1.2rem; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 2rem; color: white; text-decoration: none; font-size: 0.9rem; transition: all 0.3s ease; }
    .social-btn:hover { background: rgba(44, 122, 123, 0.2); border-color: var(--turquesa); color: var(--turquesa-claro); box-shadow: 0 0 15px rgba(44, 122, 123, 0.4); transform: translateY(-3px); }
    .footer-bottom { border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 1.5rem; text-align: center; color: #718096; font-size: 0.875rem; }
    @media (max-width: 768px) { .footer-grid { text-align: center; gap: 2rem; } .footer-links a:hover { transform: translateY(-2px); } .social-icons { justify-content: center; } }
</style>