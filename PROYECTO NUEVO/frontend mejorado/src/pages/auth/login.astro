---
// src/pages/auth/login.astro
import BaseLayout from '../../layouts/GastronomiaLayout.astro';
import { APP_CONFIG } from '../../config/app.config.js';

const lang = Astro.cookies.get('lang')?.value || 'es';
let translations;
try {
  translations = await import(`../../i18n/${lang}.json`);
} catch (e) {
  translations = await import('../../i18n/es.json');
}

// Obtener redirect de la URL (opcional, para volver a una página específica)
const redirect = Astro.url.searchParams.get('redirect') || APP_CONFIG.adminPanelUrl;
// Construir URL de login de Angular con redirect
const angularLoginUrl = `${APP_CONFIG.angularLoginUrl}?redirect=${encodeURIComponent(redirect)}`;
---

<BaseLayout lang={lang}>
    <div style="max-width: 400px; margin: 3rem auto; background: white; padding: 2rem; border-radius: 0.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.1); text-align: center;">
        <h2 style="font-size: 1.5rem; font-weight: bold; color: var(--turquesa); margin-bottom: 1rem;">
            {translations.inicio_sesion}
        </h2>
        <p style="margin-bottom: 1.5rem; color: #4a5568;">
            La autenticación se gestiona desde el sistema de administración.
        </p>
        <a href={angularLoginUrl} class="btn btn-primary" style="font-size: 1rem; padding: 0.75rem 2rem; width: 100%;">
            Ir al login de administración
        </a>
        <p style="margin-top: 1rem; font-size: 0.875rem; color: #718096;">
            ¿No tienes cuenta? Contacta con el administrador.
        </p>
    </div>
</BaseLayout>

<script>
    // Opcional: si quieres redirigir automáticamente sin mostrar la página
    // const angularLoginUrl = document.querySelector('a.btn-primary').href;
    // window.location.href = angularLoginUrl;
</script>