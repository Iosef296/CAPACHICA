    const dynSection = `
      <div style="font-size:10px;font-weight:700;color:var(--dim);text-transform:uppercase;letter-spacing:.08em;padding:0 2px;margin:18px 0 8px">Páginas personalizadas</div>
      ${dynHtml || '<div style="font-size:12px;color:var(--dim);padding:8px 2px">Ninguna todavía — pulsa ＋ Nueva página</div>'}
    `;

    $('paginasList').innerHTML = `
      <div style="font-size:10px;font-weight:700;color:var(--dim);text-transform:uppercase;letter-spacing:.08em;padding:0 2px;margin-bottom:8px">Páginas del sistema</div>
      ${staticHtml}
      ${dynSection}
    `;
  }

  /* ── EDITOR ── */
  const TYPE_LABELS = { hero: '🦅 Hero', texto: '📝 Texto', cards: '🃏 Cards', galeria: '🖼️ Galería', contacto: '📬 CTA' };

  function openPageEditor(id, _unused = null, mode = 'paginas', contenidoSlug = '', contenidoData = null) {
    peMode = mode;
    peContenidoSlug = contenidoSlug;

    if (mode === 'contenido') {
      peCurrentId = null;
      $('pe-title').textContent = 'Editar: ' + (contenidoData?.titulo || contenidoSlug);
      $('pe-titulo').value      = contenidoData?.titulo || '';
      $('pe-slug').value        = contenidoSlug;
      $('pe-desc').value        = contenidoData?.descripcion || '';
      $('pe-publicado').checked = true;
      $('pe-slug').readOnly     = true;
      $('pe-publicado').parentElement.style.display = 'none';
      peSections = JSON.parse(JSON.stringify(contenidoData?.secciones || []));
    } else {
      const p = id ? paginasData.find(x => x.id === id) : null;
      peCurrentId = p ? p.id : null;
      $('pe-title').textContent = p ? 'Editar página' : 'Nueva página';
      $('pe-titulo').value      = p ? p.titulo    : '';
      $('pe-slug').value        = p ? p.slug      : '';
      $('pe-desc').value        = p ? (p.descripcion || '') : '';
      $('pe-publicado').checked = p ? !!p.publicado : true;
      $('pe-slug').readOnly     = false;
      $('pe-publicado').parentElement.style.display = 'flex';
      peSections = p ? JSON.parse(JSON.stringify(p.secciones || [])) : [];
      $('pe-preview-btn').style.display = id ? 'inline-flex' : 'none';
    }

    peActiveIdx = -1;
    renderPeSections();
    renderPeSectionEditor();
    $('pageEditor').classList.add('open');
  }

  function closePageEditor() {
    $('pageEditor').classList.remove('open');
    $('pe-slug').readOnly = false;
    $('pe-publicado').parentElement.style.display = 'flex';
    peMode = 'paginas';
    peContenidoSlug = '';
  }

  function renderPeSections() {
    const container = $('pe-sections-list');
    if (!peSections.length) {
      container.innerHTML = '<div style="font-size:12px;color:var(--dim);padding:6px 0">Sin secciones</div>';
      return;
    }
    container.innerHTML = peSections.map((s, i) => `
      <div class="sec-chip ${i === peActiveIdx ? 'active' : ''}" onclick="selectPeSection(${i})">
        <span class="sec-chip-type">${TYPE_LABELS[s.tipo] || s.tipo}</span>
        <button onclick="event.stopPropagation();removePeSection(${i})" style="background:transparent;border:none;color:var(--red);font-size:12px;cursor:pointer;padding:0 2px;line-height:1">✕</button>
      </div>
    `).join('');
  }

  function selectPeSection(idx) {
    // save current before switching
    savePeSectionData(peActiveIdx);
    peActiveIdx = idx;
    renderPeSections();
    renderPeSectionEditor();
  }

  function addSection() {
    $('typePicker').classList.add('open');
  }

  function addSectionOfType(tipo) {
    $('typePicker').classList.remove('open');
    savePeSectionData(peActiveIdx);
    const base = { tipo, id: Date.now() };
    if (tipo === 'cards') base.items = [];
    if (tipo === 'galeria') base.imagenes = [];
    peSections.push(base);
    peActiveIdx = peSections.length - 1;
    renderPeSections();
    renderPeSectionEditor();
  }

  function removePeSection(idx) {
    peSections.splice(idx, 1);
    if (peActiveIdx >= peSections.length) peActiveIdx = peSections.length - 1;
    renderPeSections();
    renderPeSectionEditor();
  }

  function renderPeSectionEditor() {
    const container = $('pe-section-editor');
    if (peActiveIdx < 0 || peActiveIdx >= peSections.length) {
      container.innerHTML = '<div class="empty" style="margin-top:3rem"><div class="ei">👈</div><p>Selecciona o agrega una sección para editarla</p></div>';
      return;
    }
    const s = peSections[peActiveIdx];
    const tipo = s.tipo;

    const sharedTitulo = `
      <div class="fg"><label>Título de sección</label><input type="text" id="pe-s-titulo" value="${esc(s.titulo||'')}" placeholder="Título opcional" /></div>
    `;

    let extra = '';
    if (tipo === 'hero') {
      extra = `
        <div class="fg"><label>Subtítulo</label><textarea id="pe-s-subtitulo" rows="3" placeholder="Descripción que aparece bajo el título...">${esc(s.subtitulo||'')}</textarea></div>
        <div class="fg"><label>URL imagen de fondo (opcional)</label><input type="text" id="pe-s-imagen" value="${esc(s.imagen||'')}" placeholder="https://..." /></div>
      `;
    } else if (tipo === 'texto') {
      extra = `
        <div class="fg"><label>Contenido</label><textarea id="pe-s-contenido" rows="10" placeholder="Escribe el texto aquí...">${esc(s.contenido||'')}</textarea></div>
      `;
    } else if (tipo === 'cards') {
      const itemsHtml = (s.items || []).map((item, i) => `
        <div class="card-row">
          <button class="card-row-del" onclick="peRemoveCard(${i})">✕</button>
          <div class="form-row2" style="margin-bottom:8px">
            <div class="fg" style="margin:0"><label>Título *</label><input type="text" data-card="${i}" data-field="titulo" value="${esc(item.titulo||'')}" placeholder="Familia Quispe" /></div>
            <div class="fg" style="margin:0"><label>Etiqueta / Tipo</label><input type="text" data-card="${i}" data-field="etiqueta" value="${esc(item.etiqueta||'')}" placeholder="Familia Anfitriona" /></div>
          </div>
          <div class="form-row2" style="margin-bottom:8px">
            <div class="fg" style="margin:0"><label>Emoji (si no hay imagen)</label><input type="text" data-card="${i}" data-field="emoji" value="${esc(item.emoji||'')}" placeholder="🏡" maxlength="4" /></div>
            <div class="fg" style="margin:0"><label>Ubicación</label><input type="text" data-card="${i}" data-field="lugar" value="${esc(item.lugar||'')}" placeholder="Llachón" /></div>
          </div>
          <div class="form-row2" style="margin-bottom:8px">
            <div class="fg" style="margin:0"><label>Precio</label><input type="text" data-card="${i}" data-field="precio" value="${esc(item.precio||'')}" placeholder="S/ 80" /></div>
            <div class="fg" style="margin:0"><label>Unidad de precio</label><input type="text" data-card="${i}" data-field="precio_unidad" value="${esc(item.precio_unidad||'')}" placeholder="persona/noche" /></div>
          </div>
          <div class="fg" style="margin-bottom:8px"><label>Descripción</label><textarea data-card="${i}" data-field="desc" rows="2" placeholder="Descripción corta...">${esc(item.desc||'')}</textarea></div>
          <div class="fg" style="margin-bottom:8px"><label>Servicios / Amenities (uno por línea)</label><textarea data-card="${i}" data-field="extra" rows="3" placeholder="🍽️ Comidas incluidas&#10;🌅 Vista al lago&#10;🚣 Paseo en bote">${esc(item.extra||'')}</textarea></div>
          <div class="form-row2" style="margin-bottom:0">
            <div class="fg" style="margin:0"><label>URL imagen</label><input type="text" data-card="${i}" data-field="imagen" value="${esc(item.imagen||'')}" placeholder="https://..." /></div>
            <div class="fg" style="margin:0"><label>Color (hex)</label><input type="text" data-card="${i}" data-field="color" value="${esc(item.color||'')}" placeholder="#38bdf8" /></div>
          </div>
        </div>
      `).join('');
      extra = `
        <div id="pe-cards-list">${itemsHtml}</div>
        <button class="add-sec-btn" onclick="peAddCard()">＋ Agregar tarjeta</button>
      `;
    } else if (tipo === 'galeria') {
      extra = `
        <div class="fg"><label>URLs de imágenes (una por línea)</label><textarea id="pe-s-imagenes" rows="8" placeholder="https://foto1.jpg&#10;https://foto2.jpg&#10;...">${(s.imagenes||[]).join('\n')}</textarea></div>
      `;
    } else if (tipo === 'contacto') {
      extra = `
        <div class="fg"><label>Subtítulo / descripción</label><textarea id="pe-s-subtitulo" rows="3" placeholder="Diseñamos tu itinerario ideal...">${esc(s.subtitulo||'')}</textarea></div>
        <div class="form-row2">
          <div class="fg" style="margin:0"><label>Texto del botón</label><input type="text" id="pe-s-boton_texto" value="${esc(s.boton_texto||'')}" placeholder="Reservar ahora" /></div>
          <div class="fg" style="margin:0"><label>URL del botón</label><input type="text" id="pe-s-boton_url" value="${esc(s.boton_url||'')}" placeholder="/contacto" /></div>
        </div>
      `;
    }

    container.innerHTML = `
      <div class="sec-editor">
        <div style="font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:18px">
          ${TYPE_LABELS[tipo] || tipo}
        </div>
        ${sharedTitulo}
        ${extra}
      </div>
    `;
  }

  function savePeSectionData(idx) {
    if (idx < 0 || idx >= peSections.length) return;
    const s = peSections[idx];
    const gv = id => { const el = document.getElementById(id); return el ? el.value : null; };
    const titulo = gv('pe-s-titulo');
    if (titulo !== null) s.titulo = titulo;

    if (s.tipo === 'hero') {
      s.subtitulo = gv('pe-s-subtitulo') ?? s.subtitulo;
      s.imagen    = gv('pe-s-imagen')    ?? s.imagen;
    } else if (s.tipo === 'texto') {
      s.contenido = gv('pe-s-contenido') ?? s.contenido;
    } else if (s.tipo === 'cards') {
      const rows = document.querySelectorAll('.card-row');
      s.items = Array.from(rows).map((row, i) => {
        const fv = f => { const el = row.querySelector(`[data-card="${i}"][data-field="${f}"]`); return el ? el.value : ''; };
        return {
          titulo: fv('titulo'), etiqueta: fv('etiqueta'), emoji: fv('emoji'),
          lugar: fv('lugar'), desc: fv('desc'), precio: fv('precio'),
          precio_unidad: fv('precio_unidad'), extra: fv('extra'),
          imagen: fv('imagen'), color: fv('color'),
        };
      });
    } else if (s.tipo === 'galeria') {
      const raw = gv('pe-s-imagenes') ?? '';
      s.imagenes = raw.split('\n').map(u => u.trim()).filter(Boolean);
    } else if (s.tipo === 'contacto') {
      s.subtitulo   = gv('pe-s-subtitulo')   ?? s.subtitulo;
      s.boton_texto = gv('pe-s-boton_texto') ?? s.boton_texto;
      s.boton_url   = gv('pe-s-boton_url')   ?? s.boton_url;
    }
  }

  function peAddCard() {
    savePeSectionData(peActiveIdx);
    peSections[peActiveIdx].items = peSections[peActiveIdx].items || [];
    peSections[peActiveIdx].items.push({ titulo: '', desc: '', precio: '', imagen: '' });
    renderPeSectionEditor();
  }

  window.peRemoveCard = function(idx) {
    savePeSectionData(peActiveIdx);
    peSections[peActiveIdx].items.splice(idx, 1);
    renderPeSectionEditor();
  };

  async function savePageEditor() {
    savePeSectionData(peActiveIdx);
    const titulo = $('pe-titulo').value.trim();
    const slug   = $('pe-slug').value.trim();
    if (!titulo || !slug) { showMsg('Título y slug son obligatorios', 'err'); return; }

    const body = {
      titulo,
      slug,
      descripcion: $('pe-desc').value.trim(),
      publicado:   $('pe-publicado').checked,
      secciones:   peSections,
    };

    try {
      let res;
      if (peMode === 'contenido') {
        res = await fetch(`${IA_URL}/api/admin/contenido/${peContenidoSlug}`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        showMsg('Contenido guardado — recarga la página del sitio para ver cambios');
      } else if (peCurrentId) {
        res = await fetch(`${IA_URL}/api/admin/paginas/${peCurrentId}`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        showMsg('Página guardada');
        loadPaginas();
      } else {
        res = await fetch(`${IA_URL}/api/admin/paginas`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        showMsg('Página creada — visítala en /pagina/' + slug);
        loadPaginas();
      }
      closePageEditor();
    } catch (e) {
      showMsg('Error al guardar: ' + e.message, 'err');
    }
  }

  function previewPage() {
    const slug = $('pe-slug').value.trim();
    if (slug) window.open(`/pagina/${slug}`, '_blank');
  }

  window.deletePagina = async (id) => {
    if (!confirm('¿Eliminar esta página?')) return;
    try {
      const res = await fetch(`${IA_URL}/api/admin/paginas/${id}`, { method: 'DELETE' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      paginasData = paginasData.filter(p => p.id !== id);
      document.getElementById(`pag-${id}`)?.remove();
      const n = paginasData.length;
      $('pag-count').textContent     = n + ' página' + (n !== 1 ? 's' : '');
      $('nav-pag-count').textContent = n;
      showMsg('Página eliminada');
    } catch (e) {
      showMsg('Error: ' + e.message, 'err');
    }
  };

  window.openPageEditor   = openPageEditor;
  window.closePageEditor  = closePageEditor;
  window.savePageEditor   = savePageEditor;
  window.previewPage      = previewPage;
  window.addSection       = addSection;
  window.addSectionOfType = addSectionOfType;
  window.selectPeSection  = selectPeSection;
  window.removePeSection  = removePeSection;
  window.peAddCard        = peAddCard;
</script>
</body>
</html>
