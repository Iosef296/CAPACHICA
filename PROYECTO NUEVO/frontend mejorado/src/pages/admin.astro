---
const API_URL = import.meta.env.PUBLIC_BACKEND_URL || "http://localhost:3000";
const IA_URL  = import.meta.env.PUBLIC_IA_URL      || "http://localhost:5000";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — Capachica Turismo</title>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #07111f;
      --s1:        #0d1e30;
      --s2:        #111f33;
      --s3:        #162540;
      --border:    rgba(255,255,255,0.07);
      --border2:   rgba(255,255,255,0.13);
      --text:      #e6edf5;
      --muted:     #7f95aa;
      --dim:       #4d6070;
      --cyan:      #38bdf8;
      --cyan-dim:  rgba(56,189,248,0.12);
      --cyan-b:    rgba(56,189,248,0.25);
      --green:     #34d399;
      --amber:     #fbbf24;
      --red:       #f87171;
      --purple:    #a78bfa;
    }

    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ───────────────── LOGIN ───────────────── */
    #loginPage {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(56,189,248,0.08), transparent);
    }

    .login-card {
      background: var(--s1);
      border: 1px solid var(--border2);
      border-radius: 20px;
      padding: 44px;
      width: 100%;
      max-width: 400px;
      text-align: center;
      box-shadow: 0 0 60px rgba(56,189,248,0.07);
    }

    .login-icon { font-size: 44px; margin-bottom: 18px; }

    .login-card h2 {
      font-size: 24px; font-weight: 700;
      color: var(--text); margin-bottom: 5px;
    }

    .login-card p { color: var(--muted); font-size: 13px; margin-bottom: 28px; }

    .inp {
      width: 100%; padding: 11px 14px; margin-bottom: 10px;
      background: var(--s2);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text); font-size: 14px;
      outline: none; font-family: inherit;
      transition: border-color .2s;
    }
    .inp:focus { border-color: var(--cyan); }
    .inp::placeholder { color: var(--dim); }

    #loginErr { color: var(--red); font-size: 13px; margin-bottom: 10px; display: none; }

    .btn-login {
      width: 100%; padding: 12px;
      background: linear-gradient(135deg, #38bdf8, #0284c7);
      border: none; border-radius: 10px;
      color: #fff; font-size: 15px; font-weight: 600;
      cursor: pointer; font-family: inherit; margin-top: 4px;
      transition: filter .2s, transform .15s;
    }
    .btn-login:hover { filter: brightness(1.1); transform: translateY(-1px); }

    .login-hint { color: var(--dim); font-size: 11px; margin-top: 18px; }

    /* ───────────────── LAYOUT ───────────────── */
    #adminPanel { display: none; min-height: 100vh; flex-direction: column; }

    /* TOPBAR */
    .topbar {
      height: 56px;
      background: rgba(13,30,48,.9);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      padding: 0 28px;
      display: flex; align-items: center; gap: 14px;
      position: sticky; top: 0; z-index: 100; flex-shrink: 0;
    }

    .topbar-logo {
      width: 30px; height: 30px;
      background: linear-gradient(135deg, #38bdf8, #818cf8);
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px;
    }

    .topbar-title h1  { font-size: 13.5px; font-weight: 700; color: var(--text); }
    .topbar-title p   { font-size: 11px; color: var(--muted); }
    .topbar-right     { margin-left: auto; display: flex; gap: 8px; }

    .btn-sm {
      padding: 6px 14px; border-radius: 8px;
      border: 1px solid var(--border2);
      background: transparent; color: var(--muted);
      font-size: 12px; cursor: pointer; font-family: inherit;
      transition: all .15s;
    }
    .btn-sm:hover { background: var(--s2); color: var(--text); }

    /* BODY AREA */
    .body-area { display: flex; flex: 1; }

    /* SIDEBAR */
    .sidebar {
      width: 200px; flex-shrink: 0;
      background: var(--s1);
      border-right: 1px solid var(--border);
      padding: 16px 10px;
      display: flex; flex-direction: column; gap: 2px;
    }

    .nav-label {
      font-size: 10px; font-weight: 700; color: var(--dim);
      text-transform: uppercase; letter-spacing: .08em;
      padding: 0 8px; margin: 12px 0 4px;
    }
    .nav-label:first-child { margin-top: 0; }

    .nav-btn {
      display: flex; align-items: center; gap: 9px;
      padding: 9px 11px; border-radius: 8px;
      border: 1px solid transparent;
      background: transparent; color: var(--muted);
      font-size: 13.5px; font-weight: 500;
      cursor: pointer; font-family: inherit;
      width: 100%; text-align: left;
      transition: all .15s;
    }
    .nav-btn:hover  { background: var(--s2); color: var(--text); border-color: var(--border); }
    .nav-btn.active { background: var(--cyan-dim); border-color: var(--cyan-b); color: var(--cyan); }

    .nav-count {
      margin-left: auto; font-size: 10px; font-weight: 700;
      background: var(--s3); color: var(--muted);
      padding: 1px 6px; border-radius: 10px;
    }
    .nav-btn.active .nav-count { background: rgba(56,189,248,.2); color: var(--cyan); }

    /* MAIN */
    .main { flex: 1; padding: 28px 32px; overflow-y: auto; }

    .section { display: none; animation: fadeUp .18s ease; }
    .section.active { display: block; }
    #sec-global.active { display: block !important; padding: 0 !important; }

    @keyframes fadeUp { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }

    .page-hdr { margin-bottom: 24px; }
    .page-hdr h2 { font-size: 20px; font-weight: 700; color: var(--text); letter-spacing: -.02em; margin-bottom: 3px; }
    .page-hdr p  { font-size: 13px; color: var(--muted); }

    /* MSG */
    .msg {
      display: none; align-items: center; gap: 8px;
      padding: 10px 15px; border-radius: 9px; margin-bottom: 18px; font-size: 13px;
    }
    .msg.ok  { display:flex; background:rgba(52,211,153,.1); border:1px solid rgba(52,211,153,.25); color:#6ee7b7; }
    .msg.err { display:flex; background:rgba(248,113,113,.1); border:1px solid rgba(248,113,113,.25); color:var(--red); }

    /* CARD */
    .card {
      background: var(--s1);
      border: 1px solid var(--border);
      border-radius: 14px; padding: 22px; margin-bottom: 14px;
    }
    .card:hover { border-color: var(--border2); }

    /* FORM */
    .form-row3 { display: grid; grid-template-columns: 1fr 2fr 2fr; gap: 12px; margin-bottom: 14px; }
    .fg { margin-bottom: 12px; }

    label { display: block; font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 6px; }

    input, select, textarea {
      width: 100%;
      padding: 9px 12px;
      background: var(--s2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text); font-size: 14px; font-family: inherit;
      outline: none; transition: all .2s;
    }
    input:focus, select:focus, textarea:focus {
      border-color: var(--cyan);
      background: var(--s3);
      box-shadow: 0 0 0 3px rgba(56,189,248,.07);
    }
    input::placeholder, textarea::placeholder { color: var(--dim); }
    textarea { resize: vertical; min-height: 80px; line-height: 1.5; }
    select option { background: var(--s1); }

    /* BUTTONS */
    .btn-primary {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 9px 18px; border-radius: 8px;
      background: linear-gradient(135deg, #38bdf8, #0284c7);
      color: #fff; border: none;
      font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;
      transition: filter .15s, transform .15s;
    }
    .btn-primary:hover { filter: brightness(1.1); transform: translateY(-1px); box-shadow: 0 4px 14px rgba(56,189,248,.25); }

    .btn-danger {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 5px 10px; border-radius: 7px;
      background: transparent; color: var(--red);
      border: 1px solid rgba(248,113,113,.2);
      font-size: 12px; cursor: pointer; font-family: inherit;
      transition: all .15s;
    }
    .btn-danger:hover { background: rgba(248,113,113,.1); border-color: rgba(248,113,113,.4); }

    /* SECTION TOP */
    .sec-top {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 14px;
    }
    .sec-top h3 {
      font-size: 14px; font-weight: 700; color: var(--text);
      display: flex; align-items: center; gap: 8px;
    }

    .count-pill {
      background: var(--s3); color: var(--muted);
      font-size: 11px; font-weight: 700;
      padding: 2px 7px; border-radius: 10px;
    }

    /* SEARCH */
    .search-wrap { position: relative; margin-bottom: 14px; }
    .search-wrap::before { content: '🔍'; position: absolute; left: 11px; top: 50%; transform: translateY(-50%); font-size: 12px; pointer-events: none; }
    .search-wrap input { padding-left: 30px; }

    /* IA ITEMS */
    .ia-item {
      background: var(--s2);
      border: 1px solid var(--border);
      border-radius: 10px; padding: 13px 15px; margin-bottom: 7px;
      display: flex; gap: 12px; align-items: flex-start;
      transition: border-color .15s;
      animation: fadeUp .18s ease;
    }
    .ia-item:hover { border-color: var(--border2); }

    .ia-q { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 4px; }
    .ia-r { font-size: 13px; color: var(--muted); line-height: 1.45; }

    /* CATEGORY BADGES */
    .badge { display: inline-block; font-size: 10px; font-weight: 700; padding: 2px 9px; border-radius: 20px; text-transform: uppercase; letter-spacing: .04em; flex-shrink: 0; margin-top: 2px; }

    /* RESERVA ITEMS */
    .res-item {
      background: var(--s2);
      border: 1px solid var(--border);
      border-radius: 10px; padding: 16px;
      margin-bottom: 8px;
      display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
      transition: border-color .15s;
    }
    .res-item:hover { border-color: var(--border2); }

    .res-code { font-size: 13px; font-weight: 700; color: var(--cyan); }
    .res-name { font-size: 15px; font-weight: 600; color: var(--text); margin-top: 4px; }
    .res-meta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
    .res-chip { font-size: 12px; color: var(--muted); }

    /* ESTADO BADGE */
    .e-badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; margin-left: 8px; }

    /* EMPTY STATE */
    .empty { text-align: center; padding: 40px 24px; color: var(--muted); }
    .empty .ei { font-size: 32px; margin-bottom: 10px; opacity: .4; }
    .empty p { font-size: 13px; }

    /* STATS */
    .stats-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-bottom: 24px; }
    @media (max-width: 700px) { .stats-row { grid-template-columns: repeat(2,1fr); } }

    .stat-card {
      background: var(--s1); border: 1px solid var(--border); border-radius: 12px;
      padding: 16px; text-align: center;
    }
    .stat-card .sv { font-size: 26px; font-weight: 700; margin-bottom: 2px; }
    .stat-card .sl { font-size: 11px; color: var(--muted); }

    /* CTX EDITOR */
    .ctx-box {
      background: var(--s2); border: 1px solid var(--border); border-radius: 12px;
      padding: 18px; margin-bottom: 18px; display: none;
    }

    /* DESTINO ITEMS */
    .dest-item {
      background: var(--s2);
      border: 1px solid var(--border);
      border-radius: 10px; padding: 14px 16px; margin-bottom: 8px;
      display: flex; align-items: center; gap: 14px;
      transition: border-color .15s;
      animation: fadeUp .18s ease;
    }
    .dest-item:hover { border-color: var(--border2); }
    .dest-thumb {
      width: 54px; height: 54px; border-radius: 10px;
      object-fit: cover; flex-shrink: 0;
      border: 1px solid var(--border);
    }
    .dest-emoji-box {
      width: 54px; height: 54px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 24px; flex-shrink: 0;
      border: 1px solid var(--border);
    }

    /* MODAL */
    .modal-overlay {
      display: none; position: fixed; inset: 0; z-index: 200;
      background: rgba(4,10,18,.75); backdrop-filter: blur(4px);
      align-items: center; justify-content: center; padding: 16px;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: var(--s1); border: 1px solid var(--border2);
      border-radius: 18px; padding: 28px 30px; width: 100%; max-width: 580px;
      max-height: 90vh; overflow-y: auto;
      box-shadow: 0 0 80px rgba(56,189,248,.08);
    }
    .modal-hdr { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px; }
    .modal-hdr h3 { font-size: 17px; font-weight: 700; color: var(--text); }
    .modal-close {
      width: 30px; height: 30px; border-radius: 8px;
      background: var(--s3); border: 1px solid var(--border);
      color: var(--muted); cursor: pointer; font-size: 14px;
      display: flex; align-items: center; justify-content: center;
      transition: all .15s;
    }
    .modal-close:hover { background: rgba(248,113,113,.15); color: var(--red); border-color: rgba(248,113,113,.3); }
    .form-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .color-row { display: flex; align-items: center; gap: 10px; }
    .color-row input[type="color"] {
      width: 40px; height: 36px; padding: 2px; border-radius: 8px; cursor: pointer;
    }
    .color-row input[type="text"] { flex: 1; }

    /* PAGE EDITOR OVERLAY */
    .page-editor {
      display: none; position: fixed; inset: 0; z-index: 300;
      background: var(--bg);
      flex-direction: column;
    }
    .page-editor.open { display: flex; }

    .pe-topbar {
      height: 52px; background: var(--s1); border-bottom: 1px solid var(--border);
      padding: 0 24px; display: flex; align-items: center; gap: 14px; flex-shrink: 0;
    }
    .pe-topbar h2 { font-size: 15px; font-weight: 700; color: var(--text); }
    .pe-body { display: flex; flex: 1; overflow: hidden; }

    .pe-left {
      width: 340px; flex-shrink: 0; border-right: 1px solid var(--border);
      overflow-y: auto; padding: 20px 16px; display: flex; flex-direction: column; gap: 14px;
    }
    .pe-right { flex: 1; overflow: hidden; display: flex; flex-direction: column; padding: 0; min-width: 0; }
    .pe-canvas-topbar { height:38px; border-bottom:1px solid var(--border); padding:0 16px; display:flex; align-items:center; gap:8px; background:var(--s1); flex-shrink:0; font-size:11px; color:var(--muted); }
    #pe-preview-iframe { flex:1; width:100%; border:none; display:block; }
    #pe-canvas { flex:1; overflow-y:auto; padding:28px 40px 100px; background:var(--bg); }
    .pe-canvas-empty { text-align:center; padding:80px 40px; color:var(--muted); }
    .pe-canvas-empty > div { font-size:3rem; margin-bottom:14px; }
    .pe-canvas-sec { border:1px solid var(--border); border-radius:12px; margin-bottom:16px; overflow:hidden; transition:border-color .15s, box-shadow .15s; }
    .pe-canvas-sec:hover { border-color:var(--border2); }
    .pe-canvas-sec.active { border-color:var(--cyan-b); box-shadow:0 0 0 3px var(--cyan-dim); }
    .pe-canvas-sec-bar { display:flex; align-items:center; gap:8px; padding:8px 14px; background:var(--s3); border-bottom:1px solid var(--border); }
    .pe-canvas-sec-badge { font-size:11px; font-weight:700; color:var(--cyan); background:var(--cyan-dim); border:1px solid var(--cyan-b); border-radius:5px; padding:2px 7px; }
    .pe-canvas-sec-bar-controls { margin-left:auto; display:flex; gap:4px; }
    .pe-canvas-sec-bar-controls button { background:transparent; border:1px solid var(--border); border-radius:5px; color:var(--muted); font-size:12px; cursor:pointer; padding:3px 7px; font-family:inherit; transition:all .12s; }
    .pe-canvas-sec-bar-controls button:hover { border-color:var(--border2); color:var(--text); }
    .pe-canvas-sec-bar-controls button:disabled { opacity:.2; cursor:default; pointer-events:none; }
    .pe-canvas-sec-bar-controls .del-btn:hover { color:var(--red); border-color:var(--red); }
    .pe-canvas-sec-body { padding:20px 24px; cursor:pointer; position:relative; transition:background .15s; min-height:60px; }
    .pe-canvas-sec.active .pe-canvas-sec-body { cursor:default; }
    .pe-canvas-hover-hint { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(45,212,191,.05); opacity:0; transition:opacity .2s; pointer-events:none; }
    .pe-canvas-sec-body:hover .pe-canvas-hover-hint { opacity:1; }
    .pe-canvas-hover-hint span { background:var(--cyan); color:#000; font-size:12px; font-weight:700; padding:6px 18px; border-radius:20px; }

    /* VISUAL SECTION PREVIEW CARDS */
    .pe-empty-hint { text-align:center; padding:80px 40px; color:var(--muted); }
    .pe-empty-hint div:first-child { font-size:3rem; margin-bottom:14px; }
    .pe-empty-hint h3 { font-size:16px; font-weight:700; color:var(--text); margin-bottom:6px; }
    .pe-empty-hint p { font-size:13px; margin-bottom:18px; }
    #pe-overview { padding: 24px 32px 100px; }
    .pe-sec-card { background:var(--s2); border:1px solid var(--border); border-radius:14px; margin-bottom:14px; overflow:hidden; transition:border-color .15s, box-shadow .15s; }
    .pe-sec-card:hover { border-color:var(--border2); }
    .pe-sec-card.active { border-color:var(--cyan-b); box-shadow:0 0 0 3px var(--cyan-dim); }
    .pe-sec-card-hdr { display:flex; align-items:center; gap:10px; padding:10px 14px; background:var(--s3); border-bottom:1px solid var(--border); }
    .pe-sec-card-badge { display:flex; align-items:center; gap:6px; font-size:11px; font-weight:700; color:var(--cyan); background:var(--cyan-dim); border:1px solid var(--cyan-b); border-radius:6px; padding:3px 8px; flex-shrink:0; }
    .pe-sec-card-hint { font-size:13px; color:var(--text); flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; min-width:0; }
    .pe-sec-card-actions { display:flex; align-items:center; gap:5px; margin-left:auto; flex-shrink:0; }
    .pe-sec-card-actions button { background:transparent; border:1px solid var(--border); border-radius:6px; color:var(--muted); font-size:12px; cursor:pointer; padding:4px 8px; font-family:inherit; transition:all .12s; }
    .pe-sec-card-actions button:hover { border-color:var(--border2); color:var(--text); }
    .pe-sec-card-actions button:disabled { opacity:.22; cursor:default; pointer-events:none; }
    .pe-sec-card-actions .btn-edit { color:var(--cyan); border-color:var(--cyan-b); }
    .pe-sec-card-actions .btn-edit:hover { background:var(--cyan-dim); }
    .pe-sec-card-actions .btn-done { color:#4ade80; border-color:rgba(74,222,128,.4); }
    .pe-sec-card-actions .btn-done:hover { background:rgba(74,222,128,.08); }
    .pe-sec-card-actions .btn-del:hover { color:var(--red); border-color:var(--red); }
    .pe-sec-card-preview { padding:16px 18px; }
    .pe-sec-card-edit-body { display:grid; grid-template-columns:1fr 1fr; border-top:2px solid var(--cyan-b); }
    @media(max-width:900px) { .pe-sec-card-edit-body { grid-template-columns:1fr; } }
    .pe-live-col { padding:20px 22px; background:var(--bg); border-right:1px solid var(--border); overflow-y:auto; max-height:520px; }
    .pe-form-col { padding:20px 22px; background:var(--s2); overflow-y:auto; max-height:520px; }
    .pe-col-label { font-size:10px; font-weight:700; color:var(--dim); text-transform:uppercase; letter-spacing:.08em; margin-bottom:14px; display:flex; align-items:center; gap:6px; }

    /* PREVIEW MINI RENDERERS */
    .prev-hero { text-align:center; padding:12px 24px; }
    .prev-hero-title { font-size:1.5rem; font-weight:800; color:var(--text); margin-bottom:6px; font-family:var(--font-display,serif); }
    .prev-hero-sub { font-size:0.82rem; color:var(--muted); line-height:1.55; }
    .prev-stats { display:flex; gap:10px; flex-wrap:wrap; }
    .prev-stat { text-align:center; background:var(--s3); border-radius:8px; padding:8px 14px; min-width:65px; }
    .prev-stat-v { font-size:1.15rem; font-weight:800; color:var(--cyan); line-height:1.1; }
    .prev-stat-l { font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:.07em; margin-top:2px; }
    .prev-cards { display:flex; gap:8px; flex-wrap:wrap; }
    .prev-card-mini { background:var(--s3); border:1px solid var(--border); border-radius:8px; padding:6px 12px; font-size:12px; color:var(--text); }
    .prev-texto { font-size:13px; color:var(--muted); line-height:1.65; }
    .prev-simple { font-size:13px; color:var(--muted); }
    .prev-contacto { text-align:center; }
    .prev-contacto-title { font-size:14px; font-weight:600; color:var(--text); margin-bottom:8px; }
    .prev-btn-sample { font-size:11px; background:var(--cyan-dim); border:1px solid var(--cyan-b); color:var(--cyan); border-radius:6px; padding:4px 10px; }
    .prev-features { display:flex; gap:8px; flex-wrap:wrap; }
    .prev-feature { background:var(--s3); border:1px solid var(--border); border-radius:8px; padding:6px 12px; font-size:12px; color:var(--text); }
    .prev-pasos { display:flex; flex-direction:column; gap:6px; }
    .prev-paso { font-size:12px; color:var(--text); padding:5px 10px; background:var(--s3); border-radius:7px; }

    .pe-sec-label {
      font-size: 10px; font-weight: 700; color: var(--dim);
      text-transform: uppercase; letter-spacing: .08em; margin-bottom: 8px;
    }

    .sec-block {
      background: var(--s2); border: 1px solid var(--border);
      border-radius: 10px; padding: 10px 12px; margin-bottom: 6px;
      display: flex; align-items: center; gap: 8px; cursor: pointer;
      transition: border-color .15s, background .15s;
    }
    .sec-block:hover { border-color: var(--border2); background: var(--s3); }
    .sec-block.active { border-color: var(--cyan-b); background: var(--cyan-dim); }
    .sec-block-main { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
    .sec-block-icon { font-size: 18px; flex-shrink: 0; }
    .sec-block-info { min-width: 0; }
    .sec-block-type { font-size: 12px; font-weight: 700; color: var(--muted); }
    .sec-block.active .sec-block-type { color: var(--cyan); }
    .sec-block-preview { font-size: 11px; color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; max-width: 140px; }
    .sec-block-actions { display: flex; align-items: center; gap: 2px; flex-shrink: 0; }
    .sec-block-actions button { background: transparent; border: none; color: var(--muted); cursor: pointer; padding: 3px 5px; font-size: 13px; border-radius: 4px; transition: color .12s; }
    .sec-block-actions button:hover { color: var(--text); }
    .sec-block-actions button:disabled { opacity: 0.25; cursor: default; }
    .sec-block-actions .del-btn:hover { color: var(--red); }

    .add-sec-btn {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      padding: 9px; border-radius: 8px;
      border: 1px dashed var(--border2); background: transparent;
      color: var(--muted); font-size: 12px; cursor: pointer; font-family: inherit;
      transition: all .15s; margin-top: 4px;
    }
    .add-sec-btn:hover { border-color: var(--cyan); color: var(--cyan); }

    .sec-editor { animation: fadeUp .15s ease; }

    .tipo-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 6px;
    }
    .tipo-opt {
      padding: 10px 8px; border-radius: 8px; border: 1px solid var(--border);
      background: var(--s2); cursor: pointer; text-align: center; transition: all .15s;
    }
    .tipo-opt:hover { border-color: var(--cyan-b); background: var(--cyan-dim); }
    .tipo-opt .to-icon { font-size: 20px; display: block; margin-bottom: 4px; }
    .tipo-opt .to-label { font-size: 11px; color: var(--muted); font-weight: 600; }

    /* CARDS EDITOR */
    .card-row {
      background: var(--s3); border: 1px solid var(--border); border-radius: 8px;
      padding: 12px; margin-bottom: 8px; position: relative;
    }
    .card-row-del {
      position: absolute; top: 8px; right: 8px;
      background: transparent; border: none; color: var(--red);
      font-size: 13px; cursor: pointer; padding: 2px 6px;
    }

    /* PAGINAS LIST */
    .pag-item {
      background: var(--s2); border: 1px solid var(--border);
      border-radius: 10px; padding: 14px 16px; margin-bottom: 8px;
      display: flex; align-items: center; gap: 12px; transition: border-color .15s;
      animation: fadeUp .18s ease;
    }
    .pag-item:hover { border-color: var(--border2); }
  </style>
</head>
<body>

<!-- ─── LOGIN ─── -->
<div id="loginPage">
  <div class="login-card">
    <div class="login-icon">🔐</div>
    <h2>Panel Admin</h2>
    <p>Capachica Turismo</p>
    <div id="loginErr"></div>
    <input class="inp" type="email"    id="emailInp" placeholder="Email" />
    <input class="inp" type="password" id="passInp"  placeholder="Contraseña" />
    <button class="btn-login" id="loginBtn">Ingresar</button>
    <p class="login-hint">admin@capachica.pe · admin123</p>
  </div>
</div>

<!-- ─── PANEL ─── -->
<div id="adminPanel">

  <!-- TOPBAR -->
  <header class="topbar">
    <div class="topbar-logo">⚙️</div>
    <div class="topbar-title">
      <h1>Panel Admin</h1>
      <p>Capachica Turismo</p>
    </div>
    <div class="topbar-right">
      <button class="btn-sm" id="refreshBtn">↺ Actualizar</button>
      <button class="btn-sm" id="logoutBtn">Salir</button>
    </div>
  </header>

  <div class="body-area">

    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="nav-label">IA</div>
      <button class="nav-btn active" data-section="ia">
        <span>🤖</span> Conocimiento
        <span class="nav-count" id="nav-ia-count">—</span>
      </button>
      <button class="nav-btn" data-section="contexto">
        <span>⚙️</span> Personalidad
      </button>
      <button class="nav-btn" data-section="widget">
        <span>💬</span> Widget Chat
      </button>
      <div class="nav-label">Gestión</div>
      <button class="nav-btn" data-section="paginas">
        <span>📄</span> Páginas
        <span class="nav-count" id="nav-pag-count">—</span>
      </button>
      <button class="nav-btn" data-section="destinos">
        <span>📍</span> Destinos
        <span class="nav-count" id="nav-dest-count">—</span>
      </button>
      <button class="nav-btn" data-section="reservas">
        <span>📋</span> Reservas
        <span class="nav-count" id="nav-res-count">—</span>
      </button>
      <div class="nav-label">Sitio</div>
      <button class="nav-btn" data-section="global">
        <span>🎨</span> Navbar &amp; Footer
      </button>
    </aside>

    <!-- MAIN -->
    <main class="main">
      <div id="globalMsg" class="msg"></div>

      <!-- ─── IA SECTION ─── -->
      <div class="section active" id="sec-ia">
        <div class="page-hdr">
          <h2>Base de Conocimiento</h2>
          <p>Entradas que usa Inti para responder turistas</p>
        </div>

        <!-- ADD FORM -->
        <div class="card">
          <div style="font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:16px;">Agregar entrada</div>
          <div class="form-row3">
            <div>
              <label>Categoría</label>
              <select id="iaCat">
                <option value="general">General</option>
                <option value="precios">Precios</option>
                <option value="actividades">Actividades</option>
                <option value="alojamiento">Alojamiento</option>
                <option value="transporte">Transporte</option>
                <option value="gastronomia">Gastronomía</option>
                <option value="cultura">Cultura</option>
                <option value="clima">Clima</option>
                <option value="reservas">Reservas</option>
              </select>
            </div>
            <div>
              <label>Pregunta *</label>
              <input type="text" id="iaQ" placeholder="¿Cuánto cuesta el kayak?" />
            </div>
            <div>
              <label>Respuesta *</label>
              <input type="text" id="iaR" placeholder="El kayak cuesta S/. 30..." />
            </div>
          </div>
          <button class="btn-primary" id="addIaBtn">✦ Agregar a Inti</button>
        </div>

        <!-- LIST -->
        <div class="sec-top">
          <h3>Entradas <span class="count-pill" id="ia-count">0</span></h3>
        </div>
        <div class="search-wrap">
          <input id="iaSearch" placeholder="Buscar por pregunta, categoría o respuesta..." />
        </div>
        <div id="iaList"><div class="empty"><div class="ei">⏳</div><p>Cargando...</p></div></div>
      </div>

      <!-- ─── CONTEXTO SECTION ─── -->
      <div class="section" id="sec-contexto">
        <div class="page-hdr">
          <h2>Personalidad de Inti</h2>
          <p>Instrucciones globales que la IA siempre sigue</p>
        </div>
        <div class="card">
          <div class="fg">
            <label>System Prompt (Contexto Base)</label>
            <textarea id="ctxText" rows="12" placeholder="Eres Inti, un asistente amable especializado en turismo de Capachica..."></textarea>
          </div>
          <button class="btn-primary" id="saveCtxBtn">Guardar Configuración</button>
        </div>
      </div>

      <!-- ─── PÁGINAS SECTION ─── -->
      <div class="section" id="sec-paginas">
        <div class="page-hdr">
          <h2>Páginas del Sitio</h2>
          <p>Crea y gestiona páginas personalizadas accesibles en <code style="font-size:11px;color:var(--cyan)">/pagina/[slug]</code></p>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
          <span class="count-pill" id="pag-count">0 páginas</span>
          <button class="btn-primary" onclick="openPageEditor(null)">＋ Nueva página</button>
        </div>
        <div id="paginasList"><div class="empty"><div class="ei">⏳</div><p>Cargando...</p></div></div>
      </div>

      <!-- ─── DESTINOS SECTION ─── -->
      <div class="section" id="sec-destinos">
        <div class="page-hdr">
          <h2>Destinos Turísticos</h2>
          <p>Gestiona los destinos que se muestran en la página principal</p>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
          <span class="count-pill" id="dest-count">0 destinos</span>
          <button class="btn-primary" onclick="openDestinoModal(null)">＋ Nuevo destino</button>
        </div>
        <div id="destinosList"><div class="empty"><div class="ei">⏳</div><p>Cargando...</p></div></div>
      </div>

      <!-- ─── RESERVAS SECTION ─── -->
      <div class="section" id="sec-reservas">
        <div class="page-hdr">
          <h2>Reservas</h2>
          <p>Solicitudes recibidas · se actualiza cada 30s</p>
        </div>

        <div class="stats-row" id="statsRow">
          <div class="stat-card"><div class="sv" style="color:var(--cyan)"  id="st-total">0</div><div class="sl">Total</div></div>
          <div class="stat-card"><div class="sv" style="color:var(--amber)" id="st-pend">0</div><div class="sl">Pendientes</div></div>
          <div class="stat-card"><div class="sv" style="color:var(--green)" id="st-conf">0</div><div class="sl">Confirmadas</div></div>
          <div class="stat-card"><div class="sv" style="color:var(--muted)" id="st-comp">0</div><div class="sl">Completadas</div></div>
        </div>

        <div class="sec-top">
          <h3>Listado <span class="count-pill" id="res-count">0</span></h3>
        </div>
        <div id="reservasList"><div class="empty"><div class="ei">⏳</div><p>Cargando...</p></div></div>
      </div>

      <!-- ─── WIDGET SECTION ─── -->
      <div class="section" id="sec-widget">
        <div class="page-hdr">
          <h2>Widget de Chat</h2>
          <p>Personaliza el chatbot que ven los visitantes</p>
        </div>
        <div class="card">
          <div style="font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:18px">Identidad</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">
            <div class="fg" style="margin:0">
              <label>Nombre del bot</label>
              <input type="text" id="w-name" placeholder="Inti · Asistente IA" />
            </div>
            <div class="fg" style="margin:0">
              <label>Subtítulo</label>
              <input type="text" id="w-subtitle" placeholder="Capachica Turismo" />
            </div>
          </div>
          <div class="fg">
            <label>Placeholder del input</label>
            <input type="text" id="w-placeholder" placeholder="Escribe tu pregunta..." />
          </div>
        </div>
        <div class="card">
          <div style="font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:18px">Mensaje de bienvenida</div>
          <div class="fg">
            <label>Primer mensaje que ve el usuario</label>
            <textarea id="w-welcome" rows="3" placeholder="¡Hola! Soy Inti, tu guía virtual de Capachica 🌊&#10;¿En qué te puedo ayudar?"></textarea>
          </div>
        </div>
        <div class="card">
          <div style="font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:18px">Preguntas rápidas</div>
          <div class="fg">
            <label>Una por línea (máx. 4-5 recomendado)</label>
            <textarea id="w-quick" rows="5" placeholder="¿Qué es Capachica?&#10;¿Cómo llegar?&#10;Quiero reservar"></textarea>
          </div>
          <p style="font-size:11px;color:var(--dim);margin-top:-4px">Aparecen como botones cuando el chat se abre por primera vez.</p>
        </div>
        <div style="display:flex;gap:10px;align-items:center">
          <button class="btn-primary" id="saveWidgetBtn">Guardar Widget</button>
          <button class="btn-sm" id="previewWidgetBtn" style="padding:9px 18px">Vista previa →</button>
        </div>
      </div>

      <!-- ─── GLOBAL SECTION ─── -->
      <div class="section" id="sec-global" style="height:calc(100vh - 56px);margin:-28px -32px;overflow:hidden;">
        <div style="display:flex;height:100%;">

          <!-- LEFT: forms -->
          <div style="width:460px;flex-shrink:0;overflow-y:auto;padding:28px 24px;border-right:1px solid var(--border);background:var(--s1);">
            <div class="page-hdr">
              <h2>Navbar &amp; Footer</h2>
              <p>Configura el menú y el pie de página</p>
            </div>

            <!-- NAVBAR -->
            <div class="card" id="global-card-navbar">
              <div style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px">🧭 Barra de navegación</div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
                <div class="fg" style="margin:0">
                  <label>Nombre del logo</label>
                  <input type="text" id="nb-logo-nombre" placeholder="Capachica" />
                </div>
                <div class="fg" style="margin:0">
                  <label>Tagline del logo</label>
                  <input type="text" id="nb-logo-tagline" placeholder="Turismo Vivencial" />
                </div>
              </div>
              <div style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px;">Links del menú</div>
              <div id="nb-links-list" style="display:flex;flex-direction:column;gap:6px;margin-bottom:8px;"></div>
              <button class="btn-sm" onclick="nbAddLink()" style="padding:6px 12px;font-size:12px;">+ Agregar link</button>
            </div>

            <!-- FOOTER -->
            <div class="card" id="global-card-footer">
              <div style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px">🏛️ Footer — Columnas</div>
              <div id="ft-col-cards" style="display:flex;flex-direction:column;gap:8px;"></div>
            </div>

            <div style="display:flex;gap:10px;align-items:center;padding-bottom:24px;">
              <button class="btn-primary" onclick="saveSiteconfigAdmin()">💾 Guardar cambios</button>
              <span id="global-msg" style="font-size:13px;color:var(--green);display:none">✓ Guardado — recarga el iframe →</span>
            </div>
          </div>

          <!-- RIGHT: iframe preview -->
          <div style="flex:1;display:flex;flex-direction:column;background:#000;">
            <div style="height:38px;background:var(--s2);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;padding:0 14px;flex-shrink:0;">
              <span style="font-size:11px;color:var(--muted);">Vista previa real</span>
              <span style="font-size:10px;color:var(--dim);">Guarda para ver los cambios</span>
              <button onclick="document.getElementById('globalPreviewFrame').src=document.getElementById('globalPreviewFrame').src" style="margin-left:auto;padding:4px 10px;border-radius:6px;border:1px solid var(--border2);background:transparent;color:var(--muted);font-size:11px;cursor:pointer;">↺ Actualizar</button>
            </div>
            <iframe id="globalPreviewFrame" src={import.meta.env.PUBLIC_SITE_URL || "http://localhost:4322/"} style="flex:1;border:none;width:100%;height:100%;" title="Vista previa" onload="scheduleGlobalInject(this)"></iframe>
          </div>

        </div>
      </div>

    </main>
  </div>
</div>

<!-- ─── PAGE EDITOR OVERLAY ─── -->
<div class="page-editor" id="pageEditor">
  <div class="pe-topbar">
    <button class="modal-close" onclick="closePageEditor()">✕</button>
    <h2 id="pe-title">Nueva página</h2>
    <div style="margin-left:auto;display:flex;gap:8px">
      <button class="btn-sm" id="pe-preview-btn" style="padding:7px 14px" onclick="previewPage()">👁 Vista previa</button>
      <button class="btn-primary" id="pe-save-btn" onclick="savePageEditor()">Guardar página</button>
    </div>
  </div>
  <div class="pe-body">

    <!-- LEFT: metadata + dynamic panel (section list OR form editor) -->
    <div class="pe-left">
      <div>
        <div class="pe-sec-label">Metadatos</div>
        <div class="fg"><label>Título de la página *</label><input type="text" id="pe-titulo" placeholder="Tours y Paquetes" /></div>
        <div class="fg"><label>Slug (URL) *</label><input type="text" id="pe-slug" placeholder="tours" oninput="this.value=this.value.toLowerCase().replace(/[^a-z0-9-]/g,'-')" /></div>
        <div class="fg"><label>Descripción SEO</label><input type="text" id="pe-desc" placeholder="Descubre los mejores tours..." /></div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px">
          <label style="margin:0;font-size:12px;color:var(--muted);cursor:pointer;display:flex;align-items:center;gap:6px">
            <input type="checkbox" id="pe-publicado" checked style="width:auto;accent-color:var(--cyan)" />
            Publicada
          </label>
        </div>
      </div>
      <!-- Dynamic: section list overview OR section form editor -->
      <div id="pe-left-dynamic"></div>
    </div>

    <!-- RIGHT: actual page in iframe -->
    <div class="pe-right">
      <div class="pe-canvas-topbar">
        <span>📄 Vista previa real</span>
        <span style="margin-left:6px;opacity:.55;font-size:10px;">· Edita a la izquierda → Guardar página → se actualiza aquí</span>
        <button onclick="reloadPreviewIframe()" style="margin-left:auto;background:transparent;border:1px solid var(--border);border-radius:6px;color:var(--muted);font-size:11px;cursor:pointer;padding:4px 10px;font-family:inherit;transition:all .12s" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--muted)'">🔄 Actualizar</button>
      </div>
      <iframe id="pe-preview-iframe" src="about:blank" style="flex:1;width:100%;border:none;display:block;" allow="same-origin"></iframe>
    </div>

  </div>
</div>

<!-- TYPE PICKER MODAL (inside page editor) -->
<div class="modal-overlay" id="typePicker" style="z-index:400">
  <div class="modal-box" style="max-width:440px">
    <div class="modal-hdr">
      <h3>Tipo de sección</h3>
      <button class="modal-close" onclick="$('typePicker').classList.remove('open')">✕</button>
    </div>
    <div class="tipo-grid">
      <div class="tipo-opt" onclick="addSectionOfType('hero')"><span class="to-icon">🦅</span><span class="to-label">Hero / Encabezado</span></div>
      <div class="tipo-opt" onclick="addSectionOfType('texto')"><span class="to-icon">📝</span><span class="to-label">Bloque de texto</span></div>
      <div class="tipo-opt" onclick="addSectionOfType('cards')"><span class="to-icon">🃏</span><span class="to-label">Tarjetas / Cards</span></div>
      <div class="tipo-opt" onclick="addSectionOfType('galeria')"><span class="to-icon">🖼️</span><span class="to-label">Galería de fotos</span></div>
      <div class="tipo-opt" onclick="addSectionOfType('contacto')"><span class="to-icon">📬</span><span class="to-label">Llamada a acción</span></div>
      <div class="tipo-opt" onclick="addSectionOfType('stats')"><span class="to-icon">📊</span><span class="to-label">Estadísticas</span></div>
      <div class="tipo-opt" onclick="addSectionOfType('features')"><span class="to-icon">✨</span><span class="to-label">Características</span></div>
      <div class="tipo-opt" onclick="addSectionOfType('pasos')"><span class="to-icon">📋</span><span class="to-label">Pasos / Timeline</span></div>
    </div>
  </div>
</div>

<!-- ─── DESTINO MODAL ─── -->
<div class="modal-overlay" id="destinoModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h3 id="modalTitle">Nuevo destino</h3>
      <button class="modal-close" onclick="closeDestinoModal()">✕</button>
    </div>
    <input type="hidden" id="d-id" value="" />

    <div class="form-row2">
      <div class="fg" style="margin:0">
        <label>Nombre *</label>
        <input type="text" id="d-nombre" placeholder="Llachón" />
      </div>
      <div class="fg" style="margin:0">
        <label>Comunidad / Ubicación *</label>
        <input type="text" id="d-comunidad" placeholder="Comunidad de Llachón" />
      </div>
    </div>

    <div class="fg">
      <label>Descripción *</label>
      <textarea id="d-desc" rows="3" placeholder="Breve descripción del destino..."></textarea>
    </div>

    <div class="fg">
      <label>Foto</label>
      <div id="d-upload-area" style="border:2px dashed var(--border2);border-radius:10px;padding:14px;text-align:center;cursor:pointer;transition:border-color .2s;margin-bottom:8px;" onclick="document.getElementById('d-file-input').click()" ondragover="event.preventDefault();this.style.borderColor='var(--cyan)'" ondragleave="this.style.borderColor='var(--border2)'" ondrop="handleDestDrop(event)">
        <div id="d-upload-preview" style="display:none;margin-bottom:8px"><img id="d-upload-img" src="" style="max-height:100px;border-radius:8px;object-fit:cover;" /></div>
        <div id="d-upload-hint" style="color:var(--muted);font-size:13px">📁 Click o arrastra una foto aquí<br><span style="font-size:11px;color:var(--dim)">JPEG, PNG, WebP, GIF · máx 5MB</span></div>
        <div id="d-upload-prog" style="display:none;color:var(--cyan);font-size:12px;margin-top:6px">Subiendo...</div>
      </div>
      <input type="file" id="d-file-input" accept="image/*" style="display:none" onchange="handleDestFile(this.files[0])" />
      <input type="url" id="d-imagen" placeholder="O pega una URL de imagen: https://..." style="margin-top:4px" />
    </div>

    <div class="form-row2" style="margin-bottom:12px">
      <div class="fg" style="margin:0">
        <label>Emoji (si no hay foto)</label>
        <input type="text" id="d-emoji" placeholder="🏖️" maxlength="4" />
      </div>
      <div class="fg" style="margin:0">
        <label>Texto destacado (badge)</label>
        <input type="text" id="d-highlight" placeholder="Mejor destino vivencial" />
      </div>
    </div>

    <div class="fg">
      <label>Color del badge (hex)</label>
      <div class="color-row">
        <input type="color" id="d-color-picker" value="#0ea5e9" oninput="document.getElementById('d-color').value=this.value" />
        <input type="text"  id="d-color" value="#0ea5e9" placeholder="#0ea5e9" oninput="document.getElementById('d-color-picker').value=this.value.match(/^#[0-9a-fA-F]{6}$/) ? this.value : this.value" />
      </div>
    </div>

    <div class="fg">
      <label>Etiquetas (separadas por coma)</label>
      <input type="text" id="d-tags" placeholder="Mirador, Amanecer, Trekking" />
    </div>

    <div style="display:flex;gap:10px;margin-top:6px">
      <button class="btn-primary" onclick="saveDestinoModal()" style="flex:1">Guardar destino</button>
      <button class="btn-sm" onclick="closeDestinoModal()" style="padding:9px 18px">Cancelar</button>
    </div>
  </div>
</div>

<script define:vars={{ API_URL, IA_URL }}>
  let TOKEN = localStorage.getItem('admin_token') || '';
  let iaData = { conocimiento: [], contexto_base: '' };
  let resData = [];

  const $ = id => document.getElementById(id);

  /* ─── CAT COLORS ─── */
  const CAT = {
    general:      'rgba(100,116,139,.2);color:#94a3b8;border:1px solid rgba(100,116,139,.3)',
    alojamiento:  'rgba(139,92,246,.15);color:#a78bfa;border:1px solid rgba(139,92,246,.3)',
    actividades:  'rgba(56,189,248,.15);color:#7dd3fc;border:1px solid rgba(56,189,248,.3)',
    gastronomia:  'rgba(249,115,22,.15);color:#fdba74;border:1px solid rgba(249,115,22,.3)',
    transporte:   'rgba(59,130,246,.15);color:#93c5fd;border:1px solid rgba(59,130,246,.3)',
    precios:      'rgba(52,211,153,.15);color:#6ee7b7;border:1px solid rgba(52,211,153,.3)',
    cultura:      'rgba(217,70,239,.15);color:#e879f9;border:1px solid rgba(217,70,239,.3)',
    clima:        'rgba(14,165,233,.15);color:#67e8f9;border:1px solid rgba(14,165,233,.3)',
    reservas:     'rgba(245,158,11,.15);color:#fcd34d;border:1px solid rgba(245,158,11,.3)',
    otro:         'rgba(100,116,139,.12);color:#94a3b8;border:1px solid rgba(100,116,139,.2)',
  };

  const ESTADO = {
    pendiente:  'rgba(251,191,36,.15);color:#fde68a;border:1px solid rgba(251,191,36,.3)',
    confirmada: 'rgba(52,211,153,.15);color:#6ee7b7;border:1px solid rgba(52,211,153,.3)',
    cancelada:  'rgba(248,113,113,.15);color:#fca5a5;border:1px solid rgba(248,113,113,.3)',
    completada: 'rgba(56,189,248,.15);color:#7dd3fc;border:1px solid rgba(56,189,248,.3)',
  };

  function catBadge(cat) {
    const s = CAT[cat] || CAT.otro;
    return `<span class="badge" style="background:${s}">${cat}</span>`;
  }

  function estadoBadge(e) {
    const s = ESTADO[e] || ESTADO.pendiente;
    return `<span class="e-badge" style="background:${s}">${e}</span>`;
  }

  /* ─── MSG ─── */
  function showMsg(text, type = 'ok') {
    const el = $('globalMsg');
    el.className = 'msg ' + type;
    el.innerHTML = (type === 'ok' ? '✓ ' : '✗ ') + text;
    el.style.display = 'flex';
    setTimeout(() => el.style.display = 'none', 4000);
  }

  /* ─── SHOW PANEL ─── */
  function showPanel() {
    $('loginPage').style.display  = 'none';
    $('adminPanel').style.display = 'flex';
    loadIA();
  }

  if (TOKEN) showPanel();

  /* ─── LOGIN ─── */
  $('loginBtn').onclick = async () => {
    const email = $('emailInp').value;
    const pass  = $('passInp').value;
    $('loginErr').style.display = 'none';
    try {
      const res  = await fetch(`${API_URL}/api/auth/login`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password: pass })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Error al iniciar sesión');
      if (data.usuario?.rol !== 'admin') throw new Error('Acceso denegado: se requiere rol admin');
      TOKEN = data.accessToken;
      localStorage.setItem('admin_token', TOKEN);
      showPanel();
    } catch (e) {
      $('loginErr').textContent = '⚠️ ' + e.message;
      $('loginErr').style.display = 'block';
    }
  };
  $('passInp').onkeydown = e => { if (e.key === 'Enter') $('loginBtn').click(); };

  /* ─── LOGOUT ─── */
  $('logoutBtn').onclick = () => {
    TOKEN = '';
    localStorage.removeItem('admin_token');
    $('adminPanel').style.display = 'none';
    $('loginPage').style.display  = 'flex';
  };

  /* ─── NAV ─── */
  document.querySelectorAll('.nav-btn[data-section]').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
      btn.classList.add('active');
      $('sec-' + btn.dataset.section).classList.add('active');
      if (btn.dataset.section === 'reservas') loadReservas();
      if (btn.dataset.section === 'contexto') loadCtx();
      if (btn.dataset.section === 'widget')   loadWidget();
      if (btn.dataset.section === 'destinos') loadDestinos();
      if (btn.dataset.section === 'paginas')  loadPaginas();
      if (btn.dataset.section === 'global')   loadSiteconfigAdmin();
    };
  });

  $('refreshBtn').onclick = () => {
    const active = document.querySelector('.nav-btn.active');
    if (!active) return;
    const sec = active.dataset.section;
    if (sec === 'ia')       loadIA();
    if (sec === 'reservas') loadReservas();
    if (sec === 'contexto') loadCtx();
    if (sec === 'widget')   loadWidget();
    if (sec === 'destinos') loadDestinos();
    if (sec === 'paginas')  loadPaginas();
  };

  /* ─── IA ─── */
  async function loadIA() {
    try {
      const res  = await fetch(`${IA_URL}/api/admin/conocimiento`);
      iaData     = await res.json();
      const n    = (iaData.conocimiento || []).length;
      $('ia-count').textContent      = n;
      $('nav-ia-count').textContent  = n;
      renderIA();
    } catch { showMsg('Error al cargar conocimiento IA', 'err'); }
  }

  function renderIA() {
    const q    = ($('iaSearch').value || '').toLowerCase();
    const list = (iaData.conocimiento || []).filter(k =>
      !q || k.pregunta.toLowerCase().includes(q) ||
            k.respuesta.toLowerCase().includes(q) ||
            k.categoria.toLowerCase().includes(q)
    );
    if (!list.length) {
      $('iaList').innerHTML = '<div class="empty"><div class="ei">🧠</div><p>No hay entradas aún.</p></div>';
      return;
    }
    $('iaList').innerHTML = list.map(k => `
      <div class="ia-item" id="iai-${k.id}">
        <div style="flex:1;min-width:0">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:5px;flex-wrap:wrap">
            ${catBadge(k.categoria)}
            <span style="font-size:14px;font-weight:600;color:#e6edf5">${esc(k.pregunta)}</span>
          </div>
          <div style="font-size:13px;color:#7f95aa;line-height:1.45">${esc(k.respuesta)}</div>
        </div>
        <button onclick="deleteIA(${k.id})" style="flex-shrink:0;margin-top:2px;padding:5px 10px;border-radius:7px;border:1px solid rgba(248,113,113,.22);background:transparent;color:#f87171;font-size:12px;cursor:pointer;font-family:inherit;transition:background .15s" onmouseover="this.style.background='rgba(248,113,113,.1)'" onmouseout="this.style.background='transparent'">✕</button>
      </div>
    `).join('');
  }

  $('iaSearch').oninput = renderIA;

  $('addIaBtn').onclick = async () => {
    const q = $('iaQ').value.trim();
    const r = $('iaR').value.trim();
    if (!q || !r) { showMsg('Pregunta y Respuesta son obligatorias', 'err'); return; }
    try {
      await fetch(`${IA_URL}/api/admin/conocimiento`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ categoria: $('iaCat').value, pregunta: q, respuesta: r })
      });
      $('iaQ').value = ''; $('iaR').value = '';
      showMsg('Conocimiento agregado a Inti');
      loadIA();
    } catch { showMsg('Error al agregar', 'err'); }
  };

  window.deleteIA = async (id) => {
    if (!confirm('¿Eliminar este conocimiento?')) return;
    try {
      await fetch(`${IA_URL}/api/admin/conocimiento/${id}`, { method: 'DELETE' });
      document.getElementById(`iai-${id}`)?.remove();
      const n = parseInt($('ia-count').textContent) - 1;
      $('ia-count').textContent     = n;
      $('nav-ia-count').textContent = n;
      showMsg('Entrada eliminada');
    } catch { showMsg('Error al eliminar', 'err'); }
  };

  /* ─── CONTEXTO ─── */
  async function loadCtx() {
    try {
      const res  = await fetch(`${IA_URL}/api/admin/conocimiento`);
      const data = await res.json();
      $('ctxText').value = data.contexto_base || '';
    } catch {}
  }

  $('saveCtxBtn').onclick = async () => {
    try {
      await fetch(`${IA_URL}/api/admin/contexto`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ contexto_base: $('ctxText').value })
      });
      showMsg('Configuración guardada');
    } catch { showMsg('Error al guardar', 'err'); }
  };

  /* ─── WIDGET ─── */
  const WIDGET_DEFAULTS = {
    bot_name:     'Inti · Asistente IA',
    bot_subtitle: 'Capachica Turismo',
    welcome_msg:  '¡Hola! Soy Inti, tu guía virtual de Capachica 🌊\n¿En qué te puedo ayudar?',
    quick_prompts: ['¿Qué es Capachica?', '¿Cómo llegar?', 'Quiero reservar'],
    placeholder:  'Escribe tu pregunta...',
  };

  function fillWidgetForm(data) {
    $('w-name').value        = data.bot_name      || WIDGET_DEFAULTS.bot_name;
    $('w-subtitle').value    = data.bot_subtitle   || WIDGET_DEFAULTS.bot_subtitle;
    $('w-welcome').value     = data.welcome_msg    || WIDGET_DEFAULTS.welcome_msg;
    $('w-placeholder').value = data.placeholder    || WIDGET_DEFAULTS.placeholder;
    const qp = Array.isArray(data.quick_prompts) ? data.quick_prompts : WIDGET_DEFAULTS.quick_prompts;
    $('w-quick').value       = qp.join('\n');
  }

  async function loadWidget() {
    try {
      const res = await fetch(`${IA_URL}/api/widget/config`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      fillWidgetForm(data);
    } catch (e) {
      showMsg(`Error cargando widget: ${e.message} — ¿reiniciaste el backend IA?`, 'err');
      fillWidgetForm(WIDGET_DEFAULTS);
    }
  }

  $('saveWidgetBtn').onclick = async () => {
    const quick = ($('w-quick').value || '').split('\n').map(s => s.trim()).filter(Boolean);
    if (!quick.length) { showMsg('Agrega al menos una pregunta rápida', 'err'); return; }
    try {
      const res = await fetch(`${IA_URL}/api/admin/widget`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          bot_name:      $('w-name').value.trim()        || WIDGET_DEFAULTS.bot_name,
          bot_subtitle:  $('w-subtitle').value.trim()    || WIDGET_DEFAULTS.bot_subtitle,
          welcome_msg:   $('w-welcome').value.trim()     || WIDGET_DEFAULTS.welcome_msg,
          quick_prompts: quick,
          placeholder:   $('w-placeholder').value.trim() || WIDGET_DEFAULTS.placeholder,
        })
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      showMsg('Widget guardado ✓ — recarga la página principal para ver cambios');
    } catch (e) {
      showMsg(`Error al guardar: ${e.message} — ¿reiniciaste el backend IA?`, 'err');
    }
  };

  $('previewWidgetBtn').onclick = () => window.open('/', '_blank');

  /* ─── RESERVAS ─── */
  let resInterval = null;

  async function loadReservas() {
    try {
      const res  = await fetch(`${API_URL}/api/reservas`, {
        headers: { Authorization: `Bearer ${TOKEN}` }
      });
      if (!res.ok) { $('reservasList').innerHTML = '<div class="empty"><div class="ei">🔒</div><p>Sin acceso o sin reservas.</p></div>'; return; }
      resData = await res.json();
      if (!Array.isArray(resData)) resData = [];

      const pend = resData.filter(r => r.estado === 'pendiente').length;
      const conf = resData.filter(r => r.estado === 'confirmada').length;
      const comp = resData.filter(r => r.estado === 'completada').length;
      $('st-total').textContent = resData.length;
      $('st-pend').textContent  = pend;
      $('st-conf').textContent  = conf;
      $('st-comp').textContent  = comp;
      $('res-count').textContent     = resData.length;
      $('nav-res-count').textContent = resData.length;

      if (!resData.length) {
        $('reservasList').innerHTML = '<div class="empty"><div class="ei">📭</div><p>No hay reservas aún.</p></div>';
        return;
      }

      $('reservasList').innerHTML = [...resData].reverse().map(r => `
        <div class="res-item" id="res-${r.id}">
          <div style="flex:1">
            <div style="display:flex;align-items:center;gap:4px;flex-wrap:wrap">
              <span class="res-code">${esc(r.codigo || r.id)}</span>
              ${estadoBadge(r.estado)}
              <span style="color:var(--dim);font-size:11px;margin-left:4px">${r.created_at ? new Date(r.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : ''}</span>
            </div>
            <div class="res-name">${esc(r.nombre_huesped || r.nombre || '')}</div>
            <div class="res-meta">
              ${r.email ? `<span class="res-chip">📧 <a href="mailto:${esc(r.email)}" style="color:var(--cyan);text-decoration:none">${esc(r.email)}</a></span>` : ''}
              ${r.telefono ? `<span class="res-chip">📞 <a href="https://wa.me/${(r.telefono+'').replace(/\D/g,'')}" target="_blank" style="color:#4ade80;text-decoration:none">WhatsApp</a></span>` : ''}
              ${r.fecha_llegada ? `<span class="res-chip">📅 ${esc(r.fecha_llegada)}${r.fecha_salida ? ' → '+esc(r.fecha_salida) : ''}</span>` : ''}
              ${r.num_personas || r.personas ? `<span class="res-chip">👥 ${r.num_personas || r.personas} persona(s)</span>` : ''}
              ${r.familia_nombre ? `<span class="res-chip">🏠 ${esc(r.familia_nombre)}</span>` : ''}
              ${r.precio_total ? `<span class="res-chip" style="color:var(--cyan);font-weight:700">S/. ${parseFloat(r.precio_total).toLocaleString()}</span>` : ''}
            </div>
            ${r.notas ? `<div style="margin-top:8px;padding:7px 11px;background:rgba(251,191,36,.07);border:1px solid rgba(251,191,36,.15);border-radius:7px;font-size:12px;color:var(--amber)">📝 ${esc(r.notas)}</div>` : ''}
          </div>
          <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0;min-width:140px">
            <select onchange="updateEstado('${r.id}', this.value)"
              style="padding:6px 9px;font-size:12px;border-radius:7px;">
              <option value="pendiente"  ${r.estado==='pendiente'  ?'selected':''}>⏳ Pendiente</option>
              <option value="confirmada" ${r.estado==='confirmada' ?'selected':''}>✅ Confirmada</option>
              <option value="cancelada"  ${r.estado==='cancelada'  ?'selected':''}>❌ Cancelada</option>
              <option value="completada" ${r.estado==='completada' ?'selected':''}>🏁 Completada</option>
            </select>
            ${r.telefono ? `<a href="https://wa.me/${(r.telefono+'').replace(/\D/g,'')}?text=Hola ${esc(r.nombre_huesped||r.nombre||'')}, su reserva ${esc(r.codigo||r.id)} en Capachica Turismo está confirmada. ¡Le esperamos!" target="_blank" style="padding:6px;border-radius:7px;background:rgba(74,222,128,.1);border:1px solid rgba(74,222,128,.2);color:#4ade80;font-size:12px;text-align:center;text-decoration:none">💬 WhatsApp</a>` : ''}
          </div>
        </div>
      `).join('');
    } catch { $('reservasList').innerHTML = '<div class="empty"><div class="ei">⚠️</div><p>Error al cargar reservas.</p></div>'; }
  }

  window.updateEstado = async (id, estado) => {
    try {
      await fetch(`${API_URL}/api/reservas/${id}/estado`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${TOKEN}` },
        body: JSON.stringify({ estado })
      });
      showMsg(`Estado → "${estado}"`);
    } catch { showMsg('Error al actualizar estado', 'err'); }
  };

  function esc(str) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* ─── DESTINOS ─── */
  let destinosData = [];

  async function loadDestinos() {
    try {
      const res = await fetch(`${IA_URL}/api/destinos`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      destinosData = await res.json();
      const n = destinosData.length;
      $('dest-count').textContent    = n + ' destino' + (n !== 1 ? 's' : '');
      $('nav-dest-count').textContent = n;
      renderDestinos();
    } catch (e) {
      showMsg('Error cargando destinos: ' + e.message + ' — ¿reiniciaste el backend IA?', 'err');
      $('destinosList').innerHTML = '<div class="empty"><div class="ei">⚠️</div><p>No se pudo cargar. Reinicia el backend IA (puerto 5000).</p></div>';
    }
  }

  function renderDestinos() {
    if (!destinosData.length) {
      $('destinosList').innerHTML = '<div class="empty"><div class="ei">📍</div><p>No hay destinos. Agrega el primero.</p></div>';
      return;
    }
    $('destinosList').innerHTML = destinosData.map(d => {
      const thumb = d.imagen
        ? `<img class="dest-thumb" src="${esc(d.imagen)}" alt="${esc(d.nombre)}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" /><div class="dest-emoji-box" style="display:none;background:rgba(${hexToRgbStr(d.color)},0.12)">${esc(d.emoji||'📍')}</div>`
        : `<div class="dest-emoji-box" style="background:rgba(${hexToRgbStr(d.color)},0.12)">${esc(d.emoji||'📍')}</div>`;
      const tagHtml = (d.tags||[]).map(t => `<span style="padding:2px 8px;border-radius:999px;font-size:11px;background:var(--s3);color:var(--muted);border:1px solid var(--border)">${esc(t)}</span>`).join('');
      return `
        <div class="dest-item" id="dest-${d.id}">
          ${thumb}
          <div style="flex:1;min-width:0">
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px">
              <span style="font-size:15px;font-weight:700;color:var(--text)">${esc(d.nombre)}</span>
              <span style="font-size:10px;font-weight:700;padding:2px 9px;border-radius:20px;background:rgba(${hexToRgbStr(d.color)},0.15);color:${esc(d.color)};border:1px solid rgba(${hexToRgbStr(d.color)},0.3)">${esc(d.highlight)}</span>
            </div>
            <div style="font-size:12px;color:var(--cyan);margin-bottom:5px">📍 ${esc(d.comunidad)}</div>
            <div style="font-size:12px;color:var(--muted);line-height:1.4;margin-bottom:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(d.desc)}</div>
            <div style="display:flex;flex-wrap:wrap;gap:4px">${tagHtml}</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0">
            <button onclick="openDestinoModal(${d.id})" style="padding:6px 12px;border-radius:7px;border:1px solid var(--border2);background:transparent;color:var(--muted);font-size:12px;cursor:pointer;font-family:inherit;transition:all .15s" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--muted)'">✎ Editar</button>
            <button onclick="deleteDestino(${d.id})" style="padding:6px 12px;border-radius:7px;border:1px solid rgba(248,113,113,.22);background:transparent;color:var(--red);font-size:12px;cursor:pointer;font-family:inherit;transition:background .15s" onmouseover="this.style.background='rgba(248,113,113,.1)'" onmouseout="this.style.background='transparent'">✕ Eliminar</button>
          </div>
        </div>
      `;
    }).join('');
  }

  function hexToRgbStr(hex) {
    const m = (hex||'#38bdf8').replace('#','').match(/.{2}/g);
    return m ? m.map(h => parseInt(h, 16)).join(',') : '56,189,248';
  }

  function openDestinoModal(id) {
    const d = id ? destinosData.find(x => x.id === id) : null;
    $('modalTitle').textContent = d ? 'Editar destino' : 'Nuevo destino';
    $('d-id').value         = d ? d.id : '';
    $('d-nombre').value     = d ? d.nombre    : '';
    $('d-comunidad').value  = d ? d.comunidad : '';
    $('d-desc').value       = d ? d.desc      : '';
    $('d-imagen').value     = d ? d.imagen    : '';
    $('d-emoji').value      = d ? (d.emoji||'') : '';
    $('d-highlight').value  = d ? d.highlight : '';
    const color = (d && d.color) ? d.color : '#0ea5e9';
    $('d-color').value         = color;
    $('d-color-picker').value  = color;
    $('d-tags').value       = d ? (d.tags||[]).join(', ') : '';
    resetDestUpload();
    if (d && d.imagen) setDestPreview(d.imagen);
    $('destinoModal').classList.add('open');
  }

  function closeDestinoModal() {
    $('destinoModal').classList.remove('open');
    resetDestUpload();
  }

  function resetDestUpload() {
    $('d-upload-preview').style.display = 'none';
    $('d-upload-hint').style.display    = 'block';
    $('d-upload-prog').style.display    = 'none';
    $('d-upload-area').style.borderColor = 'var(--border2)';
    $('d-file-input').value = '';
  }

  async function uploadImageFile(file) {
    const form = new FormData();
    form.append('imagen', file);
    const res = await fetch(`${API_URL}/api/upload`, { method: 'POST', body: form });
    if (!res.ok) throw new Error('Error al subir imagen');
    const data = await res.json();
    return data.url;
  }

  function setDestPreview(url) {
    $('d-upload-img').src = url.startsWith('http') ? url : `${API_URL}${url}`;
    $('d-upload-preview').style.display = 'block';
    $('d-upload-hint').style.display    = 'none';
  }

  async function handleDestFile(file) {
    if (!file) return;
    $('d-upload-prog').style.display = 'block';
    $('d-upload-hint').style.display = 'none';
    try {
      const url = await uploadImageFile(file);
      $('d-imagen').value = url;
      setDestPreview(url);
    } catch (e) {
      showMsg(e.message, 'err');
      $('d-upload-hint').style.display = 'block';
    } finally {
      $('d-upload-prog').style.display = 'none';
    }
  }

  function handleDestDrop(e) {
    e.preventDefault();
    $('d-upload-area').style.borderColor = 'var(--border2)';
    const file = e.dataTransfer?.files?.[0];
    if (file && file.type.startsWith('image/')) handleDestFile(file);
  }

  // Sync URL field → preview
  $('d-imagen').addEventListener('input', () => {
    const v = $('d-imagen').value.trim();
    if (v) setDestPreview(v); else resetDestUpload();
  });

  // ── GENERIC IMAGE UPLOAD HELPERS (page editor) ─────────────────
  // Returns HTML: text input + "📁 Subir" button + hidden file input
  function imgFieldHtml(inputId, value, placeholder = 'https://...') {
    return `
      <div style="display:flex;gap:6px;align-items:center">
        <input type="text" id="${inputId}" value="${esc(value||'')}" placeholder="${placeholder}" style="flex:1" oninput="syncImgPreview('${inputId}')" />
        <button type="button" onclick="document.getElementById('_file_${inputId}').click()" style="padding:7px 12px;border-radius:7px;border:1px solid var(--border2);background:var(--s2);color:var(--cyan);font-size:12px;cursor:pointer;white-space:nowrap;font-family:inherit">📁 Subir</button>
        <input type="file" id="_file_${inputId}" accept="image/*" style="display:none" onchange="handleGenImgUpload(this,'${inputId}')" />
      </div>
      <div id="_prev_${inputId}" style="margin-top:6px;display:${value?'block':'none'}">
        <img src="${value ? (value.startsWith('http') ? value : API_URL+value) : ''}" style="max-height:80px;border-radius:6px;object-fit:cover;border:1px solid var(--border)" onerror="this.parentElement.style.display='none'" />
      </div>`;
  }

  // For card items (data-card / data-field attributes)
  function imgCardFieldHtml(cardIdx, value) {
    const fileId = `_file_card_${cardIdx}`;
    return `
      <div style="display:flex;gap:6px;align-items:center">
        <input type="text" data-card="${cardIdx}" data-field="imagen" value="${esc(value||'')}" placeholder="https://..." style="flex:1" />
        <button type="button" onclick="document.getElementById('${fileId}').click()" style="padding:7px 12px;border-radius:7px;border:1px solid var(--border2);background:var(--s2);color:var(--cyan);font-size:12px;cursor:pointer;white-space:nowrap;font-family:inherit">📁 Subir</button>
        <input type="file" id="${fileId}" accept="image/*" style="display:none" onchange="handleCardImgUpload(this,${cardIdx})" />
      </div>`;
  }

  // For galeria (multiple URLs textarea)
  function galeriaFieldHtml(imagenes) {
    return `
      <label>URLs de imágenes (una por línea)</label>
      <textarea id="pe-s-imagenes" rows="6" placeholder="https://foto1.jpg&#10;https://foto2.jpg">${(imagenes||[]).join('\n')}</textarea>
      <div style="display:flex;gap:8px;align-items:center;margin-top:8px">
        <button type="button" onclick="document.getElementById('_file_galeria').click()" style="padding:8px 14px;border-radius:7px;border:1px solid var(--border2);background:var(--s2);color:var(--cyan);font-size:12px;cursor:pointer;font-family:inherit">📁 Subir foto(s) y agregar</button>
        <input type="file" id="_file_galeria" accept="image/*" multiple style="display:none" onchange="handleGaleriaUpload(this)" />
        <span id="_galeria_prog" style="font-size:12px;color:var(--cyan);display:none">Subiendo...</span>
      </div>`;
  }

  async function handleGenImgUpload(fileInput, targetId) {
    const file = fileInput.files[0];
    if (!file) return;
    try {
      const url = await uploadImageFile(file);
      const el = document.getElementById(targetId);
      if (el) { el.value = url; syncImgPreview(targetId); }
    } catch(e) { showMsg('Error al subir imagen: ' + e.message, 'err'); }
    fileInput.value = '';
  }

  async function handleCardImgUpload(fileInput, cardIdx) {
    const file = fileInput.files[0];
    if (!file) return;
    try {
      const url = await uploadImageFile(file);
      const el = document.querySelector(`[data-card="${cardIdx}"][data-field="imagen"]`);
      if (el) el.value = url;
    } catch(e) { showMsg('Error al subir imagen: ' + e.message, 'err'); }
    fileInput.value = '';
  }

  async function handleGaleriaUpload(fileInput) {
    const files = Array.from(fileInput.files);
    if (!files.length) return;
    const prog = document.getElementById('_galeria_prog');
    if (prog) prog.style.display = 'inline';
    const ta = document.getElementById('pe-s-imagenes');
    for (const file of files) {
      try {
        const url = await uploadImageFile(file);
        const fullUrl = API_URL + url;
        if (ta) ta.value = (ta.value.trim() ? ta.value.trim() + '\n' : '') + fullUrl;
      } catch(e) { showMsg('Error al subir: ' + file.name, 'err'); }
    }
    if (prog) prog.style.display = 'none';
    fileInput.value = '';
  }

  function syncImgPreview(inputId) {
    const v = (document.getElementById(inputId)||{}).value || '';
    const prev = document.getElementById('_prev_' + inputId);
    if (!prev) return;
    if (v) {
      prev.style.display = 'block';
      const img = prev.querySelector('img');
      if (img) { img.src = v.startsWith('http') ? v : API_URL + v; img.style.display = 'block'; }
    } else {
      prev.style.display = 'none';
    }
  }

  $('destinoModal').addEventListener('click', e => {
    if (e.target === $('destinoModal')) closeDestinoModal();
  });

  async function saveDestinoModal() {
    const nombre    = $('d-nombre').value.trim();
    const comunidad = $('d-comunidad').value.trim();
    const desc      = $('d-desc').value.trim();
    if (!nombre || !comunidad || !desc) { showMsg('Nombre, comunidad y descripción son obligatorios', 'err'); return; }

    const tags = $('d-tags').value.split(',').map(s => s.trim()).filter(Boolean);
    const body = {
      nombre, comunidad, desc,
      imagen:    $('d-imagen').value.trim(),
      emoji:     $('d-emoji').value.trim() || '📍',
      highlight: $('d-highlight').value.trim() || nombre,
      color:     $('d-color').value.trim() || '#0ea5e9',
      tags,
    };

    const id = $('d-id').value;
    try {
      let res;
      if (id) {
        res = await fetch(`${IA_URL}/api/admin/destinos/${id}`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
      } else {
        res = await fetch(`${IA_URL}/api/admin/destinos`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
      }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      closeDestinoModal();
      showMsg(id ? 'Destino actualizado' : 'Destino creado');
      loadDestinos();
    } catch (e) {
      showMsg('Error al guardar: ' + e.message, 'err');
    }
  }

  window.deleteDestino = async (id) => {
    if (!confirm('¿Eliminar este destino?')) return;
    try {
      const res = await fetch(`${IA_URL}/api/admin/destinos/${id}`, { method: 'DELETE' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      destinosData = destinosData.filter(d => d.id !== id);
      document.getElementById(`dest-${id}`)?.remove();
      const n = destinosData.length;
      $('dest-count').textContent     = n + ' destino' + (n !== 1 ? 's' : '');
      $('nav-dest-count').textContent = n;
      showMsg('Destino eliminado');
    } catch (e) {
      showMsg('Error al eliminar: ' + e.message, 'err');
    }
  };

  window.openDestinoModal = openDestinoModal;
  window.closeDestinoModal = closeDestinoModal;
  window.saveDestinoModal = saveDestinoModal;

