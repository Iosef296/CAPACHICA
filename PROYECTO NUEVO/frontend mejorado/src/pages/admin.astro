  function renderNbLinks(links) {
    const container = document.getElementById('nb-links-list');
    if (!container) return;
    container.innerHTML = links.map((l, i) => `
      <div style="display:grid;grid-template-columns:auto 1fr 1fr auto auto auto;gap:6px;align-items:center;" data-nb-idx="${i}">
        <span style="color:var(--dim);font-size:13px;cursor:grab;padding:0 4px;">⠿</span>
        <input type="text" value="${esc(l.label||'')}" placeholder="Etiqueta" oninput="nbUpdateLink(${i},'label',this.value)" style="margin:0;font-size:13px;" />
        <input type="text" value="${esc(l.href||'')}" placeholder="/url" oninput="nbUpdateLink(${i},'href',this.value)" style="margin:0;font-size:13px;" />
        <button onclick="nbMoveLink(${i},-1)" ${i===0?'disabled':''} style="padding:4px 8px;border-radius:6px;border:1px solid var(--border2);background:transparent;color:var(--muted);font-size:12px;cursor:pointer;" title="Subir">↑</button>
        <button onclick="nbMoveLink(${i},1)" ${i===links.length-1?'disabled':''} style="padding:4px 8px;border-radius:6px;border:1px solid var(--border2);background:transparent;color:var(--muted);font-size:12px;cursor:pointer;" title="Bajar">↓</button>
        <button onclick="nbRemoveLink(${i})" style="padding:4px 8px;border-radius:6px;border:1px solid rgba(248,113,113,.2);background:transparent;color:var(--red);font-size:12px;cursor:pointer;">✕</button>
      </div>
    `).join('');
  }

  function nbUpdateLink(i, field, val) {
    if (!_sitecfg.navbar.links[i]) return;
    _sitecfg.navbar.links[i][field] = val;
  }
  function nbMoveLink(i, dir) {
    const links = _sitecfg.navbar.links;
    const j = i + dir;
    if (j < 0 || j >= links.length) return;
    [links[i], links[j]] = [links[j], links[i]];
    renderNbLinks(links);
  }
  function nbRemoveLink(i) {
    _sitecfg.navbar.links.splice(i, 1);
    renderNbLinks(_sitecfg.navbar.links);
  }
  function nbAddLink() {
    if (!_sitecfg.navbar.links) _sitecfg.navbar.links = [];
    _sitecfg.navbar.links.push({ label: '', href: '/' });
    renderNbLinks(_sitecfg.navbar.links);
  }
  window.nbAddLink    = nbAddLink;
  window.nbRemoveLink = nbRemoveLink;
  window.nbUpdateLink = nbUpdateLink;
  window.nbMoveLink   = nbMoveLink;

  const FT_SECTION_MAP = {
    destinos:     { key: 'destinos_links',    containerId: 'ft-destinos-list' },
    experiencias: { key: 'experiencias_links', containerId: 'ft-experiencias-list' },
    info:         { key: 'links',              containerId: 'ft-links-list' },
  };

  function renderFtSection(section, links) {
    const { containerId } = FT_SECTION_MAP[section] || {};
    const container = document.getElementById(containerId);
    if (!container) return;
    container.innerHTML = links.map((l, i) => `
      <div style="display:grid;grid-template-columns:auto 1fr 1fr auto auto auto;gap:6px;align-items:center;">
        <span style="color:var(--dim);font-size:13px;cursor:grab;padding:0 4px;">⠿</span>
        <input type="text" value="${esc(l.label||'')}" placeholder="Etiqueta" oninput="ftSectionUpdate('${section}',${i},'label',this.value)" style="margin:0;font-size:13px;" />
        <input type="text" value="${esc(l.href||'')}" placeholder="/url" oninput="ftSectionUpdate('${section}',${i},'href',this.value)" style="margin:0;font-size:13px;" />
        <button onclick="ftSectionMove('${section}',${i},-1)" ${i===0?'disabled':''} style="padding:4px 8px;border-radius:6px;border:1px solid var(--border2);background:transparent;color:var(--muted);font-size:12px;cursor:pointer;" title="Subir">↑</button>
        <button onclick="ftSectionMove('${section}',${i},1)" ${i===links.length-1?'disabled':''} style="padding:4px 8px;border-radius:6px;border:1px solid var(--border2);background:transparent;color:var(--muted);font-size:12px;cursor:pointer;" title="Bajar">↓</button>
        <button onclick="ftSectionRemove('${section}',${i})" style="padding:4px 8px;border-radius:6px;border:1px solid rgba(248,113,113,.2);background:transparent;color:var(--red);font-size:12px;cursor:pointer;">✕</button>
      </div>
    `).join('');
  }
  function ftSectionLinks(section) {
    const { key } = FT_SECTION_MAP[section] || {};
    if (!key) return [];
    if (!_sitecfg.footer[key]) _sitecfg.footer[key] = [];
    return _sitecfg.footer[key];
  }
  function ftSectionUpdate(section, i, field, val) {
    const links = ftSectionLinks(section);
    if (links[i]) links[i][field] = val;
  }
  function ftSectionMove(section, i, dir) {
    const links = ftSectionLinks(section);
    const j = i + dir;
    if (j < 0 || j >= links.length) return;
    [links[i], links[j]] = [links[j], links[i]];
    renderFtSection(section, links);
  }
  function ftSectionRemove(section, i) {
    const links = ftSectionLinks(section);
    links.splice(i, 1);
    renderFtSection(section, links);
  }
  function ftSectionAdd(section) {
    const links = ftSectionLinks(section);
    links.push({ label: '', href: '/' });
    renderFtSection(section, links);
  }
  window.ftSectionUpdate = ftSectionUpdate;
  window.ftSectionMove   = ftSectionMove;
  window.ftSectionRemove = ftSectionRemove;
  window.ftSectionAdd    = ftSectionAdd;

