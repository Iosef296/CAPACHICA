  function getNormOrder() {
    const raw = _sitecfg.footer?.column_order || [['brand'],['destinos'],['experiencias'],['info'],['newsletter']];
    return raw.map(function(c) { return Array.isArray(c) ? c : [c]; });
  }

  function renderFtColCards() {
    const card = document.getElementById('global-card-footer');
    if (!card) return;
    if (!_sitecfg.footer) _sitecfg.footer = {};

    if (ftColActiveKey) {
      // DETAIL VIEW
      const meta = FT_COL_META[ftColActiveKey];
      if (!meta) { ftColActiveKey = null; renderFtColCards(); return; }
      card.innerHTML = `
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:18px;">
          <button onclick="ftColToggle(null)" style="background:transparent;border:1px solid var(--border);border-radius:7px;color:var(--muted);font-size:12px;cursor:pointer;padding:5px 10px;font-family:inherit;" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--muted)'">← Columnas</button>
          <div class="pe-sec-card-badge">${meta.icon} ${meta.label}</div>
        </div>
        ${meta.editBody()}
      `;
      const ft = _sitecfg.footer;
      if (ftColActiveKey === 'destinos') renderFtSection('destinos', ft.destinos_links || []);
      if (ftColActiveKey === 'experiencias') renderFtSection('experiencias', ft.experiencias_links || []);
      if (ftColActiveKey === 'info') renderFtSection('info', ft.links || []);
    } else {
      // LIST VIEW
      const order = getNormOrder();
      const n = order.length;
      card.innerHTML = `
        <div style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px">🏛️ Footer — Columnas</div>
        <div id="ft-col-cards" style="display:flex;flex-direction:column;gap:8px;">
          ${order.map((keys, i) => {
            const colId = keys.join('-');
            const isCombo = keys.length > 1;
            const badges = keys.map(k => { const m = FT_COL_META[k]; return m ? m.icon + ' ' + m.label : k; }).join(' <span style="opacity:.4">+</span> ');
            const editBtns = keys.map(k => {
              const m = FT_COL_META[k];
              return `<button class="btn-edit" onclick="ftColToggle('${k}')" title="Editar ${m?.label||k}">${m?.icon||''} ${m?.label||k}</button>`;
            }).join('');
            return `<div class="pe-sec-card" id="ftcc-${colId}">
              <div class="pe-sec-card-hdr">
                <div class="pe-sec-card-badge" style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${badges}</div>
                <div class="pe-sec-card-actions" style="flex-shrink:0;">
                  <button onclick="ftColMoveGroup(${i},-1)" ${i===0?'disabled':''}>↑</button>
                  <button onclick="ftColMoveGroup(${i},1)" ${i===n-1?'disabled':''}>↓</button>
                  ${isCombo ? `<button onclick="ftColSplit(${i})" title="Separar en columnas independientes" style="font-size:11px;">✂ Separar</button>` : (i < n-1 ? `<button onclick="ftColMerge(${i})" title="Combinar con columna siguiente" style="font-size:11px;">⊕+</button>` : '')}
                  ${!isCombo ? editBtns : ''}
                </div>
              </div>
              ${isCombo ? `<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;padding-top:8px;border-top:1px solid var(--border);">${editBtns}</div>` : ''}
            </div>`;
          }).join('')}
        </div>
      `;
    }
  }

  function _ftColHighlight(activeKey) {
    const frame = document.getElementById('globalPreviewFrame');
    if (!frame) return;
    try {
      const doc = frame.contentDocument || frame.contentWindow?.document;
      if (!doc) return;
      doc.querySelectorAll('[data-footer-col]').forEach(c => {
        c.style.outline = '';
        c.style.boxShadow = '';
        c.style.transition = 'outline .15s, box-shadow .15s';
      });
      if (activeKey) {
        // find column that contains this section key (supports compound keys like 'experiencias-info')
        const col = Array.from(doc.querySelectorAll('[data-footer-col]')).find(function(c) {
          return c.getAttribute('data-footer-col').split('-').includes(activeKey);
        });
        if (col) {
          col.style.outline = '2px solid #2dd4bf';
          col.style.boxShadow = '0 0 0 4px rgba(45,212,191,0.18)';
          col.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }
    } catch(e) {}
  }

  function ftColToggle(key) {
    ftColActiveKey = (key === ftColActiveKey) ? null : (key || null);
    renderFtColCards();
    _ftColHighlight(ftColActiveKey);
  }

  function ftColMoveGroup(idx, dir) {
    if (!_sitecfg.footer) _sitecfg.footer = {};
    const order = getNormOrder();
    const j = idx + dir;
    if (j < 0 || j >= order.length) return;
    const tmp = order[idx]; order[idx] = order[j]; order[j] = tmp;
    _sitecfg.footer.column_order = order;
    renderFtColCards();
    _ftColHighlight(ftColActiveKey);
    // Sync iframe
    const frame = document.getElementById('globalPreviewFrame');
    if (!frame) return;
    try {
      const doc = frame.contentDocument || frame.contentWindow?.document;
      const grid = doc?.querySelector('.arena-footer-grid');
      if (!grid) return;
      const cols = Array.from(grid.querySelectorAll('[data-footer-col]'));
      const colA = cols[idx];
      const colB = cols[j];
      if (!colA || !colB) return;
      if (dir > 0) { colB.insertAdjacentElement('afterend', colA); }
      else { grid.insertBefore(colA, colB); }
    } catch(e) {}
  }

  function ftColSplit(idx) {
    if (!_sitecfg.footer) _sitecfg.footer = {};
    const order = getNormOrder();
    const keys = order[idx];
    if (keys.length <= 1) return;
    const newOrder = [...order.slice(0, idx), ...keys.map(function(k) { return [k]; }), ...order.slice(idx+1)];
    _sitecfg.footer.column_order = newOrder;
    renderFtColCards();
  }

  function ftColMerge(idx) {
    if (!_sitecfg.footer) _sitecfg.footer = {};
    const order = getNormOrder();
    if (idx >= order.length - 1) return;
    const merged = [...order[idx], ...order[idx+1]];
    const newOrder = [...order.slice(0, idx), merged, ...order.slice(idx+2)];
    _sitecfg.footer.column_order = newOrder;
    renderFtColCards();
  }

  window.ftColMoveGroup = ftColMoveGroup;
  window.ftColSplit     = ftColSplit;
  window.ftColMerge     = ftColMerge;

  function ftColMove(key, dir) {
    if (!_sitecfg.footer) _sitecfg.footer = {};
    const order = (_sitecfg.footer.column_order || ['brand','destinos','experiencias','newsletter']).slice();
    const i = order.indexOf(key);
    const j = i + dir;
    if (j < 0 || j >= order.length) return;
    [order[i], order[j]] = [order[j], order[i]];
    _sitecfg.footer.column_order = order;
    renderFtColCards();
    _ftColHighlight(ftColActiveKey);
    // Sync iframe DOM immediately
    const frame = document.getElementById('globalPreviewFrame');
    if (!frame) return;
    try {
      const doc = frame.contentDocument || frame.contentWindow?.document;
      const grid = doc?.querySelector('.arena-footer-grid');
      if (!grid) return;
      const colKey   = grid.querySelector(`[data-footer-col="${key}"]`);
      const colOther = grid.querySelector(`[data-footer-col="${order[i]}"]`);
      if (!colKey || !colOther) return;
      if (dir > 0) { colOther.insertAdjacentElement('afterend', colKey); }
      else         { grid.insertBefore(colKey, colOther); }
    } catch(e) {}
  }

  window.ftColToggle = ftColToggle;

  // Wait for React to hydrate the navbar, then inject
  function scheduleGlobalInject(iframe) {
    let attempts = 0;
    function tryInject() {
      attempts++;
      try {
        const doc = iframe.contentDocument || iframe.contentWindow?.document;
        const nav = doc && doc.querySelector('nav');
        const links = nav && nav.querySelectorAll('a.nav-link');
        if (links && links.length > 0) {
          injectGlobalEditMode(iframe);
          // Retry footer drag separately in case footer wasn't ready yet
          let ftAttempts = 0;
          function tryFtInject() {
            ftAttempts++;
            try {
              const d = iframe.contentDocument || iframe.contentWindow?.document;
              const ft = d && d.querySelector('[data-footer-section]');
              if (ft && !ft._dragReady) {
                injectGlobalEditMode(iframe);
              } else if (!ft && ftAttempts < 10) {
                setTimeout(tryFtInject, 400);
              }
            } catch(e) { if (ftAttempts < 10) setTimeout(tryFtInject, 400); }
          }
          setTimeout(tryFtInject, 600);
        } else if (attempts < 20) {
          setTimeout(tryInject, 300);
        }
      } catch(e) {
        if (attempts < 20) setTimeout(tryInject, 300);
      }
    }
    setTimeout(tryInject, 400);
  }
  window.scheduleGlobalInject = scheduleGlobalInject;

  // Inject click-to-select overlays + drag-to-reorder into iframe
  function injectGlobalEditMode(iframe) {
    try {
      const doc = iframe.contentDocument || iframe.contentWindow?.document;
      if (!doc || !doc.body) return;
      const CYAN = '#2dd4bf';

      // ── Navbar + Footer click-to-select ──
      const targets = [
        { el: doc.querySelector('nav'), key: 'navbar', label: '🧭 Navbar — click para editar' },
        { el: doc.querySelector('footer'), key: 'footer', label: '🏛️ Footer — click para editar' },
      ];
      targets.forEach(({ el, key, label }) => {
        if (!el || el._globalOv) return;
        el.style.position = 'relative';
        const ov = doc.createElement('div');
        ov.style.cssText = `position:absolute;inset:0;border:2px solid transparent;border-radius:4px;pointer-events:none;z-index:9998;transition:border-color .15s,background .15s;`;
        const tag = doc.createElement('div');
        tag.style.cssText = `position:absolute;top:6px;left:6px;background:${CYAN};color:#0a1628;font-size:10px;font-weight:700;padding:3px 8px;border-radius:4px;opacity:0;transition:opacity .15s;font-family:monospace;pointer-events:none;`;
        tag.textContent = label;
        ov.appendChild(tag);
        el.appendChild(ov);
        el._globalOv = ov;
        el.addEventListener('mouseenter', () => { ov.style.borderColor = CYAN; ov.style.background = 'rgba(45,212,191,0.05)'; tag.style.opacity = '1'; });
        el.addEventListener('mouseleave', () => { if (!el._selected) { ov.style.borderColor = 'transparent'; ov.style.background = ''; tag.style.opacity = '0'; } });
        el.addEventListener('click', (e) => {
          if (e._fromDrag) return;
          e.preventDefault(); e.stopPropagation();
          targets.forEach(t => { if (t.el?._globalOv) { t.el._globalOv.style.background=''; t.el._globalOv.style.borderColor='transparent'; t.el._selected=false; } });
          ov.style.borderColor = CYAN; ov.style.background = 'rgba(45,212,191,0.10)'; el._selected = true;
          window.parent.postMessage({ type: 'cms-global-click', element: key }, '*');
        });
      });

      // ── Drag-to-reorder navbar links ──
      const navDesktop = doc.querySelector('.nav-desktop');
      if (navDesktop && !navDesktop._dragReady) {
        navDesktop._dragReady = true;
        navDesktop.style.position = 'relative';
        let dragSrc = null;
        let dragTarget = null;
        let dropBefore = true;
        let dropIndicator = null;

        function getNavLinks() { return Array.from(navDesktop.querySelectorAll('a.nav-link')); }

        function showIndicator(targetEl, before) {
          if (!dropIndicator) {
            dropIndicator = doc.createElement('div');
            dropIndicator.style.cssText = `position:absolute;width:3px;background:${CYAN};border-radius:2px;height:28px;pointer-events:none;box-shadow:0 0 8px ${CYAN};z-index:9999;`;
            navDesktop.appendChild(dropIndicator);
          }
          const rect = targetEl.getBoundingClientRect();
          const navRect = navDesktop.getBoundingClientRect();
          const x = before ? rect.left - navRect.left - 4 : rect.right - navRect.left + 1;
          dropIndicator.style.left = x + 'px';
          dropIndicator.style.top = (rect.top - navRect.top + (rect.height - 28) / 2) + 'px';
          dropIndicator.style.display = 'block';
        }

        function hideIndicator() { if (dropIndicator) dropIndicator.style.display = 'none'; }

        getNavLinks().forEach((link) => {
          link.setAttribute('draggable', 'true');
          link.style.cursor = 'grab';

          link.addEventListener('dragstart', (e) => {
            dragSrc = link;
            link._dragging = true;
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', link.textContent || '');
            setTimeout(() => { link.style.opacity = '0.35'; link.style.outline = `2px dashed ${CYAN}`; }, 0);
          });
          link.addEventListener('click', (e) => { if (link._dragging) { e.preventDefault(); e.stopPropagation(); } });
          link.addEventListener('dragend', () => {
            link.style.opacity = '';
            link.style.outline = '';
            link.style.cursor = 'grab';
            hideIndicator();
            dragSrc = null;
            dragTarget = null;
            setTimeout(() => { link._dragging = false; }, 50);
          });
        });

        // Container handles dragover + drop — avoids per-link dragleave gaps
        navDesktop.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          if (!dragSrc) return;
          const links = getNavLinks();
          let hit = null;
          for (const l of links) {
            if (l === dragSrc) continue;
            const r = l.getBoundingClientRect();
            if (e.clientX >= r.left - 6 && e.clientX <= r.right + 6) { hit = l; break; }
          }
          if (!hit) return;
          const rect = hit.getBoundingClientRect();
          dropBefore = e.clientX < rect.left + rect.width / 2;
          dragTarget = hit;
          showIndicator(hit, dropBefore);
        });

        navDesktop.addEventListener('dragleave', (e) => {
          if (!navDesktop.contains(e.relatedTarget)) { hideIndicator(); dragTarget = null; }
        });

        navDesktop.addEventListener('drop', (e) => {
          e.preventDefault(); e.stopPropagation();
          hideIndicator();
          if (!dragSrc || !dragTarget || dragSrc === dragTarget) return;
          const allLinks = getNavLinks();
          const from = allLinks.indexOf(dragSrc);
          let to = allLinks.indexOf(dragTarget);
          if (from < 0 || to < 0) return;
          if (!dropBefore) to += 1;
          if (from < to) to -= 1;
          // Move DOM element immediately — visual feedback without reload
          if (dropBefore) {
            dragTarget.parentNode.insertBefore(dragSrc, dragTarget);
          } else {
            dragTarget.insertAdjacentElement('afterend', dragSrc);
          }
          window.parent.postMessage({ type: 'cms-global-reorder', from, to }, '*');
        });
      }
      // ── Drag-to-reorder footer sections (all [data-footer-section] lists) ──
      doc.querySelectorAll('[data-footer-section]').forEach(function(ftContainer) {
        if (ftContainer._dragReady) return;
        ftContainer._dragReady = true;
        ftContainer.style.position = 'relative';
        const sectionKey = ftContainer.getAttribute('data-footer-section');
        let ftDragSrc = null, ftDragTarget = null, ftDropBefore = true, ftDropIndicator = null;

        function getFtItems() { return Array.from(ftContainer.querySelectorAll('li')); }

        function showFtIndicator(targetEl, before) {
          if (!ftDropIndicator) {
            ftDropIndicator = doc.createElement('div');
            ftDropIndicator.style.cssText = `position:absolute;height:3px;background:${CYAN};border-radius:2px;left:0;right:0;pointer-events:none;box-shadow:0 0 8px ${CYAN};z-index:9999;`;
            ftContainer.appendChild(ftDropIndicator);
          }
          const rect = targetEl.getBoundingClientRect();
          const cRect = ftContainer.getBoundingClientRect();
          const y = before ? rect.top - cRect.top - 4 : rect.bottom - cRect.top + 1;
          ftDropIndicator.style.top = y + 'px';
          ftDropIndicator.style.display = 'block';
        }
        function hideFtIndicator() { if (ftDropIndicator) ftDropIndicator.style.display = 'none'; }

        getFtItems().forEach(li => {
          li.setAttribute('draggable', 'true');
          li.style.cursor = 'grab';
          li.addEventListener('dragstart', e => {
            ftDragSrc = li;
            li._dragging = true;
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', li.textContent || '');
            setTimeout(() => { li.style.opacity = '0.35'; li.style.outline = `2px dashed ${CYAN}`; }, 0);
          });
          li.addEventListener('click', e => { if (li._dragging) { e.preventDefault(); e.stopPropagation(); } });
          li.addEventListener('dragend', () => {
            li.style.opacity = ''; li.style.outline = ''; li.style.cursor = 'grab';
            hideFtIndicator(); ftDragSrc = null; ftDragTarget = null;
            setTimeout(() => { li._dragging = false; }, 50);
          });
        });

        ftContainer.addEventListener('dragover', e => {
          e.preventDefault(); e.dataTransfer.dropEffect = 'move';
          if (!ftDragSrc) return;
          const items = getFtItems();
          let hit = null;
          for (const li of items) {
            if (li === ftDragSrc) continue;
            const r = li.getBoundingClientRect();
            if (e.clientY >= r.top - 6 && e.clientY <= r.bottom + 6) { hit = li; break; }
          }
          if (!hit) return;
          const rect = hit.getBoundingClientRect();
          ftDropBefore = e.clientY < rect.top + rect.height / 2;
          ftDragTarget = hit;
          showFtIndicator(hit, ftDropBefore);
        });

        ftContainer.addEventListener('dragleave', e => {
          if (!ftContainer.contains(e.relatedTarget)) { hideFtIndicator(); ftDragTarget = null; }
        });

        ftContainer.addEventListener('drop', e => {
          e.preventDefault(); e.stopPropagation();
          hideFtIndicator();
          if (!ftDragSrc || !ftDragTarget || ftDragSrc === ftDragTarget) return;
          const allItems = getFtItems();
          const from = allItems.indexOf(ftDragSrc);
          let to = allItems.indexOf(ftDragTarget);
          if (from < 0 || to < 0) return;
          if (!ftDropBefore) to += 1;
          if (from < to) to -= 1;
          if (ftDropBefore) { ftContainer.insertBefore(ftDragSrc, ftDragTarget); }
          else { ftDragTarget.insertAdjacentElement('afterend', ftDragSrc); }
          window.parent.postMessage({ type: 'cms-global-footer-reorder', section: sectionKey, from, to }, '*');
        });
      });

      // ── Hide URL tooltip on footer links (drag is on <li>, pointer falls to parent) ──
      if (!doc._ftLinkStyleInjected) {
        doc._ftLinkStyleInjected = true;
        var _ftStyle = doc.createElement('style');
        _ftStyle.textContent = '[data-footer-section] a { pointer-events: none !important; }';
        (doc.head || doc.body).appendChild(_ftStyle);
      }

      // ── Drag-to-reorder footer columns ──
      var ftColDragSrc = null;
      doc.querySelectorAll('[data-footer-col]').forEach(function(col) {
        if (col._colDragReady) return;
        col._colDragReady = true;
        col.setAttribute('draggable', 'true');
        col.style.cursor = 'grab';
        col.addEventListener('dragstart', function(e) {
          if (e.target !== col) return; // ignore child drags (li items)
          ftColDragSrc = col;
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', col.getAttribute('data-footer-col') || '');
          e.stopPropagation();
          setTimeout(function() { col.style.opacity = '0.4'; col.style.outline = '2px dashed ' + CYAN; }, 0);
        });
        col.addEventListener('dragend', function() {
          col.style.opacity = ''; col.style.outline = '';
          doc.querySelectorAll('[data-footer-col]').forEach(function(c) { c.style.boxShadow = ''; });
          ftColDragSrc = null;
        });
        col.addEventListener('dragover', function(e) {
          if (!ftColDragSrc) return;
          e.preventDefault(); e.stopPropagation();
          e.dataTransfer.dropEffect = 'move';
          if (col !== ftColDragSrc) col.style.boxShadow = '0 0 0 2px ' + CYAN + ', 0 0 14px rgba(45,212,191,0.25)';
        });
        col.addEventListener('dragleave', function() { col.style.boxShadow = ''; });
        col.addEventListener('drop', function(e) {
          if (!ftColDragSrc || ftColDragSrc === col) return;
          e.preventDefault(); e.stopPropagation();
          col.style.boxShadow = '';
          var grid = col.parentNode;
          var cRect = col.getBoundingClientRect();
          var before = e.clientX < cRect.left + cRect.width / 2;
          if (before) { grid.insertBefore(ftColDragSrc, col); }
          else { col.insertAdjacentElement('afterend', ftColDragSrc); }
          ftColDragSrc.style.opacity = ''; ftColDragSrc.style.outline = '';
          var newOrder = Array.from(grid.querySelectorAll('[data-footer-col]')).map(function(c) { return c.getAttribute('data-footer-col'); });
          window.parent.postMessage({ type: 'cms-footer-col-reorder', order: newOrder }, '*');
        });
      });

      // ── Click column in iframe → open detail view in admin ──
      doc.querySelectorAll('[data-footer-col]').forEach(function(col) {
        if (col._clickReady) return;
        col._clickReady = true;
        col.addEventListener('click', function(e) {
          if (e._fromDrag || ftColDragSrc) return;
          e.stopPropagation();
          var key = col.getAttribute('data-footer-col');
          window.parent.postMessage({ type: 'cms-footer-col-click', key: key }, '*');
        });
      });
    } catch (e) {}
  }
  window.injectGlobalEditMode = injectGlobalEditMode;

  // Listen for global click + reorder messages from iframe
  window.addEventListener('message', function(e) {
    if (e.data?.type === 'cms-global-click') {
      const cardId = e.data.element === 'navbar' ? 'global-card-navbar' : 'global-card-footer';
      const card = document.getElementById(cardId);
      if (!card) return;
      document.querySelectorAll('#sec-global .card').forEach(c => { c.style.borderColor = ''; c.style.boxShadow = ''; });
      card.style.borderColor = '#2dd4bf';
      card.style.boxShadow = '0 0 0 2px rgba(45,212,191,0.25)';
      card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    if (e.data?.type === 'cms-global-reorder') {
      const { from, to } = e.data;
      const links = _sitecfg.navbar.links;
      if (from < 0 || to < 0 || from >= links.length || to >= links.length || from === to) return;
      const [item] = links.splice(from, 1);
      links.splice(to, 0, item);
      renderNbLinks(links);
    }
    if (e.data?.type === 'cms-global-footer-reorder') {
      const { section, from, to } = e.data;
      const sec = section || 'info';
      const links = ftSectionLinks(sec);
      if (from < 0 || to < 0 || from >= links.length || to >= links.length || from === to) return;
      const [item] = links.splice(from, 1);
      links.splice(to, 0, item);
      renderFtSection(sec, links);
    }
    if (e.data?.type === 'cms-footer-col-reorder') {
      if (!_sitecfg.footer) _sitecfg.footer = {};
      // compound keys like 'experiencias-info' → ['experiencias','info']
      _sitecfg.footer.column_order = e.data.order.map(function(k) { return k.split('-'); });
    }
    if (e.data?.type === 'cms-footer-col-click') {
      // colId may be compound like 'experiencias-info'; open detail for first section
      const key = (e.data.key || '').split('-')[0];
      if (!key) return;
      const globalBtn = document.querySelector('.nav-btn[data-section="global"]');
      if (globalBtn && !globalBtn.classList.contains('active')) {
        globalBtn.click();
        setTimeout(function() { ftColActiveKey = null; ftColToggle(key); }, 350);
      } else {
        ftColToggle(key);
      }
      const card = document.getElementById('global-card-footer');
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });

  async function saveSiteconfigAdmin() {
    const gv = id => { const el = document.getElementById(id); return el ? el.value.trim() : ''; };
    if (!_sitecfg.navbar) _sitecfg.navbar = {};
    _sitecfg.navbar.logo_nombre  = gv('nb-logo-nombre');
    _sitecfg.navbar.logo_tagline = gv('nb-logo-tagline');
    if (!_sitecfg.footer) _sitecfg.footer = {};
    if (!_sitecfg.footer.column_order) _sitecfg.footer.column_order = [['brand'],['destinos'],['experiencias'],['info'],['newsletter']];
    try {
      const r = await fetch(`${IA_URL}/api/admin/siteconfig`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(_sitecfg),
      });
      if (r.ok) {
        const msg = document.getElementById('global-msg');
        if (msg) { msg.style.display = 'inline'; setTimeout(() => msg.style.display = 'none', 3000); }
        const frame = document.getElementById('globalPreviewFrame');
        if (frame) {
          setTimeout(() => {
            frame.src = frame.src;
            frame.onload = () => scheduleGlobalInject(frame);
          }, 300);
        }
      }
    } catch (e) { alert('Error: ' + e.message); }
  }
  window.saveSiteconfigAdmin = saveSiteconfigAdmin;

  /* ── EDITOR ── */
  const TYPE_LABELS = { hero:'🦅 Hero', texto:'📝 Texto', cards:'🃏 Cards', galeria:'🖼️ Galería', contacto:'📬 CTA', stats:'📊 Stats', features:'✨ Features', pasos:'📋 Pasos', bienvenida:'🌄 Bienvenida', 'destinos-showcase':'🗺️ Destinos', 'info-practica':'🧭 Info Práctica', experiencias:'🎯 Experiencias' };
  const TYPE_EMOJIS = { hero:'🦅', texto:'📝', cards:'🃏', galeria:'🖼️', contacto:'📬', stats:'📊', features:'✨', pasos:'📋', bienvenida:'🌄', 'destinos-showcase':'🗺️', 'info-practica':'🧭', experiencias:'🎯' };
  const TYPE_NAMES  = { hero:'Hero', texto:'Texto', cards:'Cards', galeria:'Galería', contacto:'CTA', stats:'Stats', features:'Features', pasos:'Pasos', bienvenida:'Bienvenida', 'destinos-showcase':'Destinos', 'info-practica':'Info Práctica', experiencias:'Experiencias' };

  function getSectionPreview(s) {
    if (s.tipo === 'hero') return `<div class="prev-hero"><div class="prev-hero-title">${s.titulo || '<em style="opacity:.4">Sin título</em>'}</div>${s.subtitulo ? `<div class="prev-hero-sub">${s.subtitulo.substring(0,140)}${s.subtitulo.length>140?'…':''}</div>` : ''}</div>`;
    if (s.tipo === 'stats') return `<div class="prev-stats">${(s.items||[]).map(it=>`<div class="prev-stat"><div class="prev-stat-v">${it.valor||'—'}</div><div class="prev-stat-l">${it.label||'?'}</div></div>`).join('')}${!(s.items||[]).length?'<span style="color:var(--dim);font-size:12px">Sin stats</span>':''}</div>`;
    if (s.tipo === 'cards') return `<div class="prev-cards">${(s.items||[]).slice(0,5).map(c=>`<div class="prev-card-mini">${c.emoji||'📄'} ${c.titulo||'Sin título'}</div>`).join('')}${(s.items||[]).length>5?`<div class="prev-card-mini" style="color:var(--muted)">+${(s.items||[]).length-5}</div>`:''}</div>`;
    if (s.tipo === 'texto') return `<div class="prev-texto">${s.titulo?`<strong>${s.titulo}</strong><br>`:''}${(s.contenido||'Sin contenido').substring(0,180)}${(s.contenido||'').length>180?'…':''}</div>`;
    if (s.tipo === 'galeria') return `<div class="prev-simple">🖼️ ${(s.imagenes||[]).length} imagen${(s.imagenes||[]).length===1?'':'es'}</div>`;
    if (s.tipo === 'contacto') return `<div class="prev-contacto"><div class="prev-contacto-title">${s.titulo||'¿Listo para tu aventura?'}</div>${s.boton_texto?`<span class="prev-btn-sample">${s.boton_texto} →</span>`:''}</div>`;
    if (s.tipo === 'features') return `<div class="prev-features">${(s.items||[]).slice(0,5).map(f=>`<div class="prev-feature">${f.icono||'✦'} ${f.titulo||'—'}</div>`).join('')}</div>`;
    if (s.tipo === 'pasos') return `<div class="prev-pasos">${(s.items||[]).slice(0,4).map((p,i)=>`<div class="prev-paso">${p.icono||String(i+1)} ${p.titulo||'—'}</div>`).join('')}${(s.items||[]).length>4?`<div class="prev-paso" style="color:var(--muted)">+${(s.items||[]).length-4} más</div>`:''}</div>`;
    if (s.tipo === 'bienvenida') return `<div class="prev-texto">${s.intro ? s.intro.substring(0,120)+'…' : 'Sección de introducción con características'}</div>`;
    if (s.tipo === 'destinos-showcase') return `<div class="prev-cards">${(s.items||[]).slice(0,4).map(d=>`<div class="prev-card-mini">${d.icono||'📍'} ${d.nombre||'—'}</div>`).join('')}</div>`;
    if (s.tipo === 'info-practica') return `<div class="prev-features">${(s.items||[]).slice(0,3).map(f=>`<div class="prev-feature">${f.icono||'📋'} ${f.titulo||'—'}</div>`).join('')}</div>`;
    if (s.tipo === 'experiencias') return `<div class="prev-cards">${(s.items||[]).slice(0,4).map(e=>`<div class="prev-card-mini">${e.emoji||'✨'} ${e.etiqueta||'—'}</div>`).join('')}</div>`;
    return '';
  }

  function openPageEditor(id, _unused = null, mode = 'paginas', contenidoSlug = '', contenidoData = null) {
    peMode = mode;
    peContenidoSlug = contenidoSlug;

    if (mode === 'contenido') {
      peCurrentId = null;
      $('pe-title').textContent = 'Editar: ' + (contenidoData?.titulo || contenidoSlug);
      $('pe-titulo').value      = contenidoData?.titulo || '';
      $('pe-slug').value        = contenidoSlug;
      $('pe-desc').value        = contenidoData?.descripcion || '';
      $('pe-publicado').checked = true;
      $('pe-slug').readOnly     = true;
      $('pe-publicado').parentElement.style.display = 'none';
      peSections = JSON.parse(JSON.stringify(contenidoData?.secciones || []));
    } else {
      const p = id ? paginasData.find(x => x.id === id) : null;
      peCurrentId = p ? p.id : null;
      $('pe-title').textContent = p ? 'Editar página' : 'Nueva página';
      $('pe-titulo').value      = p ? p.titulo    : '';
      $('pe-slug').value        = p ? p.slug      : '';
      $('pe-desc').value        = p ? (p.descripcion || '') : '';
      $('pe-publicado').checked = p ? !!p.publicado : true;
      $('pe-slug').readOnly     = false;
      $('pe-publicado').parentElement.style.display = 'flex';
      peSections = p ? JSON.parse(JSON.stringify(p.secciones || [])) : [];
      $('pe-preview-btn').style.display = id ? 'inline-flex' : 'none';
    }

    peActiveIdx = -1;
    renderPeLeft();

    // Set iframe to real page URL
    const iframe = $('pe-preview-iframe');
    if (iframe) {
      let previewUrl = 'about:blank';
      if (mode === 'contenido') {
        previewUrl = contenidoSlug === 'index' ? '/' : '/' + contenidoSlug;
      } else if (id) {
        const p = paginasData.find(x => x.id === id);
        if (p?.slug) previewUrl = '/pagina/' + p.slug;
      }
      if (previewUrl !== 'about:blank') iframe.src = previewUrl;
    }

    $('pageEditor').classList.add('open');
  }

  function reloadPreviewIframe() {
    const iframe = $('pe-preview-iframe');
    if (!iframe || !iframe.src || iframe.src === 'about:blank') return;
    const url = iframe.src;
    iframe.src = 'about:blank';
    setTimeout(() => {
      iframe.src = url;
      iframe.addEventListener('load', function onLoad() {
        iframe.removeEventListener('load', onLoad);
        setTimeout(() => injectEditMode(iframe), 200);
      });
    }, 50);
  }
  window.reloadPreviewIframe = reloadPreviewIframe;

  // Inject click-to-edit overlays into iframe after load
  function injectEditMode(iframe) {
    try {
      const doc = iframe.contentDocument || iframe.contentWindow?.document;
      if (!doc || !doc.body) return;
      // Prevent double injection
      if (doc.body.dataset.cmsEditInjected) return;
      doc.body.dataset.cmsEditInjected = '1';

      const script = doc.createElement('script');
      script.textContent = `(function(){
        var CYAN = '#2dd4bf';
        function setup(el, tipo) {
          if (el._cmsReady) return;
          el._cmsReady = true;
          var cs = getComputedStyle(el);
          if (cs.position === 'static') el.style.position = 'relative';
          el.style.cursor = 'pointer';
          var ov = document.createElement('div');
          ov.style.cssText = 'position:absolute;inset:0;border:2px solid transparent;border-radius:6px;transition:border-color .15s,background .15s;pointer-events:none;z-index:99998;box-sizing:border-box;';
          el.appendChild(ov);
          el.addEventListener('mouseenter', function(){ ov.style.borderColor = CYAN; ov.style.background = 'rgba(45,212,191,0.06)'; });
          el.addEventListener('mouseleave', function(){ ov.style.borderColor = 'transparent'; ov.style.background = ''; });
          el.addEventListener('click', function(e){
            e.preventDefault(); e.stopPropagation();
            document.querySelectorAll('[data-cms-tipo]').forEach(function(x){ if (x._ov) x._ov.style.background=''; });
            ov.style.borderColor = CYAN; ov.style.background = 'rgba(45,212,191,0.12)';
            window.parent.postMessage({ type: 'cms-click', tipo: tipo }, '*');
          });
          el._ov = ov;
        }
        // Mark all data-cms-tipo elements
        document.querySelectorAll('[data-cms-tipo]').forEach(function(el){
          setup(el, el.dataset.cmsTipo);
        });
        // Also observe future DOM changes (for React hydration)
        var obs = new MutationObserver(function(){
          document.querySelectorAll('[data-cms-tipo]:not([data-cms-ready])').forEach(function(el){
            setup(el, el.dataset.cmsTipo);
          });
        });
        obs.observe(document.body, {childList:true, subtree:true});
      })();`;
      doc.body.appendChild(script);

      // Add global style for edit cursor indicator
      const style = doc.createElement('style');
      style.textContent = `[data-cms-tipo] { outline-offset: 0; } `;
      doc.head.appendChild(style);
    } catch(e) {
      console.log('editmode inject error:', e);
    }
  }

  // Listen for click messages from iframe
  window.addEventListener('message', function(e) {
    if (e.data?.type !== 'cms-click') return;
    const tipo = e.data.tipo;
    // Find first matching section
    const idx = peSections.findIndex(s => s.tipo === tipo);
    if (idx >= 0) {
      savePeSectionData(peActiveIdx);
      peActiveIdx = idx;
      renderPeLeft();
    }
  });

  // Wire iframe load event to inject edit mode
  document.addEventListener('DOMContentLoaded', function() {
    const iframe = $('pe-preview-iframe');
    if (!iframe) return;
    iframe.addEventListener('load', function() {
      setTimeout(() => injectEditMode(iframe), 200);
    });
  });

  function closePageEditor() {
    $('pageEditor').classList.remove('open');
    $('pe-slug').readOnly = false;
    $('pe-publicado').parentElement.style.display = 'flex';
    peMode = 'paginas';
    peContenidoSlug = '';
  }

  function renderPeSections() {
    const container = document.getElementById('pe-sections-list');
    if (!container) return;
    if (!peSections.length) {
      container.innerHTML = '<div style="font-size:12px;color:var(--dim);padding:6px 0">Sin secciones</div>';
      return;
    }
    const n = peSections.length;
    container.innerHTML = peSections.map((s, i) => `
      <div class="sec-block ${i === peActiveIdx ? 'active' : ''}" onclick="selectPeSection(${i})">
        <div class="sec-block-main">
          <div class="sec-block-icon">${TYPE_EMOJIS[s.tipo] || '📄'}</div>
          <div class="sec-block-info">
            <div class="sec-block-type">${TYPE_NAMES[s.tipo] || s.tipo}</div>
            ${s.titulo ? `<div class="sec-block-preview">${s.titulo}</div>` : ''}
          </div>
        </div>
        <div class="sec-block-actions" onclick="event.stopPropagation()">
          <button onclick="movePeSection(${i},-1)" ${i===0?'disabled':''}>↑</button>
          <button onclick="movePeSection(${i},1)" ${i===n-1?'disabled':''}>↓</button>
          <button class="del-btn" onclick="removePeSection(${i})">✕</button>
        </div>
      </div>
    `).join('');
  }

  function renderPeLeft() {
    const container = $('pe-left-dynamic');
    if (peActiveIdx >= 0 && peActiveIdx < peSections.length) {
      const s = peSections[peActiveIdx];
      container.innerHTML = `
        <div>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
            <button onclick="closeSecEditor()" style="background:transparent;border:1px solid var(--border);border-radius:7px;color:var(--muted);font-size:12px;cursor:pointer;padding:5px 10px;font-family:inherit;" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--muted)'">← Secciones</button>
            <div style="font-size:13px;font-weight:700;color:var(--cyan);">${TYPE_EMOJIS[s.tipo]} ${TYPE_NAMES[s.tipo]}</div>
          </div>
          ${getSectionFormHtml(s)}
          <button class="btn-primary" onclick="closeSecEditor()" style="width:100%;margin-top:14px;justify-content:center;">✓ Listo</button>
        </div>
      `;
      setTimeout(() => { container.addEventListener('input', updateLivePreview); }, 60);
    } else {
      container.innerHTML = `
        <div>
          <div class="pe-sec-label">Secciones</div>
          <div id="pe-sections-list"></div>
          <button class="add-sec-btn" onclick="addSection()">＋ Agregar sección</button>
        </div>
      `;
      renderPeSections();
    }
  }

  function renderPeCanvas() {
    const container = $('pe-canvas');
    if (!peSections.length) {
      container.innerHTML = `<div class="pe-canvas-empty"><div>✨</div><p>Sin secciones. Agrega tu primera sección.</p><button class="btn-primary" onclick="addSection()" style="margin-top:14px;">＋ Primera sección</button></div>`;
      return;
    }
    const n = peSections.length;
    container.innerHTML = peSections.map((s, i) => {
      const isActive = i === peActiveIdx;
      return `
        <div class="pe-canvas-sec ${isActive?'active':''}" id="pcs-${i}">
          <div class="pe-canvas-sec-bar">
            <span class="pe-canvas-sec-badge">${TYPE_EMOJIS[s.tipo]} ${TYPE_NAMES[s.tipo]}</span>
            ${s.titulo?`<span style="font-size:12px;color:var(--muted);margin-left:6px;">${s.titulo}</span>`:''}
            <div class="pe-canvas-sec-bar-controls" onclick="event.stopPropagation()">
              <button onclick="movePeSection(${i},-1)" ${i===0?'disabled':''}>↑</button>
              <button onclick="movePeSection(${i},1)" ${i===n-1?'disabled':''}>↓</button>
              <button class="del-btn" onclick="removePeSection(${i})">🗑</button>
            </div>
          </div>
          <div class="pe-canvas-sec-body" id="pcs-body-${i}" onclick="selectPeSection(${i})">
            ${renderSectionLivePreview(s)}
            ${!isActive?`<div class="pe-canvas-hover-hint"><span>✎ Editar sección</span></div>`:''}
          </div>
        </div>
      `;
    }).join('') + `<div style="text-align:center;padding:8px 0;"><button class="add-sec-btn" onclick="addSection()" style="width:auto;padding:10px 24px;">＋ Agregar sección</button></div>`;
  }

  function selectPeSection(idx) {
    savePeSectionData(peActiveIdx);
    peActiveIdx = idx;
    renderPeLeft();
    renderPeCanvas();
    setTimeout(() => {
      const sec = document.getElementById(`pcs-${idx}`);
      if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 60);
  }

  function addSection() {
    $('typePicker').classList.add('open');
  }

  function addSectionOfType(tipo) {
    $('typePicker').classList.remove('open');
    savePeSectionData(peActiveIdx);
    const base = { tipo, id: Date.now() };
    if (tipo === 'cards' || tipo === 'features' || tipo === 'pasos' || tipo === 'stats') base.items = [];
    if (tipo === 'galeria') base.imagenes = [];
    peSections.push(base);
    peActiveIdx = peSections.length - 1;
    renderPeLeft();
    renderPeCanvas();
    setTimeout(() => {
      const sec = document.getElementById(`pcs-${peActiveIdx}`);
      if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 80);
  }

  function removePeSection(idx) {
    peSections.splice(idx, 1);
    if (peActiveIdx >= peSections.length) peActiveIdx = peSections.length - 1;
    if (peSections.length === 0) peActiveIdx = -1;
    renderPeLeft();
    renderPeCanvas();
  }

  function renderSectionLivePreview(s) {
    if (!s) return '';
    if (s.tipo === 'hero') return `
      <div style="text-align:center;padding:32px 20px;background:linear-gradient(135deg,var(--s3),var(--s2));border-radius:10px;">
        <div style="font-family:'Playfair Display',Georgia,serif;font-size:2rem;font-weight:800;color:var(--text);line-height:1.1;margin-bottom:10px;">${s.titulo||'<span style="opacity:.3">Título aquí</span>'}</div>
        ${s.subtitulo?`<div style="font-size:.9rem;color:var(--muted);line-height:1.65;max-width:420px;margin:0 auto 12px;">${s.subtitulo}</div>`:''}
        <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:10px;">
          ${s.boton_texto||'Explorar destinos →'?`<span style="background:var(--cyan);color:#0a1628;padding:6px 14px;border-radius:999px;font-size:11px;font-weight:700;">${s.boton_texto||'Explorar destinos →'}</span>`:''}
          ${s.boton2_texto||'Cómo llegar'?`<span style="border:1px solid var(--cyan);color:var(--cyan);padding:6px 14px;border-radius:999px;font-size:11px;">${s.boton2_texto||'Cómo llegar'}</span>`:''}
        </div>
      </div>`;
    if (s.tipo === 'stats') return `
      <div style="padding:8px 0;">
