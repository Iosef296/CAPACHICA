      extra = `<div class="fg"><label>Introducción</label><input type="text" id="pe-s-intro" value="${esc(s.intro||'')}" placeholder="Descripción introductoria..." /></div><div id="pe-list-items">${destiHtml}</div><button class="add-sec-btn" onclick="peAddListItem('destinos')">＋ Agregar destino</button>`;
    } else if (tipo === 'info-practica') {
      const infoHtml = (s.items||[]).map((item,i)=>`<div class="card-row"><button class="card-row-del" onclick="peRemoveListItem(${i},'info')">✕</button><div class="form-row2" style="margin-bottom:8px"><div class="fg" style="margin:0"><label>Ícono</label><input type="text" data-list="${i}" data-field="icono" value="${esc(item.icono||'')}" placeholder="🚌" maxlength="4" /></div><div class="fg" style="margin:0"><label>Título</label><input type="text" data-list="${i}" data-field="titulo" value="${esc(item.titulo||'')}" placeholder="Cómo llegar" /></div></div><div class="fg" style="margin-bottom:8px"><label>Lista (una por línea)</label><textarea data-list="${i}" data-field="lista" rows="4">${esc(item.lista||'')}</textarea></div><div class="form-row2"><div class="fg" style="margin:0"><label>URL del enlace</label><input type="text" data-list="${i}" data-field="link" value="${esc(item.link||'')}" placeholder="/como-llegar" /></div><div class="fg" style="margin:0"><label>Texto del enlace</label><input type="text" data-list="${i}" data-field="link_texto" value="${esc(item.link_texto||'')}" placeholder="Ver más" /></div></div><div class="fg" style="margin:0"><label>Color (hex)</label><input type="text" data-list="${i}" data-field="color" value="${esc(item.color||'')}" placeholder="#2dd4bf" /></div></div>`).join('');
      extra = `<div id="pe-list-items">${infoHtml}</div><button class="add-sec-btn" onclick="peAddListItem('info')">＋ Agregar tarjeta</button>`;
    } else if (tipo === 'experiencias') {
      const expHtml = (s.items||[]).map((item,i)=>`<div class="card-row"><button class="card-row-del" onclick="peRemoveCard(${i})">✕</button><div class="form-row2" style="margin-bottom:8px"><div class="fg" style="margin:0"><label>Emoji</label><input type="text" data-card="${i}" data-field="emoji" value="${esc(item.emoji||'')}" placeholder="🏠" maxlength="4" /></div><div class="fg" style="margin:0"><label>Etiqueta</label><input type="text" data-card="${i}" data-field="etiqueta" value="${esc(item.etiqueta||'')}" placeholder="Vivencial" /></div></div><div class="fg" style="margin-bottom:8px"><label>Título</label><input type="text" data-card="${i}" data-field="titulo" value="${esc(item.titulo||'')}" placeholder="Vive con familias..." /></div><div class="fg" style="margin-bottom:8px"><label>Descripción</label><textarea data-card="${i}" data-field="desc" rows="2">${esc(item.desc||'')}</textarea></div><div class="form-row2"><div class="fg" style="margin:0"><label>URL</label><input type="text" data-card="${i}" data-field="href" value="${esc(item.href||'')}" placeholder="/vivencial" /></div><div class="fg" style="margin:0"><label>Color</label><input type="text" data-card="${i}" data-field="color" value="${esc(item.color||'')}" placeholder="#0ea5e9" /></div></div><div class="fg" style="margin:0"><label>Tags (separados por coma)</label><input type="text" data-card="${i}" data-field="tags" value="${esc(item.tags||'')}" placeholder="Kayak,Pesca,Escalada" /></div></div>`).join('');
      extra = `<div class="fg"><label>Introducción</label><input type="text" id="pe-s-intro" value="${esc(s.intro||'')}" placeholder="Descripción introductoria..." /></div><div id="pe-cards-list">${expHtml}</div><button class="add-sec-btn" onclick="peAddCard()">＋ Agregar experiencia</button>`;
    }
    return `<div class="sec-editor">${sharedTitulo}${extra}</div>`;
  }

  function renderPeSectionEditor() {
    renderPeLeft();
    renderPeCanvas();
  }

  function closeSecEditor() {
    savePeSectionData(peActiveIdx);
    peActiveIdx = -1;
    renderPeLeft();
    renderPeCanvas();
  }
  window.closeSecEditor = closeSecEditor;

  function movePeSection(idx, dir) {
    savePeSectionData(peActiveIdx);
    const newIdx = idx + dir;
    if (newIdx < 0 || newIdx >= peSections.length) return;
    [peSections[idx], peSections[newIdx]] = [peSections[newIdx], peSections[idx]];
    if (peActiveIdx === idx) peActiveIdx = newIdx;
    else if (peActiveIdx === newIdx) peActiveIdx = idx;
    renderPeLeft();
    renderPeCanvas();
  }
  window.movePeSection = movePeSection;

  function savePeSectionData(idx) {
    if (idx < 0 || idx >= peSections.length) return;
    const s = peSections[idx];
    const gv = id => { const el = document.getElementById(id); return el ? el.value : null; };
    const titulo = gv('pe-s-titulo');
    if (titulo !== null) s.titulo = titulo;

    if (s.tipo === 'hero') {
      s.subtitulo    = gv('pe-s-subtitulo')    ?? s.subtitulo;
      s.imagen       = gv('pe-s-imagen')       ?? s.imagen;
      s.boton_texto  = gv('pe-s-boton_texto')  ?? s.boton_texto;
      s.boton_url    = gv('pe-s-boton_url')    ?? s.boton_url;
      s.boton2_texto = gv('pe-s-boton2_texto') ?? s.boton2_texto;
      s.boton2_url   = gv('pe-s-boton2_url')   ?? s.boton2_url;
    } else if (s.tipo === 'texto') {
      s.contenido = gv('pe-s-contenido') ?? s.contenido;
    } else if (s.tipo === 'cards') {
      const rows = document.querySelectorAll('.card-row');
      s.items = Array.from(rows).map((row, i) => {
        const fv = f => { const el = row.querySelector(`[data-card="${i}"][data-field="${f}"]`); return el ? el.value : ''; };
        return {
          titulo: fv('titulo'), etiqueta: fv('etiqueta'), emoji: fv('emoji'),
          lugar: fv('lugar'), desc: fv('desc'), precio: fv('precio'),
          precio_unidad: fv('precio_unidad'), extra: fv('extra'),
          imagen: fv('imagen'), color: fv('color'),
        };
      });
    } else if (s.tipo === 'stats' || s.tipo === 'features' || s.tipo === 'pasos') {
      const rows = document.querySelectorAll('#pe-list-items .card-row');
      s.items = Array.from(rows).map((row, i) => {
        const fv = f => { const el = row.querySelector(`[data-list="${i}"][data-field="${f}"]`); return el ? el.value : ''; };
        if (s.tipo === 'stats')    return { valor: fv('valor'), label: fv('label') };
        if (s.tipo === 'features') return { icono: fv('icono'), titulo: fv('titulo'), desc: fv('desc') };
        if (s.tipo === 'pasos')    return { icono: fv('icono'), titulo: fv('titulo'), desc: fv('desc') };
        return {};
      });
    } else if (s.tipo === 'bienvenida') {
      s.intro    = gv('pe-s-intro')    ?? s.intro;
      s.parrafo1 = gv('pe-s-parrafo1') ?? s.parrafo1;
      s.parrafo2 = gv('pe-s-parrafo2') ?? s.parrafo2;
      const rows = document.querySelectorAll('#pe-list-items .card-row');
      s.items = Array.from(rows).map((row, i) => {
        const fv = f => { const el = row.querySelector(`[data-list="${i}"][data-field="${f}"]`); return el ? el.value : ''; };
        return { icono: fv('icono'), titulo: fv('titulo'), desc: fv('desc') };
      });
    } else if (s.tipo === 'destinos-showcase') {
      s.intro = gv('pe-s-intro') ?? s.intro;
      const rows = document.querySelectorAll('#pe-list-items .card-row');
      s.items = Array.from(rows).map((row, i) => {
        const fv = f => { const el = row.querySelector(`[data-list="${i}"][data-field="${f}"]`); return el ? el.value : ''; };
        return { nombre: fv('nombre'), subtitulo: fv('subtitulo'), desc: fv('desc'), icono: fv('icono'), color: fv('color') };
      });
    } else if (s.tipo === 'info-practica') {
      const rows = document.querySelectorAll('#pe-list-items .card-row');
      s.items = Array.from(rows).map((row, i) => {
        const fv = f => { const el = row.querySelector(`[data-list="${i}"][data-field="${f}"]`); return el ? el.value : ''; };
        return { icono: fv('icono'), titulo: fv('titulo'), lista: fv('lista'), link: fv('link'), link_texto: fv('link_texto'), color: fv('color') };
      });
    } else if (s.tipo === 'experiencias') {
      s.intro = gv('pe-s-intro') ?? s.intro;
      const rows = document.querySelectorAll('.card-row');
      s.items = Array.from(rows).map((row, i) => {
        const fv = f => { const el = row.querySelector(`[data-card="${i}"][data-field="${f}"]`); return el ? el.value : ''; };
        return { emoji: fv('emoji'), etiqueta: fv('etiqueta'), titulo: fv('titulo'), desc: fv('desc'), href: fv('href'), color: fv('color'), tags: fv('tags') };
      });
    } else if (s.tipo === 'galeria') {
      const raw = gv('pe-s-imagenes') ?? '';
      s.imagenes = raw.split('\n').map(u => u.trim()).filter(Boolean);
    } else if (s.tipo === 'contacto') {
      s.subtitulo    = gv('pe-s-subtitulo')    ?? s.subtitulo;
      s.boton_texto  = gv('pe-s-boton_texto')  ?? s.boton_texto;
      s.boton_url    = gv('pe-s-boton_url')    ?? s.boton_url;
      s.boton2_texto = gv('pe-s-boton2_texto') ?? s.boton2_texto;
      s.boton2_url   = gv('pe-s-boton2_url')   ?? s.boton2_url;
    }
  }

  function peAddCard() {
    savePeSectionData(peActiveIdx);
    peSections[peActiveIdx].items = peSections[peActiveIdx].items || [];
    const tipo = peSections[peActiveIdx].tipo;
    if (tipo === 'experiencias') {
      peSections[peActiveIdx].items.push({ emoji: '✨', etiqueta: '', titulo: '', desc: '', href: '/', color: '#38bdf8', tags: '' });
    } else {
      peSections[peActiveIdx].items.push({ titulo: '', desc: '', precio: '', imagen: '' });
    }
    renderPeLeft(); renderPeCanvas();
  }

  window.peRemoveCard = function(idx) {
    savePeSectionData(peActiveIdx);
    peSections[peActiveIdx].items.splice(idx, 1);
    renderPeLeft(); renderPeCanvas();
  };

  window.peAddListItem = function(tipo) {
    savePeSectionData(peActiveIdx);
    peSections[peActiveIdx].items = peSections[peActiveIdx].items || [];
    if (tipo === 'stats')    peSections[peActiveIdx].items.push({ valor: '', label: '' });
    if (tipo === 'features') peSections[peActiveIdx].items.push({ icono: '', titulo: '', desc: '' });
    if (tipo === 'pasos')    peSections[peActiveIdx].items.push({ icono: '', titulo: '', desc: '' });
    if (tipo === 'destinos') peSections[peActiveIdx].items.push({ nombre: '', subtitulo: '', desc: '', icono: '📍', color: '#2dd4bf' });
    if (tipo === 'info')     peSections[peActiveIdx].items.push({ icono: '📋', titulo: '', lista: '', link: '', link_texto: '', color: '#2dd4bf' });
    renderPeLeft(); renderPeCanvas();
  };

  window.peRemoveListItem = function(idx, tipo) {
    savePeSectionData(peActiveIdx);
    peSections[peActiveIdx].items.splice(idx, 1);
    renderPeLeft(); renderPeCanvas();
  };

  async function savePageEditor() {
    savePeSectionData(peActiveIdx);
    const titulo = $('pe-titulo').value.trim();
    const slug   = $('pe-slug').value.trim();
    if (!titulo || !slug) { showMsg('Título y slug son obligatorios', 'err'); return; }

    const body = {
      titulo,
      slug,
      descripcion: $('pe-desc').value.trim(),
      publicado:   $('pe-publicado').checked,
      secciones:   peSections,
    };

    try {
      let res;
      if (peMode === 'contenido') {
        res = await fetch(`${IA_URL}/api/admin/contenido/${peContenidoSlug}`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        showMsg('✓ Guardado — actualizando vista previa...');
        setTimeout(reloadPreviewIframe, 300);
        return;
      } else if (peCurrentId) {
        res = await fetch(`${IA_URL}/api/admin/paginas/${peCurrentId}`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        showMsg('✓ Página guardada');
        loadPaginas();
        setTimeout(reloadPreviewIframe, 300);
      } else {
        res = await fetch(`${IA_URL}/api/admin/paginas`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        showMsg('✓ Página creada — /pagina/' + slug);
        loadPaginas();
        setTimeout(() => { const iframe = $('pe-preview-iframe'); if (iframe) iframe.src = '/pagina/' + slug; }, 300);
      }
    } catch (e) {
      showMsg('Error al guardar: ' + e.message, 'err');
    }
  }

  function previewPage() {
    const slug = $('pe-slug').value.trim();
    if (slug) window.open(`/pagina/${slug}`, '_blank');
  }

  window.deletePagina = async (id) => {
    if (!confirm('¿Eliminar esta página?')) return;
    try {
      const res = await fetch(`${IA_URL}/api/admin/paginas/${id}`, { method: 'DELETE' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      paginasData = paginasData.filter(p => p.id !== id);
      document.getElementById(`pag-${id}`)?.remove();
      const n = paginasData.length;
      $('pag-count').textContent     = n + ' página' + (n !== 1 ? 's' : '');
      $('nav-pag-count').textContent = n;
      showMsg('Página eliminada');
    } catch (e) {
      showMsg('Error: ' + e.message, 'err');
    }
  };

  window.openPageEditor   = openPageEditor;
  window.closePageEditor  = closePageEditor;
  window.savePageEditor   = savePageEditor;
  window.previewPage      = previewPage;
  window.addSection       = addSection;
  window.addSectionOfType = addSectionOfType;
  window.selectPeSection  = selectPeSection;
  window.removePeSection  = removePeSection;
  window.peAddCard        = peAddCard;
</script>
</body>
</html>
