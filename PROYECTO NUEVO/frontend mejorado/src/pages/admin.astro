  async function openContenidoEditor(slug, titulo) {
    const defaults = CONTENIDO_DEFAULTS[slug] || { titulo, descripcion: '', secciones: [{ tipo: 'hero', titulo, subtitulo: '' }] };
    try {
      const res = await fetch(`${IA_URL}/api/admin/contenido/${slug}`);
      const data = await res.json();
      if (!data?.secciones?.length) {
        openPageEditor(null, null, 'contenido', slug, defaults);
        setTimeout(() => savePageEditor(), 400);
        return;
      }
      // Merge: if existing is missing sections that defaults define, supplement with defaults
      const existingTypes = new Set(data.secciones.map(s => s.tipo));
      const missingFromDefaults = defaults.secciones.some(ds => !existingTypes.has(ds.tipo));
      let content;
      if (missingFromDefaults) {
        const mergedSections = defaults.secciones.map(ds => {
          return data.secciones.find(es => es.tipo === ds.tipo) || ds;
        });
        content = { ...defaults, ...data, secciones: mergedSections };
        openPageEditor(null, null, 'contenido', slug, content);
        // Auto-save so iframe reloads with new sections immediately
        setTimeout(() => savePageEditor(), 400);
      } else {
        content = data;
        openPageEditor(null, null, 'contenido', slug, content);
      }
    } catch (e) {
      openPageEditor(null, null, 'contenido', slug, defaults);
      setTimeout(() => savePageEditor(), 400);
    }
  }
  window.openContenidoEditor = openContenidoEditor;

