  function updateLivePreview() {
    const idx = peActiveIdx;
    if (idx < 0 || idx >= peSections.length) return;
    const s = JSON.parse(JSON.stringify(peSections[idx]));
    const gv = id => { const el = document.getElementById(id); return el ? el.value : null; };
    const tv = id => { const el = document.getElementById(id); return el ? el.value : null; };
    const sv = gv('pe-s-titulo'); if (sv !== null) s.titulo = sv;
    if (s.tipo === 'hero') { s.subtitulo = tv('pe-s-subtitulo') ?? s.subtitulo; s.boton_texto = gv('pe-s-boton_texto') ?? s.boton_texto; s.boton_url = gv('pe-s-boton_url') ?? s.boton_url; s.boton2_texto = gv('pe-s-boton2_texto') ?? s.boton2_texto; s.boton2_url = gv('pe-s-boton2_url') ?? s.boton2_url; }
    else if (s.tipo === 'texto') { s.contenido = tv('pe-s-contenido') ?? s.contenido; }
    else if (s.tipo === 'contacto') { s.subtitulo = tv('pe-s-subtitulo') ?? s.subtitulo; s.boton_texto = gv('pe-s-boton_texto') ?? s.boton_texto; }
    else if (s.tipo === 'stats') {
      const rows = document.querySelectorAll('#pe-list-items .card-row');
      s.items = Array.from(rows).map((row,i)=>{ const fv=f=>{const el=row.querySelector(`[data-list="${i}"][data-field="${f}"]`);return el?el.value:''}; return{valor:fv('valor'),label:fv('label')}; });
    } else if (s.tipo === 'features') {
      const rows = document.querySelectorAll('#pe-list-items .card-row');
      s.items = Array.from(rows).map((row,i)=>{ const fv=f=>{const el=row.querySelector(`[data-list="${i}"][data-field="${f}"]`);return el?el.value:''}; return{icono:fv('icono'),titulo:fv('titulo'),desc:fv('desc')}; });
    } else if (s.tipo === 'pasos') {
      const rows = document.querySelectorAll('#pe-list-items .card-row');
      s.items = Array.from(rows).map((row,i)=>{ const fv=f=>{const el=row.querySelector(`[data-list="${i}"][data-field="${f}"]`);return el?el.value:''}; return{icono:fv('icono'),titulo:fv('titulo'),desc:fv('desc')}; });
    } else if (s.tipo === 'cards') {
      const rows = document.querySelectorAll('.card-row');
      s.items = Array.from(rows).map((row,i)=>{ const fv=f=>{const el=row.querySelector(`[data-card="${i}"][data-field="${f}"]`);return el?el.value:''}; return{titulo:fv('titulo'),emoji:fv('emoji'),imagen:fv('imagen'),precio:fv('precio'),precio_unidad:fv('precio_unidad'),etiqueta:fv('etiqueta'),lugar:fv('lugar'),desc:fv('desc'),extra:fv('extra'),color:fv('color')}; });
    }
    const div = document.getElementById(`pcs-body-${idx}`);
    if (div) div.innerHTML = renderSectionLivePreview(s);
  }
  window.updateLivePreview = updateLivePreview;

