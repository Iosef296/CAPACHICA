  async function openContenidoEditor(slug, titulo) {
    try {
      const res = await fetch(`${IA_URL}/api/admin/contenido/${slug}`);
      const data = await res.json();
      const existing = data?.secciones?.length ? data : null;
      const defaults = CONTENIDO_DEFAULTS[slug] || { titulo, descripcion: '', secciones: [{ tipo: 'hero', titulo, subtitulo: '' }] };
      const content = existing || defaults;
      openPageEditor(null, null, 'contenido', slug, content);
    } catch (e) {
      const defaults = CONTENIDO_DEFAULTS[slug] || { titulo, descripcion: '', secciones: [{ tipo: 'hero', titulo, subtitulo: '' }] };
      openPageEditor(null, null, 'contenido', slug, defaults);
    }
  }
