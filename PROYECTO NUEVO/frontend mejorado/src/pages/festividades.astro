---
import Layout from '../layouts/Layout.astro';

let festividades: any[] = [];
try {
  const res = await fetch(`${import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api'}/festividades`);
  if (res.ok) festividades = await res.json();
} catch {}

if (!festividades.length) {
  festividades = [
    { id:1, nombre:'Virgen de la Candelaria', fecha:'1 al 14 de Febrero', mes:2, tipo:'Religiosa', ubicacion:'Capachica, Puno', descripcion:'Una de las festividades más importantes de la región. Misa, procesión por el lago y danzas tradicionales en honor a la Virgen.', actividades:['Procesión por el lago','Danzas tradicionales','Misa solemne'], imagen:'https://picsum.photos/seed/candelaria/800/500', galeria:['https://picsum.photos/seed/candel1/600/400','https://picsum.photos/seed/candel2/600/400'], destacado:true },
    { id:2, nombre:'Carnavales de Capachica', fecha:'20 al 25 de Febrero', mes:2, tipo:'Tradicional', ubicacion:'Capachica', descripcion:"Celebración con ch'alla, cortamonte, danzas autóctonas y comparsas.", actividades:["Ch'alla",'Cortamonte','Danzas autóctonas'], imagen:'https://picsum.photos/seed/carnavales/800/500', galeria:['https://picsum.photos/seed/carn1/600/400'], destacado:false },
    { id:3, nombre:'Inti Raymi', fecha:'21 al 24 de Junio', mes:6, tipo:'Ceremonial', ubicacion:'Orillas del Lago Titicaca', descripcion:'Ceremonia al dios Sol en el solsticio de invierno. Rituales ancestrales agradeciendo al Inti.', actividades:['Rituales ancestrales','Ofrendas al Sol','Música ceremonial'], imagen:'https://picsum.photos/seed/intiraymi/800/500', galeria:['https://picsum.photos/seed/inti1/600/400'], destacado:true },
    { id:4, nombre:'Pachamama Raymi', fecha:'1 al 15 de Agosto', mes:8, tipo:'Ceremonial', ubicacion:'Cerros sagrados de Capachica', descripcion:'Ritual ancestral de agradecimiento a la Madre Tierra. Ofrendas y ceremonias en los cerros sagrados.', actividades:['Ofrendas a la tierra','Ritual del challaco','Banquete comunitario'], imagen:'https://picsum.photos/seed/pachamama/800/500', galeria:['https://picsum.photos/seed/pacha1/600/400'], destacado:true },
    { id:5, nombre:'Día de Todos los Santos', fecha:'1 al 2 de Noviembre', mes:11, tipo:'Tradicional', ubicacion:'Cementerio de Capachica', descripcion:'Visita al cementerio con ofrendas, flores y velas. Las familias preparan panes tradicionales.', actividades:['Visita al cementerio','Ofrendas florales','Vigilia comunitaria'], imagen:'https://picsum.photos/seed/todossantos/800/500', galeria:['https://picsum.photos/seed/santos1/600/400'], destacado:false },
    { id:6, nombre:'Navidad en Capachica', fecha:'25 de Diciembre', mes:12, tipo:'Religiosa', ubicacion:'Capachica', descripcion:'Misa de gallo, cena familiar y la alegría del pueblo junto al Lago Titicaca.', actividades:['Misa de gallo','Cena familiar','Pesebre comunitario'], imagen:'https://picsum.photos/seed/navidad/800/500', galeria:['https://picsum.photos/seed/nav1/600/400'], destacado:false },
  ];
}

const tipos = ['Todos', ...new Set(festividades.map((f: any) => f.tipo).filter(Boolean))];
const NOMBRES_MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const tipoIcon: Record<string,string> = { Religiosa:'⛪', Ceremonial:'☀️', Tradicional:'💃', Cultural:'🎭', Nacional:'🏛️' };
const tipoColor: Record<string,string> = { Religiosa:'#9333ea', Ceremonial:'#f59e0b', Tradicional:'#FF6B35', Cultural:'#3b82f6', Nacional:'#10b981' };
const hasGallery = festividades.some((f: any) => f.galeria && f.galeria.length > 0);
---

<Layout title="Festividades · Capachica Turismo" description="Tradición, fe y cultura viva a orillas del lago más alto del mundo. Descubre las celebraciones ancestrales de Capachica.">

  <!-- HERO -->
  <Fragment slot="hero">
    <span class="section-label">🎉 Festividades · Capachica · Lago Titicaca</span>
    <h1 style="font-family:var(--font-display);font-size:clamp(3rem,7vw,5.5rem);line-height:1.05;color:var(--text-main);margin-bottom:0.4rem;animation:fadeUp 0.8s ease both;">
      Celebraciones <em style="font-style:italic;color:var(--gold);">Ancestrales</em>
    </h1>
    <p style="font-size:clamp(1rem,2vw,1.15rem);color:var(--text-muted);max-width:520px;margin:0.6rem auto 1.4rem;line-height:1.75;animation:fadeUp 0.8s 0.1s ease both;">
      Tradición, fe y cultura viva a orillas del lago más alto del mundo.
      Cada festividad es una ventana al alma del pueblo capachiquense.
    </p>
    <div class="fst-hero-ctas">
      <a href="#festividades" class="btn-primary">🎉 Ver Festividades</a>
      <a href="#calendario" class="btn-outline">📅 Calendario</a>
    </div>
    <div class="fst-hero-stats">
      <div class="fst-stat"><span class="fst-stat-val">{festividades.length}+</span><span class="fst-stat-lbl">Festividades</span></div>
      <div class="fst-stat"><span class="fst-stat-val">12</span><span class="fst-stat-lbl">Meses activos</span></div>
      <div class="fst-stat"><span class="fst-stat-val">500+</span><span class="fst-stat-lbl">Años tradición</span></div>
    </div>
  </Fragment>

  <!-- MAIN CONTENT -->
  <div id="festividades">

    <!-- SECTION HEADER -->
    <div class="fst-section-hdr reveal">
      <div class="fst-eyebrow">Cultura Viva · Capachica</div>
      <h2 class="section-title">Nuestras Festividades</h2>
    </div>

    <!-- FILTER BAR -->
    <div class="fst-filter-bar" id="filterBar">
      <div class="fst-filter-grp">
        <span class="fst-filter-lbl">Mes</span>
        <button class="fst-chip active" data-mes="0">Todos</button>
        {NOMBRES_MESES.map((nombre, i) => {
          const tiene = festividades.some((f: any) => f.mes === i + 1);
          return tiene ? <button class="fst-chip" data-mes={i + 1}>{nombre}</button> : null;
        })}
      </div>
      <div class="fst-filter-grp">
        <span class="fst-filter-lbl">Tipo</span>
        {tipos.map((t, i) => (
          <button class:list={['fst-chip fst-tipo-chip', i===0 && 'active']} data-tipo={t}>{t}</button>
        ))}
      </div>
      <span class="fst-result-count" id="resultCount">{festividades.length} festividades</span>
    </div>

    <!-- FESTIVAL GRID -->
    <div class="fst-grid" id="festGrid">
      {festividades.map((f: any) => (
        <article
          class:list={['fest-card reveal', f.destacado && 'destacado']}
          data-mes={f.mes}
          data-tipo={f.tipo || ''}
        >
          <div class="fest-img-wrap">
            <img class="fest-img" src={f.imagen} alt={f.nombre} loading="lazy" />
            {f.tipo && (
              <span class="fest-badge" style={`background:${tipoColor[f.tipo] || '#666'}22;color:${tipoColor[f.tipo] || '#999'};border:1px solid ${tipoColor[f.tipo] || '#666'}44;`}>
                {tipoIcon[f.tipo] || '🎉'} {f.tipo}
              </span>
            )}
          </div>
          <div class="fest-body">
            <div class="fest-date">📅 {f.fecha || `Mes ${f.mes}`}</div>
            <h3 class="fest-name">{f.nombre}</h3>
            {f.descripcion && <p class="fest-desc">{f.descripcion}</p>}
            {f.actividades && f.actividades.length > 0 && (
              <div class="fest-acts">
                {f.actividades.slice(0, 3).map((a: string) => (
                  <span class="fest-act-pill">{a}</span>
                ))}
              </div>
            )}
            <div class="fest-footer">
              <span class="fest-location">📍 {f.ubicacion || 'Capachica'}</span>
              {f.destacado && <span class="fest-star" title="Festividad destacada">⭐</span>}
            </div>
          </div>
        </article>
      ))}
    </div>
    <div style="padding-bottom:4rem;"></div>
  </div>

  <!-- CALENDAR SECTION -->
  <section class="fst-calendar-section" id="calendario">
    <div class="fst-section-hdr reveal">
      <div class="fst-eyebrow">Planifica tu visita</div>
      <h2 class="section-title">Calendario Festivo</h2>
    </div>
    <div class="fst-cal-grid" id="calendarGrid"></div>
  </section>

  <!-- GALLERY SECTION -->
  {hasGallery && (
    <section class="fst-gallery-section">
      <div style="max-width:1100px;margin:0 auto;">
        <div class="fst-section-hdr reveal">
          <div class="fst-eyebrow">Momentos capturados</div>
          <h2 class="section-title">Galería</h2>
        </div>
        <div class="fst-gallery-grid">
          {festividades.flatMap((f: any) => (f.galeria || []).slice(0, 2).map((img: string) => (
            <div class="fst-gallery-item reveal" data-src={img} data-label={f.nombre}>
              <img src={img} alt={f.nombre} loading="lazy" />
              <div class="fst-gallery-overlay"><span class="fst-gallery-label">{f.nombre}</span></div>
            </div>
          ))).slice(0, 9)}
        </div>
      </div>
    </section>
  )}

  <!-- Gallery modal -->
  <div class="fst-gallery-modal" id="galleryModal">
    <button class="fst-gallery-close" id="galleryClose">×</button>
    <img id="galleryModalImg" src="" alt="" />
    <p id="galleryModalLabel" style="color:rgba(255,255,255,0.65);font-size:13px;margin-top:10px;"></p>
  </div>

  <!-- FLOATING CALENDAR WIDGET -->
  <div class="fst-floating-cal" id="floatingCal">
    <div class="fc-hdr" id="fcHeader">
      <div style="display:flex;align-items:center;gap:6px;"><span>📅</span><span style="font-size:11px;font-weight:700;letter-spacing:0.5px;color:#fff;text-transform:uppercase;">Próxima Festividad</span></div>
      <button class="fc-min" id="fcMinimize">−</button>
    </div>
    <div class="fc-bd">
      <div class="fc-next" id="fcNextFest"></div>
      <div class="fc-mini-cal" id="fcMiniCal"></div>
    </div>
  </div>
  <button class="fc-icon-btn" id="fcIconBtn" aria-label="Abrir calendario">📅</button>

</Layout>

<style is:global>
/* ─── FESTIVIDADES HERO ─── */
.fst-hero-ctas {
  display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;
  margin-bottom: 1.6rem; animation: fadeUp 0.8s 0.2s ease both;
}
.fst-hero-stats {
  display: flex; gap: 0; flex-wrap: wrap;
  background: rgba(10,22,40,0.7); border: 1px solid rgba(45,212,191,0.2);
  border-radius: 12px; backdrop-filter: blur(12px); overflow: hidden;
  animation: fadeUp 0.8s 0.3s ease both;
}
.fst-stat { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px 28px; flex: 1; min-width: 90px; border-right: 1px solid rgba(45,212,191,0.12); }
.fst-stat:last-child { border-right: none; }
.fst-stat-val { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: var(--gold); line-height: 1; }
.fst-stat-lbl { font-size: 0.68rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-top: 3px; }
[data-theme="light"] .fst-hero-stats { background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.32); }
[data-theme="light"] .fst-stat-val { color: #ffd060; }
[data-theme="light"] .fst-stat-lbl { color: rgba(255,255,255,0.7); }

/* ─── SECTION HEADER ─── */
.fst-section-hdr { text-align: center; margin-bottom: 2.5rem; }
.fst-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font-mono); font-size: 10px; letter-spacing: 2.5px;
  text-transform: uppercase; color: rgba(255,107,53,0.85); margin-bottom: 0.75rem;
}
.fst-eyebrow::before { content: ''; display: block; width: 20px; height: 1px; background: rgba(255,107,53,0.6); }
[data-theme="light"] .fst-eyebrow { color: rgba(255,220,160,0.95); }
[data-theme="light"] .fst-eyebrow::before { background: rgba(255,220,160,0.7); }
[data-theme="light"] .section-title { color: #fff; }

/* ─── FILTER BAR ─── */
.fst-filter-bar { max-width: 1100px; margin: 0 auto 2rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: center; }
.fst-filter-grp { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.fst-filter-lbl { font-family: var(--font-mono); font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(240,237,232,0.38); padding-right: 4px; }
[data-theme="light"] .fst-filter-lbl { color: rgba(255,255,255,0.55); }
.fst-chip {
  padding: 6px 14px; border-radius: 20px; font-size: 12.5px; font-weight: 600;
  border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.05);
  color: rgba(240,237,232,0.62); cursor: pointer; transition: all 0.2s;
  font-family: var(--font-mono); letter-spacing: 0.5px;
}
.fst-chip:hover { border-color: rgba(255,107,53,0.5); color: rgba(255,140,90,0.95); }
.fst-chip.active { background: linear-gradient(135deg,rgba(255,107,53,0.22),rgba(255,107,53,0.08)); border-color: rgba(255,107,53,0.6); color: #FF8C5A; }
[data-theme="light"] .fst-chip { border-color: rgba(255,255,255,0.28); color: rgba(255,255,255,0.75); }
[data-theme="light"] .fst-chip:hover { background: rgba(255,255,255,0.12); color: #fff; }
[data-theme="light"] .fst-chip.active { background: rgba(255,255,255,0.2); border-color: rgba(255,255,255,0.7); color: #fff; }
.fst-result-count { font-size: 12px; color: rgba(240,237,232,0.5); font-family: var(--font-mono); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 5px 12px; }
[data-theme="light"] .fst-result-count { color: rgba(255,255,255,0.75); border-color: rgba(255,255,255,0.25); }

/* ─── FESTIVAL GRID ─── */
.fst-grid {
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
}
@media (max-width: 900px) { .fst-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 580px) { .fst-grid { grid-template-columns: 1fr; } }

.fest-card {
  border-radius: 16px; overflow: hidden;
  background: var(--card-bg); border: 1px solid var(--card-border);
  backdrop-filter: blur(16px); cursor: pointer;
  transition: transform 0.35s cubic-bezier(0.4,0,0.2,1), box-shadow 0.35s, border-color 0.35s;
}
.fest-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 30px rgba(255,107,53,0.12); border-color: rgba(255,107,53,0.35); }
.fest-card.destacado { border-color: rgba(255,107,53,0.3); }
[data-theme="light"] .fest-card:hover { box-shadow: 0 20px 50px rgba(0,0,0,0.18), 0 0 30px rgba(10,150,220,0.15); border-color: rgba(10,120,200,0.45); }
[data-theme="light"] .fest-card.destacado { border-color: rgba(10,150,220,0.35); }

.fest-img-wrap { overflow: hidden; position: relative; }
.fest-img { width: 100%; height: 180px; object-fit: cover; display: block; transition: transform 0.5s; }
.fest-card:hover .fest-img { transform: scale(1.05); }
.fest-badge { position: absolute; top: 10px; right: 10px; padding: 4px 10px; border-radius: 20px; font-size: 10.5px; font-weight: 700; font-family: var(--font-mono); letter-spacing: 0.5px; backdrop-filter: blur(8px); }
.fest-body { padding: 1.2rem 1.3rem 1.3rem; }
.fest-date { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: rgba(255,107,53,0.85); text-transform: uppercase; margin-bottom: 0.5rem; }
[data-theme="light"] .fest-date { color: rgba(194,90,24,0.9); }
.fest-name { font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.6rem; line-height: 1.3; }
.fest-desc { font-size: 13.5px; color: var(--text-muted); line-height: 1.65; margin-bottom: 0.9rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.fest-acts { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 0.85rem; }
.fest-act-pill { padding: 3px 9px; border-radius: 20px; font-size: 11px; background: rgba(255,107,53,0.1); border: 1px solid rgba(255,107,53,0.2); color: rgba(255,140,90,0.85); }
[data-theme="light"] .fest-act-pill { background: rgba(194,90,24,0.1); border-color: rgba(194,90,24,0.25); color: rgba(150,60,10,0.9); }
.fest-footer { display: flex; align-items: center; justify-content: space-between; padding-top: 0.75rem; border-top: 1px solid rgba(255,255,255,0.06); font-size: 12px; color: var(--text-muted); }
[data-theme="light"] .fest-footer { border-top-color: rgba(0,0,0,0.07); }
.fest-star { color: var(--gold); font-size: 13px; }

/* ─── CALENDAR SECTION ─── */
.fst-calendar-section { padding: 5rem 2rem 4rem; background: linear-gradient(180deg, #091224 0%, #070D1A 100%); position: relative; }
[data-theme="light"] .fst-calendar-section { background: linear-gradient(180deg, #00a0b5 0%, #005f73 100%); }
.fst-cal-grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
@media (max-width: 900px) { .fst-cal-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 540px) { .fst-cal-grid { grid-template-columns: 1fr; } }

.cal-month-card { border-radius: 14px; padding: 1rem; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07); transition: border-color 0.2s, background 0.2s; }
.cal-month-card.current { background: rgba(255,107,53,0.07); border-color: rgba(255,107,53,0.25); }
[data-theme="light"] .cal-month-card { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.2); }
[data-theme="light"] .cal-month-card.current { background: rgba(255,255,255,0.22); border-color: rgba(255,255,255,0.5); }
.cal-month-name { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; text-align: center; margin-bottom: 0.6rem; color: rgba(240,237,232,0.55); }
.cal-month-card.current .cal-month-name { color: #FF8C5A; }
[data-theme="light"] .cal-month-name { color: rgba(255,255,255,0.7); }
[data-theme="light"] .cal-month-card.current .cal-month-name { color: #fff; }
.cal-table { width: 100%; border-collapse: collapse; font-size: 0.65rem; text-align: center; }
.cal-table th { color: rgba(255,255,255,0.28); font-weight: 600; padding: 2px; font-family: var(--font-mono); }
[data-theme="light"] .cal-table th { color: rgba(255,255,255,0.5); }
.cal-day { padding: 2px; color: rgba(255,255,255,0.38); }
[data-theme="light"] .cal-day { color: rgba(255,255,255,0.65); }
.cal-day.today { background: #FF6B35; color: #fff; font-weight: 700; border-radius: 50%; display: inline-flex; width: 18px; height: 18px; align-items: center; justify-content: center; }
.cal-day.has-fest { background: rgba(255,107,53,0.22); color: #FF8C5A; font-weight: 700; border-radius: 50%; display: inline-flex; width: 18px; height: 18px; align-items: center; justify-content: center; cursor: pointer; }
[data-theme="light"] .cal-day.has-fest { background: rgba(255,255,255,0.3); color: #fff; }
.cal-fest-list { margin-top: 0.6rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 0.5rem; }
.cal-fest-item { font-size: 0.6rem; color: rgba(255,255,255,0.42); padding: 2px 0; display: flex; align-items: center; gap: 4px; }
[data-theme="light"] .cal-fest-item { color: rgba(255,255,255,0.7); }

/* ─── GALLERY ─── */
.fst-gallery-section { padding: 5rem 2rem 4rem; }
.fst-gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
@media (max-width: 700px) { .fst-gallery-grid { grid-template-columns: repeat(2, 1fr); } }
.fst-gallery-item { border-radius: 12px; overflow: hidden; position: relative; cursor: pointer; aspect-ratio: 4/3; border: 1px solid rgba(255,255,255,0.08); }
.fst-gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s; }
.fst-gallery-item:hover img { transform: scale(1.08); }
.fst-gallery-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.65), transparent); opacity: 0; transition: opacity 0.3s; display: flex; align-items: flex-end; padding: 12px; }
.fst-gallery-item:hover .fst-gallery-overlay { opacity: 1; }
.fst-gallery-label { font-size: 12px; color: #fff; font-weight: 600; }
.fst-gallery-modal { position: fixed; inset: 0; z-index: 2000; background: rgba(0,0,0,0.92); backdrop-filter: blur(10px); display: none; align-items: center; justify-content: center; flex-direction: column; }
.fst-gallery-modal.open { display: flex; }
.fst-gallery-modal img { max-width: 90vw; max-height: 82vh; border-radius: 12px; object-fit: contain; }
.fst-gallery-close { position: absolute; top: 20px; right: 24px; font-size: 28px; color: #fff; background: none; border: none; cursor: pointer; opacity: 0.75; transition: opacity 0.2s; }
.fst-gallery-close:hover { opacity: 1; }

/* ─── FLOATING CALENDAR ─── */
.fst-floating-cal { position: fixed; bottom: 24px; right: 24px; width: 270px; z-index: 1500; border-radius: 18px; overflow: hidden; background: rgba(7,13,26,0.94); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(22px); box-shadow: 0 12px 40px rgba(0,0,0,0.5); user-select: none; }
.fst-floating-cal.hidden { display: none !important; }
.fc-hdr { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; cursor: grab; background: linear-gradient(135deg, #FF6B35, #FF8C5A); }
.fc-min { width: 22px; height: 22px; border-radius: 50%; background: rgba(255,255,255,0.22); border: none; cursor: pointer; color: #fff; font-size: 14px; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
.fc-min:hover { background: rgba(255,255,255,0.4); }
.fc-bd { padding: 14px; }
.fc-next { text-align: center; margin-bottom: 10px; }
.fc-next-icon { font-size: 2rem; margin-bottom: 4px; }
.fc-next-name { font-weight: 700; font-size: 13px; color: #fff; margin-bottom: 2px; }
.fc-next-date { font-size: 11px; color: rgba(255,255,255,0.5); margin-bottom: 4px; }
.fc-days-left { font-size: 2rem; font-weight: 900; color: #FF6B35; line-height: 1; }
.fc-days-label { font-size: 9.5px; color: rgba(255,255,255,0.38); }
.fc-mini-cal { margin-top: 8px; }
.fc-mini-table { width: 100%; border-collapse: collapse; font-size: 0.6rem; text-align: center; }
.fc-mini-table th { color: rgba(255,255,255,0.3); padding: 2px; }
.fc-mini-day { padding: 2px; color: rgba(255,255,255,0.45); }
.fc-mini-today { background: #FF6B35; color: #fff; font-weight: 700; border-radius: 50%; display: inline-flex; width: 17px; height: 17px; align-items: center; justify-content: center; }
.fc-mini-fest { background: rgba(255,107,53,0.25); color: #FF8C5A; font-weight: 700; border-radius: 50%; display: inline-flex; width: 17px; height: 17px; align-items: center; justify-content: center; }
.fc-icon-btn { position: fixed; bottom: 24px; right: 24px; width: 52px; height: 52px; border-radius: 50%; border: none; cursor: pointer; font-size: 22px; z-index: 1499; background: linear-gradient(135deg, #FF6B35, #FF8C5A); box-shadow: 0 4px 18px rgba(255,107,53,0.45); display: none; align-items: center; justify-content: center; animation: fst-float 3s ease-in-out infinite; }
.fc-icon-btn.visible { display: flex; }
@keyframes fst-float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-5px)} }

/* main bg for festividades */
[data-theme="light"] main { background: linear-gradient(180deg, #005f73 0%, #007288 35%, #008899 65%, #00a0b5 100%); }
</style>

<script is:inline>
var FEST_DATA = [
  { id:'epifania',      nombre:'Epifanía',                mes:1,  dia:6,  icono:'👑' },
  { id:'candelaria',    nombre:'Virgen de la Candelaria', mes:2,  dia:2,  icono:'🕯️' },
  { id:'carnavales',    nombre:'Carnavales de Capachica', mes:2,  dia:20, icono:'🎭' },
  { id:'fiesta-cruz',   nombre:'Fiesta de la Cruz',       mes:5,  dia:3,  icono:'✝️' },
  { id:'corpus-christi',nombre:'Corpus Christi',          mes:6,  dia:19, icono:'⛪' },
  { id:'inti-raymi',    nombre:'Inti Raymi',               mes:6,  dia:21, icono:'☀️' },
  { id:'san-juan',      nombre:'San Juan Bautista',       mes:6,  dia:24, icono:'🔥' },
  { id:'llachon',       nombre:'Aniv. Llachón',           mes:7,  dia:28, icono:'🏘️' },
  { id:'pachamama',     nombre:'Pachamama Raymi',         mes:8,  dia:1,  icono:'🌍' },
  { id:'asuncion',      nombre:'Virgen de la Asunción',   mes:8,  dia:15, icono:'🕊️' },
  { id:'primavera',     nombre:'Fiesta de la Primavera',  mes:9,  dia:21, icono:'🌸' },
  { id:'milagros',      nombre:'Señor de los Milagros',   mes:10, dia:18, icono:'✝️' },
  { id:'todos-santos',  nombre:'Día de Todos los Santos', mes:11, dia:1,  icono:'🕯️' },
  { id:'difuntos',      nombre:'Día de los Difuntos',     mes:11, dia:2,  icono:'🪔' },
  { id:'inmaculada',    nombre:'Inmaculada Concepción',   mes:12, dia:8,  icono:'🌟' },
  { id:'navidad',       nombre:'Navidad en Capachica',    mes:12, dia:25, icono:'🎄' },
];
var MESES_NOMBRES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
var DIAS_CORTOS = ['Do','Lu','Ma','Mi','Ju','Vi','Sa'];

/* ── FESTIVAL FILTER ── */
(function() {
  var monthChips = document.querySelectorAll('.fst-chip:not(.fst-tipo-chip)');
  var tipoChips  = document.querySelectorAll('.fst-tipo-chip');
  var cards = document.querySelectorAll('.fest-card');
  var resultCount = document.getElementById('resultCount');
  var activeMes = 0, activeTipo = 'Todos';

  function applyFilter() {
    var count = 0;
    cards.forEach(function(card) {
      var mes = parseInt(card.dataset.mes || '0');
      var tipo = card.dataset.tipo || '';
      var show = (activeMes === 0 || mes === activeMes) && (activeTipo === 'Todos' || tipo === activeTipo);
      card.style.display = show ? '' : 'none';
      if (show) count++;
    });
    if (resultCount) resultCount.textContent = count + ' festividade' + (count !== 1 ? 's' : '');
  }

  monthChips.forEach(function(chip) {
    chip.addEventListener('click', function() {
      monthChips.forEach(function(c){ c.classList.remove('active'); });
      chip.classList.add('active');
      activeMes = parseInt(chip.dataset.mes || '0');
      applyFilter();
    });
  });
  tipoChips.forEach(function(chip) {
    chip.addEventListener('click', function() {
      tipoChips.forEach(function(c){ c.classList.remove('active'); });
      chip.classList.add('active');
      activeTipo = chip.dataset.tipo || 'Todos';
      applyFilter();
    });
  });
})();

/* ── 12-MONTH CALENDAR ── */
(function() {
  var grid = document.getElementById('calendarGrid');
  if (!grid) return;
  var now = new Date();
  var year = now.getFullYear();
  var currentMonth = now.getMonth();
  var today = now.getDate();

  for (var m = 0; m < 12; m++) {
    var isCurrent = m === currentMonth;
    var firstDay = new Date(year, m, 1).getDay();
    var daysInMonth = new Date(year, m + 1, 0).getDate();
    var festMonth = FEST_DATA.filter(function(f){ return f.mes === m + 1; });

    var card = document.createElement('div');
    card.className = 'cal-month-card reveal' + (isCurrent ? ' current' : '');

    var html = '<div class="cal-month-name">' + MESES_NOMBRES[m] + ' ' + year + '</div>';
    html += '<table class="cal-table"><thead><tr>';
    DIAS_CORTOS.forEach(function(d){ html += '<th>' + d + '</th>'; });
    html += '</tr></thead><tbody><tr>';

    var col = 0;
    for (var i = 0; i < firstDay; i++) { html += '<td></td>'; col++; }
    for (var d = 1; d <= daysInMonth; d++) {
      var isToday = isCurrent && d === today;
      var fest = festMonth.find(function(f){ return f.dia === d; });
      var cls = 'cal-day';
      if (isToday) cls += ' today';
      else if (fest) cls += ' has-fest';
      html += '<td><span class="' + cls + '" title="' + (fest ? fest.icono + ' ' + fest.nombre : '') + '">' + d + '</span></td>';
      col++;
      if (col % 7 === 0 && d < daysInMonth) { html += '</tr><tr>'; col = 0; }
    }
    html += '</tr></tbody></table>';

    if (festMonth.length > 0) {
      html += '<div class="cal-fest-list">';
      festMonth.forEach(function(f){ html += '<div class="cal-fest-item"><span>' + f.icono + '</span><span>' + f.nombre + ' (' + f.dia + ')</span></div>'; });
      html += '</div>';
    }
    card.innerHTML = html;
    grid.appendChild(card);
  }
})();

/* ── FLOATING CALENDAR ── */
(function() {
  var fc = document.getElementById('floatingCal');
  var iconBtn = document.getElementById('fcIconBtn');
  var minimize = document.getElementById('fcMinimize');
  var nextFestEl = document.getElementById('fcNextFest');
  var miniCalEl = document.getElementById('fcMiniCal');

  var now = new Date();
  var year = now.getFullYear();
  var today = new Date(year, now.getMonth(), now.getDate());

  var upcoming = FEST_DATA.map(function(f) {
    var d = new Date(year, f.mes - 1, f.dia);
    if (d < today) d = new Date(year + 1, f.mes - 1, f.dia);
    return Object.assign({}, f, { daysLeft: Math.ceil((d - today) / 86400000), date: d });
  }).sort(function(a, b){ return a.daysLeft - b.daysLeft; });
  var next = upcoming[0];

  if (next && nextFestEl) {
    nextFestEl.innerHTML = '<div class="fc-next-icon">' + next.icono + '</div><div class="fc-next-name">' + next.nombre + '</div><div class="fc-next-date">' + next.date.toLocaleDateString('es-PE',{day:'numeric',month:'long'}) + '</div><div class="fc-days-left">' + next.daysLeft + '</div><div class="fc-days-label">días restantes</div>';
  }

  if (miniCalEl) {
    var m = now.getMonth(); var d0 = now.getDate();
    var firstDay = new Date(year, m, 1).getDay();
    var daysInMonth = new Date(year, m + 1, 0).getDate();
    var festDays = FEST_DATA.filter(function(f){ return f.mes === m + 1; }).map(function(f){ return f.dia; });
    var html = '<table class="fc-mini-table"><thead><tr>';
    DIAS_CORTOS.forEach(function(d){ html += '<th>' + d + '</th>'; });
    html += '</tr></thead><tbody><tr>';
    var col = 0;
    for (var i = 0; i < firstDay; i++) { html += '<td></td>'; col++; }
    for (var d = 1; d <= daysInMonth; d++) {
      var isToday2 = d === d0;
      var hasFest = festDays.indexOf(d) >= 0;
      var cls = isToday2 ? 'fc-mini-today' : hasFest ? 'fc-mini-fest' : 'fc-mini-day';
      html += '<td><span class="' + cls + '">' + d + '</span></td>';
      col++;
      if (col % 7 === 0) html += '</tr><tr>';
    }
    html += '</tr></tbody></table>';
    miniCalEl.innerHTML = html;
  }

  minimize && minimize.addEventListener('click', function() {
    fc && fc.classList.add('hidden');
    iconBtn && iconBtn.classList.add('visible');
  });
  iconBtn && iconBtn.addEventListener('click', function() {
    iconBtn.classList.remove('visible');
    fc && fc.classList.remove('hidden');
  });

  var dragging = false, ox = 0, oy = 0;
  var fcHeader = document.getElementById('fcHeader');
  function startDrag(cx, cy) { dragging = true; var r = fc.getBoundingClientRect(); ox = cx - r.left; oy = cy - r.top; }
  function moveDrag(cx, cy) { if (!dragging || !fc) return; fc.style.left = (cx-ox)+'px'; fc.style.top = (cy-oy)+'px'; fc.style.right='auto'; fc.style.bottom='auto'; }
  function endDrag() { dragging = false; }
  fcHeader && fcHeader.addEventListener('mousedown', function(e){ startDrag(e.clientX, e.clientY); });
  document.addEventListener('mousemove', function(e){ moveDrag(e.clientX, e.clientY); });
  document.addEventListener('mouseup', endDrag);
  fcHeader && fcHeader.addEventListener('touchstart', function(e){ var t=e.touches[0]; startDrag(t.clientX, t.clientY); }, {passive:true});
  document.addEventListener('touchmove', function(e){ if(!dragging) return; var t=e.touches[0]; moveDrag(t.clientX, t.clientY); }, {passive:true});
  document.addEventListener('touchend', endDrag);
})();

/* ── GALLERY MODAL ── */
(function() {
  var modal = document.getElementById('galleryModal');
  var modalImg = document.getElementById('galleryModalImg');
  var modalLabel = document.getElementById('galleryModalLabel');
  var closeBtn = document.getElementById('galleryClose');
  document.querySelectorAll('.fst-gallery-item').forEach(function(item) {
    item.addEventListener('click', function() {
      if (!modal || !modalImg) return;
      modalImg.src = item.dataset.src || (item.querySelector('img') && item.querySelector('img').src) || '';
      if (modalLabel) modalLabel.textContent = item.dataset.label || '';
      modal.classList.add('open');
    });
  });
  closeBtn && closeBtn.addEventListener('click', function(){ modal && modal.classList.remove('open'); });
  modal && modal.addEventListener('click', function(e){ if (e.target === modal) modal.classList.remove('open'); });
})();
</script>
