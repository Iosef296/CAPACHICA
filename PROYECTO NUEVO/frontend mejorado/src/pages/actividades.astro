<script define:vars={{ API_URL }} is:inline>
/* ── FILTERS ── */
var activeCat = 'all';
document.querySelectorAll('.act-pill').forEach(function(pill) {
  pill.addEventListener('click', function() {
    document.querySelectorAll('.act-pill').forEach(function(p){ p.classList.remove('active'); });
    pill.classList.add('active');
    activeCat = pill.dataset.cat;
    applyFilters();
  });
});
document.getElementById('diffFilter').addEventListener('change', applyFilters);
document.getElementById('durFilter').addEventListener('change', applyFilters);
document.getElementById('priceFilter').addEventListener('change', applyFilters);

function applyFilters() {
  var diff = document.getElementById('diffFilter').value;
  var dur  = document.getElementById('durFilter').value;
  var price = document.getElementById('priceFilter').value;
  var count = 0;
  document.querySelectorAll('.act-card').forEach(function(card) {
    var p = parseInt(card.dataset.price);
    var ok = (activeCat === 'all' || card.dataset.cat === activeCat)
          && (diff  === 'all' || card.dataset.diff === diff)
          && (dur   === 'all' || card.dataset.dur  === dur)
          && (price === 'all'
              || (price === 'cheap'   && p <= 40)
              || (price === 'mid'     && p > 40 && p <= 80)
              || (price === 'premium' && p > 80));
    card.classList.toggle('hidden', !ok);
    if (ok) count++;
  });
  document.getElementById('countNum').textContent = count;
}

/* ── PACKAGE ── */
var pkgItems = [], persons = 1;

function addToPackage(btn) {
  var card = btn.closest('.act-card');
  var name = card.dataset.name, price = parseInt(card.dataset.price);
  if (pkgItems.find(function(i){ return i.name === name; })) {
    btn.textContent = '✓ Agregado'; btn.classList.add('added'); return;
  }
  pkgItems.push({ name: name, price: price });
  btn.textContent = '✓ En paquete'; btn.classList.add('added');
  renderPkg();
  if (pkgItems.length === 1) openPkg();
  updateFab();
}

function renderPkg() {
  var list = document.getElementById('pkgList');
  var empty = document.getElementById('pkgEmpty');
  empty.style.display = pkgItems.length ? 'none' : 'block';
  list.innerHTML = pkgItems.map(function(item, i) {
    return '<div class="pkg-item"><span class="pkg-item-name">'+item.name+'</span><span class="pkg-item-price">S/.'+item.price+'</span><button class="pkg-item-remove" onclick="removePkg('+i+')">✕</button></div>';
  }).join('');
  calcTotal();
}

function removePkg(i) {
  var name = pkgItems[i].name; pkgItems.splice(i, 1);
  document.querySelectorAll('.act-card').forEach(function(card) {
    if (card.dataset.name === name) {
      var btn = card.querySelector('.btn-add');
      btn.textContent = '+ Paquete'; btn.classList.remove('added');
    }
  });
  renderPkg(); updateFab();
}

function calcTotal() {
  var sum = pkgItems.reduce(function(a,b){ return a + b.price; }, 0);
  document.getElementById('pkgTotal').textContent = sum * persons;
}

function changePeople(d) {
  persons = Math.max(1, Math.min(20, persons + d));
  document.getElementById('personCount').textContent = persons;
  calcTotal();
}

function openPkg()   { document.getElementById('pkgSidebar').classList.add('open'); }
function closePkg()  { document.getElementById('pkgSidebar').classList.remove('open'); }
function togglePkg() { document.getElementById('pkgSidebar').classList.toggle('open'); }

function updateFab() {
  var badge = document.getElementById('pkgBadge');
  badge.textContent = pkgItems.length;
  badge.style.display = pkgItems.length ? 'flex' : 'none';
}

/* ── MODAL ── */
function openModal(name, price, isPkg) {
  document.getElementById('modalActivity').value = name;
  document.getElementById('modalPrice').textContent = isPkg
    ? pkgItems.reduce(function(a,b){ return a+b.price; }, 0) * persons : price;
  document.getElementById('modalSubtitle').textContent = isPkg
    ? 'Paquete de ' + pkgItems.length + ' actividades · ' + persons + ' persona(s)' : name;
  document.getElementById('modalDate').min = new Date().toISOString().split('T')[0];
  document.getElementById('modalOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeModal(e) {
  if (!e || e.target === document.getElementById('modalOverlay')) {
    document.getElementById('modalOverlay').classList.remove('open');
    document.body.style.overflow = '';
  }
}

async function submitReserva() {
  var nombreEl   = document.getElementById('mNombre');
  var emailEl    = document.getElementById('mEmail');
  var fechaEl    = document.getElementById('modalDate');
  var personasEl = document.getElementById('mPersonas');
  var actividad  = document.getElementById('modalActivity').value;
  var nombre = nombreEl.value.trim(), email = emailEl.value.trim(), fecha = fechaEl.value;

  [nombreEl, emailEl, fechaEl].forEach(function(el){ el.classList.remove('input-error'); });
  var valid = true;
  if (!nombre) { nombreEl.classList.add('input-error'); valid = false; }
  if (!email || !email.includes('@')) { emailEl.classList.add('input-error'); valid = false; }
  if (!fecha) { fechaEl.classList.add('input-error'); valid = false; }
  if (!valid) { showToast('⚠️ Completa los campos requeridos'); return; }

  var btn = document.querySelector('.btn-submit');
  var orig = btn.textContent; btn.textContent = '⏳ Enviando...'; btn.disabled = true;
  try {
    var precio = parseInt(document.getElementById('modalPrice').textContent) || 0;
    var esPaquete = actividad.includes('Paquete') || actividad.includes('paquete');
    var res = await fetch(API_URL + '/reservas', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ nombre: nombre, email: email, fecha_visita: fecha, personas: parseInt(personasEl.value) || 1, actividad: actividad, precio_total: precio, es_paquete: esPaquete, actividades_paquete: esPaquete ? pkgItems : null }),
    });
    var data = await res.json();
    if (data.success) {
      document.getElementById('modalOverlay').classList.remove('open');
      document.body.style.overflow = '';
      showToast('🎉 ¡Reserva guardada! ID: ' + (data.reserva_id ? data.reserva_id.slice(0,8).toUpperCase() : '—'));
      if (esPaquete) { pkgItems = []; renderPkg(); updateFab(); }
      [nombreEl, emailEl, fechaEl].forEach(function(el){ el.value = ''; });
    } else { showToast('❌ ' + (data.error || 'Error al guardar')); }
  } catch(err) { showToast('❌ Error de conexión. Verifica que el servidor esté activo.'); }
  finally { btn.textContent = orig; btn.disabled = false; }
}

function showToast(msg) {
  var t = document.getElementById('toast');
  if (!t) {
    t = document.createElement('div'); t.id = 'toast';
    t.style.cssText = 'position:fixed;bottom:90px;left:50%;transform:translateX(-50%) translateY(16px);background:rgba(10,22,40,0.97);border:1px solid rgba(45,212,191,0.35);border-radius:12px;padding:13px 22px;font-size:15px;color:#f0ede8;opacity:0;pointer-events:none;transition:all 0.4s;z-index:600;backdrop-filter:blur(12px);white-space:nowrap;';
    document.body.appendChild(t);
  }
  t.textContent = msg; t.style.opacity = '1'; t.style.transform = 'translateX(-50%) translateY(0)';
  clearTimeout(t._timer);
  t._timer = setTimeout(function(){ t.style.opacity = '0'; t.style.transform = 'translateX(-50%) translateY(16px)'; }, 3800);
}
</script>
