---
import Layout from '../layouts/Layout.astro';
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api';
---

<Layout title="Actividades · Capachica Turismo" description="Aventura, cultura y naturaleza a orillas del lago más alto del mundo. Kayak, senderismo, cocina andina y más.">

  <!-- HERO -->
  <Fragment slot="hero">
    <span class="section-label">Actividades · Capachica · 3,812 msnm</span>
    <h1 style="font-family:var(--font-display);font-size:clamp(3rem,7vw,5.5rem);line-height:1.05;color:var(--text-main);margin-bottom:0.4rem;animation:fadeUp 0.8s ease both;">
      Nuestras <em style="font-style:italic;color:var(--gold);">Actividades</em>
    </h1>
    <p style="font-size:clamp(1rem,2vw,1.15rem);color:var(--text-muted);max-width:520px;margin:0.6rem auto 1.6rem;line-height:1.75;animation:fadeUp 0.8s 0.1s ease both;">
      Aventura, cultura y naturaleza a orillas del lago más alto del mundo.
      Cada actividad es una ventana al alma del Titicaca.
    </p>
    <div class="act-hero-stats">
      <div class="act-stat"><span class="act-stat-val">15+</span><span class="act-stat-lbl">Actividades</span></div>
      <div class="act-stat"><span class="act-stat-val">3,812</span><span class="act-stat-lbl">msnm</span></div>
      <div class="act-stat"><span class="act-stat-val">4.9 ★</span><span class="act-stat-lbl">Valoración</span></div>
      <div class="act-stat"><span class="act-stat-val">Todo</span><span class="act-stat-lbl">El año</span></div>
    </div>
  </Fragment>

  <!-- MAIN CONTENT -->
  <!-- FILTERS -->
  <section class="act-filter-section">
    <div class="act-filter-header reveal">
      <div>
        <div class="act-eyebrow">Experiencias únicas</div>
        <h2 class="section-title">Elige tu aventura</h2>
      </div>
      <div class="act-result-count"><span id="countNum">15</span> actividades</div>
    </div>
    <div class="act-pills reveal">
      <button class="act-pill active" data-cat="all"><span>🌊</span> Todas</button>
      <button class="act-pill" data-cat="aquatic"><span>🚣</span> Acuáticas</button>
      <button class="act-pill" data-cat="terrestrial"><span>🏔️</span> Terrestres</button>
      <button class="act-pill" data-cat="cultural"><span>🎨</span> Culturales</button>
      <button class="act-pill" data-cat="gastro"><span>🍽️</span> Gastronómicas</button>
    </div>
    <div class="act-filter-selects reveal">
      <select class="act-select" id="diffFilter">
        <option value="all">Dificultad: Todas</option>
        <option value="easy">Fácil</option>
        <option value="medium">Moderada</option>
        <option value="hard">Exigente</option>
      </select>
      <select class="act-select" id="durFilter">
        <option value="all">Duración: Todas</option>
        <option value="2h">2 horas</option>
        <option value="half">Medio día</option>
        <option value="full">Día completo</option>
      </select>
      <select class="act-select" id="priceFilter">
        <option value="all">Precio: Todos</option>
        <option value="cheap">Hasta S/.40</option>
        <option value="mid">S/.40 – S/.80</option>
        <option value="premium">Más de S/.80</option>
      </select>
    </div>
  </section>

  <!-- ACTIVITIES GRID -->
  <section class="act-grid-section">
    <div class="act-grid" id="activitiesGrid">

      <div class="act-card cat-aquatic reveal" data-cat="aquatic" data-diff="medium" data-dur="half" data-price="60" data-name="Kayak en el Titicaca">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🚣</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Acuático</span><span class="atag atag-med">Moderado</span></div>
          <h3 class="act-title">Kayak en el Titicaca</h3>
          <p class="act-desc">Navega las aguas sagradas del lago más alto del mundo en kayak, rodeado de totorales y el silencio del altiplano.</p>
          <div class="act-meta"><span>⏱️ Medio día</span><span>👤 Mín. 10 años</span><span>🎒 Equipo incluido</span></div>
          <div class="act-footer">
            <div class="act-price">S/.60 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Kayak en el Titicaca',60)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-terrestrial reveal" data-cat="terrestrial" data-diff="medium" data-dur="full" data-price="55" data-name="Ciclismo Panorámico 35km">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🚴</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Terrestre</span><span class="atag atag-med">Moderado</span></div>
          <h3 class="act-title">Ciclismo Panorámico 35km</h3>
          <p class="act-desc">Recorre la peninsula entera en bicicleta con vistas impresionantes al lago Titicaca, comunidades y campos de quinua.</p>
          <div class="act-meta"><span>⏱️ Día completo</span><span>👤 Mín. 14 años</span><span>🚲 Bici incluida</span></div>
          <div class="act-footer">
            <div class="act-price">S/.55 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Ciclismo Panorámico 35km',55)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-aquatic reveal" data-cat="aquatic" data-diff="easy" data-dur="2h" data-price="35" data-name="Pesca Artesanal al Amanecer">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🎣</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Acuático</span><span class="atag atag-easy">Fácil</span></div>
          <h3 class="act-title">Pesca Artesanal al Amanecer</h3>
          <p class="act-desc">Acompaña a pescadores locales en sus balsas de totora al rayar el alba. La trucha del Titicaca como protagonista.</p>
          <div class="act-meta"><span>⏱️ 2-3 horas</span><span>👤 Mín. 6 años</span><span>🌅 Sale 5am</span></div>
          <div class="act-footer">
            <div class="act-price">S/.35 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Pesca Artesanal al Amanecer',35)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-terrestrial reveal" data-cat="terrestrial" data-diff="hard" data-dur="full" data-price="45" data-name="Senderismo al Mirador del Amaru">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🥾</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Terrestre</span><span class="atag atag-hard">Exigente</span></div>
          <h3 class="act-title">Senderismo al Mirador del Amaru</h3>
          <p class="act-desc">Asciende hasta 4,000 msnm con guía local. Vistas panorámicas 360° del Titicaca, la península y la cordillera boliviana.</p>
          <div class="act-meta"><span>⏱️ Día completo</span><span>👤 Mín. 12 años</span><span>🧗 Guía incluido</span></div>
          <div class="act-footer">
            <div class="act-price">S/.45 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Senderismo al Mirador del Amaru',45)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-terrestrial reveal" data-cat="terrestrial" data-diff="easy" data-dur="half" data-price="30" data-name="Avistamiento de Aves">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🦅</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Terrestre</span><span class="atag atag-easy">Fácil</span></div>
          <h3 class="act-title">Avistamiento de Aves</h3>
          <p class="act-desc">Descubre el flamenco andino, el pato de los torrentes y más de 60 especies que habitan los totorales del Titicaca.</p>
          <div class="act-meta"><span>⏱️ Medio día</span><span>👤 Todas las edades</span><span>🔭 Binoculares incl.</span></div>
          <div class="act-footer">
            <div class="act-price">S/.30 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Avistamiento de Aves',30)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-cultural reveal" data-cat="cultural" data-diff="easy" data-dur="2h" data-price="35" data-name="Taller de Tejido de Alpaca">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🧶</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Cultural</span><span class="atag atag-easy">Fácil</span></div>
          <h3 class="act-title">Taller de Tejido de Alpaca</h3>
          <p class="act-desc">Aprende la técnica milenaria del telar de cintura con artesanas de la comunidad. Te llevas la pieza que creas.</p>
          <div class="act-meta"><span>⏱️ 2-3 horas</span><span>👤 Todas las edades</span><span>🎁 Pieza incluida</span></div>
          <div class="act-footer">
            <div class="act-price">S/.35 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Taller de Tejido de Alpaca',35)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-gastro reveal" data-cat="gastro" data-diff="easy" data-dur="half" data-price="50" data-name="Taller de Cocina Andina">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🫕</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Gastronómico</span><span class="atag atag-easy">Fácil</span></div>
          <h3 class="act-title">Taller de Cocina Andina</h3>
          <p class="act-desc">Prepara trucha al ají amarillo, chairo y quinua con madres de familia locales en fogón de leña. Almuerzo incluido.</p>
          <div class="act-meta"><span>⏱️ Medio día</span><span>👤 Todas las edades</span><span>🍽️ Almuerzo incl.</span></div>
          <div class="act-footer">
            <div class="act-price">S/.50 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Taller de Cocina Andina',50)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-terrestrial reveal" data-cat="terrestrial" data-diff="easy" data-dur="2h" data-price="40" data-name="Noche de Estrellas 3812m">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🔭</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Terrestre</span><span class="atag atag-easy">Fácil</span></div>
          <h3 class="act-title">Noche de Estrellas 3,812m</h3>
          <p class="act-desc">El cielo nocturno del altiplano es inigualable. Telescopios, guía astronómico y mate de coca bajo la Vía Láctea.</p>
          <div class="act-meta"><span>⏱️ 2-3 horas</span><span>🌙 Horario nocturno</span><span>☕ Bebidas incl.</span></div>
          <div class="act-footer">
            <div class="act-price">S/.40 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Noche de Estrellas 3812m',40)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-cultural reveal" data-cat="cultural" data-diff="easy" data-dur="2h" data-price="25" data-name="Clase de Idioma Aimara">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🗣️</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Cultural</span><span class="atag atag-easy">Fácil</span></div>
          <h3 class="act-title">Clase de Idioma Aimara</h3>
          <p class="act-desc">Aprende frases esenciales del aimara, idioma ancestral del altiplano. Saludos, números, colores y palabras del lago.</p>
          <div class="act-meta"><span>⏱️ 2 horas</span><span>👤 Todas las edades</span><span>📖 Manual incluido</span></div>
          <div class="act-footer">
            <div class="act-price">S/.25 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Clase de Idioma Aimara',25)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-cultural reveal" data-cat="cultural" data-diff="easy" data-dur="2h" data-price="30" data-name="Taller de Instrumentos Andinos">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🎵</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Cultural</span><span class="atag atag-easy">Fácil</span></div>
          <h3 class="act-title">Taller de Instrumentos Andinos</h3>
          <p class="act-desc">Zampoña, quena y bombo en manos de músicos de la comunidad. Aprende melodías del lago y te llevas recuerdo sonoro.</p>
          <div class="act-meta"><span>⏱️ 2 horas</span><span>👤 Todas las edades</span><span>🎶 Grabación incl.</span></div>
          <div class="act-footer">
            <div class="act-price">S/.30 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Taller de Instrumentos Andinos',30)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-aquatic reveal" data-cat="aquatic" data-diff="medium" data-dur="half" data-price="70" data-name="Snorkel en el Titicaca">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🤿</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Acuático</span><span class="atag atag-med">Moderado</span></div>
          <h3 class="act-title">Snorkel en el Titicaca</h3>
          <p class="act-desc">Sumerge en las cristalinas aguas del Titicaca y descubre el ecosistema subacuático único de la rana gigante del lago.</p>
          <div class="act-meta"><span>⏱️ Medio día</span><span>👤 Mín. 12 años</span><span>🌊 Traje incluido</span></div>
          <div class="act-footer">
            <div class="act-price">S/.70 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Snorkel en el Titicaca',70)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-cultural reveal" data-cat="cultural" data-diff="easy" data-dur="2h" data-price="35" data-name="Ceremonia Pachamama">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🌿</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Cultural</span><span class="atag atag-easy">Fácil</span></div>
          <h3 class="act-title">Ceremonia Pachamama</h3>
          <p class="act-desc">Participa en el ritual ancestral de ofrenda a la Madre Tierra con un yatiri (sabio andino) a la orilla del lago.</p>
          <div class="act-meta"><span>⏱️ 2 horas</span><span>🌄 Al atardecer</span><span>🙏 Ceremonial</span></div>
          <div class="act-footer">
            <div class="act-price">S/.35 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Ceremonia Pachamama',35)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-gastro reveal" data-cat="gastro" data-diff="easy" data-dur="2h" data-price="30" data-name="Chicha de Jora Artesanal">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">🍺</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Gastronómico</span><span class="atag atag-easy">Fácil</span></div>
          <h3 class="act-title">Chicha de Jora Artesanal</h3>
          <p class="act-desc">Elabora la bebida ceremonial andina con receta de siglos. Maíz, fermentación y tradición viva en manos de la comunidad.</p>
          <div class="act-meta"><span>⏱️ 2 horas</span><span>👤 Mín. 18 años</span><span>🌽 Degustación incl.</span></div>
          <div class="act-footer">
            <div class="act-price">S/.30 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Chicha de Jora Artesanal',30)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-aquatic reveal" data-cat="aquatic" data-diff="easy" data-dur="half" data-price="55" data-name="Amanecer en Bote al Centro del Lago">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">⛵</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Acuático</span><span class="atag atag-easy">Fácil</span></div>
          <h3 class="act-title">Amanecer en Bote al Centro del Lago</h3>
          <p class="act-desc">Navega hasta el corazón del Titicaca en barca de totora y vive el amanecer más mágico de tu vida a 3,812 msnm.</p>
          <div class="act-meta"><span>⏱️ Medio día</span><span>🌅 Sale 5:30am</span><span>☕ Desayuno incl.</span></div>
          <div class="act-footer">
            <div class="act-price">S/.55 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Amanecer en Bote al Centro del Lago',55)">Reservar</button>
          </div>
        </div>
      </div>

      <div class="act-card cat-terrestrial reveal" data-cat="terrestrial" data-diff="easy" data-dur="half" data-price="45" data-name="Tour de Fotografía de Paisajes">
        <div class="act-img"><div class="act-img-bg"></div><span class="act-emoji">📸</span></div>
        <div class="act-body">
          <div class="act-tags"><span class="atag atag-cat">Terrestre</span><span class="atag atag-easy">Fácil</span></div>
          <h3 class="act-title">Tour de Fotografía de Paisajes</h3>
          <p class="act-desc">Guía fotógrafo profesional te lleva a los miradores secretos de Capachica para capturas épicas del Titicaca y la cordillera.</p>
          <div class="act-meta"><span>⏱️ Medio día</span><span>👤 Todas las edades</span><span>📷 Guía prof. incl.</span></div>
          <div class="act-footer">
            <div class="act-price">S/.45 <span>/persona</span></div>
            <button class="btn-add" onclick="addToPackage(this)">+ Paquete</button>
            <button class="btn-reserve" onclick="openModal('Tour de Fotografía de Paisajes',45)">Reservar</button>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- PACKAGE SIDEBAR -->
  <div class="pkg-sidebar" id="pkgSidebar">
    <div class="pkg-header">
      <div class="pkg-title">Mi paquete personalizado</div>
      <button class="pkg-close" onclick="closePkg()">×</button>
    </div>
    <div class="pkg-body" id="pkgBody">
      <div class="pkg-empty" id="pkgEmpty"><div style="font-size:2.5rem;margin-bottom:8px">🎒</div><p>Agrega actividades para armar tu paquete ideal</p></div>
      <div id="pkgList"></div>
    </div>
    <div class="pkg-footer">
      <div class="pkg-persons">
        <label>Personas</label>
        <div class="persons-ctrl">
          <button class="persons-btn" onclick="changePeople(-1)">−</button>
          <span class="persons-val" id="personCount">1</span>
          <button class="persons-btn" onclick="changePeople(1)">+</button>
        </div>
      </div>
      <div class="pkg-total">
        <span class="pkg-total-lbl">Total estimado</span>
        <span class="pkg-total-val">S/.<span id="pkgTotal">0</span></span>
      </div>
      <button class="btn-pkg-reserve" onclick="openModal('Paquete personalizado',0,true)">Reservar paquete →</button>
    </div>
  </div>
  <button class="pkg-fab" id="pkgFab" onclick="togglePkg()" title="Ver mi paquete">
    🎒<span class="pkg-badge" id="pkgBadge">0</span>
  </button>

  <!-- RESERVATION MODAL -->
  <div class="act-modal-overlay" id="modalOverlay" onclick="closeModal(event)">
    <div class="act-modal">
      <div class="modal-hdr">
        <div>
          <div class="modal-ttl">Reservar actividad</div>
          <div class="modal-sub" id="modalSubtitle">Completa los datos para confirmar</div>
        </div>
        <button class="modal-cls" onclick="closeModal()">×</button>
      </div>
      <div class="form-row">
        <div class="form-grp"><label>Nombre completo</label><input type="text" id="mNombre" placeholder="Tu nombre"/></div>
        <div class="form-grp"><label>Email</label><input type="email" id="mEmail" placeholder="tu@email.com"/></div>
      </div>
      <div class="form-row">
        <div class="form-grp"><label>Fecha de visita</label><input type="date" id="modalDate"/></div>
        <div class="form-grp"><label>Personas</label><input type="number" id="mPersonas" min="1" max="30" value="1"/></div>
      </div>
      <div class="form-row">
        <div class="form-grp"><label>Idioma de atención</label><select><option>Español</option><option>English</option><option>Français</option></select></div>
        <div class="form-grp"><label>Actividad</label><input type="text" id="modalActivity" readonly style="color:var(--turquoise)"/></div>
      </div>
      <div class="form-grp"><label>Necesidades especiales</label><textarea rows="2" placeholder="Dieta, accesibilidad, alergias..."></textarea></div>
      <div class="cancel-policy">📋 <strong>Política de cancelación:</strong> Cancelación gratuita hasta 48h antes. Cancelaciones con menos de 24h de anticipación no son reembolsables.</div>
      <div style="text-align:right;margin-bottom:1rem">
