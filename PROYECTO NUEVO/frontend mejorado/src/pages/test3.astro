---
import Layout from '../layouts/Layout.astro';
import HomeSections from '../components/HomeSections';

const IA_URL = import.meta.env.PUBLIC_IA_URL || 'http://localhost:5000';
let cms: any = null;
try { const r = await fetch(`${IA_URL}/api/contenido/index`); if (r.ok) cms = await r.json(); } catch {}
const cmsHero = cms?.secciones?.find((s: any) => s.tipo === 'hero');
const cmsStats = cms?.secciones?.find((s: any) => s.tipo === 'stats');
const statsData = cmsStats?.items || [
  { valor: '8+', label: 'Comunidades' },
  { valor: '3,820', label: 'msnm' },
  { valor: '500+', label: 'Años historia' },
  { valor: '12', label: 'Islas cercanas' },
];

const photos = [
  { src: '/foto-lago.jpg',        alt: 'Lago Titicaca',    tag: 'Destinos',     title: 'Lago Titicaca' },
  { src: '/foto-vivencial.jpg',   alt: 'Turismo vivencial', tag: 'Vivencial',   title: 'Vida en Comunidad' },
  { src: '/foto-actividades.jpg', alt: 'Actividades',       tag: 'Actividades', title: 'Aventura en el Lago' },
  { src: '/foto-festividades.jpg',alt: 'Festividades',      tag: 'Festividades',title: 'Fiestas Ancestrales' },
];
---

<Layout
  title="Test3 — Tira de fotos horizontal"
  description="Test: horizontal photo strip inside hero"
>
  <Fragment slot="hero">
    <div class="idx-badge">Puno · Perú · Lago Titicaca</div>
    <h1 class="hero-title">
      {cmsHero?.titulo ? cmsHero.titulo : <Fragment>Descubre <em>Capachica</em></Fragment>}
    </h1>
    <p class="hero-desc">
      {cmsHero?.subtitulo || 'Una península andina a 3,820 msnm donde el lago más alto del mundo navegable se convierte en horizonte.'}
    </p>
    <div class="hero-ctas">
      <a href="/destinos" class="btn-primary">Explorar destinos →</a>
      <a href="/como-llegar" class="btn-outline">Cómo llegar</a>
    </div>
    <div class="hero-stats">
      {statsData.map((st: any) => (
        <div class="stat-item">
          <div class="stat-val">{st.valor}</div>
          <div class="stat-label">{st.label}</div>
        </div>
      ))}
    </div>

    <!-- PHOTO STRIP — horizontal scroll on mobile, hidden on desktop (uses side cards) -->
    <div class="photo-strip" id="photoStrip">
      {photos.map((p, i) => (
        <div class="ps-card" onclick={`openPS(${i})`}>
          <img src={p.src} alt={p.alt} loading="lazy" />
          <div class="ps-label">
            <span class="ps-tag">{p.tag}</span>
            <span class="ps-title">{p.title}</span>
          </div>
        </div>
      ))}
    </div>

    <nav class="hero-quicknav">
      <a href="/vivencial">🏡 Vivencial</a>
      <a href="/actividades">🏔️ Actividades</a>
      <a href="/gastronomia">🍽️ Gastronomía</a>
      <a href="/festividades">🎊 Festividades</a>
      <a href="/artesania">🧶 Artesanía</a>
      <a href="/destinos">🗺️ Destinos</a>
    </nav>
  </Fragment>

  <!-- side cards desktop only -->
  <Fragment slot="hero-overlay">
    {photos.map((p, i) => (
      <div
        class={`hpc hpc-${i < 2 ? 'left' : 'right'}`}
        style={`top:${i % 2 === 0 ? 18 : 52}%`}
        onclick={`openPS(${i})`}
      >
        <div class="hpc-thumb">
          <img src={p.src} alt={p.alt} loading="lazy"/>
          <span class="hpc-arrow">{i < 2 ? '›' : '‹'}</span>
        </div>
        <div class="hpc-body">
          <span class="hpc-tag">{p.tag}</span>
          <h4 class="hpc-title">{p.title}</h4>
        </div>
      </div>
    ))}
  </Fragment>

  <HomeSections client:load />
</Layout>

<!-- MODAL overlay for strip clicks -->
<div class="ps-modal-overlay" id="psOverlay" onclick="closePS()">
  <div class="ps-modal" onclick="event.stopPropagation()">
    <button class="ps-close" onclick="closePS()">✕</button>
    <div class="ps-modal-img-wrap">
      <img id="psModalImg" src="" alt="" />
    </div>
    <div class="ps-modal-info">
      <span class="ps-modal-tag" id="psModalTag"></span>
      <h3 class="ps-modal-title" id="psModalTitle"></h3>
    </div>
    <div class="ps-modal-nav">
      <button onclick="stepPS(-1)">‹</button>
      <button onclick="stepPS(1)">›</button>
    </div>
  </div>
</div>

<style is:global>
/* ─── INDEX BADGE (reuse) ─── */
.idx-badge {
  display:inline-flex; align-items:center; gap:6px;
  padding:5px 16px; border-radius:100px;
  border:1px solid rgba(212,168,67,0.45); background:rgba(212,168,67,0.10);
  font-family:var(--font-mono); font-size:10px; letter-spacing:2px;
  color:var(--gold); text-transform:uppercase;
  margin-bottom:1.2rem; animation:fadeUp 0.8s ease both;
}
.idx-badge::before {
  content:''; width:6px; height:6px; border-radius:50%;
  background:var(--gold); animation:idx-blink 2s ease-in-out infinite;
}
@keyframes idx-blink { 0%,100%{opacity:1} 50%{opacity:0.3} }

/* ─── PHOTO STRIP ─── */
.photo-strip {
  display:none; /* hidden on desktop — side cards used instead */
  gap:10px; padding:4px 2px; margin-top:1.4rem;
  overflow-x:auto; scroll-snap-type:x mandatory;
  -webkit-overflow-scrolling:touch; width:100%;
  scrollbar-width:none;
}
.photo-strip::-webkit-scrollbar { display:none; }

.ps-card {
  flex:0 0 130px; height:110px; border-radius:12px; overflow:hidden;
  position:relative; cursor:pointer; scroll-snap-align:start;
  border:2px solid rgba(212,168,67,0.3);
  transition:transform 0.25s ease, border-color 0.25s ease;
  box-shadow:0 4px 16px rgba(0,0,0,0.45);
}
.ps-card:active { transform:scale(0.96); }
.ps-card img { width:100%; height:100%; object-fit:cover; display:block; }
.ps-label {
  position:absolute; bottom:0; left:0; right:0;
  padding:6px 8px;
  background:linear-gradient(to top, rgba(4,9,20,0.92) 0%, transparent 100%);
  display:flex; flex-direction:column;
}
.ps-tag {
  font-family:var(--font-mono); font-size:7px; letter-spacing:1.2px;
  text-transform:uppercase; color:#4ade80;
}
.ps-title { font-size:11px; font-weight:600; color:#f0ede8; line-height:1.2; }

/* ─── SIDE CARDS (desktop) ─── */
.hpc {
  position:absolute; z-index:4; width:64px; height:190px;
  background:rgba(8,18,36,0.92); border:3px solid #7a4a1e;
  border-radius:10px; overflow:hidden; cursor:pointer;
  transition:all 0.42s cubic-bezier(0.4,0,0.2,1);
  box-shadow:0 2px 12px rgba(0,0,0,0.45), 0 8px 32px rgba(0,0,0,0.6);
}
.hpc.hpc-left  { left:6px; }
.hpc.hpc-right { right:6px; }
.hpc-thumb { position:relative; width:100%; height:100%; overflow:hidden; }
.hpc-thumb img { width:100%; height:100%; object-fit:cover; display:block; }
.hpc-left  .hpc-thumb img { object-position:left center; }
.hpc-right .hpc-thumb img { object-position:right center; }
.hpc-arrow {
  position:absolute; top:50%; transform:translateY(-50%);
  font-size:1.8rem; font-weight:300; color:rgba(255,255,255,0.9);
  line-height:1; pointer-events:none;
  text-shadow:0 1px 6px rgba(0,0,0,0.6);
}
.hpc-left  .hpc-arrow { right:6px; }
.hpc-right .hpc-arrow { left:6px; }
.hpc-body { display:none; }

/* ─── MODAL ─── */
.ps-modal-overlay {
  display:none; position:fixed; inset:0; z-index:200;
  background:rgba(0,0,0,0.88); align-items:center; justify-content:center;
  padding:1rem;
}
.ps-modal-overlay.open { display:flex; }
.ps-modal {
  position:relative; width:min(90vw,480px);
  background:rgba(8,18,36,0.98); border-radius:16px;
  border:1px solid rgba(212,168,67,0.25);
  overflow:hidden; box-shadow:0 24px 80px rgba(0,0,0,0.75);
}
.ps-modal-img-wrap { width:100%; aspect-ratio:16/9; overflow:hidden; }
.ps-modal-img-wrap img { width:100%; height:100%; object-fit:cover; display:block; }
.ps-modal-info { padding:14px 16px 8px; }
.ps-modal-tag {
  display:inline-block; padding:2px 9px; border-radius:100px;
  background:rgba(34,197,94,0.13); border:1px solid rgba(34,197,94,0.38);
  font-family:var(--font-mono); font-size:9px; letter-spacing:1.5px;
  text-transform:uppercase; color:#4ade80; margin-bottom:6px;
}
.ps-modal-title { font-family:var(--font-display); font-size:18px; color:#f0ede8; }
.ps-modal-nav {
  display:flex; justify-content:space-between; padding:8px 16px 14px;
}
.ps-modal-nav button {
  background:rgba(212,168,67,0.12); border:1px solid rgba(212,168,67,0.3);
  color:var(--gold); border-radius:8px; padding:6px 20px;
  font-size:1.4rem; cursor:pointer; transition:background 0.2s;
}
.ps-modal-nav button:hover { background:rgba(212,168,67,0.25); }
.ps-close {
  position:absolute; top:10px; right:12px; z-index:1;
  background:rgba(0,0,0,0.5); border:none; color:#fff;
  border-radius:50%; width:30px; height:30px; font-size:14px;
  cursor:pointer; display:flex; align-items:center; justify-content:center;
}

/* ─── RESPONSIVE ─── */
@media(max-width:900px) {
  .hpc { display:none; }
  .photo-strip { display:flex; }
}
@media(max-width:768px) {
  .hero-title { font-size:clamp(2.4rem,10vw,4rem) !important; }
  .hero-desc { text-align:center; }
  .hero-ctas { flex-direction:column; align-items:center; gap:0.75rem; }
  .hero-ctas .btn-primary, .hero-ctas .btn-outline { width:min(100%,280px); text-align:center; justify-content:center; }
  .hero-stats { width:100%; flex-wrap:wrap; }
  .stat-item { flex:1; min-width:80px; }
  .hero-quicknav a { font-size:9px; padding:4px 8px; }
}
</style>

<script is:inline>
const PS_DATA = [
  { src:'/foto-lago.jpg',        tag:'Destinos',     title:'Lago Titicaca' },
  { src:'/foto-vivencial.jpg',   tag:'Vivencial',    title:'Vida en Comunidad' },
  { src:'/foto-actividades.jpg', tag:'Actividades',  title:'Aventura en el Lago' },
  { src:'/foto-festividades.jpg',tag:'Festividades', title:'Fiestas Ancestrales' },
];
var psIdx = 0;
function openPS(i) {
  psIdx = i;
  renderPS();
  document.getElementById('psOverlay').classList.add('open');
}
function closePS() { document.getElementById('psOverlay').classList.remove('open'); }
function stepPS(d) { psIdx = (psIdx + d + PS_DATA.length) % PS_DATA.length; renderPS(); }
function renderPS() {
  var p = PS_DATA[psIdx];
  document.getElementById('psModalImg').src = p.src;
  document.getElementById('psModalImg').alt = p.title;
  document.getElementById('psModalTag').textContent = p.tag;
  document.getElementById('psModalTitle').textContent = p.title;
}
</script>
