---
import Navbar from '../components/Navbar';
import HomeSections from '../components/HomeSections';
import ChatWidget from '../components/ChatWidget';
import SectionRenderer from '../components/SectionRenderer.astro';
import ArenaFooter from '../components/ArenaFooter.astro';

const IA_URL = import.meta.env.PUBLIC_IA_URL || 'http://localhost:5000';
let cms: any = null;
try { const r = await fetch(`${IA_URL}/api/contenido/index`); if (r.ok) cms = await r.json(); } catch {}
const cmsHero  = cms?.secciones?.find((s: any) => s.tipo === 'hero');
const cmsStats = cms?.secciones?.find((s: any) => s.tipo === 'stats');
const bodySecciones = (cms?.secciones ?? []).filter((s: any) => s.tipo !== 'hero' && s.tipo !== 'stats');
const hasBody = bodySecciones.length > 0;
---
<html lang="es" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#070D1A" />
  <title>Capachica Turismo — La joya del Lago Titicaca</title>
  <meta name="description" content="Descubre la península de Capachica: turismo vivencial, gastronomía andina, festividades ancestrales y los atardeceres más bellos del Titicaca." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Crimson+Pro:wght@300;400;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style is:global>
    /* ─── CSS VARS ─── */
    :root {
      --turquoise: #2dd4bf;
      --turquoise-dark: #0f9488;
      --turquoise-glow: rgba(45,212,191,0.25);
      --gold: #d4a843;
      --gold-light: #f0c96a;
      --gold-pale: rgba(212,168,67,0.15);
      --navy: #0a1628;
      --navy-mid: #0f2240;
      --navy-light: #162d4e;
      --sand: #e8dcc8;
      --sand-dark: #c4a882;
      --text-main: #f0ede8;
      --text-muted: rgba(240,237,232,0.65);
      --white: #ffffff;
      --card-bg: rgba(10,22,40,0.75);
      --card-border: rgba(45,212,191,0.18);
      --accent: #FF6B35;
      --accent-glow: rgba(255,107,53,0.25);
      --transition: all 0.35s cubic-bezier(0.4,0,0.2,1);
      /* compat aliases for React components */
      --font-display: 'Playfair Display', serif;
      --font-body: 'Crimson Pro', Georgia, serif;
      --font-mono: 'Space Mono', monospace;
      --radius: 16px; --radius-sm: 10px; --radius-lg: 24px;
      --text: #f0ede8; --text2: rgba(240,237,232,0.65); --text3: rgba(240,237,232,0.38);
      --border: rgba(45,212,191,0.14); --border-hover: rgba(45,212,191,0.35);
      --accent-light: rgba(45,212,191,0.08);
      --bg-main: #0a1628; --bg: #0a1628; --bg2: #0f2240;
      --surface: rgba(10,22,40,0.75); --surface2: rgba(15,34,64,0.5);
      --cyan: #2dd4bf; --emerald: #34d399;
    }
    [data-theme="light"] {
      --turquoise: #0f9488; --turquoise-dark: #0d7a6f;
      --turquoise-glow: rgba(15,148,136,0.25);
      --gold: #b8860b; --gold-light: #d4a843;
      --gold-pale: rgba(184,134,11,0.12);
      --navy: #f8f6f3; --navy-mid: #f0ede8; --navy-light: #e8e4de;
      --text-main: #1a1a2e; --text-muted: rgba(26,26,46,0.6);
      --card-bg: rgba(255,255,255,0.85); --card-border: rgba(10,120,200,0.22);
      --accent: #c25a18; --accent-glow: rgba(194,90,24,0.22);
      --text: #1a1a2e; --text2: rgba(26,26,46,0.6); --text3: rgba(26,26,46,0.38);
      --border: rgba(10,120,200,0.18); --border-hover: rgba(10,120,200,0.4);
      --accent-light: rgba(10,120,200,0.08);
      --bg-main: #e6f3fc; --bg: #e6f3fc; --bg2: #cce4f7;
      --surface: rgba(255,255,255,0.9); --surface2: rgba(204,228,247,0.8);
      --cyan: #0f9488;
    }

    /* ─── RESET ─── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Crimson Pro', Georgia, serif;
      background: #070D1A; color: var(--text-main);
      min-height: 100vh; overflow-x: hidden;
      transition: background 0.7s ease, color 0.7s ease;
    }
    [data-theme="light"] body { background: var(--navy); }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #070D1A; }
    ::-webkit-scrollbar-thumb { background: rgba(45,212,191,0.35); border-radius: 3px; }

    /* ─── REVEAL (for React components) ─── */
    .reveal { opacity:0; transform:translateY(24px); transition:opacity 0.65s ease, transform 0.65s ease; }
    .reveal.visible { opacity:1; transform:translateY(0); }
    .reveal-left { opacity:0; transform:translateX(-28px); transition:opacity 0.7s ease, transform 0.7s ease; }
    .reveal-left.visible { opacity:1; transform:translateX(0); }
    .reveal-right { opacity:0; transform:translateX(28px); transition:opacity 0.7s ease, transform 0.7s ease; }
    .reveal-right.visible { opacity:1; transform:translateX(0); }

    /* ─── LAYOUT ─── */
    .container { max-width:1200px; margin:0 auto; padding:0 1.5rem; }
    section { padding:90px 0; }
    @media(max-width:768px) { section { padding:60px 0; } .container { padding:0 1rem; } }

    /* ─── TYPOGRAPHY ─── */
    .section-label {
      display:inline-flex; align-items:center; gap:0.5rem;
      padding:0.35rem 1rem; background:rgba(45,212,191,0.08);
      border:1px solid rgba(45,212,191,0.3); color:var(--turquoise);
      font-size:0.7rem; font-weight:700; letter-spacing:0.18em;
      text-transform:uppercase; border-radius:999px; margin-bottom:1.2rem;
      font-family:'Space Mono',monospace;
    }
    .section-title {
      font-family:'Playfair Display',serif;
      font-size:clamp(1.8rem,4vw,3rem); font-weight:800; line-height:1.15; color:var(--text-main);
    }
    .gradient-text {
      background:linear-gradient(135deg,#f0ede8 30%,var(--turquoise) 80%);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
    }
    [data-theme="light"] .gradient-text {
      background:linear-gradient(135deg,#0a1628 30%,var(--turquoise) 80%);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
    }
    .divider { width:48px; height:3px; background:linear-gradient(90deg,var(--turquoise),transparent); border-radius:2px; margin:1rem 0; }
    .text-center .divider { margin:1rem auto; }
    .text-center { text-align:center; }

    /* ─── BUTTONS ─── */
    .btn-primary {
      display:inline-flex; align-items:center; gap:8px;
      background:linear-gradient(135deg,var(--turquoise),var(--turquoise-dark));
      border:1px solid rgba(255,255,255,0.12); color:#0a1628;
      border-radius:999px; padding:14px 32px; font-family:'Crimson Pro',serif;
      font-size:15px; font-weight:700; cursor:pointer;
      box-shadow:0 4px 20px rgba(45,212,191,0.3);
      transition:all 0.3s ease; text-decoration:none;
    }
    .btn-primary:hover { transform:translateY(-3px); box-shadow:0 8px 35px rgba(45,212,191,0.45); }
    .btn-outline {
      display:inline-flex; align-items:center; gap:8px;
      background:rgba(45,212,191,0.06); color:var(--turquoise);
      border:1.5px solid rgba(45,212,191,0.4); border-radius:999px;
      padding:13px 28px; font-family:'Crimson Pro',serif; font-size:15px;
      font-weight:500; cursor:pointer; transition:all 0.25s; text-decoration:none;
      backdrop-filter:blur(6px);
    }
    .btn-outline:hover { background:var(--turquoise); color:#0a1628; border-color:var(--turquoise); transform:translateY(-2px); }

    /* ─── HERO ─── */
    .hero {
      position:relative; min-height:100vh;
      display:flex; flex-direction:column;
      align-items:center; justify-content:center;
      overflow:hidden; padding-top:64px;
    }

    /* @property — festividades night sky colors */
    @property --sky-c1 { syntax:'<color>'; initial-value:#070D1A; inherits:false; }
    @property --sky-c2 { syntax:'<color>'; initial-value:#0B1426; inherits:false; }
    @property --sky-c3 { syntax:'<color>'; initial-value:#0f1835; inherits:false; }
    @property --sky-c4 { syntax:'<color>'; initial-value:#132042; inherits:false; }
    @property --sky-c5 { syntax:'<color>'; initial-value:#1B2D5A; inherits:false; }
    @property --sky-c6 { syntax:'<color>'; initial-value:#243870; inherits:false; }

    .hero-sky {
      position:absolute; inset:0; z-index:0;
      --sky-c1:#070D1A; --sky-c2:#0B1426; --sky-c3:#0f1835;
      --sky-c4:#132042; --sky-c5:#1B2D5A; --sky-c6:#243870;
      background:linear-gradient(180deg,
        var(--sky-c1) 0%, var(--sky-c2) 20%, var(--sky-c3) 40%,
        var(--sky-c4) 62%, var(--sky-c5) 80%, var(--sky-c6) 100%);
      transition:
        --sky-c1 1.5s ease, --sky-c2 1.5s ease, --sky-c3 1.5s ease,
        --sky-c4 1.5s ease, --sky-c5 1.5s ease, --sky-c6 1.5s ease;
    }
    [data-theme="light"] .hero-sky {
      --sky-c1:#0d47a1; --sky-c2:#1565c0; --sky-c3:#1e88e5;
      --sky-c4:#42a5f5; --sky-c5:#90caf9; --sky-c6:#ddeeff;
    }
    .hero-sky.sky-transitioning {
      animation:skyToLight 2.4s cubic-bezier(0.33,0,0.12,1) forwards !important;
    }
    .hero-sky.sky-transitioning-reverse {
      animation:skyToDark 2.4s cubic-bezier(0.33,0,0.12,1) forwards !important;
    }
    /* Warm horizon glow */
    .sky-glow {
      position:absolute; inset:0; pointer-events:none; z-index:1; opacity:0;
      transition:opacity 2.4s cubic-bezier(0.33,0,0.12,1);
    }
    .sky-glow.glow-sunrise {
      background:radial-gradient(ellipse at 50% 80%,rgba(255,200,100,0.22) 0%,rgba(200,160,100,0.12) 40%,transparent 70%);
      opacity:1;
    }
    .sky-glow.glow-sunset {
      background:radial-gradient(ellipse at 50% 80%,rgba(10,20,50,0.22) 0%,rgba(20,30,60,0.12) 40%,transparent 70%);
      opacity:1;
    }

    @keyframes skyToLight {
      0%   { --sky-c1:#070D1A; --sky-c2:#0B1426; --sky-c3:#0f1835; --sky-c4:#132042; --sky-c5:#1B2D5A; --sky-c6:#243870; }
      30%  { --sky-c1:#0c2038; --sky-c2:#12304e; --sky-c3:#1c4468; --sky-c4:#2a5880; --sky-c5:#3c6e98; --sky-c6:#5088b0; }
      60%  { --sky-c1:#183040; --sky-c2:#24405e; --sky-c3:#32567e; --sky-c4:#46749c; --sky-c5:#5888b4; --sky-c6:#70aec2; }
      100% { --sky-c1:#0d47a1; --sky-c2:#1565c0; --sky-c3:#1e88e5; --sky-c4:#42a5f5; --sky-c5:#90caf9; --sky-c6:#ddeeff; }
    }
    @keyframes skyToDark {
      0%   { --sky-c1:#0d47a1; --sky-c2:#1565c0; --sky-c3:#1e88e5; --sky-c4:#42a5f5; --sky-c5:#90caf9; --sky-c6:#ddeeff; }
      30%  { --sky-c1:#183040; --sky-c2:#24405e; --sky-c3:#32567e; --sky-c4:#46749c; --sky-c5:#5888b4; --sky-c6:#70aec2; }
      60%  { --sky-c1:#0c2038; --sky-c2:#12304e; --sky-c3:#1c4468; --sky-c4:#2a5880; --sky-c5:#3c6e98; --sky-c6:#5088b0; }
      100% { --sky-c1:#070D1A; --sky-c2:#0B1426; --sky-c3:#0f1835; --sky-c4:#132042; --sky-c5:#1B2D5A; --sky-c6:#243870; }
    }

    /* Stars canvas */
    .stars-layer { position:absolute; inset:0; z-index:1; pointer-events:none; }
    [data-theme="light"] .stars-layer { opacity:0 !important; transition:opacity 1s ease; }

    /* Moon (actividades style — radial-gradient full sphere) */
    .hero-moon {
      position:absolute; top:9%; left:50%; transform:translateX(-50%);
      width:110px; height:110px; border-radius:50%; z-index:6; pointer-events:none;
      background:radial-gradient(circle at 35% 35%, #e8e0cc, #c8bfa0 60%, #a09070);
      box-shadow:
        0 0 40px rgba(220,200,150,0.35),
        0 0 80px rgba(220,200,150,0.15),
        inset -12px -12px 20px rgba(0,0,0,0.25);
      animation:moonPulse 6s ease-in-out infinite;
    }
    [data-theme="light"] .hero-moon {
      background:radial-gradient(circle at 35% 35%, #FFD700, #FFA500 60%, #FF8C00) !important;
      box-shadow:
        0 0 40px rgba(255,215,0,0.35),
        0 0 80px rgba(255,165,0,0.15),
        inset -12px -12px 20px rgba(0,0,0,0.1) !important;
      animation:sunPulse 6s ease-in-out infinite !important;
    }
    @keyframes moonPulse {
      0%,100% { box-shadow:0 0 40px rgba(220,200,150,0.35),0 0 80px rgba(220,200,150,0.15),inset -12px -12px 20px rgba(0,0,0,0.25); }
      50%     { box-shadow:0 0 55px rgba(220,200,150,0.5),0 0 110px rgba(220,200,150,0.25),inset -12px -12px 20px rgba(0,0,0,0.25); }
    }
    @keyframes sunPulse {
      0%,100% { box-shadow:0 0 40px rgba(255,215,0,0.35),0 0 80px rgba(255,165,0,0.15),inset -12px -12px 20px rgba(0,0,0,0.1); }
      50%     { box-shadow:0 0 55px rgba(255,215,0,0.5),0 0 110px rgba(255,165,0,0.25),inset -12px -12px 20px rgba(0,0,0,0.1); }
    }
    /* Cinematic moon fall / rise */
    .hero-moon.theme-switching-down {
      animation:themeSwitchDown 2.4s cubic-bezier(0.33,0,0.12,1) forwards !important;
      will-change:transform,opacity,filter;
    }
    .hero-moon.theme-switching-up {
      animation:themeSwitchUp 2.4s cubic-bezier(0.33,0,0.12,1) forwards !important;
      will-change:transform,opacity,filter;
    }
    @keyframes themeSwitchDown {
      0%   { transform:translateX(-50%)              translateY(0)    rotate(0deg)   scale(1);    opacity:1;    filter:brightness(1)   blur(0px);   }
      5%   { transform:translateX(calc(-50% + 3vw))  translateY(2vh)  rotate(10deg)  scale(0.99); opacity:0.99; filter:brightness(0.99) blur(0px);   }
      12%  { transform:translateX(calc(-50% + 8vw))  translateY(6vh)  rotate(26deg)  scale(0.96); opacity:0.96; filter:brightness(0.95) blur(0.1px); }
      20%  { transform:translateX(calc(-50% + 15vw)) translateY(12vh) rotate(48deg)  scale(0.91); opacity:0.90; filter:brightness(0.87) blur(0.2px); }
      30%  { transform:translateX(calc(-50% + 23vw)) translateY(20vh) rotate(76deg)  scale(0.84); opacity:0.81; filter:brightness(0.75) blur(0.5px); }
      40%  { transform:translateX(calc(-50% + 31vw)) translateY(28vh) rotate(104deg) scale(0.74); opacity:0.69; filter:brightness(0.60) blur(0.9px); }
      50%  { transform:translateX(calc(-50% + 38vw)) translateY(36vh) rotate(130deg) scale(0.62); opacity:0.56; filter:brightness(0.46) blur(1.4px); }
      60%  { transform:translateX(calc(-50% + 44vw)) translateY(43vh) rotate(154deg) scale(0.48); opacity:0.42; filter:brightness(0.33) blur(2px);   }
      70%  { transform:translateX(calc(-50% + 49vw)) translateY(49vh) rotate(175deg) scale(0.34); opacity:0.27; filter:brightness(0.21) blur(3px);   }
      80%  { transform:translateX(calc(-50% + 53vw)) translateY(53vh) rotate(194deg) scale(0.20); opacity:0.14; filter:brightness(0.11) blur(4.5px); }
      90%  { transform:translateX(calc(-50% + 56vw)) translateY(56vh) rotate(209deg) scale(0.09); opacity:0.05; filter:brightness(0.05) blur(6.5px); }
      100% { transform:translateX(calc(-50% + 58vw)) translateY(58vh) rotate(220deg) scale(0.02); opacity:0;    filter:brightness(0.02) blur(8px);   }
    }
    @keyframes themeSwitchUp {
      0%   { transform:translateX(calc(-50% - 58vw)) translateY(58vh) rotate(0deg)    scale(0.02); opacity:0;    filter:brightness(0.02) blur(8px);   }
      10%  { transform:translateX(calc(-50% - 56vw)) translateY(56vh) rotate(-12deg)  scale(0.09); opacity:0.05; filter:brightness(0.05) blur(6.5px); }
      20%  { transform:translateX(calc(-50% - 53vw)) translateY(53vh) rotate(-28deg)  scale(0.20); opacity:0.14; filter:brightness(0.11) blur(4.5px); }
      30%  { transform:translateX(calc(-50% - 49vw)) translateY(49vh) rotate(-47deg)  scale(0.34); opacity:0.27; filter:brightness(0.21) blur(3px);   }
      40%  { transform:translateX(calc(-50% - 44vw)) translateY(43vh) rotate(-68deg)  scale(0.48); opacity:0.42; filter:brightness(0.33) blur(2px);   }
      50%  { transform:translateX(calc(-50% - 38vw)) translateY(36vh) rotate(-92deg)  scale(0.62); opacity:0.56; filter:brightness(0.46) blur(1.4px); }
      60%  { transform:translateX(calc(-50% - 31vw)) translateY(28vh) rotate(-118deg) scale(0.74); opacity:0.69; filter:brightness(0.60) blur(0.9px); }
      70%  { transform:translateX(calc(-50% - 23vw)) translateY(20vh) rotate(-146deg) scale(0.84); opacity:0.81; filter:brightness(0.75) blur(0.5px); }
      80%  { transform:translateX(calc(-50% - 15vw)) translateY(12vh) rotate(-174deg) scale(0.91); opacity:0.90; filter:brightness(0.87) blur(0.2px); }
      88%  { transform:translateX(calc(-50% - 8vw))  translateY(6vh)  rotate(-196deg) scale(0.96); opacity:0.96; filter:brightness(0.95) blur(0.1px); }
      95%  { transform:translateX(calc(-50% - 3vw))  translateY(2vh)  rotate(-212deg) scale(0.99); opacity:0.99; filter:brightness(0.99) blur(0px);   }
      100% { transform:translateX(-50%)              translateY(0)    rotate(-220deg) scale(1);    opacity:1;    filter:brightness(1)    blur(0px);   }
    }

    /* Lock falling sphere to its PRE-transition color until off-screen */
    [data-theme="light"] .hero-moon.theme-switching-down {
      background: radial-gradient(circle at 35% 35%, #e8e0cc, #c8bfa0 60%, #a09070) !important;
      box-shadow: 0 0 40px rgba(220,200,150,0.35), 0 0 80px rgba(220,200,150,0.15), inset -12px -12px 20px rgba(0,0,0,0.25) !important;
    }
    [data-theme="dark"] .hero-moon.theme-switching-down {
      background: radial-gradient(circle at 35% 35%, #FFD700, #FFA500 60%, #FF8C00) !important;
      box-shadow: 0 0 40px rgba(255,215,0,0.45), 0 0 80px rgba(255,165,0,0.25), inset -12px -12px 20px rgba(0,0,0,0.1) !important;
    }
    /* Birds */
    .hero-birds { position:absolute; inset:0; z-index:2; pointer-events:none; overflow:visible; opacity:0; transition:opacity 2.4s cubic-bezier(0.33,0,0.12,1); }
    [data-theme="light"] .hero-birds { opacity:1; }
    .hero-birds.birds-fade-in  { opacity:1 !important; transition:opacity 1.8s cubic-bezier(0.33,0,0.12,1) 0.6s !important; }
    .hero-birds.birds-fade-out { opacity:0 !important; transition:opacity 1.2s cubic-bezier(0.33,0,0.12,1) !important; }
    .bird { position:absolute; will-change:transform; }
    [data-theme="light"] .bird { color:rgba(25,35,50,0.55); }
    @keyframes flapSlow  { 0%,100%{transform:scaleX(1) scaleY(1)} 35%{transform:scaleX(0.55) scaleY(0.7)} 65%{transform:scaleX(1.1) scaleY(1.05)} }
    @keyframes flapMed   { 0%,100%{transform:scaleX(1) scaleY(1)} 35%{transform:scaleX(0.5)  scaleY(0.65)} 65%{transform:scaleX(1.12) scaleY(1.08)} }
    @keyframes flapFast  { 0%,100%{transform:scaleX(1) scaleY(1)} 35%{transform:scaleX(0.45) scaleY(0.6)} 65%{transform:scaleX(1.15) scaleY(1.1)} }
    @keyframes birdFloat1 { 0%,100%{transform:translate(0,0) rotate(0deg)} 25%{transform:translate(18px,-10px) rotate(-2deg)} 50%{transform:translate(35px,4px) rotate(1deg)} 75%{transform:translate(14px,-6px) rotate(-1deg)} }
    @keyframes birdFloat2 { 0%,100%{transform:scaleX(-1) translate(0,0)} 25%{transform:scaleX(-1) translate(-15px,8px)} 50%{transform:scaleX(-1) translate(-28px,-6px)} 75%{transform:scaleX(-1) translate(-10px,10px)} }
    @keyframes birdFloat3 { 0%,100%{transform:translate(0,0) rotate(0deg)} 30%{transform:translate(22px,-14px) rotate(-3deg)} 60%{transform:translate(40px,6px) rotate(1.5deg)} 85%{transform:translate(12px,-8px) rotate(-0.5deg)} }
    @keyframes birdFloat4 { 0%,100%{transform:scaleX(-1) translate(0,0)} 20%{transform:scaleX(-1) translate(-20px,-10px)} 50%{transform:scaleX(-1) translate(-38px,8px)} 80%{transform:scaleX(-1) translate(-12px,-4px)} }
    @keyframes birdFloat5 { 0%,100%{transform:translate(0,0) rotate(0deg)} 35%{transform:translate(16px,12px) rotate(2deg)} 65%{transform:translate(30px,-8px) rotate(-1.5deg)} 90%{transform:translate(8px,4px) rotate(0.5deg)} }
    @keyframes birdFloat6 { 0%,100%{transform:scaleX(-1) translate(0,0)} 25%{transform:scaleX(-1) translate(-12px,-12px)} 55%{transform:scaleX(-1) translate(-24px,6px)} 80%{transform:scaleX(-1) translate(-8px,-4px)} }
    @keyframes birdFloat7 { 0%,100%{transform:translate(0,0) rotate(0deg)} 20%{transform:translate(14px,-8px) rotate(-1.5deg)} 50%{transform:translate(28px,10px) rotate(2deg)} 75%{transform:translate(10px,-4px) rotate(-0.5deg)} }

    /* Hero content */
    .hero-content {
      position:relative; z-index:5; text-align:center;
      padding:clamp(130px,16vh,200px) 1.5rem 0; margin-bottom:180px;
      display:flex; flex-direction:column; align-items:center;
    }
    .hero-badge {
      display:inline-flex; align-items:center; gap:6px;
      padding:5px 14px; border-radius:100px;
      border:1px solid rgba(212,168,67,0.45);
      background:rgba(212,168,67,0.10);
      font-family:'Space Mono',monospace; font-size:10px; letter-spacing:2px;
      color:var(--gold); text-transform:uppercase; margin-bottom:1.2rem;
      animation:fadeUp 0.8s ease both;
    }
    .hero-badge::before {
      content:''; width:6px; height:6px; border-radius:50%;
      background:var(--gold); animation:blink 2s ease-in-out infinite;
    }
    .hero-quicknav {
      display:flex; gap:0.55rem; justify-content:center; flex-wrap:wrap;
      margin-top:1.6rem; animation:fadeUp 0.8s 0.45s ease both;
    }
    .hero-quicknav a {
      padding:5px 13px; border-radius:100px; font-size:11px; font-weight:600;
      border:1px solid rgba(240,237,232,0.15); color:rgba(240,237,232,0.65);
      background:rgba(255,255,255,0.05); text-decoration:none; letter-spacing:0.04em;
      transition:all 0.25s ease;
    }
    .hero-quicknav a:hover { border-color:rgba(212,168,67,0.5); color:var(--gold); background:rgba(212,168,67,0.08); }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
    .hero-title {
      font-family:'Playfair Display',serif;
      font-size:clamp(3.2rem,8vw,6rem); line-height:1.05;
      color:#f0ede8; animation:fadeUp 0.8s 0.1s ease both; margin-bottom:0.3rem;
    }
    .hero-title em {
      display:block; font-style:italic; color:var(--gold);
    }
    .hero-desc {
      font-size:clamp(1rem,2vw,1.2rem); color:var(--text-muted);
      max-width:520px; margin:1rem auto 0; line-height:1.7;
      animation:fadeUp 0.8s 0.2s ease both;
    }
    .hero-ctas {
      display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;
      margin-top:2rem; animation:fadeUp 0.8s 0.3s ease both;
    }
    .hero-stats {
      position:relative; z-index:5; display:flex; gap:0;
      background:rgba(10,22,40,0.7); border:1px solid rgba(45,212,191,0.2);
      border-radius:12px; backdrop-filter:blur(12px); overflow:hidden;
      margin-top:2rem; animation:fadeUp 0.8s 0.4s ease both;
    }
    .stat-item { padding:12px 22px; text-align:center; border-right:1px solid rgba(45,212,191,0.12); }
    .stat-item:last-child { border-right:none; }
    .stat-val { font-family:'Playfair Display',serif; font-size:1.4rem; font-weight:700; color:var(--gold); line-height:1; }
    .stat-label { font-size:0.7rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px; margin-top:3px; }

    @keyframes fadeUp { from{opacity:0;transform:translateY(24px)} to{opacity:1;transform:translateY(0)} }

    /* Hero wave layers (actividades style) */
    .hero-waves { position:absolute; bottom:0; left:0; right:0; height:280px; overflow:hidden; }
    .wave { position:absolute; bottom:0; left:-5%; right:-5%; height:100%; }
    .wave-water {
      background:linear-gradient(180deg,rgba(42,96,112,0.3) 0%,rgba(20,70,90,0.6) 35%,rgba(10,55,72,0.85) 65%,#043a48 100%);
      clip-path:polygon(0% 48%,5% 40%,12% 33%,20% 28%,28% 25%,35% 24%,42% 26%,50% 30%,57% 33%,64% 34%,72% 31%,80% 26%,88% 22%,95% 20%,100% 19%,105% 19%,105% 100%,0% 100%);
      animation:waveMove 7s ease-in-out infinite;
    }
    .wave-sand {
      background:linear-gradient(180deg,rgba(30,80,95,0.15) 0%,rgba(15,60,78,0.4) 40%,rgba(8,50,68,0.7) 70%,#043a48 100%);
      clip-path:polygon(0% 65%,6% 58%,14% 53%,23% 50%,32% 49%,40% 51%,48% 54%,56% 55%,64% 53%,72% 50%,80% 48%,88% 49%,95% 52%,100% 55%,105% 55%,105% 100%,0% 100%);
      animation:waveSandMove 10s ease-in-out infinite 1.8s;
    }
    @keyframes waveMove {
      0%,100% {
        clip-path:polygon(0% 48%,5% 40%,12% 33%,20% 28%,28% 25%,35% 24%,42% 26%,50% 30%,57% 33%,64% 34%,72% 31%,80% 26%,88% 22%,95% 20%,100% 19%,105% 19%,105% 100%,0% 100%);
        transform:translateX(0%);
      }
      50% {
        clip-path:polygon(0% 57%,5% 49%,12% 42%,20% 37%,28% 34%,35% 33%,42% 35%,50% 39%,57% 42%,64% 43%,72% 40%,80% 35%,88% 31%,95% 29%,100% 28%,105% 28%,105% 100%,0% 100%);
        transform:translateX(-2.5%);
      }
    }
    @keyframes waveSandMove {
      0%,100% {
        clip-path:polygon(0% 65%,6% 58%,14% 53%,23% 50%,32% 49%,40% 51%,48% 54%,56% 55%,64% 53%,72% 50%,80% 48%,88% 49%,95% 52%,100% 55%,105% 55%,105% 100%,0% 100%);
        transform:translateX(0%);
      }
      50% {
        clip-path:polygon(0% 73%,6% 66%,14% 61%,23% 58%,32% 57%,40% 59%,48% 62%,56% 63%,64% 61%,72% 58%,80% 56%,88% 57%,95% 60%,100% 63%,105% 63%,105% 100%,0% 100%);
        transform:translateX(2.5%);
      }
    }

    /* Light mode wave + hero overrides */
    [data-theme="light"] .wave-water {
      background:linear-gradient(180deg,rgba(220,242,255,0.4) 0%,rgba(0,140,172,0.65) 38%,rgba(0,95,115,0.90) 68%,#005f73 100%) !important;
    }
    [data-theme="light"] .wave-sand {
      background:linear-gradient(180deg,rgba(200,238,255,0.18) 0%,rgba(0,112,142,0.44) 42%,rgba(0,80,100,0.74) 70%,#005f73 100%) !important;
    }
    [data-theme="light"] .hero-title { color:#ffffff !important; }
    [data-theme="light"] .hero-badge { border-color:rgba(255,255,255,0.5); background:rgba(255,255,255,0.18); color:#ffffff; }
    [data-theme="light"] .hero-badge::before { background:#fff; }
    [data-theme="light"] .hero-quicknav a { border-color:rgba(255,255,255,0.3); color:rgba(255,255,255,0.80); background:rgba(255,255,255,0.10); }
    [data-theme="light"] .hero-quicknav a:hover { border-color:rgba(255,255,255,0.8); color:#fff; background:rgba(255,255,255,0.22); }
    [data-theme="light"] .hero-stats { background:rgba(255,255,255,0.15); border-color:rgba(255,255,255,0.32); }
    [data-theme="light"] .hero-stats .stat-val { color:#ffd060; }
    [data-theme="light"] .stat-label { color:rgba(255,255,255,0.7); }
    [data-theme="light"] .hero-desc { color:rgba(255,255,255,0.75); }

    /* ─── MAIN ─── */
    main { background:#043a48; position:relative; transition:background 0.7s ease; }
    [data-theme="light"] main { background:linear-gradient(180deg,#005f73 0%,#007288 35%,#008899 65%,#00a0b5 100%); }

    /* ─── BOTTOM WAVE ─── */
    .bottom-wave {
      position:relative; height:80px; overflow:hidden; margin-top:-2px;
      background:linear-gradient(180deg,#043a48 0%,#342e24 35%,#342e24 65%,#4a3a28 100%);
    }
    .sand-wave {
      position:absolute; bottom:0; left:-5%; right:-5%; height:100%;
      background:linear-gradient(180deg,rgba(20,32,24,0.25) 0%,rgba(48,44,34,0.5) 45%,#4a3a28 100%);
      clip-path:polygon(0% 52%,4% 46%,10% 41%,18% 37%,26% 35%,34% 36%,42% 38%,50% 40%,58% 40%,66% 38%,74% 35%,82% 34%,90% 36%,96% 40%,100% 44%,105% 44%,105% 100%,0% 100%);
      animation:sandWave 10s ease-in-out infinite;
    }
    @keyframes sandWave {
      0%,100% { clip-path:polygon(0% 52%,4% 46%,10% 41%,18% 37%,26% 35%,34% 36%,42% 38%,50% 40%,58% 40%,66% 38%,74% 35%,82% 34%,90% 36%,96% 40%,100% 44%,105% 44%,105% 100%,0% 100%); }
      50%     { clip-path:polygon(0% 57%,4% 51%,10% 46%,18% 42%,26% 40%,34% 41%,42% 43%,50% 45%,58% 45%,66% 43%,74% 40%,82% 39%,90% 41%,96% 45%,100% 49%,105% 49%,105% 100%,0% 100%); }
    }
    [data-theme="light"] .bottom-wave {
      height: 180px !important;
      background:linear-gradient(180deg,
        #00a0b5 0%,
        #04a8ac 10%,
        #10a89e 20%,
        #2aaa90 30%,
        #52a872 40%,
        #7ea055 50%,
        #a89440 60%,
        #c4a032 70%,
        #d4b048 80%,
        #e0c468 90%,
        #edd890 100%
      ) !important;
    }
    [data-theme="light"] .sand-wave {
      background:linear-gradient(180deg,
        rgba(0,160,181,0.20) 0%,
        rgba(40,168,144,0.35) 28%,
        rgba(120,152,80,0.45) 52%,
        rgba(210,184,100,0.70) 78%,
        #edd890 100%
      ) !important;
    }

    /* ─── CAMPFIRE APNG ─── */
    .illo-campfire  { position:absolute; bottom:0; right:40px; width:300px; height:300px; z-index:5; pointer-events:none; animation:campfireFlicker 2.0s ease-in-out infinite; }
    .illo-campfire2 { position:absolute; bottom:0; left:40px;  width:300px; height:300px; z-index:5; pointer-events:none; animation:campfireFlicker 2.4s ease-in-out infinite 0.35s; transform:scaleX(-1); }
    [data-theme="light"] .illo-campfire  { display:none !important; }
    [data-theme="light"] .illo-campfire2 { display:none !important; }
    .illo-campfire img, .illo-campfire2 img {
      width:100%; height:100%; display:block;
      image-rendering: pixelated;
    }
    @keyframes campfireFlicker {
      0%,100% { filter:drop-shadow(0 0 28px rgba(255,110,10,0.80)) drop-shadow(0 0 65px rgba(255,60,0,0.45)); }
      25%     { filter:drop-shadow(0 0 44px rgba(255,150,20,0.95)) drop-shadow(0 0 90px rgba(255,80,10,0.60)); }
      60%     { filter:drop-shadow(0 0 18px rgba(255,80,0,0.60))  drop-shadow(0 0 45px rgba(255,40,0,0.35)); }
    }

    /* ─── BEACH BALLS (light only) ─── */
    [data-theme="dark"] .beach-ball-wrap { display:none !important; }
    .beach-ball-wrap { position:absolute; z-index:5; pointer-events:none; display:flex; flex-direction:column; align-items:center; }
    .beach-ball { position:relative; border-radius:50%; background:conic-gradient(from 12deg,#FF3333 0deg 60deg,#FFD700 60deg 120deg,#33CC55 120deg 180deg,#1E8FFF 180deg 240deg,#FF33AA 240deg 300deg,#FF7700 300deg 360deg); box-shadow:0 16px 40px rgba(0,0,0,0.40),0 5px 12px rgba(0,0,0,0.22),inset 0 -18px 32px rgba(0,0,0,0.32),inset 0 16px 24px rgba(255,255,255,0.42); animation:beachBallBounce var(--bb-dur,2.8s) linear infinite; animation-delay:var(--bb-delay,0s); will-change:transform; }
    .beach-ball::before { content:''; position:absolute; inset:0; border-radius:50%; background:radial-gradient(ellipse 58% 46% at 30% 25%,rgba(255,255,255,0.75) 0%,rgba(255,255,255,0.22) 35%,transparent 64%),radial-gradient(ellipse 40% 34% at 74% 80%,rgba(0,0,0,0.24) 0%,transparent 58%); }
    .beach-ball::after { content:''; position:absolute; top:50%; left:50%; width:11px; height:11px; background:radial-gradient(circle at 38% 33%,#fff 0%,#ddd 55%,#bbb 100%); border-radius:50%; transform:translate(-50%,-50%); box-shadow:0 0 5px rgba(255,255,255,0.55),0 2px 4px rgba(0,0,0,0.22); }
    .beach-ball-shadow { border-radius:50%; background:radial-gradient(ellipse,rgba(0,0,0,0.30) 0%,transparent 72%); transform:scaleY(0.25); transform-origin:center top; margin-top:-2px; animation:beachShadowAnim var(--bb-dur,2.8s) linear infinite; animation-delay:var(--bb-delay,0s); }
    @keyframes beachBallBounce { 0%{transform:translateY(0) rotate(0deg);animation-timing-function:cubic-bezier(0.33,0,0.66,0)} 50%{transform:translateY(-28px) rotate(16deg);animation-timing-function:cubic-bezier(0.33,1,0.66,1)} 100%{transform:translateY(0) rotate(32deg)} }
    @keyframes beachShadowAnim { 0%{transform:scaleY(0.24) scaleX(1.0);opacity:0.55;animation-timing-function:cubic-bezier(0.33,0,0.66,0)} 50%{transform:scaleY(0.10) scaleX(0.64);opacity:0.20;animation-timing-function:cubic-bezier(0.33,1,0.66,1)} 100%{transform:scaleY(0.24) scaleX(1.0);opacity:0.55} }

    /* ─── ARENA FOOTER ─── */
    .arena-footer {
      background:linear-gradient(180deg,#4a3a28 0%,#3a2a18 30%,#2a1a10 60%,#1a1008 100%);
      padding:3.5rem 2rem 2rem; position:relative; overflow:hidden;
    }
    .arena-footer::before { content:''; position:absolute; bottom:0; left:0; right:0; height:340px; background:radial-gradient(ellipse 340px 260px at 8% 95%,rgba(255,130,10,0.28) 0%,rgba(255,80,10,0.14) 42%,rgba(255,40,0,0.05) 65%,transparent 80%),radial-gradient(ellipse 340px 260px at 92% 95%,rgba(255,130,10,0.28) 0%,rgba(255,80,10,0.14) 42%,rgba(255,40,0,0.05) 65%,transparent 80%); pointer-events:none; z-index:0; animation:footerGlowPulse 2.2s ease-in-out infinite; }
    @keyframes footerGlowPulse {
      0%,100% { opacity:1; }
      35%     { opacity:1.3; }
      65%     { opacity:0.75; }
    }
    .arena-footer::after { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent 5%,rgba(212,168,67,0.25) 30%,rgba(45,212,191,0.15) 70%,transparent 95%); }
    [data-theme="light"] .arena-footer { background:linear-gradient(180deg,#edd890 0%,#dbb852 28%,#c89838 60%,#ae7e20 100%) !important; margin-top:-4px !important; }
    [data-theme="light"] .arena-footer::before { display:none; }
    [data-theme="light"] .arena-footer::after { display:none; }
    [data-theme="light"] .arena-brand-name { color:rgba(26,16,4,0.95) !important; }
    [data-theme="light"] .arena-brand-tagline { color:rgba(90,55,5,0.80) !important; }
    [data-theme="light"] .arena-heading { color:rgba(60,35,4,0.90) !important; }
    [data-theme="light"] .arena-link { color:rgba(26,14,2,0.80) !important; }
    [data-theme="light"] .arena-link:hover { color:rgba(26,14,2,1) !important; }
    [data-theme="light"] .arena-text { color:rgba(26,14,2,0.72) !important; }
    [data-theme="light"] .arena-social-btn { color:rgba(26,14,2,0.70) !important; border-color:rgba(90,55,5,0.40); background:rgba(90,55,5,0.12); }
    [data-theme="light"] .arena-social-btn:hover { color:rgba(26,14,2,1) !important; background:rgba(90,55,5,0.25); border-color:rgba(90,55,5,0.65); }
    [data-theme="light"] .arena-contact-item { color:rgba(26,14,2,0.72) !important; }
    [data-theme="light"] .arena-contact-item:hover { color:rgba(26,14,2,1) !important; }
    [data-theme="light"] .arena-newsletter-input { background:rgba(255,255,255,0.50) !important; border-color:rgba(90,55,5,0.40) !important; color:rgba(26,14,2,0.95) !important; }
    [data-theme="light"] .arena-newsletter-input::placeholder { color:rgba(26,14,2,0.40) !important; }
    [data-theme="light"] .arena-link-list li::before { background:rgba(90,55,5,0.55) !important; }
    [data-theme="light"] .arena-footer-grid { border-bottom-color:rgba(90,55,5,0.22) !important; }
    .arena-footer-body { max-width:1100px; margin:0 auto; position:relative; z-index:2; }
    .arena-footer-grid { display:grid; grid-template-columns:1.5fr 1fr 1fr 1fr; gap:2rem 2.5rem; padding-bottom:2rem; border-bottom:1px solid rgba(212,168,67,0.15); align-items:start; }
    .arena-brand-logo { display:flex; align-items:center; gap:10px; margin-bottom:1rem; }
    .arena-logo-circle { width:42px; height:42px; border-radius:50%; background:linear-gradient(135deg,#2dd4bf,#d4a843); display:flex; align-items:center; justify-content:center; font-family:'Playfair Display',serif; font-weight:700; font-size:18px; color:#0a1628; flex-shrink:0; }
    .arena-brand-name { font-family:'Playfair Display',serif; font-size:20px; font-weight:700; color:rgba(240,237,232,0.92); line-height:1.1; }
    .arena-brand-tagline { font-family:'Space Mono',monospace; font-size:9px; color:rgba(212,168,67,0.6); letter-spacing:2px; }
    .arena-brand-desc { font-size:13px; line-height:1.65; max-width:225px; margin-bottom:1.1rem; }
    .arena-social-row { display:flex; gap:9px; flex-wrap:wrap; }
    .arena-social-btn { width:34px; height:34px; border-radius:50%; border:1px solid rgba(212,168,67,0.25); background:rgba(212,168,67,0.08); display:flex; align-items:center; justify-content:center; color:rgba(240,237,232,0.50); cursor:pointer; transition:background 0.2s,color 0.2s,border-color 0.2s; text-decoration:none; }
    .arena-social-btn:hover { background:rgba(212,168,67,0.22); color:rgba(240,237,232,0.95); border-color:rgba(212,168,67,0.55); }
    .arena-heading { font-family:'Space Mono',monospace; font-size:10px; letter-spacing:2.5px; text-transform:uppercase; color:rgba(212,168,67,0.7); margin-bottom:1rem; }
    .arena-link { color:rgba(240,237,232,0.55) !important; transition:color 0.25s ease,padding-left 0.25s ease; display:inline-block; }
    .arena-link:hover { color:rgba(240,237,232,0.95) !important; padding-left:4px; }
    .arena-text { color:rgba(240,237,232,0.45) !important; }
    .arena-link-list { list-style:none; display:flex; flex-direction:column; gap:8px; }
    .arena-link-list li { display:flex; align-items:center; gap:7px; }
    .arena-link-list li::before { content:''; display:block; width:4px; height:4px; border-radius:50%; background:rgba(212,168,67,0.45); flex-shrink:0; }
    .arena-link-list .arena-link { padding-left:0 !important; display:inline !important; font-size:13.5px; }
    .arena-link-list .arena-link:hover { padding-left:0 !important; }
    .arena-newsletter-form { display:flex; flex-direction:column; gap:8px; margin-bottom:0.75rem; }
    .arena-newsletter-input { background:rgba(255,255,255,0.07); border:1px solid rgba(212,168,67,0.25); border-radius:6px; padding:8px 12px; font-size:13px; color:rgba(240,237,232,0.92); font-family:'Crimson Pro',serif; outline:none; width:100%; transition:border-color 0.2s; }
    .arena-newsletter-input::placeholder { color:rgba(240,237,232,0.30); }
    .arena-newsletter-input:focus { border-color:rgba(212,168,67,0.55); }
    .arena-subscribe-btn { background:linear-gradient(135deg,#d4a843,#c08a28); color:#0a1628; border:none; border-radius:6px; padding:9px 12px; font-size:13px; font-weight:700; font-family:'Crimson Pro',serif; cursor:pointer; transition:opacity 0.15s,transform 0.15s; width:100%; }
    .arena-subscribe-btn:hover { opacity:0.88; transform:translateY(-1px); }
    .arena-contact-row { display:flex; flex-direction:column; gap:6px; margin-top:0.85rem; }
    .arena-contact-item { display:flex; align-items:center; gap:7px; font-size:12.5px; color:rgba(240,237,232,0.48); text-decoration:none; transition:color 0.2s; }
    .arena-contact-item:hover { color:rgba(240,237,232,0.85); }
    .arena-bottom-bar { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem; padding-top:1.25rem; }
    .arena-legal-links { display:flex; gap:1.2rem; }
    @media(max-width:900px) { .illo-campfire{opacity:0.75;transform:scale(0.65);transform-origin:bottom right} .illo-campfire2{opacity:0.75;transform:scaleX(-1) scale(0.65);transform-origin:bottom left} .beach-ball-wrap{transform:scale(0.65);opacity:0.85;transform-origin:bottom center} .arena-footer-grid{grid-template-columns:1fr 1fr} }
    @media(max-width:768px) { .bottom-wave{height:50px} .illo-campfire{transform:scale(0.48);bottom:0;right:-10px;opacity:0.55;transform-origin:bottom right} .illo-campfire2{transform:scaleX(-1) scale(0.48);bottom:0;left:-10px;opacity:0.55;transform-origin:bottom left} .beach-ball-wrap{display:none} .arena-footer{padding:2rem 1rem} .arena-footer-grid{grid-template-columns:1fr} }
    @keyframes chatPanelIn { from{opacity:0;transform:translateY(16px) scale(0.96)} to{opacity:1;transform:translateY(0) scale(1)} }
    @keyframes chatDot { 0%,80%,100%{transform:scale(0.6);opacity:0.4} 40%{transform:scale(1);opacity:1} }

    /* ─── HERO PHOTO CARDS ─── */
    .hero-photo-card {
      position:absolute; z-index:4;
      background:rgba(8,18,36,0.92); border:1.5px solid rgba(34,197,94,0.35);
      overflow:hidden; cursor:pointer;
      width:200px; height:190px;
      transition:width 0.52s cubic-bezier(0.4,0,0.2,1),height 0.52s cubic-bezier(0.4,0,0.2,1),top 0.52s cubic-bezier(0.4,0,0.2,1),box-shadow 0.3s,opacity 0.3s ease;
      backdrop-filter:blur(14px); box-shadow:0 8px 32px rgba(0,0,0,0.55);
    }
    .hero-photo-card.hpc-left  { left:0;  border-radius:0 14px 14px 0; border-left:none; }
    .hero-photo-card.hpc-right { right:0; border-radius:14px 0 0 14px; border-right:none; }
    .hero-photo-card.expanded  { width:85vw; height:calc(100vh - 90px - 155px); top:90px !important; z-index:8; box-shadow:0 16px 64px rgba(0,0,0,0.72),0 0 48px rgba(34,197,94,0.12); }
    .hpc-thumb { position:relative; width:100%; height:100%; overflow:hidden; }
    .hpc-thumb img { width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.52s ease,object-position 0.52s ease; }
    .hpc-left  .hpc-thumb img { object-position:left center; }
    .hpc-right .hpc-thumb img { object-position:right center; }
    .hero-photo-card.expanded .hpc-thumb img { transform:scale(1.03); object-position:center center; }
    /* fallback bg when no image */
    .hpc-thumb { background:linear-gradient(135deg,#0f2240 0%,#0a3040 100%); }
    /* arrow — sticks to inner edge of card */
    .hpc-arrow {
      position:absolute; top:50%; z-index:2; pointer-events:none;
      background:rgba(34,197,94,0.90); border:none;
      width:22px; height:52px; color:#052e10;
      display:flex; align-items:center; justify-content:center;
      font-size:18px; font-weight:900; line-height:1;
    }
    .hpc-left  .hpc-arrow { right:0; border-radius:0 8px 8px 0; transform:translateY(-50%);          transition:transform 0.45s cubic-bezier(0.4,0,0.2,1); }
    .hpc-right .hpc-arrow { left:0;  border-radius:8px 0 0 8px; transform:translateY(-50%) scaleX(-1); transition:transform 0.45s cubic-bezier(0.4,0,0.2,1); }
    .hpc-left.expanded  .hpc-arrow { transform:translateY(-50%) scaleX(-1); }
    .hpc-right.expanded .hpc-arrow { transform:translateY(-50%); }
    /* body */
    .hpc-body {
      position:absolute; bottom:0; left:0; right:0;
      max-height:0; overflow:hidden;
      transition:max-height 0.52s cubic-bezier(0.4,0,0.2,1),padding 0.35s;
      padding:0 22px;
      background:linear-gradient(to top, rgba(4,9,20,0.97) 0%, rgba(4,9,20,0.88) 55%, transparent 100%);
    }
    .hero-photo-card.expanded .hpc-body { max-height:180px; padding:32px 22px 20px; }
    .hpc-tag {
      display:inline-block; margin-bottom:7px; padding:2px 9px; border-radius:100px;
      background:rgba(34,197,94,0.13); border:1px solid rgba(34,197,94,0.38);
      color:#4ade80; font-size:9px; font-weight:700; letter-spacing:0.13em; text-transform:uppercase;
      font-family:'Space Mono',monospace;
    }
    .hpc-title { font-family:'Playfair Display',serif; font-size:16px; font-weight:700; color:#f0ede8; margin-bottom:6px; line-height:1.2; }
    .hpc-desc  { font-size:13px; color:rgba(240,237,232,0.62); line-height:1.6; }
    @media(max-width:1100px) { .hero-photo-card { display:none !important; } }
  </style>
</head>
<body>

<Navbar client:load />

<!-- ═══════════ HERO ═══════════ -->
<section class="hero">
  <div class="hero-sky"></div>
  <div class="sky-glow" id="skyGlow"></div>
  <canvas class="stars-layer" id="starsCanvas"></canvas>

  <!-- Birds (light mode) -->
  <div class="hero-birds" id="heroBirds"></div>

  <!-- Moon / Sun (same element) -->
  <div class="hero-moon"></div>

  <!-- Content -->
  <div class="hero-content" data-cms-tipo="hero">
    <div class="hero-badge">Puno · Perú · Lago Titicaca</div>
    <h1 class="hero-title">
      {cmsHero?.titulo ? cmsHero.titulo : <Fragment>Descubre<em>Capachica</em></Fragment>}
    </h1>
    <p class="hero-desc">
      {cmsHero?.subtitulo || 'Una península andina a 3,820 msnm donde el lago más alto del mundo navegable se convierte en horizonte y cinco siglos de cultura quechua siguen vivos en cada familia.'}
    </p>
    <div class="hero-ctas">
      <a href={cmsHero?.boton_url || '/destinos'} class="btn-primary">{cmsHero?.boton_texto || 'Explorar destinos →'}</a>
      <a href={cmsHero?.boton2_url || '/como-llegar'} class="btn-outline">{cmsHero?.boton2_texto || 'Cómo llegar'}</a>
    </div>
    <div class="hero-stats" data-cms-tipo="stats">
      {(cmsStats?.items || [
        { valor: '8+',   label: 'Comunidades' },
        { valor: '3,820',label: 'msnm' },
        { valor: '500+', label: 'Años historia' },
        { valor: '12',   label: 'Islas cercanas' },
      ]).map((st: any) => (
        <div class="stat-item">
          <div class="stat-val">{st.valor}</div>
          <div class="stat-label">{st.label}</div>
        </div>
      ))}
    </div>
    <nav class="hero-quicknav" aria-label="Secciones principales">
      <a href="/vivencial">🏠 Vivencial</a>
      <a href="/actividades">🚣 Actividades</a>
      <a href="/gastronomia">🍽️ Gastronomía</a>
      <a href="/festividades">🎊 Festividades</a>
      <a href="/artesania">🧶 Artesanía</a>
      <a href="/destinos">🏔️ Destinos</a>
    </nav>
  </div>


  <!-- Photo Cards -->
  <div class="hero-photo-card hpc-left" id="hpc1" style="top:18%;" onclick="toggleHPC(this)">
    <div class="hpc-thumb">
      <img src="/foto-lago.jpg" alt="Lago Titicaca" loading="lazy"/>
      <div class="hpc-arrow" aria-hidden="true">&#8250;</div>
    </div>
    <div class="hpc-body">
      <span class="hpc-tag">Destinos</span>
      <h4 class="hpc-title">Lago Titicaca</h4>
      <p class="hpc-desc">El lago navegable mas alto del mundo a 3,820 msnm. Aguas azul profundo, cielos inmensos y cinco siglos de historia vivos en cada orilla.</p>
    </div>
  </div>
  <div class="hero-photo-card hpc-left" id="hpc2" style="top:52%;" onclick="toggleHPC(this)">
    <div class="hpc-thumb">
      <img src="/foto-vivencial.jpg" alt="Turismo vivencial" loading="lazy"/>
      <div class="hpc-arrow" aria-hidden="true">&#8250;</div>
    </div>
    <div class="hpc-body">
      <span class="hpc-tag">Vivencial</span>
      <h4 class="hpc-title">Vida en Comunidad</h4>
      <p class="hpc-desc">Convive con familias quechuas, aprende tejido en telar, pesca ancestral y cocina andina en las comunidades de Capachica.</p>
    </div>
  </div>
  <div class="hero-photo-card hpc-right" id="hpc3" style="top:18%;" onclick="toggleHPC(this)">
    <div class="hpc-thumb">
      <img src="/foto-actividades.jpg" alt="Actividades en Capachica" loading="lazy"/>
      <div class="hpc-arrow" aria-hidden="true">&#8250;</div>
    </div>
    <div class="hpc-body">
      <span class="hpc-tag">Actividades</span>
      <h4 class="hpc-title">Aventura en el Lago</h4>
      <p class="hpc-desc">Kayak, pesca tradicional, senderismo entre cactus gigantes y vistas panoramicas del Titicaca desde los miradores de la peninsula.</p>
    </div>
  </div>
  <div class="hero-photo-card hpc-right" id="hpc4" style="top:52%;" onclick="toggleHPC(this)">
    <div class="hpc-thumb">
      <img src="/foto-festividades.jpg" alt="Festividades de Capachica" loading="lazy"/>
      <div class="hpc-arrow" aria-hidden="true">&#8250;</div>
    </div>
    <div class="hpc-body">
      <span class="hpc-tag">Festividades</span>
      <h4 class="hpc-title">Fiestas Ancestrales</h4>
      <p class="hpc-desc">Danzas, musica y rituales milenarios que mantienen viva la herencia cultural quechua del altiplano a orillas del Titicaca.</p>
    </div>
  </div>

  <!-- Wave layers -->
  <div class="hero-waves">
    <div class="wave wave-sand"></div>
    <div class="wave wave-water"></div>
  </div>
</section>

<!-- ═══════════ MAIN (React components o CMS) ═══════════ -->
<main>
  {hasBody ? (
    <SectionRenderer secciones={bodySecciones} />
  ) : (
    <HomeSections client:load />
  )}
</main>

<ChatWidget client:load />

<ArenaFooter />

<script is:inline>
  /* ── THEME RESTORE (before paint) ── */
  (function() {
    const saved = localStorage.getItem('capachica-theme') || localStorage.getItem('theme');
    if (saved) document.documentElement.setAttribute('data-theme', saved);
  })();


  /* -- HERO PHOTO CARDS -- */
  function toggleHPC(card) {
    var wasExpanded = card.classList.contains('expanded');
    document.querySelectorAll('.hero-photo-card').forEach(function(c) {
      c.classList.remove('expanded');
      c.style.opacity = '';
      c.style.pointerEvents = '';
    });
    if (!wasExpanded) {
      card.classList.add('expanded');
      var side = card.classList.contains('hpc-left') ? 'hpc-left' : 'hpc-right';
      document.querySelectorAll('.hero-photo-card.' + side).forEach(function(c) {
        if (c !== card) { c.style.opacity = '0'; c.style.pointerEvents = 'none'; }
      });
    }
  }

  /* -- STARS (gentle twinkle) -- */
  (function initStars() {
    const canvas = document.getElementById('starsCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const resize = () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; };
    resize();
    window.addEventListener('resize', resize, { passive: true });
    const stars = Array.from({ length: 160 }, () => ({
      x:  Math.random(),
      y:  Math.random() * 0.75,
      r:  0.7 + Math.random() * 2.0,
      a:  Math.random() * Math.PI * 2,
      da: 0.0004 + Math.random() * 0.0012,
    }));
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const t = Date.now();
      stars.forEach(s => {
        const alpha = 0.25 + Math.abs(Math.sin(t * s.da)) * 0.60;
        ctx.beginPath();
        ctx.arc(s.x * canvas.width, s.y * canvas.height, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,255,240,${alpha})`;
        ctx.fill();
      });
      requestAnimationFrame(draw);
    }
    draw();
  })();

  /* ── BIRDS (7 with real wing-flap) ── */
  (function initBirds() {
    const container = document.getElementById('heroBirds');
    if (!container) return;
    const birdDefs = [
      { w:60, stroke:2.5, flap:'flapSlow', dur:'1.5s', top:'10%', left:'8%',  float:'birdFloat1', floatDur:'8s' },
      { w:48, stroke:2.0, flap:'flapMed',  dur:'1.1s', top:'16%', left:'72%', float:'birdFloat2', floatDur:'10s' },
      { w:54, stroke:2.2, flap:'flapFast', dur:'0.8s', top:'22%', left:'28%', float:'birdFloat3', floatDur:'7s' },
      { w:40, stroke:1.8, flap:'flapSlow', dur:'1.4s', top:'8%',  left:'88%', float:'birdFloat4', floatDur:'11s' },
      { w:52, stroke:2.2, flap:'flapMed',  dur:'1.2s', top:'28%', left:'50%', float:'birdFloat5', floatDur:'9s' },
      { w:36, stroke:1.6, flap:'flapFast', dur:'0.75s',top:'14%', left:'42%', float:'birdFloat6', floatDur:'12s' },
      { w:46, stroke:2.0, flap:'flapSlow', dur:'1.6s', top:'18%', left:'15%', float:'birdFloat7', floatDur:'8.5s' },
    ];
    birdDefs.forEach(b => {
      const el = document.createElement('div');
      el.className = 'bird';
      el.style.cssText = `top:${b.top};left:${b.left};animation:${b.float} ${b.floatDur} ease-in-out infinite;`;
      const h = b.w * 0.45;
      const cx = b.w / 2; const cy = h * 0.6;
      const wingUp = cy - h * 0.7; const wingMid = cy + h * 0.1;
      el.innerHTML = `<svg width="${b.w}" height="${h}" viewBox="0 0 ${b.w} ${h}" fill="none">
        <path d="M${cx} ${cy} Q${cx - b.w*0.3} ${wingUp} 2 ${wingMid}"
              stroke="currentColor" stroke-width="${b.stroke}" stroke-linecap="round" fill="none"
              style="animation:${b.flap} ${b.dur} ease-in-out infinite;transform-origin:${cx}px ${cy}px"/>
        <path d="M${cx} ${cy} Q${cx + b.w*0.3} ${wingUp} ${b.w - 2} ${wingMid}"
              stroke="currentColor" stroke-width="${b.stroke}" stroke-linecap="round" fill="none"
              style="animation:${b.flap} ${b.dur} ease-in-out infinite;transform-origin:${cx}px ${cy}px;animation-delay:0.06s"/>
      </svg>`;
      container.appendChild(el);
    });
  })();

  /* ── THEME TRANSITION (cinematic moon + sky glow) ── */
  (function initThemeTransition() {
    const html  = document.documentElement;
    const moon  = document.querySelector('.hero-moon');
    const sky   = document.querySelector('.hero-sky');
    const glow  = document.getElementById('skyGlow');
    const stars = document.getElementById('starsCanvas');
    const birds = document.getElementById('heroBirds');
    if (!moon || !sky || !glow) return;

    let lastTheme = html.getAttribute('data-theme') || 'dark';
    new MutationObserver(() => {
      const current = lastTheme;
      const next    = html.getAttribute('data-theme');
      if (next === current) return;
      lastTheme = next;

      moon.classList.remove('theme-switching-down', 'theme-switching-up');
      glow.classList.remove('glow-sunrise', 'glow-sunset');
      void moon.offsetWidth;

      const wash = document.createElement('div');
      wash.style.cssText = 'position:fixed;inset:0;z-index:180;pointer-events:none;opacity:0;transition:opacity 0.45s ease;';
      wash.style.background = current === 'dark'
        ? 'linear-gradient(180deg,rgba(14,72,160,0.18) 0%,rgba(0,100,120,0.26) 50%,rgba(190,170,55,0.18) 100%)'
        : 'linear-gradient(180deg,rgba(4,13,28,0.26) 0%,rgba(4,58,72,0.30) 55%,rgba(26,16,8,0.18) 100%)';
      document.body.appendChild(wash);

      if (current === 'dark') {
        moon.classList.add('theme-switching-down');
        sky.classList.add('sky-transitioning');
        glow.classList.add('glow-sunrise');
        if (stars) { stars.style.transition = 'opacity 2.4s cubic-bezier(0.33,0,0.12,1)'; stars.style.opacity = '0'; }
        if (birds) { birds.classList.add('birds-fade-in'); birds.classList.remove('birds-fade-out'); }
      } else {
        moon.classList.add('theme-switching-down');
        sky.classList.add('sky-transitioning-reverse');
        glow.classList.add('glow-sunset');
        if (stars) { stars.style.transition = 'opacity 1.2s cubic-bezier(0.33,0,0.12,1)'; stars.style.opacity = '1'; }
        if (birds) { birds.classList.add('birds-fade-out'); birds.classList.remove('birds-fade-in'); }
      }
      setTimeout(() => { wash.style.opacity = '1'; }, 1900);
      setTimeout(() => {
        moon.classList.remove('theme-switching-down');
        sky.classList.remove('sky-transitioning', 'sky-transitioning-reverse');
        glow.classList.remove('glow-sunrise', 'glow-sunset');
        void moon.offsetWidth;
        moon.classList.add('theme-switching-up');
        wash.style.transition = 'opacity 1.1s cubic-bezier(0.33,0,0.12,1)';
        wash.style.opacity = '0';
        setTimeout(() => { moon.classList.remove('theme-switching-up'); wash.remove(); }, 2500);
      }, 2400);
    }).observe(html, { attributes: true, attributeFilter: ['data-theme'] });
  })();


  /* ── REVEAL (for React components) ── */
  (function initReveal() {
    const io = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
      }),
      { threshold: 0.08 }
    );
    document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => io.observe(el));
  })();
</script>

</body>
</html>
