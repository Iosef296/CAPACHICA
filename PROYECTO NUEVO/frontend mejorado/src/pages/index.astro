    .hero-photo-card.expanded::after { content:none; }
    @keyframes hpcLeafIn {
      from{ opacity:0; transform:translateY(-5px); }
      to  { opacity:1; transform:translateY(0); }
    }
    .hpc-thumb { position:relative; width:100%; height:100%; overflow:hidden; }
    .hpc-thumb img { width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.52s ease,object-position 0.52s ease; }
    .hpc-left  .hpc-thumb img { object-position:left center; }
    .hpc-right .hpc-thumb img { object-position:right center; }
    .hero-photo-card.expanded .hpc-thumb img { transform:scale(1.03); object-position:center center; }
    /* fallback bg when no image */
    .hpc-thumb { background:linear-gradient(135deg,#0f2240 0%,#0a3040 100%); }
    /* arrow — sticks to inner edge of card */
    .hpc-arrow {
      position:absolute; top:50%; z-index:2; pointer-events:none;
      background:rgba(34,197,94,0.90); border:none;
      width:22px; height:52px; color:#052e10;
      display:flex; align-items:center; justify-content:center;
      font-size:18px; font-weight:900; line-height:1;
    }
    .hpc-left  .hpc-arrow { right:0; border-radius:0 8px 8px 0; transform:translateY(-50%);          transition:transform 0.45s cubic-bezier(0.4,0,0.2,1); }
    .hpc-right .hpc-arrow { left:0;  border-radius:8px 0 0 8px; transform:translateY(-50%) scaleX(-1); transition:transform 0.45s cubic-bezier(0.4,0,0.2,1); }
    .hpc-left.expanded  .hpc-arrow { transform:translateY(-50%) scaleX(-1); }
    .hpc-right.expanded .hpc-arrow { transform:translateY(-50%); }
    /* body */
    .hpc-body {
      position:absolute; bottom:0; left:0; right:0;
      max-height:0; overflow:hidden;
      transition:max-height 0.52s cubic-bezier(0.4,0,0.2,1),padding 0.35s;
      padding:0 22px;
      background:linear-gradient(to top, rgba(4,9,20,0.97) 0%, rgba(4,9,20,0.88) 55%, transparent 100%);
    }
    .hero-photo-card.expanded .hpc-body { max-height:180px; padding:32px 22px 20px; }
    .hpc-tag {
      display:inline-block; margin-bottom:7px; padding:2px 9px; border-radius:100px;
      background:rgba(34,197,94,0.13); border:1px solid rgba(34,197,94,0.38);
      color:#4ade80; font-size:9px; font-weight:700; letter-spacing:0.13em; text-transform:uppercase;
      font-family:'Space Mono',monospace;
    }
    .hpc-title { font-family:'Playfair Display',serif; font-size:16px; font-weight:700; color:#f0ede8; margin-bottom:6px; line-height:1.2; }
    .hpc-desc  { font-size:13px; color:rgba(240,237,232,0.62); line-height:1.6; }
    @media(max-width:1100px) {
      .hero-photo-card { width:58px; height:170px; }
    }
    /* ≤900px: ocultar side cards → mostrar gallery FAB */
    @media(max-width:900px) {
      .hero-photo-card { display:none !important; }
      .gallery-fab { display:flex !important; }
    }
    @media(max-width:768px) {
      .hero-content { padding-left:1.5rem !important; padding-right:1.5rem !important; }
      .gallery-fab { bottom:195px; }
    }
    @media(max-width:480px) {
      .hero-content { padding-left:1rem !important; padding-right:1rem !important; }
      .gallery-fab { bottom:160px; }
      .gallery-fab-thumbs { width:40px; height:40px; }
    }

    /* ─── GALLERY FAB ─── */
    .gallery-fab {
      display:none; /* hidden on desktop, shown via @media(max-width:900px) */
      position:absolute; bottom:225px; left:50%; transform:translateX(-50%);
      z-index:7; align-items:center; gap:12px;
      background:rgba(6,14,30,0.82); border:1px solid rgba(212,168,67,0.42);
      border-radius:16px; padding:10px 18px 10px 10px;
      cursor:pointer; backdrop-filter:blur(18px);
      box-shadow:0 6px 28px rgba(0,0,0,0.5), 0 0 0 1px rgba(212,168,67,0.1);
      transition:all 0.25s ease; white-space:nowrap;
      animation:fadeUp 0.8s 0.5s ease both;
    }
    .gallery-fab:hover {
      background:rgba(6,14,30,0.96); border-color:rgba(212,168,67,0.72);
      box-shadow:0 10px 40px rgba(0,0,0,0.65), 0 0 0 1px rgba(212,168,67,0.3);
      transform:translateX(-50%) translateY(-2px);
    }
    .gallery-fab-thumbs {
      display:grid; grid-template-columns:1fr 1fr; gap:2px;
      width:48px; height:48px; border-radius:10px; overflow:hidden;
      flex-shrink:0;
    }
    .gallery-fab-thumbs img { width:100%; height:100%; object-fit:cover; display:block; }
    .gallery-fab-text { display:flex; flex-direction:column; gap:2px; }
    .gallery-fab-label { font-family:var(--font-mono); font-size:10px; letter-spacing:1.8px; color:var(--gold); text-transform:uppercase; }
    .gallery-fab-sub { font-size:11.5px; color:rgba(240,237,232,0.5); font-family:'Crimson Pro',serif; }

    /* ─── GALLERY MODAL (bottom sheet) ─── */
    .gallery-modal { display:none; position:fixed; inset:0; z-index:500; }
    .gallery-modal.open { display:block; }
    .gallery-backdrop {
      position:absolute; inset:0; background:rgba(2,5,16,0.88);
      animation:gBack 0.3s ease both;
    }
    @keyframes gBack { from{opacity:0} to{opacity:1} }
    .gallery-sheet {
      position:absolute; bottom:0; left:0; right:0; max-height:92vh;
      background:linear-gradient(180deg,#0a1628 0%,#07101e 100%);
      border-radius:22px 22px 0 0; overflow:hidden;
      box-shadow:0 -16px 64px rgba(0,0,0,0.75);
      border-top:1px solid rgba(212,168,67,0.2);
      display:flex; flex-direction:column;
      animation:gSheet 0.38s cubic-bezier(0.32,0.72,0,1) both;
    }
    @keyframes gSheet { from{transform:translateY(100%)} to{transform:translateY(0)} }
    .gallery-sheet-header {
      display:flex; align-items:center; justify-content:space-between;
      padding:18px 20px 14px; border-bottom:1px solid rgba(45,212,191,0.1); flex-shrink:0;
    }
    .gallery-sheet-title { font-family:'Playfair Display',serif; font-size:22px; color:#f0ede8; }
    .gallery-sheet-sub { font-size:11px; color:rgba(212,168,67,0.6); font-family:'Space Mono',monospace; letter-spacing:1.5px; margin-top:2px; }
    .gallery-close-btn {
      width:36px; height:36px; border-radius:50%;
      background:rgba(240,237,232,0.08); border:1px solid rgba(240,237,232,0.12);
      color:rgba(240,237,232,0.65); font-size:15px; cursor:pointer;
      display:flex; align-items:center; justify-content:center; transition:all 0.2s;
    }
    .gallery-close-btn:hover { background:rgba(240,237,232,0.18); color:#fff; }
    /* Views */
    .gallery-grid-view, .gallery-full-view { display:none; flex-direction:column; flex:1; min-height:0; overflow:hidden; }
    .gallery-grid-view.active, .gallery-full-view.active { display:flex; }
    /* Grid */
    .gallery-grid { display:grid; grid-template-columns:1fr 1fr; gap:3px; padding:3px; overflow-y:auto; flex:1; }
    .gallery-grid-item { position:relative; aspect-ratio:1; overflow:hidden; cursor:pointer; }
    .gallery-grid-item img { width:100%; height:100%; object-fit:cover; display:block; transition:transform 0.35s ease; }
    .gallery-grid-item:active img { transform:scale(0.95); }
    .gallery-grid-overlay {
      position:absolute; inset:0; padding:10px;
      background:linear-gradient(to top, rgba(4,9,20,0.92) 0%, rgba(4,9,20,0) 55%);
      display:flex; flex-direction:column; justify-content:flex-end;
      transition:opacity 0.25s;
    }
    .g-tag { font-family:'Space Mono',monospace; font-size:7.5px; letter-spacing:1.2px; text-transform:uppercase; color:#4ade80; }
    .g-title { font-size:13px; font-weight:700; color:#f0ede8; line-height:1.2; margin-top:2px; }
    /* Fullscreen */
    .gallery-full-view { background:#07101f; }
    .gallery-full-header { display:flex; align-items:center; justify-content:space-between; padding:14px 16px; flex-shrink:0; border-bottom:1px solid rgba(45,212,191,0.08); }
    .gallery-back-btn { background:none; border:none; color:var(--gold); font-size:13px; cursor:pointer; font-family:'Crimson Pro',serif; display:flex; align-items:center; gap:4px; }
    .gallery-counter { font-family:'Space Mono',monospace; font-size:11px; color:rgba(240,237,232,0.4); }
    .gallery-full-img { flex:1; min-height:0; overflow:hidden; }
    .gallery-full-img img { width:100%; height:100%; object-fit:cover; display:block; transition:opacity 0.2s; }
    .gallery-full-info { padding:14px 18px 6px; flex-shrink:0; }
    .gallery-full-tag { display:inline-block; padding:2px 10px; border-radius:100px; background:rgba(34,197,94,0.13); border:1px solid rgba(34,197,94,0.38); font-family:'Space Mono',monospace; font-size:8.5px; letter-spacing:1.5px; text-transform:uppercase; color:#4ade80; margin-bottom:6px; }
    .gallery-full-title { font-family:'Playfair Display',serif; font-size:20px; color:#f0ede8; margin-bottom:4px; }
    .gallery-full-desc { font-size:13px; color:rgba(240,237,232,0.6); line-height:1.6; }
    .gallery-full-nav { display:flex; align-items:center; gap:10px; padding:10px 18px 16px; flex-shrink:0; }
    .gallery-nav-btn { flex:1; background:rgba(212,168,67,0.1); border:1px solid rgba(212,168,67,0.25); color:var(--gold); border-radius:10px; padding:12px; font-size:1.3rem; cursor:pointer; transition:all 0.2s; }
    .gallery-nav-btn:hover { background:rgba(212,168,67,0.22); border-color:rgba(212,168,67,0.5); }
    .gallery-dots { display:flex; gap:6px; justify-content:center; align-items:center; }
    .gallery-dot { width:6px; height:6px; border-radius:50%; background:rgba(240,237,232,0.2); transition:all 0.25s; flex-shrink:0; }
    .gallery-dot.active { background:var(--gold); width:20px; border-radius:3px; }

    /* ─── BOTTOM NAV ─── */
    .bnav { display:none; }
    @media(max-width:768px) {
      body { padding-bottom:calc(62px + env(safe-area-inset-bottom)); }
      .bnav {
        display:flex !important;
        position:fixed; bottom:0; left:0; right:0; z-index:9000;
        height:calc(62px + env(safe-area-inset-bottom));
        padding-bottom:env(safe-area-inset-bottom);
        background:rgba(5,12,22,0.96);
        backdrop-filter:blur(24px) saturate(180%);
        -webkit-backdrop-filter:blur(24px) saturate(180%);
        border-top:1px solid rgba(56,189,248,0.15);
        box-shadow:0 -4px 30px rgba(0,0,0,0.40);
        align-items:stretch;
      }
      [data-theme="light"] .bnav { background:rgba(255,255,255,0.96); border-top-color:rgba(10,80,150,0.12); }
      .chat-fab   { bottom:calc(80px + env(safe-area-inset-bottom)) !important; }
      .chat-panel { bottom:calc(146px + env(safe-area-inset-bottom)) !important; }
    }
    .bnav-tab {
      flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
      gap:3px; color:rgba(240,237,232,0.40); background:transparent; border:none;
      cursor:pointer; padding:0; text-decoration:none;
      -webkit-tap-highlight-color:transparent;
      transition:transform 0.15s ease,color 0.15s ease;
    }
    [data-theme="light"] .bnav-tab { color:rgba(26,26,46,0.38); }
    .bnav-tab:active { transform:scale(0.82); }
    .bnav-tab.bnav-active { color:#38bdf8; }
    [data-theme="light"] .bnav-tab.bnav-active { color:#0369a1; }
    .bnav-pip { width:44px; height:28px; display:flex; align-items:center; justify-content:center; border-radius:14px; transition:background 0.2s; }
    .bnav-tab.bnav-active .bnav-pip { background:rgba(56,189,248,0.13); }
    .bnav-label { font-size:9.5px; font-weight:500; letter-spacing:0.01em; line-height:1; font-family:var(--font-body); }
    .bnav-backdrop { position:fixed; inset:0; z-index:8990; background:rgba(0,0,0,0.55); backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px); }
    .bnav-sheet {
      position:fixed; left:0; right:0; z-index:8995;
      bottom:calc(62px + env(safe-area-inset-bottom));
      background:rgba(7,15,28,0.97); border:1px solid rgba(56,189,248,0.10);
      border-bottom:none; border-radius:24px 24px 0 0; padding:12px 20px 22px;
      backdrop-filter:blur(28px); -webkit-backdrop-filter:blur(28px);
      animation:bnavSheetUp 0.3s cubic-bezier(0.34,1.2,0.64,1);
    }
    [data-theme="light"] .bnav-sheet { background:rgba(255,255,255,0.97); }
    @keyframes bnavSheetUp { from{transform:translateY(100%)} to{transform:translateY(0)} }
    .bnav-handle { width:36px; height:4px; border-radius:2px; background:rgba(240,237,232,0.15); margin:0 auto 16px; }
    .bnav-sheet-title { font-family:var(--font-display); font-size:11px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:#38bdf8; margin-bottom:14px; }
    .bnav-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
    .bnav-more-item {
      display:flex; align-items:center; gap:10px; padding:13px 14px; border-radius:14px;
      text-decoration:none; font-size:14px; font-weight:500; font-family:var(--font-body);
      color:rgba(240,237,232,0.88); background:rgba(56,189,248,0.05);
      border:1px solid rgba(56,189,248,0.10); -webkit-tap-highlight-color:transparent;
    }
    .bnav-more-item:active { transform:scale(0.94); }

    /* ══════════════ MOBILE APP RESTRUCTURE ══════════════ */
    @media(max-width:768px) {
      /* Hero: compact banner (~65vh), preserve 56px top pad for fixed navbar */
      .hero { min-height:65vh !important; padding-top:56px !important; }
      .hero-content {
        padding-top:clamp(62px,10vh,88px) !important;
        padding-left:20px !important;
        padding-right:20px !important;
        margin-bottom:0.5rem !important;
      }

      /* Badge */
      .hero-badge { font-size:8px; padding:3px 10px; margin-bottom:0.5rem; letter-spacing:1.4px; }

      /* Title: bold app heading */
      .hero-title { font-size:clamp(1.85rem,7.5vw,2.6rem) !important; line-height:1.07; }

      /* Desc: 3-line clamp */
      .hero-desc {
        font-size:12.5px !important; line-height:1.5; margin-top:0.35rem;
        display:-webkit-box; -webkit-line-clamp:3;
        -webkit-box-orient:vertical; overflow:hidden; max-width:100%;
      }

      /* CTAs: full-width */
      .hero-ctas { flex-direction:column !important; gap:0.5rem; margin-top:0.85rem; }
      .hero-ctas .btn-primary,
      .hero-ctas .btn-outline {
        width:100% !important; padding:13px 20px !important;
        font-size:14px !important; text-align:center; justify-content:center !important;
      }

      /* Stats: 2x2 app card grid */
      .hero-stats {
        display:grid !important;
        grid-template-columns:1fr 1fr !important;
        gap:6px !important;
        background:transparent !important;
        border:none !important;
        border-radius:0 !important;
        padding:0 !important;
        margin-top:0.85rem !important;
        width:100%;
        backdrop-filter:none !important;
        -webkit-backdrop-filter:none !important;
      }
      .stat-item {
        background:rgba(10,22,40,0.72) !important;
        border:1px solid rgba(45,212,191,0.18) !important;
        border-radius:10px !important;
        border-right:1px solid rgba(45,212,191,0.18) !important;
        flex:none !important;
        padding:10px 12px !important;
        text-align:center;
      }
      .stat-val { font-size:1.15rem !important; }
      .stat-label { font-size:0.6rem !important; }

      /* Hide quick nav pills — bottom nav handles navigation */
      .hero-quicknav { display:none !important; }

      /* Gallery FAB: above bottom nav */
      .gallery-fab { bottom:calc(82px + env(safe-area-inset-bottom)) !important; }

      /* Hero waves: shorter */
      .hero-waves { height:80px !important; }

      /* Main content sections: tighter padding (not hero section) */
      main section { padding:2rem 0 !important; }
      main .container { padding-left:16px !important; padding-right:16px !important; }
    }
    @media(max-width:480px) {
      .hero { min-height:58vh !important; }
      .gallery-fab { bottom:calc(80px + env(safe-area-inset-bottom)) !important; }
      .hero-title { font-size:clamp(1.7rem,8vw,2.3rem) !important; }
    }
  </style>
</head>
<body>

<Navbar client:load />

<!-- ═══════════ HERO ═══════════ -->
<section class="hero">
  <div class="hero-sky"></div>
  <div class="sky-glow" id="skyGlow"></div>
  <canvas class="stars-layer" id="starsCanvas"></canvas>

  <!-- Birds (light mode) -->
  <div class="hero-birds" id="heroBirds"></div>

  <!-- Moon / Sun (same element) -->
  <div class="hero-moon"></div>

  <!-- Content -->
  <div class="hero-content" data-cms-tipo="hero">
    <div class="hero-badge">Puno · Perú · Lago Titicaca</div>
    <h1 class="hero-title">
      {cmsHero?.titulo ? cmsHero.titulo : <Fragment>Descubre<em>Capachica</em></Fragment>}
    </h1>
    <p class="hero-desc">
      {cmsHero?.subtitulo || 'Una península andina a 3,820 msnm donde el lago más alto del mundo navegable se convierte en horizonte y cinco siglos de cultura quechua siguen vivos en cada familia.'}
    </p>
    <div class="hero-ctas">
      <a href={cmsHero?.boton_url || '/destinos'} class="btn-primary">{cmsHero?.boton_texto || 'Explorar destinos →'}</a>
      <a href={cmsHero?.boton2_url || '/como-llegar'} class="btn-outline">{cmsHero?.boton2_texto || 'Cómo llegar'}</a>
    </div>
    <div class="hero-stats" data-cms-tipo="stats">
      {(cmsStats?.items || [
        { valor: '8+',   label: 'Comunidades' },
        { valor: '3,820',label: 'msnm' },
        { valor: '500+', label: 'Años historia' },
        { valor: '12',   label: 'Islas cercanas' },
      ]).map((st: any) => (
        <div class="stat-item">
          <div class="stat-val">{st.valor}</div>
          <div class="stat-label">{st.label}</div>
        </div>
      ))}
    </div>
    <nav class="hero-quicknav" aria-label="Secciones principales">
      <a href="/vivencial">🏠 Vivencial</a>
      <a href="/actividades">🚣 Actividades</a>
      <a href="/gastronomia">🍽️ Gastronomía</a>
      <a href="/festividades">🎊 Festividades</a>
      <a href="/artesania">🧶 Artesanía</a>
      <a href="/destinos">🏔️ Destinos</a>
    </nav>
  </div>


  <!-- Photo Cards -->
  <div class="hero-photo-card hpc-left" id="hpc1" style="top:18%;" onclick="toggleHPC(this)">
    <div class="hpc-thumb">
      <img src="/foto-lago.jpg" alt="Lago Titicaca" loading="lazy"/>
      <div class="hpc-arrow" aria-hidden="true">&#8250;</div>
    </div>
    <div class="hpc-body">
      <span class="hpc-tag">Destinos</span>
      <h4 class="hpc-title">Lago Titicaca</h4>
      <p class="hpc-desc">El lago navegable mas alto del mundo a 3,820 msnm. Aguas azul profundo, cielos inmensos y cinco siglos de historia vivos en cada orilla.</p>
    </div>
  </div>
  <div class="hero-photo-card hpc-left" id="hpc2" style="top:52%;" onclick="toggleHPC(this)">
    <div class="hpc-thumb">
      <img src="/foto-vivencial.jpg" alt="Turismo vivencial" loading="lazy"/>
      <div class="hpc-arrow" aria-hidden="true">&#8250;</div>
    </div>
    <div class="hpc-body">
      <span class="hpc-tag">Vivencial</span>
      <h4 class="hpc-title">Vida en Comunidad</h4>
      <p class="hpc-desc">Convive con familias quechuas, aprende tejido en telar, pesca ancestral y cocina andina en las comunidades de Capachica.</p>
    </div>
  </div>
  <div class="hero-photo-card hpc-right" id="hpc3" style="top:18%;" onclick="toggleHPC(this)">
    <div class="hpc-thumb">
      <img src="/foto-actividades.jpg" alt="Actividades en Capachica" loading="lazy"/>
      <div class="hpc-arrow" aria-hidden="true">&#8250;</div>
    </div>
    <div class="hpc-body">
      <span class="hpc-tag">Actividades</span>
      <h4 class="hpc-title">Aventura en el Lago</h4>
      <p class="hpc-desc">Kayak, pesca tradicional, senderismo entre cactus gigantes y vistas panoramicas del Titicaca desde los miradores de la peninsula.</p>
    </div>
  </div>
  <div class="hero-photo-card hpc-right" id="hpc4" style="top:52%;" onclick="toggleHPC(this)">
    <div class="hpc-thumb">
      <img src="/foto-festividades.jpg" alt="Festividades de Capachica" loading="lazy"/>
      <div class="hpc-arrow" aria-hidden="true">&#8250;</div>
    </div>
    <div class="hpc-body">
      <span class="hpc-tag">Festividades</span>
      <h4 class="hpc-title">Fiestas Ancestrales</h4>
      <p class="hpc-desc">Danzas, musica y rituales milenarios que mantienen viva la herencia cultural quechua del altiplano a orillas del Titicaca.</p>
    </div>
  </div>

  <!-- Gallery FAB: mobile only, shown when side cards hidden -->
  <button class="gallery-fab" onclick="openGallery(0)" aria-label="Ver galería de fotos">
    <div class="gallery-fab-thumbs">
      <img src="/foto-lago.jpg" alt="" />
      <img src="/foto-actividades.jpg" alt="" />
      <img src="/foto-vivencial.jpg" alt="" />
      <img src="/foto-festividades.jpg" alt="" />
    </div>
    <div class="gallery-fab-text">
      <span class="gallery-fab-label">Galería</span>
      <span class="gallery-fab-sub">4 fotos · Explorar</span>
    </div>
  </button>

  <!-- Wave layers -->
  <div class="hero-waves">
    <div class="wave wave-sand"></div>
    <div class="wave wave-water"></div>
  </div>
</section>

<!-- ═══════════ MAIN (React components o CMS) ═══════════ -->
<main>
  {hasBody ? (
    <SectionRenderer secciones={bodySecciones} />
  ) : (
    <HomeSections client:load />
  )}
</main>

<!-- ─── GALLERY MODAL ─── -->
<div class="gallery-modal" id="galleryModal">
  <div class="gallery-backdrop" onclick="closeGallery()"></div>
  <div class="gallery-sheet">
    <div class="gallery-sheet-header">
      <div>
        <div class="gallery-sheet-title">Galería</div>
        <div class="gallery-sheet-sub">CAPACHICA · PERÚ · TITICACA</div>
      </div>
      <button class="gallery-close-btn" onclick="closeGallery()">✕</button>
    </div>
    <div class="gallery-grid-view active" id="gGridView">
      <div class="gallery-grid" id="gGrid"></div>
    </div>
    <div class="gallery-full-view" id="gFullView">
      <div class="gallery-full-header">
        <button class="gallery-back-btn" onclick="gBackToGrid()">← Galería</button>
        <span class="gallery-counter" id="gCounter"></span>
        <button class="gallery-close-btn" onclick="closeGallery()">✕</button>
      </div>
      <div class="gallery-full-img"><img id="gFullImg" src="" alt="" /></div>
      <div class="gallery-full-info">
        <span class="gallery-full-tag" id="gFullTag"></span>
        <h3 class="gallery-full-title" id="gFullTitle"></h3>
        <p class="gallery-full-desc" id="gFullDesc"></p>
      </div>
      <div class="gallery-full-nav">
        <button class="gallery-nav-btn" onclick="gStep(-1)">‹</button>
        <div class="gallery-dots" id="gDots"></div>
        <button class="gallery-nav-btn" onclick="gStep(1)">›</button>
      </div>
    </div>
  </div>
</div>

<ChatWidget client:load />

<ArenaFooter />

<!-- ═══ BOTTOM NAV (mobile ≤768px) ═══ -->
<nav class="bnav" aria-label="Navegación principal">
  <a href="/" class="bnav-tab bnav-active" data-href="/">
    <div class="bnav-pip"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg></div>
    <span class="bnav-label">Inicio</span>
  </a>
  <a href="/destinos" class="bnav-tab" data-href="/destinos">
    <div class="bnav-pip"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
    <span class="bnav-label">Destinos</span>
  </a>
  <a href="/gastronomia" class="bnav-tab" data-href="/gastronomia">
    <div class="bnav-pip"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 002-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 00-5 5v6c0 .55.45 1 1 1h4v6"/></svg></div>
    <span class="bnav-label">Gastronomía</span>
  </a>
  <a href="/festividades" class="bnav-tab" data-href="/festividades">
    <div class="bnav-pip"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
    <span class="bnav-label">Festivid.</span>
  </a>
  <button class="bnav-tab" id="bnavMoreBtn" aria-label="Más páginas">
    <div class="bnav-pip"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg></div>
    <span class="bnav-label">Más</span>
  </button>
</nav>
<div class="bnav-backdrop" id="bnavBackdrop" style="display:none"></div>
<div class="bnav-sheet" id="bnavSheet" style="display:none">
  <div class="bnav-handle"></div>
  <div class="bnav-sheet-title">Explorar</div>
  <div class="bnav-grid">
    <a href="/vivencial"   class="bnav-more-item"><span>🌿</span><span>Vivencial</span></a>
    <a href="/actividades" class="bnav-more-item"><span>🏔️</span><span>Actividades</span></a>
    <a href="/artesania"   class="bnav-more-item"><span>🎨</span><span>Artesanía</span></a>
    <a href="/alojamiento" class="bnav-more-item"><span>🏡</span><span>Alojamiento</span></a>
    <a href="/como-llegar" class="bnav-more-item"><span>🗺️</span><span>Cómo Llegar</span></a>
  </div>
</div>

<script is:inline>
  /* ── THEME RESTORE (before paint) ── */
  (function() {
    const saved = localStorage.getItem('capachica-theme') || localStorage.getItem('theme');
    if (saved) document.documentElement.setAttribute('data-theme', saved);
  })();


  /* ── GALLERY ── */
  var G_DATA = [
    { src:'/foto-lago.jpg',         tag:'Destinos',     title:'Lago Titicaca',       desc:'El lago navegable más alto del mundo a 3,820 msnm. Aguas azul profundo, cielos inmensos y cinco siglos de historia.' },
    { src:'/foto-vivencial.jpg',    tag:'Vivencial',    title:'Vida en Comunidad',   desc:'Convive con familias quechuas, aprende tejido en telar, pesca ancestral y cocina andina en Capachica.' },
    { src:'/foto-actividades.jpg',  tag:'Actividades',  title:'Aventura en el Lago', desc:'Kayak, pesca tradicional, senderismo entre cactus gigantes y vistas panorámicas desde los miradores.' },
    { src:'/foto-festividades.jpg', tag:'Festividades', title:'Fiestas Ancestrales', desc:'Danzas, música y rituales milenarios que mantienen viva la herencia cultural quechua del altiplano.' },
  ];
  var gIdx = 0;

  (function buildGrid() {
    var grid = document.getElementById('gGrid');
    if (!grid) return;
    G_DATA.forEach(function(p, i) {
      var el = document.createElement('div');
      el.className = 'gallery-grid-item';
      el.innerHTML = '<img src="' + p.src + '" alt="' + p.title + '" loading="lazy" />'
        + '<div class="gallery-grid-overlay">'
        + '<span class="g-tag">' + p.tag + '</span>'
        + '<span class="g-title">' + p.title + '</span>'
        + '</div>';
      el.addEventListener('click', function() { gOpenFull(i); });
      grid.appendChild(el);
    });
    buildDots();
  })();

  function buildDots() {
    var wrap = document.getElementById('gDots');
    if (!wrap) return;
    wrap.innerHTML = '';
    G_DATA.forEach(function(_, i) {
      var d = document.createElement('span');
      d.className = 'gallery-dot' + (i === 0 ? ' active' : '');
      d.addEventListener('click', function() { gOpenFull(i); });
      wrap.appendChild(d);
    });
  }

  function openGallery(i) {
    gIdx = i;
    document.getElementById('galleryModal').classList.add('open');
    document.body.style.overflow = 'hidden';
    gShowGrid();
  }
  function closeGallery() {
    document.getElementById('galleryModal').classList.remove('open');
    document.body.style.overflow = '';
  }
  function gShowGrid() {
    document.getElementById('gGridView').classList.add('active');
    document.getElementById('gFullView').classList.remove('active');
  }
  function gBackToGrid() { gShowGrid(); }
  function gOpenFull(i) {
    gIdx = i;
    gRenderFull();
    document.getElementById('gGridView').classList.remove('active');
    document.getElementById('gFullView').classList.add('active');
  }
  function gStep(d) {
    gIdx = (gIdx + d + G_DATA.length) % G_DATA.length;
    gRenderFull();
  }
  function gRenderFull() {
    var p = G_DATA[gIdx];
    var img = document.getElementById('gFullImg');
    img.style.opacity = '0';
    img.src = p.src; img.alt = p.title;
    img.onload = function() { img.style.opacity = '1'; };
    document.getElementById('gFullTag').textContent = p.tag;
    document.getElementById('gFullTitle').textContent = p.title;
    document.getElementById('gFullDesc').textContent = p.desc;
    document.getElementById('gCounter').textContent = (gIdx + 1) + ' / ' + G_DATA.length;
    document.querySelectorAll('.gallery-dot').forEach(function(d, i) {
      d.classList.toggle('active', i === gIdx);
    });
  }
  /* Swipe support */
  (function() {
    var startX = 0;
    var full = document.getElementById('gFullView');
    if (!full) return;
    full.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; }, { passive:true });
    full.addEventListener('touchend', function(e) {
      var dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) gStep(dx < 0 ? 1 : -1);
    }, { passive:true });
  })();
  /* Close on Escape */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeGallery();
  });

  /* -- HERO PHOTO CARDS -- */
  function toggleHPC(card) {
    var wasExpanded = card.classList.contains('expanded');
    document.querySelectorAll('.hero-photo-card').forEach(function(c) {
      c.classList.remove('expanded');
      c.style.opacity = '';
      c.style.pointerEvents = '';
    });
    if (!wasExpanded) {
      card.classList.add('expanded');
      var side = card.classList.contains('hpc-left') ? 'hpc-left' : 'hpc-right';
      document.querySelectorAll('.hero-photo-card.' + side).forEach(function(c) {
        if (c !== card) { c.style.opacity = '0'; c.style.pointerEvents = 'none'; }
      });
    }
  }

  /* -- STARS (gentle twinkle) -- */
  (function initStars() {
    const canvas = document.getElementById('starsCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const resize = () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; };
    resize();
    window.addEventListener('resize', resize, { passive: true });
    const stars = Array.from({ length: 160 }, () => ({
      x:  Math.random(),
      y:  Math.random() * 0.75,
      r:  0.7 + Math.random() * 2.0,
      a:  Math.random() * Math.PI * 2,
      da: 0.0004 + Math.random() * 0.0012,
    }));
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const t = Date.now();
      stars.forEach(s => {
        const alpha = 0.25 + Math.abs(Math.sin(t * s.da)) * 0.60;
        ctx.beginPath();
        ctx.arc(s.x * canvas.width, s.y * canvas.height, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,255,240,${alpha})`;
        ctx.fill();
      });
      requestAnimationFrame(draw);
    }
    draw();
  })();

  /* ── BIRDS (7 with real wing-flap) ── */
  (function initBirds() {
    const container = document.getElementById('heroBirds');
    if (!container) return;
    const birdDefs = [
      { w:60, stroke:2.5, flap:'flapSlow', dur:'1.5s', top:'10%', left:'8%',  float:'birdFloat1', floatDur:'8s' },
      { w:48, stroke:2.0, flap:'flapMed',  dur:'1.1s', top:'16%', left:'72%', float:'birdFloat2', floatDur:'10s' },
      { w:54, stroke:2.2, flap:'flapFast', dur:'0.8s', top:'22%', left:'28%', float:'birdFloat3', floatDur:'7s' },
      { w:40, stroke:1.8, flap:'flapSlow', dur:'1.4s', top:'8%',  left:'88%', float:'birdFloat4', floatDur:'11s' },
      { w:52, stroke:2.2, flap:'flapMed',  dur:'1.2s', top:'28%', left:'50%', float:'birdFloat5', floatDur:'9s' },
      { w:36, stroke:1.6, flap:'flapFast', dur:'0.75s',top:'14%', left:'42%', float:'birdFloat6', floatDur:'12s' },
      { w:46, stroke:2.0, flap:'flapSlow', dur:'1.6s', top:'18%', left:'15%', float:'birdFloat7', floatDur:'8.5s' },
    ];
    birdDefs.forEach(b => {
      const el = document.createElement('div');
      el.className = 'bird';
      el.style.cssText = `top:${b.top};left:${b.left};animation:${b.float} ${b.floatDur} ease-in-out infinite;`;
      const h = b.w * 0.45;
      const cx = b.w / 2; const cy = h * 0.6;
      const wingUp = cy - h * 0.7; const wingMid = cy + h * 0.1;
      el.innerHTML = `<svg width="${b.w}" height="${h}" viewBox="0 0 ${b.w} ${h}" fill="none">
        <path d="M${cx} ${cy} Q${cx - b.w*0.3} ${wingUp} 2 ${wingMid}"
              stroke="currentColor" stroke-width="${b.stroke}" stroke-linecap="round" fill="none"
              style="animation:${b.flap} ${b.dur} ease-in-out infinite;transform-origin:${cx}px ${cy}px"/>
        <path d="M${cx} ${cy} Q${cx + b.w*0.3} ${wingUp} ${b.w - 2} ${wingMid}"
              stroke="currentColor" stroke-width="${b.stroke}" stroke-linecap="round" fill="none"
              style="animation:${b.flap} ${b.dur} ease-in-out infinite;transform-origin:${cx}px ${cy}px;animation-delay:0.06s"/>
      </svg>`;
      container.appendChild(el);
    });
  })();

  /* ── THEME TRANSITION (cinematic moon + sky glow) ── */
  (function initThemeTransition() {
    const html  = document.documentElement;
    const moon  = document.querySelector('.hero-moon');
    const sky   = document.querySelector('.hero-sky');
    const glow  = document.getElementById('skyGlow');
    const stars = document.getElementById('starsCanvas');
    const birds = document.getElementById('heroBirds');
    if (!moon || !sky || !glow) return;

    let lastTheme = html.getAttribute('data-theme') || 'dark';
    new MutationObserver(() => {
      const current = lastTheme;
      const next    = html.getAttribute('data-theme');
      if (next === current) return;
      lastTheme = next;

      moon.classList.remove('theme-switching-down', 'theme-switching-up');
      glow.classList.remove('glow-sunrise', 'glow-sunset');
      void moon.offsetWidth;

      const wash = document.createElement('div');
      wash.style.cssText = 'position:fixed;inset:0;z-index:180;pointer-events:none;opacity:0;transition:opacity 0.45s ease;';
      wash.style.background = current === 'dark'
        ? 'linear-gradient(180deg,rgba(14,72,160,0.18) 0%,rgba(0,100,120,0.26) 50%,rgba(190,170,55,0.18) 100%)'
        : 'linear-gradient(180deg,rgba(4,13,28,0.26) 0%,rgba(4,58,72,0.30) 55%,rgba(26,16,8,0.18) 100%)';
      document.body.appendChild(wash);

      if (current === 'dark') {
        moon.classList.add('theme-switching-down');
        sky.classList.add('sky-transitioning');
        glow.classList.add('glow-sunrise');
        if (stars) { stars.style.transition = 'opacity 2.4s cubic-bezier(0.33,0,0.12,1)'; stars.style.opacity = '0'; }
        if (birds) { birds.classList.add('birds-fade-in'); birds.classList.remove('birds-fade-out'); }
      } else {
        moon.classList.add('theme-switching-down');
        sky.classList.add('sky-transitioning-reverse');
        glow.classList.add('glow-sunset');
        if (stars) { stars.style.transition = 'opacity 1.2s cubic-bezier(0.33,0,0.12,1)'; stars.style.opacity = '1'; }
        if (birds) { birds.classList.add('birds-fade-out'); birds.classList.remove('birds-fade-in'); }
      }
      setTimeout(() => { wash.style.opacity = '1'; }, 1900);
      setTimeout(() => {
        moon.classList.remove('theme-switching-down');
        sky.classList.remove('sky-transitioning', 'sky-transitioning-reverse');
        glow.classList.remove('glow-sunrise', 'glow-sunset');
        void moon.offsetWidth;
        moon.classList.add('theme-switching-up');
        wash.style.transition = 'opacity 1.1s cubic-bezier(0.33,0,0.12,1)';
        wash.style.opacity = '0';
        setTimeout(() => { moon.classList.remove('theme-switching-up'); wash.remove(); }, 2500);
      }, 2400);
    }).observe(html, { attributes: true, attributeFilter: ['data-theme'] });
  })();


  /* ── REVEAL (for React components) ── */
  (function initReveal() {
    const io = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
      }),
      { threshold: 0.08 }
    );
    document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => io.observe(el));
  })();

  /* ── BOTTOM NAV sheet ── */
  (function() {
    var btn = document.getElementById('bnavMoreBtn');
    var backdrop = document.getElementById('bnavBackdrop');
    var sheet = document.getElementById('bnavSheet');
    function open() { backdrop.style.display='block'; sheet.style.display='block'; if(btn) btn.classList.add('bnav-active'); }
    function close() { backdrop.style.display='none'; sheet.style.display='none'; if(btn) btn.classList.remove('bnav-active'); }
    if(btn) btn.addEventListener('click', function(){ sheet.style.display==='none'? open():close(); });
    if(backdrop) backdrop.addEventListener('click', close);
    document.addEventListener('keydown', function(e){ if(e.key==='Escape') close(); });
  })();
</script>

</body>
</html>
