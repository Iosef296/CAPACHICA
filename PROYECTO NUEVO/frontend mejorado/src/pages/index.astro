    .hero-photo-card.expanded::after { content:none; }
    @keyframes hpcLeafIn {
      from{ opacity:0; transform:translateY(-5px); }
      to  { opacity:1; transform:translateY(0); }
    }
    .hpc-thumb { position:relative; width:100%; height:100%; overflow:hidden; }
    .hpc-thumb img { width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.52s ease,object-position 0.52s ease; }
    .hpc-left  .hpc-thumb img { object-position:left center; }
    .hpc-right .hpc-thumb img { object-position:right center; }
    .hero-photo-card.expanded .hpc-thumb img { transform:scale(1.03); object-position:center center; }
    /* fallback bg when no image */
    .hpc-thumb { background:linear-gradient(135deg,#0f2240 0%,#0a3040 100%); }
    /* arrow — sticks to inner edge of card */
    .hpc-arrow {
      position:absolute; top:50%; z-index:2; pointer-events:none;
      background:rgba(34,197,94,0.90); border:none;
      width:22px; height:52px; color:#052e10;
      display:flex; align-items:center; justify-content:center;
      font-size:18px; font-weight:900; line-height:1;
    }
    .hpc-left  .hpc-arrow { right:0; border-radius:0 8px 8px 0; transform:translateY(-50%);          transition:transform 0.45s cubic-bezier(0.4,0,0.2,1); }
    .hpc-right .hpc-arrow { left:0;  border-radius:8px 0 0 8px; transform:translateY(-50%) scaleX(-1); transition:transform 0.45s cubic-bezier(0.4,0,0.2,1); }
    .hpc-left.expanded  .hpc-arrow { transform:translateY(-50%) scaleX(-1); }
    .hpc-right.expanded .hpc-arrow { transform:translateY(-50%); }
    /* body */
    .hpc-body {
      position:absolute; bottom:0; left:0; right:0;
      max-height:0; overflow:hidden;
      transition:max-height 0.52s cubic-bezier(0.4,0,0.2,1),padding 0.35s;
      padding:0 22px;
      background:linear-gradient(to top, rgba(4,9,20,0.97) 0%, rgba(4,9,20,0.88) 55%, transparent 100%);
    }
    .hero-photo-card.expanded .hpc-body { max-height:180px; padding:32px 22px 20px; }
    .hpc-tag {
      display:inline-block; margin-bottom:7px; padding:2px 9px; border-radius:100px;
      background:rgba(34,197,94,0.13); border:1px solid rgba(34,197,94,0.38);
      color:#4ade80; font-size:9px; font-weight:700; letter-spacing:0.13em; text-transform:uppercase;
      font-family:'Space Mono',monospace;
    }
    .hpc-title { font-family:'Playfair Display',serif; font-size:16px; font-weight:700; color:#f0ede8; margin-bottom:6px; line-height:1.2; }
    .hpc-desc  { font-size:13px; color:rgba(240,237,232,0.62); line-height:1.6; }
    @media(max-width:1100px) { .hero-photo-card { display:none !important; } }
  </style>
</head>
<body>

<Navbar client:load />

<!-- ═══════════ HERO ═══════════ -->
<section class="hero">
  <div class="hero-sky"></div>
  <div class="sky-glow" id="skyGlow"></div>
  <canvas class="stars-layer" id="starsCanvas"></canvas>

  <!-- Birds (light mode) -->
  <div class="hero-birds" id="heroBirds"></div>

  <!-- Moon / Sun (same element) -->
  <div class="hero-moon"></div>

  <!-- Content -->
  <div class="hero-content" data-cms-tipo="hero">
    <div class="hero-badge">Puno · Perú · Lago Titicaca</div>
    <h1 class="hero-title">
      {cmsHero?.titulo ? cmsHero.titulo : <Fragment>Descubre<em>Capachica</em></Fragment>}
    </h1>
    <p class="hero-desc">
      {cmsHero?.subtitulo || 'Una península andina a 3,820 msnm donde el lago más alto del mundo navegable se convierte en horizonte y cinco siglos de cultura quechua siguen vivos en cada familia.'}
    </p>
    <div class="hero-ctas">
      <a href={cmsHero?.boton_url || '/destinos'} class="btn-primary">{cmsHero?.boton_texto || 'Explorar destinos →'}</a>
      <a href={cmsHero?.boton2_url || '/como-llegar'} class="btn-outline">{cmsHero?.boton2_texto || 'Cómo llegar'}</a>
    </div>
    <div class="hero-stats" data-cms-tipo="stats">
      {(cmsStats?.items || [
        { valor: '8+',   label: 'Comunidades' },
        { valor: '3,820',label: 'msnm' },
        { valor: '500+', label: 'Años historia' },
        { valor: '12',   label: 'Islas cercanas' },
      ]).map((st: any) => (
        <div class="stat-item">
          <div class="stat-val">{st.valor}</div>
          <div class="stat-label">{st.label}</div>
        </div>
      ))}
    </div>
    <nav class="hero-quicknav" aria-label="Secciones principales">
      <a href="/vivencial">🏠 Vivencial</a>
      <a href="/actividades">🚣 Actividades</a>
