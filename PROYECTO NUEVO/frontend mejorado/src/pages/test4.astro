---
import Layout from '../layouts/Layout.astro';
import HomeSections from '../components/HomeSections';

const IA_URL = import.meta.env.PUBLIC_IA_URL || 'http://localhost:5000';
let cms: any = null;
try { const r = await fetch(`${IA_URL}/api/contenido/index`); if (r.ok) cms = await r.json(); } catch {}
const cmsHero = cms?.secciones?.find((s: any) => s.tipo === 'hero');
const cmsStats = cms?.secciones?.find((s: any) => s.tipo === 'stats');
const statsData = cmsStats?.items || [
  { valor: '8+', label: 'Comunidades' },
  { valor: '3,820', label: 'msnm' },
  { valor: '500+', label: 'Años historia' },
  { valor: '12', label: 'Islas cercanas' },
];
---

<Layout
  title="Test4 — Paneles laterales anchos"
  description="Test: wide side panels showing photo + category label"
>
  <Fragment slot="hero">
    <div class="idx-badge">Puno · Perú · Lago Titicaca</div>
    <h1 class="t4-title">
      {cmsHero?.titulo ? cmsHero.titulo : <Fragment>Descubre <em>Capachica</em></Fragment>}
    </h1>
    <p class="t4-desc">
      {cmsHero?.subtitulo || 'Una península andina a 3,820 msnm donde el lago más alto del mundo navegable se convierte en horizonte y cinco siglos de cultura quechua siguen vivos en cada familia.'}
    </p>
    <div class="t4-ctas">
      <a href="/destinos" class="btn-primary">Explorar destinos →</a>
      <a href="/como-llegar" class="btn-outline">Cómo llegar</a>
    </div>
    <div class="t4-stats">
      {statsData.map((st: any) => (
        <div class="t4-stat">
          <div class="t4-stat-val">{st.valor}</div>
          <div class="t4-stat-lbl">{st.label}</div>
        </div>
      ))}
    </div>
    <nav class="t4-quicknav">
      <a href="/vivencial">🏡 Vivencial</a>
      <a href="/actividades">🏔️ Actividades</a>
      <a href="/gastronomia">🍽️ Gastronomía</a>
      <a href="/festividades">🎊 Festividades</a>
      <a href="/artesania">🧶 Artesanía</a>
      <a href="/destinos">🗺️ Destinos</a>
    </nav>
  </Fragment>

  <Fragment slot="hero-overlay">
    <!-- LEFT CARDS -->
    <div class="t4-card t4-left" style="top:16%" onclick="expandT4(this,0)">
      <img src="/foto-lago.jpg" alt="Lago Titicaca" loading="lazy" />
      <div class="t4-card-label">
        <span class="t4-cat">Destinos</span>
        <span class="t4-name">Lago Titicaca</span>
      </div>
      <div class="t4-expand-icon">›</div>
    </div>
    <div class="t4-card t4-left" style="top:53%" onclick="expandT4(this,1)">
      <img src="/foto-vivencial.jpg" alt="Turismo vivencial" loading="lazy" />
      <div class="t4-card-label">
        <span class="t4-cat">Vivencial</span>
        <span class="t4-name">Vida en Comunidad</span>
      </div>
      <div class="t4-expand-icon">›</div>
    </div>
    <!-- RIGHT CARDS -->
    <div class="t4-card t4-right" style="top:16%" onclick="expandT4(this,2)">
      <img src="/foto-actividades.jpg" alt="Actividades" loading="lazy" />
      <div class="t4-card-label">
        <span class="t4-cat">Actividades</span>
        <span class="t4-name">Aventura</span>
      </div>
      <div class="t4-expand-icon">‹</div>
    </div>
    <div class="t4-card t4-right" style="top:53%" onclick="expandT4(this,3)">
      <img src="/foto-festividades.jpg" alt="Festividades" loading="lazy" />
      <div class="t4-card-label">
        <span class="t4-cat">Festividades</span>
        <span class="t4-name">Fiestas</span>
      </div>
      <div class="t4-expand-icon">‹</div>
    </div>
    <!-- EXPANDED OVERLAY -->
    <div class="t4-overlay" id="t4Overlay" onclick="closeT4()">
      <div class="t4-full" onclick="event.stopPropagation()">
        <button class="t4-close" onclick="closeT4()">✕</button>
        <img id="t4FullImg" src="" alt="" />
        <div class="t4-full-info">
          <span class="t4-full-cat" id="t4FullCat"></span>
          <h3 class="t4-full-title" id="t4FullTitle"></h3>
          <p class="t4-full-desc" id="t4FullDesc"></p>
        </div>
        <div class="t4-full-nav">
          <button onclick="stepT4(-1)">‹ Anterior</button>
          <button onclick="stepT4(1)">Siguiente ›</button>
        </div>
      </div>
    </div>
  </Fragment>

  <HomeSections client:load />
</Layout>

<style is:global>
.idx-badge {
  display:inline-flex; align-items:center; gap:6px;
  padding:5px 16px; border-radius:100px;
  border:1px solid rgba(212,168,67,0.45); background:rgba(212,168,67,0.10);
  font-family:var(--font-mono); font-size:10px; letter-spacing:2px;
  color:var(--gold); text-transform:uppercase;
  margin-bottom:1.2rem; animation:fadeUp 0.8s ease both;
}
.idx-badge::before { content:''; width:6px; height:6px; border-radius:50%; background:var(--gold); animation:t4blink 2s ease-in-out infinite; }
@keyframes t4blink { 0%,100%{opacity:1} 50%{opacity:0.3} }

/* ─── CONTENT ─── */
.t4-title {
  font-family:var(--font-display); font-size:clamp(3rem,8vw,6rem);
  line-height:1.05; color:var(--text-main); animation:fadeUp 0.8s 0.1s ease both;
}
.t4-title em { display:block; font-style:italic; color:var(--gold); }
.t4-desc {
  font-size:clamp(0.95rem,2vw,1.2rem); color:var(--text-muted);
  max-width:500px; margin:0.8rem auto 0; line-height:1.75; text-align:center;
  animation:fadeUp 0.8s 0.2s ease both;
}
.t4-ctas { display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; margin-top:2rem; animation:fadeUp 0.8s 0.3s ease both; }
.t4-stats {
  display:flex; gap:0; background:rgba(10,22,40,0.7); border:1px solid rgba(45,212,191,0.2);
  border-radius:12px; backdrop-filter:blur(12px); overflow:hidden;
  margin-top:2rem; animation:fadeUp 0.8s 0.4s ease both; flex-wrap:wrap;
}
.t4-stat { padding:12px 20px; text-align:center; border-right:1px solid rgba(45,212,191,0.12); flex:1; min-width:70px; }
.t4-stat:last-child { border-right:none; }
.t4-stat-val { font-family:var(--font-display); font-size:1.4rem; font-weight:700; color:var(--gold); line-height:1; }
.t4-stat-lbl { font-size:0.68rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px; margin-top:3px; }
.t4-quicknav { display:flex; gap:0.5rem; justify-content:center; flex-wrap:wrap; margin-top:1.6rem; animation:fadeUp 0.8s 0.45s ease both; }
.t4-quicknav a {
  padding:5px 13px; border-radius:100px; font-size:11px; font-weight:600;
  border:1px solid rgba(240,237,232,0.15); color:rgba(240,237,232,0.65);
  background:rgba(255,255,255,0.05); text-decoration:none; letter-spacing:0.04em; transition:all 0.25s;
}
.t4-quicknav a:hover { border-color:rgba(212,168,67,0.5); color:var(--gold); background:rgba(212,168,67,0.08); }

/* ─── SIDE CARDS ─── */
.t4-card {
  position:absolute; z-index:4; cursor:pointer;
  width:72px; height:200px;
  border-radius:12px; overflow:hidden;
  border:2px solid rgba(212,168,67,0.5);
  box-shadow:0 4px 20px rgba(0,0,0,0.5), 0 0 0 1px rgba(212,168,67,0.15);
  transition:width 0.35s cubic-bezier(0.4,0,0.2,1), box-shadow 0.35s;
}
.t4-card:hover { box-shadow:0 6px 28px rgba(0,0,0,0.6), 0 0 0 2px rgba(212,168,67,0.4); }
.t4-card img {
  width:100%; height:100%; object-fit:cover; display:block;
  transition:transform 0.4s ease;
}
.t4-card:hover img { transform:scale(1.06); }
.t4-left  { left:0; border-radius:0 12px 12px 0; border-left:none; }
.t4-right { right:0; border-radius:12px 0 0 12px; border-right:none; }
.t4-left  img { object-position:left center; }
.t4-right img { object-position:right center; }

.t4-card-label {
  position:absolute; bottom:0; left:0; right:0; padding:24px 7px 7px;
  background:linear-gradient(to top, rgba(4,9,20,0.95) 0%, transparent 100%);
  display:flex; flex-direction:column; gap:1px;
}
.t4-cat {
  font-family:var(--font-mono); font-size:7px; letter-spacing:1.2px;
  text-transform:uppercase; color:#4ade80; white-space:nowrap; overflow:hidden;
}
.t4-name {
  font-size:10px; font-weight:600; color:#f0ede8; line-height:1.2;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.t4-expand-icon {
  position:absolute; top:50%; transform:translateY(-50%);
  font-size:1.6rem; color:rgba(255,255,255,0.85);
  text-shadow:0 1px 4px rgba(0,0,0,0.6); font-weight:300;
  transition:opacity 0.2s;
}
.t4-left  .t4-expand-icon { right:4px; }
.t4-right .t4-expand-icon { left:4px; }

/* ─── EXPANDED OVERLAY ─── */
.t4-overlay {
  display:none; position:absolute; inset:0; z-index:20;
  background:rgba(0,0,0,0.8); align-items:center; justify-content:center;
}
.t4-overlay.open { display:flex; }
.t4-full {
  position:relative; width:min(88vw,500px);
  background:rgba(6,14,30,0.98); border-radius:16px;
  border:1px solid rgba(212,168,67,0.3); overflow:hidden;
  box-shadow:0 24px 80px rgba(0,0,0,0.8);
}
.t4-full img { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; }
.t4-full-info { padding:14px 18px 8px; }
.t4-full-cat {
  display:inline-block; padding:2px 9px; border-radius:100px;
  background:rgba(34,197,94,0.13); border:1px solid rgba(34,197,94,0.38);
  font-family:var(--font-mono); font-size:9px; letter-spacing:1.5px;
  text-transform:uppercase; color:#4ade80; margin-bottom:6px;
}
.t4-full-title { font-family:var(--font-display); font-size:20px; color:#f0ede8; margin-bottom:6px; }
.t4-full-desc { font-size:13px; color:rgba(240,237,232,0.65); line-height:1.6; }
.t4-full-nav { display:flex; gap:10px; padding:10px 18px 16px; }
.t4-full-nav button {
  flex:1; background:rgba(212,168,67,0.1); border:1px solid rgba(212,168,67,0.3);
  color:var(--gold); border-radius:8px; padding:8px; font-size:14px;
  cursor:pointer; font-family:var(--font-body); transition:background 0.2s;
}
.t4-full-nav button:hover { background:rgba(212,168,67,0.22); }
.t4-close {
  position:absolute; top:10px; right:12px; z-index:1;
  background:rgba(0,0,0,0.55); border:none; color:#fff;
  border-radius:50%; width:30px; height:30px; font-size:14px;
  cursor:pointer; display:flex; align-items:center; justify-content:center;
}

/* ─── RESPONSIVE ─── */
@media(max-width:768px) {
  .t4-title { font-size:clamp(2.4rem,10vw,4rem) !important; }
  .t4-ctas { flex-direction:column; align-items:center; gap:0.75rem; }
  .t4-ctas .btn-primary, .t4-ctas .btn-outline { width:min(100%,280px); text-align:center; justify-content:center; }
  .t4-stats { width:100%; flex-wrap:wrap; border-radius:8px; }
  .t4-stat { flex:1; min-width:70px; padding:10px 12px; }
  .t4-stat-val { font-size:1.2rem; }
  .t4-quicknav a { font-size:9px; padding:4px 8px; }
  /* Cards wider on mobile — visible photo + label */
  .t4-card { width:90px; height:180px; }
  .t4-name { font-size:9px; }
  .t4-cat { font-size:6.5px; }
}
@media(max-width:480px) {
  .t4-card { width:72px; height:150px; }
  .t4-stats { border-radius:0; margin-left:-1rem; margin-right:-1rem; }
}
</style>

<script is:inline>
const T4_DATA = [
  { src:'/foto-lago.jpg',        tag:'Destinos',     title:'Lago Titicaca',      desc:'El lago navegable más alto del mundo a 3,820 msnm. Aguas azul profundo y cinco siglos de historia.' },
  { src:'/foto-vivencial.jpg',   tag:'Vivencial',    title:'Vida en Comunidad',  desc:'Convive con familias quechuas, aprende tejido en telar, pesca ancestral y cocina andina.' },
  { src:'/foto-actividades.jpg', tag:'Actividades',  title:'Aventura en el Lago',desc:'Kayak, pesca tradicional, senderismo entre cactus gigantes y vistas panorámicas del Titicaca.' },
  { src:'/foto-festividades.jpg',tag:'Festividades', title:'Fiestas Ancestrales', desc:'Danzas, música y rituales milenarios que mantienen viva la herencia cultural quechua.' },
];
var t4Idx = 0;
function expandT4(el, i) {
  t4Idx = i;
  renderT4();
  document.getElementById('t4Overlay').classList.add('open');
}
function closeT4() { document.getElementById('t4Overlay').classList.remove('open'); }
function stepT4(d) { t4Idx = (t4Idx + d + T4_DATA.length) % T4_DATA.length; renderT4(); }
function renderT4() {
  var p = T4_DATA[t4Idx];
  document.getElementById('t4FullImg').src = p.src;
  document.getElementById('t4FullImg').alt = p.title;
  document.getElementById('t4FullCat').textContent = p.tag;
  document.getElementById('t4FullTitle').textContent = p.title;
  document.getElementById('t4FullDesc').textContent = p.desc;
}
</script>
