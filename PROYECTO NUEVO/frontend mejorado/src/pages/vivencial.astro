---
import Layout from '../layouts/Layout.astro';
import VivencialTimeline from '../components/VivencialTimeline';
import FamiliasGrid from '../components/FamiliasGrid';
import ReservaForm from '../components/ReservaForm';
---
<Layout title="Turismo Vivencial — Capachica">
  <Fragment slot="hero">
    <span class="section-label">VIVENCIAL · CAPACHICA · 3,820 MSNM</span>
    <h1 style="font-family:var(--font-display);font-size:clamp(3rem,7vw,5.5rem);line-height:1.05;color:var(--text-main);margin-bottom:0.4rem;">
      Turismo
    </h1>
    <h1 style="font-family:var(--font-display);font-size:clamp(2.6rem,6.5vw,5rem);font-style:italic;font-weight:400;color:var(--gold);line-height:1.05;margin-bottom:1.2rem;">
      Vivencial
    </h1>
    <p style="font-size:clamp(1rem,2vw,1.15rem);color:var(--text2);max-width:480px;margin:0 auto 2rem;line-height:1.7;">
      Más que turismo: una inmersión real en la vida andina de las familias de Capachica, a orillas del Titicaca.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <a href="#familias" class="btn-primary">Ver familias →</a>
      <a href="#reservar" class="btn-outline">Reservar ahora</a>
    </div>
  </Fragment>

  <VivencialTimeline client:load />
  <FamiliasGrid client:load />
  <ReservaForm client:load />
</Layout>
