---
import Navbar from '../components/Navbar';
import HomeStats from '../components/HomeStats';
import HomeSections from '../components/HomeSections';
---
<html lang="es" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Capachica Turismo — La joya del Lago Titicaca [8-BIT]</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
  <style is:global>
    /* ── CSS VARS — mismos colores del homepage, fuentes y radios overrideados ── */
    :root {
      --turquoise: #2dd4bf;
      --turquoise-dark: #0f9488;
      --turquoise-glow: rgba(45,212,191,0.25);
      --gold: #d4a843;
      --gold-light: #f0c96a;
      --gold-pale: rgba(212,168,67,0.15);
      --navy: #0a1628;
      --navy-mid: #0f2240;
      --navy-light: #162d4e;
      --sand: #e8dcc8;
      --sand-dark: #c4a882;
      --text-main: #f0ede8;
      --text-muted: rgba(240,237,232,0.65);
      --white: #ffffff;
      --card-bg: rgba(10,22,40,0.75);
      --card-border: rgba(45,212,191,0.18);
      --accent: #2dd4bf;
      --accent-glow: rgba(45,212,191,0.25);
      --transition: all 0.06s step-end;
      /* 8-bit: fuente pixelada, sin radio */
      --font-display: 'Press Start 2P', monospace;
      --font-body:    'Press Start 2P', monospace;
      --font-mono:    'Press Start 2P', monospace;
      --radius: 0px; --radius-sm: 0px; --radius-lg: 0px;
      /* alias compat para React components */
      --text: #f0ede8; --text2: rgba(240,237,232,0.65); --text3: rgba(240,237,232,0.38);
      --border: rgba(45,212,191,0.14); --border-hover: rgba(45,212,191,0.35);
      --accent-light: rgba(45,212,191,0.08);
      --bg-main: #0a1628; --bg: #0a1628; --bg2: #0f2240;
      --surface: rgba(10,22,40,0.75); --surface2: rgba(15,34,64,0.5);
      --cyan: #2dd4bf; --emerald: #34d399;
    }

    /* ── GLOBAL 8-BIT RESET ── */
    *, *::before, *::after {
      box-sizing: border-box; margin: 0; padding: 0;
      font-family: 'Press Start 2P', monospace !important;
      border-radius: 0 !important;
    }
    html { scroll-behavior: smooth; }
    body { background: #070D1A; color: #f0ede8; min-height: 100vh; overflow-x: hidden; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #070D1A; }
    ::-webkit-scrollbar-thumb { background: rgba(45,212,191,0.35); }

    /* ── REVEAL — en 8-bit todo aparece inmediatamente, sin fade ── */
    .reveal, .reveal-left, .reveal-right { opacity:1 !important; transform:none !important; transition:none !important; }

    /* ── LAYOUT ── */
    .container { max-width:1200px; margin:0 auto; padding:0 1.5rem; }
    section { padding:90px 0; }
    @media(max-width:768px){ section{padding:60px 0} .container{padding:0 1rem} }

    /* ── TYPOGRAPHY (usada por React components) ── */
    .section-label {
      display:inline-flex; align-items:center; gap:0.5rem;
      padding:0.35rem 1rem; background:rgba(45,212,191,0.08);
      border:2px solid rgba(45,212,191,0.3); color:#2dd4bf;
      font-size:0.55rem; letter-spacing:0.18em; text-transform:uppercase;
      margin-bottom:1.2rem; box-shadow:3px 3px 0 #000;
    }
    .section-title {
      font-size:clamp(13px,2.5vw,20px); font-weight:700;
      line-height:1.55; color:#f0ede8; text-shadow:3px 3px 0 #000;
    }
    .gradient-text { color:#2dd4bf; }
    .divider { width:40px; height:3px; background:linear-gradient(90deg,#2dd4bf,transparent); margin:1rem 0; }
    .text-center .divider { margin:1rem auto; }
    .text-center { text-align:center; }

    /* ── 8-BIT BUTTONS (usados por React components) ── */
    .btn-primary {
      display:inline-flex; align-items:center; gap:8px;
      background:#2dd4bf; color:#0a1628;
      border:none; padding:12px 22px; font-size:8px; cursor:pointer;
      text-decoration:none; letter-spacing:1px;
      box-shadow:4px 4px 0 #0f9488,7px 7px 0 #000;
      transition:transform .06s,box-shadow .06s;
    }
    .btn-primary:hover  { transform:translate(-2px,-2px); box-shadow:6px 6px 0 #0f9488,9px 9px 0 #000; }
    .btn-primary:active { transform:translate(3px,3px); box-shadow:1px 1px 0 #000; }
    .btn-outline {
      display:inline-flex; align-items:center; gap:8px;
      background:transparent; color:#2dd4bf;
      border:3px solid rgba(45,212,191,0.5); padding:12px 22px;
      font-size:8px; cursor:pointer; text-decoration:none; letter-spacing:1px;
      box-shadow:4px 4px 0 rgba(0,0,0,0.5);
      transition:transform .06s,box-shadow .06s;
    }
    .btn-outline:hover  { background:rgba(45,212,191,0.1); border-color:#2dd4bf; }
    .btn-outline:active { transform:translate(3px,3px); }

    /* ── HERO ── */
    .hero {
      position:relative; width:100%; height:100vh; min-height:580px; overflow:hidden;
    }
    #cHero {
      position:absolute; top:0; left:0; right:0; bottom:0;
      width:100%; height:100%;
      image-rendering:pixelated; image-rendering:crisp-edges;
    }
    .hero::before {
      content:''; position:absolute; top:0; left:0; right:0; bottom:0;
      background:repeating-linear-gradient(0deg,transparent 0px,transparent 3px,rgba(0,0,0,0.05) 3px,rgba(0,0,0,0.05) 4px);
      pointer-events:none; z-index:6;
    }
    .hero-content {
      position:absolute; top:0; left:0; right:0; bottom:0;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      padding:90px 2rem 100px; z-index:5;
    }
    .hero-badge {
      display:inline-flex; align-items:center; gap:8px;
      font-size:8px; color:#2dd4bf;
      border:2px solid rgba(45,212,191,0.45); padding:5px 14px;
      background:rgba(45,212,191,0.06); margin-bottom:1.6rem; letter-spacing:2px;
      box-shadow:3px 3px 0 #000; animation:blink8 1.8s step-end infinite;
    }
    .hero-badge::before { content:''; width:6px; height:6px; background:#2dd4bf; display:inline-block; animation:blink8 1.2s step-end infinite; }
    @keyframes blink8 { 0%,100%{opacity:1} 50%{opacity:0.35} }
    .hero-title {
      font-size:clamp(20px,4.5vw,50px); line-height:1.45; text-align:center; color:#f0ede8;
      text-shadow:4px 4px 0 rgba(0,10,30,0.8),7px 7px 0 rgba(0,0,0,0.4);
      margin-bottom:0.9rem;
    }
    .hero-title em { display:block; font-style:normal; color:#d4a843; text-shadow:4px 4px 0 #7a5010,7px 7px 0 rgba(0,0,0,0.4); }
    .hero-desc {
      font-size:8px; color:rgba(240,237,232,0.65); max-width:480px; margin:0 auto;
      line-height:2.2; text-align:center; text-shadow:2px 2px 0 rgba(0,10,30,0.7);
    }
    .hero-ctas {
      display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;
      margin-top:2rem;
    }
    .hero-stats {
      display:flex; gap:0; background:rgba(10,22,40,0.75);
      border:2px solid rgba(45,212,191,0.2); backdrop-filter:blur(12px);
      overflow:hidden; margin-top:2rem; box-shadow:5px 5px 0 #000;
    }
    .stat-item { padding:12px 22px; text-align:center; border-right:1px solid rgba(45,212,191,0.12); }
    .stat-item:last-child { border-right:none; }
    .stat-val   { font-size:1.1rem; font-weight:700; color:#d4a843; line-height:1; text-shadow:2px 2px 0 #7a5010; }
    .stat-label { font-size:6px; color:rgba(240,237,232,0.6); text-transform:uppercase; letter-spacing:1px; margin-top:4px; }

    /* ── MAIN ── */
    main { background:#043a48; position:relative; }

    /* ── BOTTOM WAVE (idéntico al homepage) ── */
    .bottom-wave {
      position:relative; height:80px; overflow:hidden; margin-top:-2px;
      background:linear-gradient(180deg,#043a48 0%,#342e24 35%,#342e24 65%,#4a3a28 100%);
    }
    .sand-wave {
      position:absolute; bottom:0; left:-5%; right:-5%; height:100%;
      background:linear-gradient(180deg,rgba(20,32,24,0.25) 0%,rgba(48,44,34,0.5) 45%,#4a3a28 100%);
      clip-path:polygon(0% 52%,4% 46%,10% 41%,18% 37%,26% 35%,34% 36%,42% 38%,50% 40%,58% 40%,66% 38%,74% 35%,82% 34%,90% 36%,96% 40%,100% 44%,105% 44%,105% 100%,0% 100%);
      animation:sandWave 10s ease-in-out infinite;
    }
    @keyframes sandWave {
      0%,100% { clip-path:polygon(0% 52%,4% 46%,10% 41%,18% 37%,26% 35%,34% 36%,42% 38%,50% 40%,58% 40%,66% 38%,74% 35%,82% 34%,90% 36%,96% 40%,100% 44%,105% 44%,105% 100%,0% 100%); }
      50%     { clip-path:polygon(0% 57%,4% 51%,10% 46%,18% 42%,26% 40%,34% 41%,42% 43%,50% 45%,58% 45%,66% 43%,74% 40%,82% 39%,90% 41%,96% 45%,100% 49%,105% 49%,105% 100%,0% 100%); }
    }

    /* ── ARENA FOOTER (idéntico al homepage) ── */
    .arena-footer {
      background:linear-gradient(180deg,#4a3a28 0%,#3a2a18 30%,#2a1a10 60%,#1a1008 100%);
      padding:3.5rem 2rem 2rem; position:relative; overflow:hidden;
    }
    .arena-footer::before { content:''; position:absolute; bottom:0; left:0; right:0; height:300px; background:radial-gradient(ellipse 280px 220px at 7% 95%,rgba(255,110,10,0.18) 0%,rgba(255,60,0,0.08) 45%,transparent 72%),radial-gradient(ellipse 280px 220px at 93% 95%,rgba(255,110,10,0.18) 0%,rgba(255,60,0,0.08) 45%,transparent 72%); pointer-events:none; z-index:0; }
    .arena-footer::after  { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent 5%,rgba(212,168,67,0.25) 30%,rgba(45,212,191,0.15) 70%,transparent 95%); }
    .arena-footer-body { max-width:1100px; margin:0 auto; position:relative; z-index:2; }
    .arena-footer-grid { display:grid; grid-template-columns:1.5fr 1fr 1fr 1.1fr; gap:2rem 1.5rem; padding-bottom:2rem; border-bottom:1px solid rgba(212,168,67,0.15); align-items:start; min-width:0; }
    .arena-brand-logo  { display:flex; align-items:center; gap:10px; margin-bottom:1rem; }
    .arena-logo-circle { width:42px; height:42px; background:linear-gradient(135deg,#2dd4bf,#d4a843); display:flex; align-items:center; justify-content:center; font-size:18px; color:#0a1628; flex-shrink:0; box-shadow:3px 3px 0 #000; }
    .arena-brand-name    { font-size:11px; font-weight:700; color:rgba(240,237,232,0.92); line-height:1.4; text-shadow:2px 2px 0 #000; }
    .arena-brand-tagline { font-size:6px; color:rgba(212,168,67,0.6); letter-spacing:2px; }
    .arena-brand-desc    { font-size:7px; line-height:2; max-width:225px; margin-bottom:1.1rem; }
    .arena-social-row { display:flex; gap:9px; flex-wrap:wrap; }
    .arena-social-btn { width:34px; height:34px; border:1px solid rgba(212,168,67,0.25); background:rgba(212,168,67,0.08); display:flex; align-items:center; justify-content:center; color:rgba(240,237,232,0.50); cursor:pointer; text-decoration:none; box-shadow:2px 2px 0 #000; transition:background .1s,color .1s,border-color .1s; }
    .arena-social-btn:hover { background:rgba(212,168,67,0.22); color:rgba(240,237,232,0.95); border-color:rgba(212,168,67,0.55); }
    .arena-heading { font-size:8px; letter-spacing:2.5px; text-transform:uppercase; color:rgba(212,168,67,0.7); margin-bottom:1rem; }
    .arena-link { color:rgba(240,237,232,0.55) !important; transition:color .1s; display:inline-block; text-decoration:none; font-size:6px; word-break:break-word; overflow-wrap:anywhere; }
    .arena-link:hover { color:rgba(240,237,232,0.95) !important; }
    .arena-text { color:rgba(240,237,232,0.45) !important; }
    .arena-link-list { list-style:none; display:flex; flex-direction:column; gap:8px; }
    .arena-link-list li { display:flex; align-items:flex-start; gap:6px; min-width:0; }
    .arena-link-list li::before { content:''; display:block; width:4px; height:4px; background:rgba(212,168,67,0.45); flex-shrink:0; margin-top:3px; }
    .arena-link-list .arena-link { padding-left:0 !important; display:inline !important; min-width:0; }
    .arena-newsletter-form { display:flex; flex-direction:column; gap:8px; margin-bottom:0.75rem; }
    .arena-newsletter-input { background:rgba(255,255,255,0.07); border:1px solid rgba(212,168,67,0.25); padding:8px 12px; font-size:7px; color:rgba(240,237,232,0.92); outline:none; width:100%; transition:border-color .1s; }
    .arena-newsletter-input::placeholder { color:rgba(240,237,232,0.30); }
    .arena-newsletter-input:focus { border-color:rgba(212,168,67,0.55); }
    .arena-subscribe-btn { background:linear-gradient(135deg,#d4a843,#c08a28); color:#0a1628; border:none; padding:9px 12px; font-size:7px; cursor:pointer; width:100%; box-shadow:3px 3px 0 #7a5010; transition:opacity .1s; }
    .arena-subscribe-btn:hover { opacity:0.88; }
    .arena-contact-row  { display:flex; flex-direction:column; gap:6px; margin-top:0.85rem; }
    .arena-contact-item { display:flex; align-items:flex-start; gap:6px; font-size:6px; color:rgba(240,237,232,0.48); text-decoration:none; transition:color .1s; overflow-wrap:anywhere; word-break:break-all; }
    .arena-contact-item:hover { color:rgba(240,237,232,0.85); }
    .arena-contact-item svg { flex-shrink:0; margin-top:1px; }
    .arena-bottom-bar   { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem; padding-top:1.25rem; }
    .arena-legal-links  { display:flex; gap:1.2rem; }
    .illo-campfire  { position:absolute; bottom:0; right:50px; width:270px; height:270px; z-index:5; pointer-events:none; filter:drop-shadow(0 0 24px rgba(255,100,10,0.55)) drop-shadow(0 0 55px rgba(255,55,0,0.28)); }
    .illo-campfire2 { position:absolute; bottom:0; left:50px;  width:270px; height:270px; z-index:5; pointer-events:none; filter:drop-shadow(0 0 24px rgba(255,100,10,0.55)) drop-shadow(0 0 55px rgba(255,55,0,0.28)); transform:scaleX(-1); }
    .illo-campfire img, .illo-campfire2 img { width:100%; height:100%; display:block; image-rendering:pixelated; -webkit-mask-image:radial-gradient(ellipse 86% 70% at 50% 66%,black 28%,rgba(0,0,0,0.75) 50%,rgba(0,0,0,0.2) 70%,transparent 88%); mask-image:radial-gradient(ellipse 86% 70% at 50% 66%,black 28%,rgba(0,0,0,0.75) 50%,rgba(0,0,0,0.2) 70%,transparent 88%); }
    @media(max-width:1100px) { .arena-footer-grid{grid-template-columns:1fr 1fr} }
    @media(max-width:640px)  { .arena-footer-grid{grid-template-columns:1fr} .arena-footer{padding:2rem 1rem} }
    @media(max-width:900px) { .illo-campfire{opacity:0.5;transform:scale(0.60);transform-origin:bottom right} .illo-campfire2{opacity:0.5;transform:scaleX(-1) scale(0.60);transform-origin:bottom left} }
    @media(max-width:768px) { .illo-campfire{transform:scale(0.38);bottom:0;right:0;opacity:0.32;transform-origin:bottom right} .illo-campfire2{transform:scaleX(-1) scale(0.38);bottom:0;left:0;opacity:0.32;transform-origin:bottom left} }

    /* ── PIXEL SHADOWS sobre tarjetas del React component ── */
    main a[style*="block"], main a[style*="border"] { box-shadow:4px 4px 0 rgba(0,0,0,0.8) !important; }
  </style>
</head>
<body>

<Navbar client:load />

<!-- ═══════════ HERO (mismo contenido, fondo canvas 8-bit) ═══════════ -->
<section class="hero">
  <canvas id="cHero"></canvas>
  <div class="hero-content">
    <div class="hero-badge">Vivencial · Capachica · 3,820 msnm</div>
    <h1 class="hero-title">
      Turismo
      <em>Vivencial</em>
    </h1>
    <p class="hero-desc">
      Más que turismo: una inmersión real en la vida andina de las familias
      de la península de Capachica, a orillas del Titicaca.
    </p>
    <div class="hero-ctas">
      <a href="/vivencial" class="btn-primary">Ver familias →</a>
      <a href="/actividades" class="btn-outline">Reservar ahora</a>
    </div>
    <div class="hero-stats">
      <div class="stat-item">
        <div class="stat-val">8+</div>
        <div class="stat-label">Comunidades</div>
      </div>
      <div class="stat-item">
        <div class="stat-val">3,820</div>
        <div class="stat-label">msnm</div>
      </div>
      <div class="stat-item">
        <div class="stat-val">500+</div>
        <div class="stat-label">Años historia</div>
      </div>
      <div class="stat-item">
        <div class="stat-val">12</div>
        <div class="stat-label">Islas cercanas</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════ MAIN — mismos componentes React del homepage ═══════════ -->
<main>
  <HomeStats client:load />
  <HomeSections client:load />
</main>

<!-- ═══════════ BOTTOM WAVE (idéntico) ═══════════ -->
<div class="bottom-wave">
  <div class="sand-wave"></div>
</div>

<!-- ═══════════ ARENA FOOTER (idéntico al homepage) ═══════════ -->
<footer class="arena-footer">
  <div class="illo-campfire">
    <img src="/campfire.gif" alt="" aria-hidden="true" />
  </div>
  <div class="illo-campfire2">
    <img src="/campfire.gif" alt="" aria-hidden="true" />
  </div>

  <div class="arena-footer-body">
    <div class="arena-footer-grid">

      <!-- Brand -->
      <div class="arena-brand-col">
        <div class="arena-brand-logo">
          <div class="arena-logo-circle">C</div>
          <div>
            <div class="arena-brand-name">Capachica</div>
            <div class="arena-brand-tagline">TURISMO VIVENCIAL</div>
          </div>
        </div>
        <p class="arena-text arena-brand-desc">La joya escondida del lago Titicaca. Turismo comunitario auténtico a 3,820 msnm.</p>
        <div class="arena-social-row">
          <a href="https://instagram.com/capachicaturismo" target="_blank" rel="noopener noreferrer" class="arena-social-btn" aria-label="Instagram">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="arena-social-btn" aria-label="Facebook">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="arena-social-btn" aria-label="YouTube">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#1a1008"/></svg>
          </a>
          <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" class="arena-social-btn" aria-label="TikTok">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
          </a>
        </div>
      </div>

      <!-- Destinos -->
      <div>
        <div class="arena-heading">Destinos</div>
        <ul class="arena-link-list">
          <li><a href="/destinos" class="arena-link">Playa Llachón</a></li>
          <li><a href="/destinos" class="arena-link">Mirador del Amaru</a></li>
          <li><a href="/destinos" class="arena-link">Isla Ticonata</a></li>
          <li><a href="/destinos" class="arena-link">Comunidad Capachica</a></li>
          <li><a href="/destinos" class="arena-link">Ver todos →</a></li>
        </ul>
      </div>

      <!-- Experiencias + Info -->
      <div>
        <div class="arena-heading">Experiencias</div>
        <ul class="arena-link-list">
          <li><a href="/vivencial"     class="arena-link">Vivencial</a></li>
          <li><a href="/actividades"   class="arena-link">Actividades</a></li>
