---
// src/pages/mis-reservas.astro
import BaseLayout from '../layouts/GastronomiaLayout.astro';

const lang = Astro.cookies.get('lang')?.value || 'es';
let translations;
try {
  translations = await import(`../i18n/${lang}.json`);
} catch (e) {
  translations = await import('../i18n/es.json');
}

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api';

const ESTADO_LABEL = {
  pendiente: { texto: 'Pendiente', color: '#d69e2e' },
  confirmada: { texto: 'Confirmada', color: '#38a169' },
  cancelada: { texto: 'Cancelada', color: '#e53e3e' },
  completada: { texto: 'Completada', color: '#3182ce' },
};
---

<BaseLayout lang={lang}>
    <div style="max-width: 700px; margin: 3rem auto; padding: 0 1rem;">
        <h2 style="font-size: 1.5rem; font-weight: bold; color: var(--turquesa); margin-bottom: 1.5rem;">
            Mis reservas
        </h2>

        <div id="sinSesion" style="display:none; background:white; padding:2rem; border-radius:0.5rem; text-align:center;">
            <p style="margin-bottom:1rem; color:#4a5568;">Debes iniciar sesión para ver tus reservas.</p>
            <a href="/auth/login?redirect=/mis-reservas" class="btn btn-primary" style="padding:0.6rem 1.5rem;">Iniciar sesión</a>
        </div>

        <div id="cargando" style="display:none; color:#718096; text-align:center;">Cargando...</div>
        <div id="sinReservas" style="display:none; background:white; padding:2rem; border-radius:0.5rem; text-align:center; color:#718096;">
            Aún no tienes reservas. <a href="/actividades" style="color:var(--turquesa); font-weight:600;">Explora actividades</a>
        </div>

        <div id="listaReservas" style="display:flex; flex-direction:column; gap:1rem;"></div>
    </div>

    <div id="modalOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center; padding:1rem;">
        <div style="background:white; border-radius:0.75rem; max-width:480px; width:100%; max-height:85vh; overflow-y:auto; padding:1.5rem; position:relative;">
            <button id="mdCerrar" aria-label="Cerrar" style="position:absolute; top:1rem; right:1rem; background:none; border:none; font-size:1.5rem; line-height:1; cursor:pointer; color:#a0aec0;">&times;</button>

            <span id="mdEstado" style="display:inline-block; color:white; padding:0.25rem 0.75rem; border-radius:1rem; font-size:0.8rem; font-weight:600;"></span>
            <h3 id="mdTitulo" style="font-weight:700; color:#2d3748; font-size:1.25rem; margin-top:0.5rem;"></h3>

            <div id="mdVista">
                <p style="color:#4a5568; margin-top:1rem;"><strong>Fecha de visita:</strong> <span id="mdFecha"></span></p>
                <p style="color:#4a5568; margin-top:0.5rem;"><strong>Personas:</strong> <span id="mdPersonas"></span></p>
                <p style="color:#4a5568; margin-top:0.5rem;"><strong>Idioma:</strong> <span id="mdIdioma"></span></p>
                <p style="color:#4a5568; margin-top:0.5rem;" id="mdNotasWrap"><strong>Notas:</strong> <span id="mdNotas"></span></p>
                <p style="color:var(--turquesa); font-weight:600; margin-top:0.5rem;">S/. <span id="mdTotal"></span></p>
                <p style="color:#a0aec0; font-size:0.85rem; margin-top:0.5rem;">Reservado el <span id="mdCreado"></span></p>

                <p id="mdErrorVista" style="display:none; color:#e53e3e; font-size:0.9rem; margin-top:1rem;"></p>

                <div id="mdAcciones" style="display:flex; gap:0.75rem; margin-top:1.25rem;">
                    <button id="mdBtnEditar" class="btn" style="flex:1; padding:0.6rem; border:1px solid var(--turquesa); color:var(--turquesa); background:white; border-radius:0.5rem; cursor:pointer;">Editar</button>
                    <button id="mdBtnCancelar" class="btn" style="flex:1; padding:0.6rem; border:1px solid #e53e3e; color:#e53e3e; background:white; border-radius:0.5rem; cursor:pointer;">Cancelar reserva</button>
                </div>

                <p id="mdBloqueada" style="display:none; color:#718096; font-size:0.85rem; margin-top:1rem; text-align:center;">
                    Esta reserva ya fue confirmada. Para cambios, contáctanos por WhatsApp.
                </p>

                <div id="mdConfirmCancelar" style="display:none; margin-top:1rem;">
                    <p style="color:#4a5568;">¿Seguro que quieres cancelar esta reserva?</p>
                    <div style="display:flex; gap:0.75rem; margin-top:0.75rem;">
                        <button id="mdBtnNoCancelar" style="flex:1; padding:0.6rem; border:1px solid #cbd5e0; background:white; border-radius:0.5rem; cursor:pointer;">No, mantener</button>
                        <button id="mdBtnSiCancelar" style="flex:1; padding:0.6rem; border:none; background:#e53e3e; color:white; border-radius:0.5rem; cursor:pointer;">Sí, cancelar</button>
                    </div>
                </div>
            </div>

            <div id="mdEdicion" style="display:none; margin-top:1rem;">
                <label style="display:block; font-size:0.85rem; color:#718096; margin-top:0.75rem;">Fecha de visita</label>
                <input id="mdInFecha" type="date" style="width:100%; padding:0.6rem; border:1px solid #cbd5e0; border-radius:0.5rem; margin-top:0.25rem;" />

                <label style="display:block; font-size:0.85rem; color:#718096; margin-top:0.75rem;">Personas</label>
                <input id="mdInPersonas" type="number" min="1" max="20" style="width:100%; padding:0.6rem; border:1px solid #cbd5e0; border-radius:0.5rem; margin-top:0.25rem;" />

                <label style="display:block; font-size:0.85rem; color:#718096; margin-top:0.75rem;">Idioma</label>
                <select id="mdInIdioma" style="width:100%; padding:0.6rem; border:1px solid #cbd5e0; border-radius:0.5rem; margin-top:0.25rem;">
                    <option value="Español">Español</option>
                    <option value="English">English</option>
                    <option value="Français">Français</option>
                </select>

                <label style="display:block; font-size:0.85rem; color:#718096; margin-top:0.75rem;">Notas</label>
                <textarea id="mdInNotas" rows="3" style="width:100%; padding:0.6rem; border:1px solid #cbd5e0; border-radius:0.5rem; margin-top:0.25rem; resize:vertical;" placeholder="Dieta, accesibilidad, alergias…"></textarea>

                <p id="mdErrorEdicion" style="display:none; color:#e53e3e; font-size:0.9rem; margin-top:0.75rem;"></p>

                <div style="display:flex; gap:0.75rem; margin-top:1.25rem;">
                    <button id="mdBtnDescartar" style="flex:1; padding:0.6rem; border:1px solid #cbd5e0; background:white; border-radius:0.5rem; cursor:pointer;">Descartar</button>
                    <button id="mdBtnGuardar" style="flex:1; padding:0.6rem; border:none; background:var(--turquesa); color:white; border-radius:0.5rem; cursor:pointer;">Guardar cambios</button>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<script define:vars={{ API_URL, ESTADO_LABEL }}>
    let reservasData = [];
    let reservaActualId = null;

    function getToken() {
        return localStorage.getItem('accessToken');
    }

    async function cargarReservas() {
        const token = getToken();
        if (!token) {
            document.getElementById('sinSesion').style.display = 'block';
            return;
        }

        document.getElementById('cargando').style.display = 'block';
        try {
            const res = await fetch(`${API_URL}/reservas/mias`, {
                headers: { Authorization: `Bearer ${token}` },
            });
            const data = await res.json();
            document.getElementById('cargando').style.display = 'none';

            if (!res.ok) {
                document.getElementById('sinSesion').style.display = 'block';
                return;
            }

            reservasData = data.reservas || [];
            document.getElementById('sinReservas').style.display = reservasData.length ? 'none' : 'block';
            renderLista();
        } catch (err) {
            document.getElementById('cargando').style.display = 'none';
            document.getElementById('sinReservas').style.display = 'block';
        }
    }

    function renderLista() {
        const lista = document.getElementById('listaReservas');
        lista.innerHTML = reservasData.map(r => {
            const estado = ESTADO_LABEL[r.estado] || { texto: r.estado, color: '#718096' };
            const fecha = new Date(r.fecha_visita).toLocaleDateString('es-PE', { year: 'numeric', month: 'long', day: 'numeric' });
            return `
                <div class="tarjetaReserva" data-id="${r.id}" style="background:white; padding:1.25rem; border-radius:0.5rem; box-shadow:0 2px 8px rgba(0,0,0,0.08); cursor:pointer;">
                    <div style="display:flex; justify-content:space-between; align-items:start; gap:1rem;">
                        <div>
                            <h3 style="font-weight:700; color:#2d3748; margin-bottom:0.25rem;">${r.actividad}</h3>
                            <p style="color:#718096; font-size:0.9rem;">${fecha} · ${r.personas} persona(s) · ${r.idioma}</p>
                            ${r.notas ? `<p style="color:#a0aec0; font-size:0.85rem; margin-top:0.25rem;">${r.notas}</p>` : ''}
                        </div>
                        <span style="background:${estado.color}; color:white; padding:0.25rem 0.75rem; border-radius:1rem; font-size:0.8rem; font-weight:600; white-space:nowrap;">
                            ${estado.texto}
                        </span>
                    </div>
                    ${r.precio_total ? `<p style="margin-top:0.5rem; font-weight:600; color:var(--turquesa);">S/. ${r.precio_total}</p>` : ''}
                    <p style="margin-top:0.5rem; color:var(--turquesa); font-size:0.85rem; font-weight:600; text-align:right;">Ver detalle &rsaquo;</p>
                </div>
            `;
        }).join('');

        lista.querySelectorAll('.tarjetaReserva').forEach(el => {
            el.addEventListener('click', () => abrirDetalle(el.dataset.id));
        });
    }

    function abrirDetalle(id) {
        const r = reservasData.find(x => x.id === id);
        if (!r) return;
        reservaActualId = id;

        const estado = ESTADO_LABEL[r.estado] || { texto: r.estado, color: '#718096' };
        document.getElementById('mdEstado').textContent = estado.texto;
        document.getElementById('mdEstado').style.background = estado.color;
        document.getElementById('mdTitulo').textContent = r.actividad;
        document.getElementById('mdFecha').textContent = new Date(r.fecha_visita).toLocaleDateString('es-PE', { year: 'numeric', month: 'long', day: 'numeric' });
        document.getElementById('mdPersonas').textContent = r.personas;
        document.getElementById('mdIdioma').textContent = r.idioma || 'Español';
        document.getElementById('mdNotasWrap').style.display = r.notas ? 'block' : 'none';
        document.getElementById('mdNotas').textContent = r.notas || '';
        document.getElementById('mdTotal').textContent = r.precio_total;
        document.getElementById('mdCreado').textContent = new Date(r.created_at).toLocaleDateString('es-PE');

        const puedeEditar = r.estado === 'pendiente';
        document.getElementById('mdAcciones').style.display = puedeEditar ? 'flex' : 'none';
        document.getElementById('mdBloqueada').style.display = (!puedeEditar && r.estado !== 'cancelada') ? 'block' : 'none';
        document.getElementById('mdConfirmCancelar').style.display = 'none';
        document.getElementById('mdErrorVista').style.display = 'none';

        document.getElementById('mdVista').style.display = 'block';
        document.getElementById('mdEdicion').style.display = 'none';

        document.getElementById('modalOverlay').style.display = 'flex';
    }

    function cerrarModal() {
        document.getElementById('modalOverlay').style.display = 'none';
        reservaActualId = null;
    }

    function abrirEdicion() {
        const r = reservasData.find(x => x.id === reservaActualId);
        if (!r) return;
        document.getElementById('mdInFecha').value = r.fecha_visita.slice(0, 10);
        document.getElementById('mdInPersonas').value = r.personas;
        document.getElementById('mdInIdioma').value = r.idioma || 'Español';
        document.getElementById('mdInNotas').value = r.notas || '';
        document.getElementById('mdErrorEdicion').style.display = 'none';

        document.getElementById('mdVista').style.display = 'none';
        document.getElementById('mdEdicion').style.display = 'block';
    }

    async function guardarEdicion() {
        const fecha_visita = document.getElementById('mdInFecha').value;
        const personas = parseInt(document.getElementById('mdInPersonas').value) || 1;
        const idioma = document.getElementById('mdInIdioma').value;
        const notas = document.getElementById('mdInNotas').value;
        const errEl = document.getElementById('mdErrorEdicion');

        if (!fecha_visita) {
            errEl.textContent = 'La fecha es obligatoria.';
            errEl.style.display = 'block';
            return;
        }

        const btn = document.getElementById('mdBtnGuardar');
        btn.disabled = true;
        btn.textContent = 'Guardando…';
        try {
            const res = await fetch(`${API_URL}/reservas/${reservaActualId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${getToken()}` },
                body: JSON.stringify({ fecha_visita, personas, idioma, notas }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data?.error || 'Error al guardar');

            reservasData = reservasData.map(x => (x.id === data.reserva.id ? data.reserva : x));
            renderLista();
            abrirDetalle(reservaActualId);
        } catch (err) {
            errEl.textContent = err.message;
            errEl.style.display = 'block';
        } finally {
            btn.disabled = false;
            btn.textContent = 'Guardar cambios';
        }
    }

    async function confirmarCancelacion() {
        const btn = document.getElementById('mdBtnSiCancelar');
        btn.disabled = true;
        btn.textContent = 'Cancelando…';
        const errEl = document.getElementById('mdErrorVista');
        try {
            const res = await fetch(`${API_URL}/reservas/${reservaActualId}/cancelar`, {
                method: 'PATCH',
                headers: { Authorization: `Bearer ${getToken()}` },
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data?.error || 'Error al cancelar');

            reservasData = reservasData.map(x => (x.id === data.reserva.id ? { ...x, estado: data.reserva.estado } : x));
            renderLista();
            abrirDetalle(reservaActualId);
        } catch (err) {
            errEl.textContent = err.message;
            errEl.style.display = 'block';
        } finally {
            btn.disabled = false;
            btn.textContent = 'Sí, cancelar';
        }
    }

    document.getElementById('mdCerrar').addEventListener('click', cerrarModal);
    document.getElementById('modalOverlay').addEventListener('click', (e) => {
        if (e.target.id === 'modalOverlay') cerrarModal();
    });
    document.getElementById('mdBtnEditar').addEventListener('click', abrirEdicion);
    document.getElementById('mdBtnDescartar').addEventListener('click', () => {
        document.getElementById('mdEdicion').style.display = 'none';
        document.getElementById('mdVista').style.display = 'block';
    });
    document.getElementById('mdBtnGuardar').addEventListener('click', guardarEdicion);
    document.getElementById('mdBtnCancelar').addEventListener('click', () => {
        document.getElementById('mdConfirmCancelar').style.display = 'block';
    });
    document.getElementById('mdBtnNoCancelar').addEventListener('click', () => {
        document.getElementById('mdConfirmCancelar').style.display = 'none';
    });
    document.getElementById('mdBtnSiCancelar').addEventListener('click', confirmarCancelacion);

    cargarReservas();
</script>
