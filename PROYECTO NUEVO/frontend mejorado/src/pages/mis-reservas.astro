---
// src/pages/mis-reservas.astro
import BaseLayout from '../layouts/GastronomiaLayout.astro';

const lang = Astro.cookies.get('lang')?.value || 'es';
let translations;
try {
  translations = await import(`../i18n/${lang}.json`);
} catch (e) {
  translations = await import('../i18n/es.json');
}

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api';

const ESTADO_LABEL = {
  pendiente: { texto: 'Pendiente', color: '#d69e2e' },
  confirmada: { texto: 'Confirmada', color: '#38a169' },
  cancelada: { texto: 'Cancelada', color: '#e53e3e' },
  completada: { texto: 'Completada', color: '#3182ce' },
};
---

<BaseLayout lang={lang}>
    <div style="max-width: 700px; margin: 3rem auto; padding: 0 1rem;">
        <h2 style="font-size: 1.5rem; font-weight: bold; color: var(--turquesa); margin-bottom: 1.5rem;">
            Mis reservas
        </h2>

        <div id="sinSesion" style="display:none; background:white; padding:2rem; border-radius:0.5rem; text-align:center;">
            <p style="margin-bottom:1rem; color:#4a5568;">Debes iniciar sesión para ver tus reservas.</p>
            <a href="/auth/login?redirect=/mis-reservas" class="btn btn-primary" style="padding:0.6rem 1.5rem;">Iniciar sesión</a>
        </div>

        <div id="cargando" style="display:none; color:#718096; text-align:center;">Cargando...</div>
        <div id="sinReservas" style="display:none; background:white; padding:2rem; border-radius:0.5rem; text-align:center; color:#718096;">
            Aún no tienes reservas. <a href="/actividades" style="color:var(--turquesa); font-weight:600;">Explora actividades</a>
        </div>

        <div id="listaReservas" style="display:flex; flex-direction:column; gap:1rem;"></div>
    </div>
</BaseLayout>

<script define:vars={{ API_URL, ESTADO_LABEL }}>
    async function cargarReservas() {
        const token = localStorage.getItem('accessToken');
        if (!token) {
            document.getElementById('sinSesion').style.display = 'block';
            return;
        }

        document.getElementById('cargando').style.display = 'block';
        try {
            const res = await fetch(`${API_URL}/reservas/mias`, {
                headers: { Authorization: `Bearer ${token}` },
            });
            const data = await res.json();
            document.getElementById('cargando').style.display = 'none';

            if (!res.ok) {
                document.getElementById('sinSesion').style.display = 'block';
                return;
            }

            const reservas = data.reservas || [];
            if (!reservas.length) {
                document.getElementById('sinReservas').style.display = 'block';
                return;
            }

            const lista = document.getElementById('listaReservas');
            lista.innerHTML = reservas.map(r => {
                const estado = ESTADO_LABEL[r.estado] || { texto: r.estado, color: '#718096' };
                const fecha = new Date(r.fecha_visita).toLocaleDateString('es-PE', { year: 'numeric', month: 'long', day: 'numeric' });
                return `
                    <div style="background:white; padding:1.25rem; border-radius:0.5rem; box-shadow:0 2px 8px rgba(0,0,0,0.08);">
                        <div style="display:flex; justify-content:space-between; align-items:start; gap:1rem;">
                            <div>
                                <h3 style="font-weight:700; color:#2d3748; margin-bottom:0.25rem;">${r.actividad}</h3>
                                <p style="color:#718096; font-size:0.9rem;">${fecha} · ${r.personas} persona(s) · ${r.idioma}</p>
                                ${r.notas ? `<p style="color:#a0aec0; font-size:0.85rem; margin-top:0.25rem;">${r.notas}</p>` : ''}
                            </div>
                            <span style="background:${estado.color}; color:white; padding:0.25rem 0.75rem; border-radius:1rem; font-size:0.8rem; font-weight:600; white-space:nowrap;">
                                ${estado.texto}
                            </span>
                        </div>
                        ${r.precio_total ? `<p style="margin-top:0.5rem; font-weight:600; color:var(--turquesa);">S/. ${r.precio_total}</p>` : ''}
                    </div>
                `;
            }).join('');
        } catch (err) {
            document.getElementById('cargando').style.display = 'none';
            document.getElementById('sinReservas').style.display = 'block';
        }
    }

    cargarReservas();
</script>
