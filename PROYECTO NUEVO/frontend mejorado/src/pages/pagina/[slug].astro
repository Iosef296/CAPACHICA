---
import Layout from '../../layouts/Layout.astro';
import SectionRenderer from '../../components/SectionRenderer.astro';

const { slug } = Astro.params;
const IA_URL = import.meta.env.PUBLIC_IA_URL || 'http://localhost:5000';

let page: any = null;
try {
  const res = await fetch(`${IA_URL}/api/paginas/${slug}`);
  if (res.ok) page = await res.json();
} catch {}

if (!page) return Astro.redirect('/');

const hero = page.secciones?.find((s: any) => s.tipo === 'hero');
---
<Layout title={`${page.titulo} — Capachica Turismo`} description={page.descripcion || ''}>
  <Fragment slot="hero">
    {hero ? (
      <>
        <h1 class="section-title" style="font-size:clamp(2.2rem,5vw,3.5rem);margin-bottom:1rem;">{hero.titulo}</h1>
        {hero.subtitulo && <p style="font-size:1.05rem;color:var(--text2);line-height:1.75;max-width:560px;margin:0 auto 2rem;">{hero.subtitulo}</p>}
      </>
    ) : (
      <h1 class="section-title" style="font-size:clamp(2.2rem,5vw,3.5rem);">{page.titulo}</h1>
    )}
  </Fragment>
  <div style="max-width:1100px;margin:0 auto;padding:3rem 1.5rem 6rem;">
    <SectionRenderer secciones={page.secciones} skipHero={true} />
  </div>
</Layout>
