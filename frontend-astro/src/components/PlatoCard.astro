---
// src/components/PlatoCard.astro
import { APP_CONFIG } from '../config/app.config.js';

const { plato, translations } = Astro.props;
const { id, nombre, descripcion, precio, foto, categoria } = plato;

let imagenUrl = foto;
if (imagenUrl && !imagenUrl.startsWith('http')) {
    const cleanPath = imagenUrl.replace(/\\/g, '/');
    const prefix = cleanPath.startsWith('/') ? '' : '/';
    imagenUrl = `${APP_CONFIG.backendUrl}${prefix}${cleanPath}`;
}
---

<article class="plato-card">
    <div class="card-image-wrapper">
        <img
                src={imagenUrl || '/images/placeholder.jpg'}
                alt={nombre}
                class="card-image"
        />
        <span class="card-badge">
            {categoria ? categoria.replace('_', ' ') : 'Plato'}
        </span>
    </div>

    <div class="card-content">
        <h4 class="card-title">{nombre}</h4>
        <p class="card-desc">{descripcion ? descripcion.substring(0, 60) + '...' : 'Sin descripción'}</p>

        <div class="card-footer">
            <span class="card-price">S/ {precio}</span>
            <button class="btn-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </div>
    </div>
</article>

<style>
/* Mantén exactamente el mismo CSS que ya tenías aquí, no cambia nada del diseño */
    .plato-card { background: rgba(26, 32, 44, 0.6); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(79, 209, 197, 0.2); border-radius: 1rem; overflow: hidden; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2); transition: all 0.3s ease; display: flex; flex-direction: column; height: 100%; cursor: pointer; }
    .plato-card:hover { transform: translateY(-8px); border-color: var(--turquesa); box-shadow: 0 10px 25px rgba(79, 209, 197, 0.3); }
    .card-image-wrapper { height: 180px; width: 100%; position: relative; overflow: hidden; background-color: #1a202c; }
    .card-image { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
    .plato-card:hover .card-image { transform: scale(1.1); }
    .card-badge { position: absolute; top: 1rem; right: 1rem; background: rgba(26, 32, 44, 0.85); backdrop-filter: blur(4px); border: 1px solid var(--turquesa); color: #fff; padding: 0.3rem 0.8rem; border-radius: 2rem; font-size: 0.75rem; font-weight: 600; text-transform: capitalize; letter-spacing: 0.5px; box-shadow: 0 0 10px rgba(79, 209, 197, 0.4); }
    .card-content { padding: 1.25rem; display: flex; flex-direction: column; flex-grow: 1; }
    .card-title { font-size: 1.25rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem; text-shadow: 0 0 5px rgba(255, 255, 255, 0.1); }
    .card-desc { font-size: 0.9rem; color: #a0aec0; line-height: 1.5; margin-bottom: 1rem; flex-grow: 1; }
    .card-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.1); margin-top: auto; }
    .card-price { font-size: 1.3rem; font-weight: 800; color: var(--dorado); text-shadow: 0 0 10px rgba(214, 158, 46, 0.4); }
    .btn-icon { background: transparent; border: none; color: var(--turquesa); display: flex; align-items: center; justify-content: center; padding: 0.5rem; border-radius: 50%; transition: all 0.3s ease; cursor: pointer; }
    .plato-card:hover .btn-icon { background: rgba(79, 209, 197, 0.2); color: var(--turquesa-claro, #81e6d9); box-shadow: 0 0 10px rgba(79, 209, 197, 0.4); transform: translateX(4px); }
    @media (max-width: 480px) { .card-image-wrapper { height: 160px; } .card-content { padding: 1rem; } .card-title { font-size: 1.15rem; } }
</style>